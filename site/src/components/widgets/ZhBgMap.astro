---
// Фон-карта сайта (п.2 редизайна): тонированная тёмная карта под контентом.
// СКРОЛЛИТСЯ вместе с контентом (как в макете v19): position:absolute от body.
// Виньетка как в макете: боковые градиенты + вертикальное затухание, без молнии.
---
<div class="zh-bg-map" aria-hidden="true">
  <img src="/bg-map.webp" alt="" loading="lazy" decoding="async" width="1440" height="8640" />
  <div class="zh-bg-shade"></div>
</div>
<style>
  :global(body){position:relative}
  .zh-bg-map{position:absolute;top:0;left:0;width:100%;height:100%;min-height:100vh;z-index:-1;background:#0B0D10;pointer-events:none;overflow:hidden}
  .zh-bg-map img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:grayscale(.4) brightness(.9) contrast(1.05)}
  .zh-bg-shade{position:absolute;inset:0;background:
    linear-gradient(90deg, rgba(0,0,0,.78) 0%, rgba(0,0,0,.42) 14%, transparent 32%, transparent 68%, rgba(0,0,0,.42) 86%, rgba(0,0,0,.78) 100%),
    linear-gradient(180deg, rgba(4,8,13,.52) 0%, rgba(4,8,13,.28) 14%, rgba(4,8,13,.46) 55%, rgba(4,8,13,.66) 100%)}
  .zh-bg-shade::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg, rgba(0,0,0,.16) 0%, rgba(0,0,0,.32) 45%, rgba(0,0,0,.5) 100%),rgba(11,13,16,.22)}
</style>
