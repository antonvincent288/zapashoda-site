---
// Фон v2: «сцена», а не пятно. Свечение НЕ в центре: прожектор за виджетом справа,
// тонкая линия-горизонт, точечная сетка и холодный отсвет сверху — глубина без картинок.
---
<div class="zh-bg-map" aria-hidden="true">
  <div class="zg-floor"></div>
  <div class="zg-soft"></div>
  <div class="zg-beam"></div>
  <div class="zg-dots"></div>
  <div class="zg-cool"></div>
  <div class="zh-bg-shade"></div>
</div>
<style>
  :global(body){position:relative}
  .zh-bg-map{position:absolute;top:0;left:0;width:100%;height:100%;min-height:100vh;z-index:-1;background:#050506;pointer-events:none;overflow:hidden}
  /* Прожектор за виджетом: правая часть hero, свет «из-под» виджета */
  .zg-floor{position:absolute;right:-12%;top:60px;width:1500px;height:1500px;
    background:radial-gradient(circle at 42% 38%, rgba(255,122,26,.13) 0%, rgba(214,74,10,.08) 26%, rgba(122,38,4,.035) 46%, transparent 66%)}
  /* Широкий мягкий полусвет вдоль нижней трети hero */
  .zg-soft{position:absolute;left:-8%;top:520px;width:80%;height:900px;
    background:radial-gradient(ellipse at 30% 60%, rgba(232,80,2,.075) 0%, rgba(150,44,6,.035) 42%, transparent 72%)}
  /* Линия-горизонт: тонкий световой штрих под виджетом */
  .zg-beam{position:absolute;left:8%;top:640px;width:84%;height:1px;
    background:linear-gradient(90deg, transparent 0%, rgba(255,143,51,.18) 30%, rgba(255,190,120,.34) 52%, rgba(255,143,51,.14) 74%, transparent 100%);
    filter:drop-shadow(0 0 14px rgba(255,122,26,.25))}
  /* Точечная сетка — техно-фактура, едва заметная */
  .zg-dots{position:absolute;inset:0;
    background-image:radial-gradient(rgba(255,160,80,.06) 1px, transparent 1.6px);
    background-size:28px 28px;
    -webkit-mask-image:radial-gradient(70% 55% at 60% 22%, #000 0%, rgba(0,0,0,.5) 45%, transparent 78%);
    mask-image:radial-gradient(70% 55% at 60% 22%, #000 0%, rgba(0,0,0,.5) 45%, transparent 78%)}
  /* Холодный отсвет сверху-слева — глубина и контраст тёплого */
  .zg-cool{position:absolute;left:-6%;top:-14%;width:900px;height:700px;
    background:radial-gradient(circle at 50% 50%, rgba(96,130,190,.05) 0%, transparent 62%)}
  @media(max-width:900px){
    .zg-floor{right:-30%;top:20px;width:1100px;height:1100px}
    .zg-soft{left:0;top:420px;width:110%}
    .zg-beam{left:4%;top:520px;width:92%}
  }
  .zh-bg-shade{position:absolute;inset:0;background:
    linear-gradient(90deg, rgba(0,0,0,.5) 0%, rgba(0,0,0,.2) 12%, transparent 30%, transparent 70%, rgba(0,0,0,.2) 88%, rgba(0,0,0,.5) 100%),
    linear-gradient(180deg, rgba(3,3,4,.4) 0%, transparent 12%, transparent 55%, rgba(3,3,4,.55) 100%)}
</style>
