---
// Фон v3: сгенерированная «сцена» (YandexART): прожектор справа, сеть точек, линия-горизонт.
// Чистый слой + виньетка; без анимаций. Файл 22 КБ.
---
<div class="zh-bg-map" aria-hidden="true">
  <img class="zbg-img" src="/bg-scene.webp" alt="" loading="eager" decoding="async" />
  <div class="zh-bg-shade"></div>
</div>
<style>
  :global(body){position:relative}
  .zh-bg-map{position:absolute;top:0;left:0;width:100%;height:100%;min-height:100vh;z-index:-1;background:#050506;pointer-events:none;overflow:hidden}
  .zh-bg-map img.zbg-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:70% 22%;filter:brightness(.82) saturate(1.06)}
  @media(max-width:900px){.zh-bg-map img.zbg-img{object-position:62% 30%}}
  .zh-bg-shade{position:absolute;inset:0;background:
    linear-gradient(90deg, rgba(0,0,0,.42) 0%, rgba(0,0,0,.16) 12%, transparent 32%, transparent 70%, rgba(0,0,0,.2) 88%, rgba(0,0,0,.46) 100%),
    linear-gradient(180deg, rgba(3,3,4,.42) 0%, transparent 14%, transparent 56%, rgba(3,3,4,.55) 100%)}
</style>
