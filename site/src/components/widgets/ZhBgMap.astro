---
// Фон: чёрный с оранжевыми засветами (решение владельца 21.11 22:55 — карта снята).
// Чистый CSS, без картинок и анимаций — нулевая нагрузка на любой прокрутке.
---
<div class="zh-bg-map" aria-hidden="true">
  <div class="zg-core"></div>
  <div class="zg-rim"></div>
  <div class="zg-low"></div>
  <div class="zh-bg-shade"></div>
</div>
<style>
  :global(body){position:relative}
  .zh-bg-map{position:absolute;top:0;left:0;width:100%;height:100%;min-height:100vh;z-index:-1;background:#050506;pointer-events:none;overflow:hidden}
  /* Ядро свечения под hero — как «затмение» на референсе */
  .zg-core{position:absolute;left:50%;top:120px;width:1400px;height:1400px;transform:translateX(-50%);
    background:radial-gradient(circle, rgba(232,80,2,.30) 0%, rgba(214,58,10,.16) 18%, rgba(120,30,6,.07) 38%, transparent 62%)}
  .zg-rim{position:absolute;left:50%;top:120px;width:760px;height:760px;transform:translateX(-50%);
    background:radial-gradient(circle, transparent 42%, rgba(255,143,51,.10) 50%, rgba(232,80,2,.16) 56%, transparent 68%)}
  /* Тёплый низ страницы — мягкий полусвет у секций инструментов */
  .zg-low{position:absolute;left:10%;top:1750px;width:1200px;height:1100px;
    background:radial-gradient(ellipse at 35% 45%, rgba(232,80,2,.10) 0%, rgba(150,40,6,.05) 40%, transparent 70%)}
  @media(max-width:900px){
    .zg-core{width:1100px;height:1100px;top:80px}
    .zg-rim{width:600px;height:600px;top:80px}
    .zg-low{left:0;top:2100px;width:900px;height:900px}
  }
  .zh-bg-shade{position:absolute;inset:0;background:
    linear-gradient(90deg, rgba(0,0,0,.55) 0%, rgba(0,0,0,.25) 14%, transparent 32%, transparent 68%, rgba(0,0,0,.25) 86%, rgba(0,0,0,.55) 100%),
    linear-gradient(180deg, rgba(3,3,4,.35) 0%, transparent 14%, transparent 55%, rgba(3,3,4,.5) 100%)}
</style>
