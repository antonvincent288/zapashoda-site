---
// Фон v3: «затмение» — ядро свечения за виджетом (справа), ореол-кольцо, глубокая аура,
// тёплый горизонт у калькулятора, холодный выдох у базы знаний. Чистый CSS, без анимаций.
---
<div class="zh-bg-map" aria-hidden="true">
  <div class="zg-stack"></div>
  <div class="zh-bg-shade"></div>
</div>
<style>
  :global(body){position:relative}
  .zh-bg-map{position:absolute;top:0;left:0;width:100%;height:100%;min-height:100vh;z-index:-1;background:linear-gradient(180deg,#050506 0%,#07070a 42%,#050506 100%);pointer-events:none;overflow:hidden}
  .zg-stack{position:absolute;inset:0;background:
    radial-gradient(80% 10% at 50% -30px, rgba(255,143,51,.10), transparent 72%),
    radial-gradient(13% 9% at 74% 398px, rgba(255,196,120,.44) 0%, rgba(255,143,51,.22) 55%, transparent 78%),
    radial-gradient(22% 16% at 74% 400px, transparent 40%, rgba(255,143,51,.20) 47%, rgba(232,80,2,.28) 53%, transparent 63%),
    radial-gradient(44% 30% at 74% 410px, rgba(255,143,51,.30) 0%, rgba(232,80,2,.17) 20%, rgba(150,45,8,.06) 46%, transparent 67%),
    radial-gradient(78% 58% at 70% 660px, rgba(150,34,6,.34) 0%, rgba(96,24,5,.13) 42%, transparent 72%),
    radial-gradient(130% 24% at 58% 1560px, rgba(232,80,2,.16) 0%, rgba(150,40,6,.05) 52%, transparent 79%),
    radial-gradient(66% 20% at 28% 2560px, rgba(10,26,48,.55) 0%, rgba(6,18,36,.15) 52%, transparent 80%),
    radial-gradient(96% 22% at 66% 3340px, rgba(232,80,2,.09) 0%, transparent 72%)}
  @media(max-width:900px){
    .zg-stack{background:
      radial-gradient(90% 9% at 50% -20px, rgba(255,143,51,.11), transparent 70%),
      radial-gradient(17% 8% at 50% 425px, rgba(255,170,80,.32) 0%, rgba(255,143,51,.16) 55%, transparent 78%),
      radial-gradient(30% 12% at 50% 430px, transparent 40%, rgba(255,143,51,.16) 47%, rgba(232,80,2,.22) 52%, transparent 63%),
      radial-gradient(60% 22% at 50% 440px, rgba(255,143,51,.30) 0%, rgba(232,80,2,.18) 22%, rgba(150,45,8,.06) 48%, transparent 68%),
      radial-gradient(100% 46% at 50% 700px, rgba(138,32,6,.30) 0%, rgba(85,22,4,.11) 46%, transparent 74%),
      radial-gradient(130% 18% at 50% 1750px, rgba(232,80,2,.11) 0%, rgba(150,40,6,.04) 52%, transparent 78%),
      radial-gradient(90% 16% at 50% 2650px, rgba(10,26,48,.5) 0%, rgba(6,18,36,.14) 50%, transparent 80%),
      radial-gradient(120% 18% at 50% 3500px, rgba(232,80,2,.07) 0%, transparent 72%)}
  }
  .zh-bg-shade{position:absolute;inset:0;background:
    linear-gradient(90deg, rgba(0,0,0,.5) 0%, rgba(0,0,0,.22) 14%, transparent 34%, transparent 66%, rgba(0,0,0,.22) 86%, rgba(0,0,0,.5) 100%),
    linear-gradient(180deg, rgba(3,3,4,.4) 0%, transparent 16%, transparent 55%, rgba(3,3,4,.55) 100%)}
</style>
