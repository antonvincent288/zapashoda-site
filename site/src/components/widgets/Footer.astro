---
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
  target?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '', theme = 'light' } = Astro.props;
---

<footer class:list={[{ dark: theme === 'dark' }, 'zh-footer relative not-prose']}>
  <div class="zh-footer-fade absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 dark:text-slate-300">
    <div class="grid grid-cols-12 gap-4 gap-y-8 sm:gap-8 py-10 md:py-14">
      <div class="col-span-12 lg:col-span-4">
        <div class="mb-3">
          <a class="zh-footer-logo inline-flex items-center gap-2 font-bold text-xl text-white" href={getHomePermalink()}>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="#FF8F33" aria-hidden="true"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"/></svg>
            <span>{SITE?.name}</span>
          </a>
        </div>
        <p class="text-sm text-muted max-w-xs">Практика зарядки EV в России: разъёмы, адаптеры, станции, деньги.</p>
        <div class="text-sm text-muted flex gap-1 mt-3">
          {
            secondaryLinks.map(({ text, href }, index) => (
              <>
                {index !== 0 ? ' · ' : ''}
                <a
                  class="text-muted hover:text-white dark:text-gray-400 hover:underline transition duration-150 ease-in-out"
                  href={href}
                  set:html={text}
                />
              </>
            ))
          }
        </div>
      </div>
      {
        links.map(({ title, links }) => (
          <div class="col-span-6 md:col-span-3 lg:col-span-2">
            <div class="dark:text-gray-200 font-semibold mb-3 text-white">{title}</div>
            {links && Array.isArray(links) && links.length > 0 && (
              <ul class="text-sm">
                {links.map(({ text, href, ariaLabel, target }) => (
                  <li class="mb-2">
                    <a
                      class="text-muted hover:text-white dark:text-gray-400 transition duration-150 ease-in-out"
                      href={href}
                      aria-label={ariaLabel}
                      target={target}
                      rel={target === '_blank' ? 'noopener' : undefined}
                    >
                      <Fragment set:html={text} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
    <div class="md:flex md:items-center md:justify-between py-6 md:py-8 border-t border-white/10">
      {
        socialLinks?.length ? (
          <ul class="flex mb-4 md:order-1 -ml-2 md:ml-4 md:mb-0">
            {socialLinks.map(({ ariaLabel, href, icon }) => (
              <li>
                <a class="zh-social text-muted dark:text-gray-400 hover:text-white focus:outline-none focus-visible:ring ring-white/40 p-2 inline-flex rounded-md" href={href} aria-label={ariaLabel}>
                  {icon ? <Icon name={icon} class="w-5 h-5" /> : <span class="w-5 h-5" />}
                </a>
              </li>
            ))}
          </ul>
        ) : null
      }
      <p class="text-sm text-muted dark:text-slate-400" set:html={footNote} />
      <p class="zh-powered mt-2 text-xs text-slate-500">powered by anton_vincent</p>
    </div>
  </div>
</footer>

<style>
  .zh-footer{background:transparent; border:0}
  /* Мягкий переход-маска от фон-карты: верх футера прозрачный, карта просвечивает, к низу — чистый чёрный */
  .zh-footer-fade{background:linear-gradient(180deg, rgba(5,5,7,0) 0%, rgba(5,5,7,.34) 20%, rgba(5,5,7,.82) 40%, #050507 58%)}
  .zh-footer-logo svg{filter:drop-shadow(0 0 6px rgba(232,80,2,.35))}
  .zh-powered{color:rgba(148,163,184,.55)}
</style>
