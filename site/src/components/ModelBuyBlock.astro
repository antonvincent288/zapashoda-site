---
import skuData from '../data/sku.json';
const { model = null } = Astro.props;
const items = skuData.items || [];
const bySlug = {};
for (const it of items) bySlug[it.slug] = it;
let picks = [];
if (model && model.port === 'GB/T') {
  picks = [bySlug['adapter-type2-gbt-base'], bySlug['portativnaya-zaryadka-gbt-3-5kw'], bySlug['kabel-type2-gbt-5m-7kw']].filter(Boolean);
} else if (model && model.port === 'CCS2') {
  picks = [bySlug['kabel-type2-type2-5m-22kw'], bySlug['portativnaya-zaryadka-type2-7kw'], bySlug['udlinitel-type2-type2-5m']].filter(Boolean);
} else if (model) {
  picks = [bySlug['kabel-type2-type2-5m-22kw'], bySlug['portativnaya-zaryadka-type2-7kw'], bySlug['nastennaya-stanciya-type2-7kw']].filter(Boolean);
} else {
  picks = [bySlug['adapter-type2-gbt-base'], bySlug['kabel-type2-gbt-5m-7kw'], bySlug['smazka-silikonom-zima']].filter(Boolean);
}
const title = model ? ('Что купить под ' + (model.name || model.title)) : 'Самое ходовое из каталога';
const leadName = model ? (model.name || model.title) : '';
---
<section class="buy-block" style="margin-top:44px;padding:26px 30px;background:var(--bg2);border:1px solid var(--line);border-radius:24px">
  <h2 style="margin:0 0 14px;font-size:21px">{title}</h2>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px">
    {picks.map((p) => (
      <a href={p.url} style="display:block;padding:16px;border:1px solid var(--line);border-radius:16px;text-decoration:none;color:var(--txt);background:var(--bg)">
        <div style="font-size:14.5px;font-weight:600;line-height:1.35">{p.title}</div>
        <div style="margin-top:8px;font-size:16px;font-weight:800;color:var(--gold)">{parseInt(p.price).toLocaleString('ru-RU')} ₽</div>
        <div style="margin-top:8px;font-size:12.5px;color:var(--txt-muted)">Открыть в каталоге →</div>
      </a>
    ))}
  </div>
  <div style="margin-top:18px;display:flex;gap:12px;flex-wrap:wrap;align-items:center">
    <button type="button" class="btn btn-gold buy-block-cta" data-model={leadName} style="cursor:pointer;text-decoration:none">{model ? 'Заявка под ' + (model.name || model.title) : 'Подобрать комплект'}</button>
    <a href="/quiz/" style="font-size:13.5px;color:var(--gold)">Подбор за 30 секунд →</a>
  </div>
</section>
<script is:inline>
(function(){
  document.addEventListener('click', function(e){
    var btn = e.target.closest('.buy-block-cta');
    if(!btn) return;
    var m = btn.getAttribute('data-model') || '';
    if(window.ZS_OPEN_LEAD){ window.ZS_OPEN_LEAD('', '', '', m, ''); }
    else { location.href = '/quiz/'; }
  }, true);
})();
</script>
