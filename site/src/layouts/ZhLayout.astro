  try{
    var pb=document.createElement('div');pb.id='zprog';document.body.appendChild(pb);
    var bt=document.createElement('button');bt.id='ztop';bt.setAttribute('aria-label','Наверх');bt.title='Наверх';
    bt.innerHTML='<svg viewBox="0 0 24 24"><path d="M12 19V5M5 12l7-7 7 7"/></svg>';
    document.body.appendChild(bt);
    var h=document.documentElement;
    function upd(){
      var max=h.scrollHeight-h.clientHeight||1;
      pb.style.width=(h.scrollTop/max*100).toFixed(2)+'%';
      if(h.scrollTop>600){bt.classList.add('show')}else{bt.classList.remove('show')}
    }
    addEventListener('scroll',upd,{passive:true});upd();
    bt.addEventListener('click',function(){scrollTo({top:0,behavior:'smooth'})});
    document.querySelectorAll('.spec').forEach(function(t){
      var rows=t.querySelectorAll('tbody tr');
      if(rows.length<=10) return;
      for(var i=10;i<rows.length;i++){rows[i].classList.add('zs-collapsed');}
      var btn=document.createElement('button');
      btn.className='spec-btn';btn.type='button';
      btn.textContent='Показать все характеристики ('+(rows.length-10)+')';
      btn.addEventListener('click',function(){
        var c=t.querySelectorAll('.zs-collapsed');
        if(c.length){c.forEach(function(r){r.classList.remove('zs-collapsed')});btn.textContent='Свернуть характеристики';}
        else{for(var j=10;j<rows.length;j++){rows[j].classList.add('zs-collapsed');}btn.textContent='Показать все характеристики ('+(rows.length-10)+')';}
      });
      t.after(btn);
    });
    document.querySelectorAll('input[type=number]').forEach(function(e){if(!e.hasAttribute('inputmode'))e.setAttribute('inputmode','numeric')});
    document.querySelectorAll('form input[type=tel]').forEach(function(e){if(!e.hasAttribute('enterkeyhint'))e.setAttribute('enterkeyhint','send')});
  }catch(e){}
})();

/* === GB/T longread: progressive reveal на клиенте (SSR остаётся для SEO) === */
document.addEventListener('DOMContentLoaded',function(){try{
  var h2s=document.querySelectorAll('.sec-alt .wrap > h2');
  for(var k=0;k<h2s.length;k++){
    var h=h2s[k];
    if(/адаптер GB\/T/i.test(h.textContent)){
      var wrap=h.parentNode;
      if(wrap.querySelector('.gbt-js-det')) continue;
      var det=document.createElement('details');det.className='gbt-js-det';
      var sum=document.createElement('summary');
      sum.textContent=h.textContent;sum.style.cssText='font-weight:700;cursor:pointer;font-size:1.35em;margin-bottom:10px';
      det.appendChild(sum);
      while(h.nextSibling) det.appendChild(wrap.removeChild(h.nextSibling));
      wrap.removeChild(h);
      wrap.appendChild(det);
      break;
    }
  }
}catch(e){}});
</script>

