---
interface Props { title?: string; description?: string; og?: string; jsonld?: object }
const { title = "Запас хода — зарядка EV в России", description = "Подбор зарядки, разъёмов и адаптеров для электромобилей в России", og, jsonld } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://zapashoda-ev.ru').href;
const path = Astro.url.pathname.replace(/\/$/, "");
const nav = [
  ["/", "Главная"],
  ["/models/", "Модели"],
  ["/blog/", "Блог"],
  ["/pain/", "Проблемы"],
  ["/tools/", "Инструменты"],
  ["/b2b/", "B2B"],
];
const isOn = (href) => href === "/" ? path === "" : path === href.replace(/\/$/, "") || path.startsWith(href.replace(/\/$/, "") + "/");
---
<!doctype html>
<html lang="ru" class="2xl:text-[20px]">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
{og && <meta property="og:image" content={og} />}
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} />
<meta property="og:type" content="website" />
<meta property="og:description" content={description} />
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
<div class="bar">Нужен адаптер или комплект под ваш разъём? Партнёрский пакет для дилеров — по запросу<a href="/b2b/">B2B →</a></div>
<header>
  <div class="wrap hwrap">
    <a class="logo" href="/"><b>ЗС</b>Запас хода</a>
    <nav id="nav">
      {nav.map(([href, label]) => (
        <a href={href} class={isOn(href) ? "on" : ""}>{label}</a>
      ))}
    </nav>
    <button class="icon-btn" id="themebtn" title="Тёмная тема">🌙</button>
    <a class="btn btn-gold" href="/quiz/">Подбор за 30 сек</a>
  </div>
</header>
<main><slot /></main>
<footer>
  <div class="wrap">
    <div class="fgrid">
      <div><a class="logo" style="color:#fff" href="/"><b>ЗС</b>Запас хода</a><p style="margin-top:14px;font-size:13.5px">Практика зарядки EV в России: разъёмы, адаптеры, станции, деньги. 145 моделей, 59 разборов, 2073 станции.</p></div>
      <div><h4>Модели</h4><a href="/models/">Каталог 145</a><a href="/models/zeekr-001-001-fr/">Zeekr 001</a><a href="/models/">Разъёмы GB/T</a><a href="/shop/digital/">Товары</a></div>
      <div><h4>База знаний</h4><a href="/blog/">Блог</a><a href="/pain/">Проблемы</a><a href="https://zapashoda-ev.ru/vin/" rel="nofollow">VIN-справочник</a></div>
      <div><h4>Связь</h4><a href="#">Telegram-канал</a><a href="#">Мини-приложение</a><a href="/b2b/">Дилерам (B2B)</a></div>
    </div>
    <div class="copy"><span>© 2026 Запас хода — практика зарядки EV в России</span><span>145 моделей · 59 разборов · 2073 станции</span></div>
  </div>
</footer>
<script>
  document.getElementById('themebtn').addEventListener('click', function(e){
    document.documentElement.classList.toggle('dark');
    e.target.textContent = document.documentElement.classList.contains('dark') ? '☀️' : '🌙';
  });
</script>
<style is:global>
:root{
  --ink:#1d1d1f; --navy:#001e2b; --gold:#D4AF37; --gold-soft:rgba(212,175,55,.6);
  --bg:#ffffff; --bg2:#f8f9fa; --card:#ffffff; --line:#e5e7eb;
  --txt:#111417; --txt-muted:rgba(16,16,16,.66); --head:#001e2b;
  --radius:16px; --shadow:0 8px 30px rgba(0,0,0,.08);
}
html.dark{
  --bg:#0d0e10; --bg2:#15171a; --card:#1d1d1f; --line:#2a2c30;
  --txt:#f5f5f7; --txt-muted:rgba(229,236,246,.66); --head:#f5f5f7;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Inter,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;
  background:var(--bg);color:var(--txt);line-height:1.6;font-size:16px;transition:background .3s,color .3s}
.wrap{max-width:1152px;margin:0 auto;padding:0 24px}
h1,h2,h3,h4{color:var(--head);letter-spacing:-.03em;line-height:1.12;font-weight:700}
h1{font-size:clamp(34px,4.6vw,58px);margin-bottom:16px}
h2{font-size:clamp(26px,3.4vw,40px);margin-bottom:12px}
h3{font-size:20px;margin-bottom:8px}
p.lead{font-size:18px;line-height:1.75;color:var(--txt-muted);max-width:680px}
.badge{display:inline-block;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--gold);margin-bottom:12px}
.bar{background:var(--ink);color:#f5f5f7;font-size:13px;text-align:center;padding:9px 16px}
.bar a{color:var(--gold);font-weight:600;text-decoration:none;margin-left:6px}
header{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--bg) 86%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.hwrap{display:flex;align-items:center;gap:20px;height:64px}
.logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:17px;letter-spacing:-.02em;color:var(--head);text-decoration:none}
.logo b{display:grid;place-items:center;width:30px;height:30px;border-radius:9px;background:var(--gold);color:var(--ink);font-size:13px}
nav{display:flex;gap:4px;margin-left:auto}
nav a{padding:8px 12px;border-radius:9px;font-size:14.5px;font-weight:600;color:var(--txt);text-decoration:none;opacity:.85}
nav a:hover,nav a.on{background:var(--bg2);opacity:1;color:var(--head)}
.icon-btn{border:1px solid var(--line);background:var(--bg);border-radius:9px;padding:8px 10px;cursor:pointer;font-size:15px}
.btn{display:inline-block;padding:12px 22px;border-radius:11px;font-weight:700;font-size:15px;text-decoration:none;border:1px solid transparent;cursor:pointer;transition:.15s}
.btn-gold{background:var(--gold);color:var(--ink);box-shadow:0 4px 18px rgba(212,175,55,.28)}
.btn-gold:hover{transform:translateY(-1px);box-shadow:0 8px 24px rgba(212,175,55,.36)}
.btn-ghost{border-color:var(--line);color:var(--txt);background:var(--bg)}
.btn-ghost:hover{border-color:var(--gold)}
.sec{padding:80px 0}
@media(max-width:720px){.sec{padding:56px 0}}
.sec-alt{background:var(--bg2)}
.hero{background:var(--ink);color:#f5f5f7;padding:104px 0 88px}
.hero h1{color:#fff;max-width:820px}
.hero h1 span{color:var(--gold)}
.hero p{color:rgba(229,236,246,.72);font-size:18px;max-width:640px;margin-bottom:28px}
.chips{display:flex;gap:10px;flex-wrap:wrap;margin-top:36px}
.chip{display:inline-flex;align-items:center;padding:8px 14px;border-radius:999px;border:1px solid var(--line);background:var(--card);color:var(--head);font-size:13.5px;text-decoration:none;transition:.15s}
.chip:hover{border-color:var(--gold);color:var(--gold)}
.hero .chip,.hero .chip:hover{border-color:rgba(229,236,246,.25);background:transparent;color:rgba(229,236,246,.85)}
.crumbs{font-size:13.5px;color:var(--txt-muted);margin-bottom:14px}
.crumbs a{color:var(--txt-muted);text-decoration:none}
.meta{display:flex;gap:14px;flex-wrap:wrap;font-size:13px;color:var(--txt-muted);margin:14px 0 28px}
.tag{display:inline-block;font-size:11.5px;font-weight:700;padding:3px 10px;border-radius:999px;background:var(--bg2);border:1px solid var(--line);color:var(--txt-muted);margin-right:6px}
.mgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.mcard{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px;text-decoration:none;display:flex;flex-direction:column;transition:.18s}
.mcard:hover{border-color:var(--gold-soft);transform:translateY(-2px);box-shadow:var(--shadow)}
.mcard b{display:block;font-size:17px;color:var(--head);letter-spacing:-.01em}
.mcard .ports{font-size:13px;color:var(--txt-muted);margin:8px 0 12px}
.mcard .sol{font-size:13px;background:var(--bg2);border:1px solid var(--line);border-radius:9px;padding:8px 10px;margin-top:auto}
.mcard .sol b{font-size:12px;color:var(--gold);display:block;letter-spacing:.06em;text-transform:uppercase}
.bgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.bcard{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:22px;text-decoration:none;display:block;transition:.18s}
.bcard:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
.bcard.bc-th{padding:0}
.bcard .th{height:150px;background:linear-gradient(135deg,#1d1d1f,#001e2b 60%,#3a3f45);position:relative}
.bcard .th span{position:absolute;left:16px;bottom:12px;color:#f5f5f7;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
.bcard .in{padding:18px 20px 22px}
.bcard h3{font-size:17px}
.bcard p{font-size:13.5px;color:var(--txt-muted);margin-top:6px}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:26px;transition:.18s;text-decoration:none;display:block}
.card:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
.card .ico{font-size:26px;margin-bottom:12px;display:block;font-weight:700}
.card h3{color:var(--head);font-size:18px}
.card p{font-size:14.5px;color:var(--txt-muted)}
.faqbox details{border:1px solid var(--line);border-radius:12px;background:var(--card);margin-bottom:12px}
.faqbox summary{cursor:pointer;font-weight:700;padding:16px 20px;list-style:none;font-size:15.5px;color:var(--head)}
.faqbox summary::after{content:"▾";float:right;color:var(--txt-muted);font-size:14px;transition:.15s}
.faqbox details[open] summary{border-bottom:1px solid var(--line);padding-bottom:14px}
.faqbox details[open] summary::after{content:"▴"}
.faqbox details p{padding:14px 20px;font-size:14.5px;color:var(--txt-muted)}
.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;align-items:start}
.plan{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:28px;position:relative}
.plan.pop{border-color:var(--gold);box-shadow:0 10px 40px rgba(212,175,55,.14)}
.popb{position:absolute;top:-11px;left:22px;background:var(--gold);color:var(--ink);font-size:11px;font-weight:800;letter-spacing:.08em;padding:4px 12px;border-radius:999px}
.price{font-size:34px;font-weight:800;letter-spacing:-.02em;color:var(--head);margin:10px 0 2px}
.price small{font-size:13px;font-weight:600;color:var(--txt-muted)}
.plan ul{list-style:none;margin:18px 0 22px;font-size:14px}
.plan li{padding:7px 0;border-bottom:1px dashed var(--line)}
.plan li::before{content:"✓";color:var(--gold);font-weight:800;margin-right:9px}
.cmp{width:100%;border-collapse:collapse;font-size:14px;margin-top:8px}
.cmp th,.cmp td{padding:11px 12px;border-bottom:1px solid var(--line);text-align:left}
.cmp th{font-size:12.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--txt-muted)}
.cmp td:not(:first-child){text-align:center}
.tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.tile{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:26px;transition:.18s;text-decoration:none;display:block;color:inherit}
.tile:hover{box-shadow:var(--shadow);transform:translateY(-2px)}
.tile .mock{height:120px;border-radius:12px;background:linear-gradient(135deg,#001e2b,#2b3a44);margin:16px 0;display:grid;place-items:center;color:#D4AF37;font-size:34px}
.cta{background:var(--ink);color:#f5f5f7;border-radius:24px;padding:56px;text-align:center}
.cta h2{color:#fff}
.cta p{color:rgba(229,236,246,.72);margin-bottom:24px}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;text-align:center}
.stats b{display:block;font-size:40px;letter-spacing:-.02em;color:var(--head)}
.stats span{font-size:14px;color:var(--txt-muted)}
.fbar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:28px;align-items:center}
.fbar input{flex:1;min-width:220px;padding:11px 14px;border-radius:11px;border:1px solid var(--line);background:var(--bg);color:var(--txt);font-size:15px}
.fchip{font-size:13px;font-weight:600;padding:8px 14px;border-radius:999px;border:1px solid var(--line);background:var(--bg);cursor:pointer;color:var(--txt-muted)}
.fchip.on{background:var(--ink);color:#fff;border-color:var(--ink)}
.artgrid{display:grid;grid-template-columns:230px minmax(0,780px);gap:56px}
.toc{position:sticky;top:96px;align-self:start;font-size:14px}
.toc div{font-size:11.5px;font-weight:700;letter-spacing:.08em;color:var(--txt-muted);margin-bottom:12px}
.toc a{display:block;padding:6px 0;color:var(--txt-muted);text-decoration:none;border-left:2px solid transparent;padding-left:12px}
.toc a.on{color:var(--gold);border-color:var(--gold);font-weight:600}
.article{font-size:17px;line-height:1.75;max-width:780px}
.article h1{margin-bottom:20px;font-size:clamp(28px,3.6vw,44px)}
.comments,.c-form,#comments{display:none!important}
.article h2{font-size:28px;margin:44px 0 14px}
.article p{margin:14px 0}
.article .lede{font-size:19px;color:var(--txt-muted);margin-bottom:8px}
.article ul,.article ol{margin:14px 0 14px 22px}
.article img{max-width:100%;border-radius:12px}
.article table{width:100%;border-collapse:collapse;font-size:15px}
.article a{color:var(--head)!important;text-decoration:underline;text-underline-offset:3px}
.article a:hover{color:var(--gold)!important}
.article [class*="text-violet"],.article [class*="text-purple"],.article [class*="text-indigo"],.article [class*="text-blue"]{color:var(--txt)!important}
.article [class*="bg-violet"],.article [class*="bg-purple"],.article [class*="bg-indigo"]{background:transparent!important;color:var(--txt)!important}
.article th{text-align:left;padding:10px 14px;background:var(--card);font-weight:700;color:var(--head)}
.article td{padding:10px 14px;vertical-align:top}
.article ul li,.article ol li{margin-bottom:8px}
.article a[target=_blank]::after{content:" ↗";font-size:.85em;color:var(--txt-muted)}
.spec{width:100%;border-collapse:collapse;font-size:14.5px;margin:28px 0}
.spec td{padding:11px 4px;border-bottom:1px solid var(--line);vertical-align:top}
.spec td:first-child{color:var(--txt-muted);width:180px}
.share{display:flex;gap:10px;margin-top:40px;padding-top:24px;border-top:1px solid var(--line)}
.share a,.share span{font-size:13px;padding:8px 14px;border:1px solid var(--line);border-radius:999px;text-decoration:none;color:var(--txt-muted);cursor:pointer}
.share a:hover{border-color:var(--gold);color:var(--head)}
footer{background:var(--ink);color:rgba(229,236,246,.7);padding:56px 0 28px;font-size:14px}
.fgrid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:32px;margin-bottom:40px}
footer h4{color:#fff;font-size:13px;letter-spacing:.08em;text-transform:uppercase;margin-bottom:14px}
footer a{display:block;color:rgba(229,236,246,.7);text-decoration:none;padding:4px 0}
footer a:hover{color:var(--gold)}
.copy{border-top:1px solid rgba(229,236,246,.14);padding-top:20px;font-size:12.5px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
#cat-chips .chip{cursor:pointer}
#city-chips .chip,#cat-chips .chip{user-select:none}
@media(max-width:900px){
  .cards,.bgrid,.mgrid,.plans,.tiles{grid-template-columns:1fr 1fr}
  .fgrid{grid-template-columns:1fr 1fr}
  .artgrid{grid-template-columns:1fr;gap:24px}
  .toc{display:none}
  nav{display:none}
}
@media(max-width:600px){
  .cards,.bgrid,.mgrid,.plans,.tiles{grid-template-columns:1fr}
  .stats{grid-template-columns:1fr 1fr;gap:28px 12px}
  .hero{padding:72px 0 64px}
  .prod-grid{gap:22px}
  .prod-grid img{max-width:100%;height:240px}
  .article{font-size:16.5px;line-height:1.72}
  .article p{margin:12px 0}
  .article .faqbox{margin-top:30px}
}
</style>
</body>
</html>
