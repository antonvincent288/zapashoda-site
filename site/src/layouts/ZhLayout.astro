.plan.pop{border-color:var(--gold);box-shadow:0 10px 40px rgba(1,97,239,.14)}
.popb{position:absolute;top:-11px;left:22px;background:var(--gold);color:#fff;font-size:11px;font-weight:800;letter-spacing:.08em;padding:4px 12px;border-radius:999px}
