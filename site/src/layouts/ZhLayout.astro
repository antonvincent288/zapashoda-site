interface Props { title?: string; description?: string; og?: string; jsonld?: object; noindex?: boolean; canonical?: string; publishedTime?: string; modifiedTime?: string }
const { title = "Запас хода — зарядка EV в России", description = "Подбор зарядки, разъёмов и адаптеров для электромобилей в России", og, jsonld, noindex, canonical: canonicalOverride, publishedTime, modifiedTime } = Astro.props;
const canonical = canonicalOverride || new URL(Astro.url.pathname, Astro.site ?? 'https://zapashoda-ev.ru').href;
const path = Astro.url.pathname.replace(/\/$/, "");
const navGroups = [
  { g: null, items: [["/models/", "Модели"], ["/catalog/", "Каталог"], ["/charging/", "Карта ЗУ"], ["/shop/digital/", "Гайды"]] },
  { g: "Инструменты", items: [["/quiz/", "Всё о твоей машине"], ["/calculator/", "Калькуляторы"], ["/vin/", "VIN-справочник"], ["/search/", "Поиск"]] },
  { g: null, items: [["/baza-znaniy/", "База знаний"], ["/safety/", "Безопасность"], ["/services/", "Услуги"]] },
];
const isOn = (href) => href === "/" ? path === "" : path === href.replace(/\/$/, "") || path.startsWith(href.replace(/\/$/, "") + "/");
