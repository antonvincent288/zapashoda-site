/* === РОЛЬ-ПЕРЕКЛЮЧАТЕЛЬ + HERO-СЕЛЕКТОР МОДЕЛИ === */
(function(){try{
  document.querySelectorAll('[data-roleseg]').forEach(function(seg){
    seg.addEventListener('click',function(e){
      var b=e.target.closest('.seg-btn'); if(!b) return;
      seg.querySelectorAll('.seg-btn').forEach(function(x){x.classList.remove('on');x.setAttribute('aria-selected','false')});
      b.classList.add('on'); b.setAttribute('aria-selected','true');
      var role=b.getAttribute('data-role');
      document.querySelectorAll('[data-role-block]').forEach(function(bl){
        bl.style.display = (bl.getAttribute('data-role-block')===role) ? '' : 'none';
      });
    });
  });
  var sel=document.getElementById('pickModel'), go=document.getElementById('pickGo');
  if(sel&&go){
    var upd=function(){go.setAttribute('href', sel.value ? '/models/'+sel.value+'/' : '/models/')};
    sel.addEventListener('change',upd); upd();
  }
}catch(e){}})();
</script>

</body>
</html>
