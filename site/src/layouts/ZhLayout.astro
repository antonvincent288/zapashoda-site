.article{font-size:17px;line-height:1.75;max-width:700px;overflow-wrap:anywhere;word-break:break-word}
.article h1{margin-bottom:20px;font-size:clamp(28px,2vw + 20px,38px);letter-spacing:-.02em;line-height:1.15}
.comments,.c-form,#comments{display:none!important}
.article h2{font-size:clamp(22px,.5714vw + 18.77px,27px);margin:44px 0 14px;letter-spacing:-.02em;line-height:1.25}
/* zh-stats главной: нейтрализация чужого .stats лейаута (4-колоночная сетка перебивала flex-ряд цифр) */
.zh-stats{display:flex;grid-template-columns:none}
.zh-stats b{font-family:inherit;font-size:clamp(34px,3.6vw,52px)}
.zh-stats span{max-width:190px;line-height:1.25}
.zh-stats .fresh{color:#e9eff673;font-size:11px}
.article p{margin:16px 0}
.article blockquote{margin:20px 0;padding:12px 18px;border-left:3px solid var(--gold);color:var(--txt-muted);background:var(--bg2);border-radius:0 10px 10px 0}
.article blockquote p{margin:4px 0}
.article code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.9em;background:var(--bg2);padding:2px 7px;border-radius:6px}
.article h3{font-size:clamp(18px,.2857vw + 16.89px,21px);margin:28px 0 10px;letter-spacing:-.01em;line-height:1.3}
.article .lede{font-size:19px;color:var(--txt-muted);margin-bottom:8px}
.article ul,.article ol{margin:14px 0 14px 22px}
.article img{max-width:100%;border-radius:12px}
.article table{width:100%;border-collapse:collapse;font-size:14.5px}
.article a{color:var(--head)!important;text-decoration:underline;text-underline-offset:3px;overflow-wrap:anywhere}
.article a:hover{color:var(--gold)!important}
.article [class*="text-violet"],.article [class*="text-purple"],.article [class*="text-indigo"],.article [class*="text-blue"]{color:var(--txt)!important}
.article [class*="bg-violet"],.article [class*="bg-purple"],.article [class*="bg-indigo"]{background:transparent!important;color:var(--txt)!important}
.article th{text-align:left;padding:10px 14px;background:var(--card);font-weight:700;color:var(--head)}
.article td{padding:10px 14px;vertical-align:top}
.article ul li,.article ol li{margin-bottom:8px}
.article a[target=_blank]::after{content:" ↗";font-size:.85em;color:var(--txt-muted)}
.spec{width:100%;border-collapse:collapse;font-size:14.5px;margin:28px 0}
.spec td{padding:11px 4px;border-bottom:1px solid var(--line);vertical-align:top}
.spec td:first-child{color:var(--txt-muted);width:180px}
.share{display:flex;gap:10px;margin-top:40px;padding-top:24px;border-top:1px solid var(--line)}
.share a,.share span{font-size:13px;padding:8px 14px;border:1px solid var(--line);border-radius:999px;text-decoration:none;color:var(--txt-muted);cursor:pointer}
.share a:hover{border-color:var(--gold);color:var(--head)}
footer{background:var(--bg);color:rgba(229,236,246,.66);padding:56px 0 28px;font-size:14px}
.fgrid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1.2fr;gap:36px;align-items:start}
@media (max-width:860px){.fgrid{grid-template-columns:1fr 1fr}}
@media (max-width:520px){.fgrid{grid-template-columns:1fr}}
.fgrid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:32px;margin-bottom:40px}
footer h4{color:#fff;font-size:13px;letter-spacing:.08em;text-transform:uppercase;margin-bottom:14px}
footer a{display:block;color:rgba(229,236,246,.7);text-decoration:none;padding:4px 0}
footer a:hover{color:var(--gold)}
.copy{border-top:1px solid rgba(229,236,246,.14);padding-top:20px;font-size:12.5px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;border-top:1px solid var(--line);margin-top:34px;padding-top:20px}
#cat-chips .chip{cursor:pointer}
#city-chips .chip,#cat-chips .chip{user-select:none}
.menu-btn{display:none;flex-direction:column;justify-content:center;gap:4px;width:40px;height:38px;
  padding:0 10px;border:1px solid var(--line);background:var(--bg);border-radius:9px;cursor:pointer}
.menu-btn span{display:block;height:2px;width:100%;background:var(--txt);border-radius:2px;transition:.18s}
.menu-btn.on span:nth-child(1){transform:translateY(6px) rotate(45deg)}
.menu-btn.on span:nth-child(2){opacity:0}
.menu-btn.on span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}
.mnav{display:none;position:fixed;top:64px;left:0;right:0;z-index:200000;background:var(--bg);
  border-bottom:1px solid var(--line);box-shadow:0 12px 30px rgba(0,0,0,.12);padding:6px 16px 14px;
  max-height:calc(100vh - 64px);overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain}
.mnav a{display:block;padding:10px 8px;font-size:15.5px;font-weight:400;color:var(--txt);
  text-decoration:none;border-bottom:1px solid var(--line)}
.mnav a:last-child{border-bottom:0}
.mnav a.on{color:var(--gold);font-weight:700}
.mnav-group{padding:12px 8px 4px;font-size:10.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--txt-muted);border-bottom:0}
@media(max-width:900px){

  .cards,.bgrid,.mgrid,.plans,.tiles{grid-template-columns:1fr 1fr}
  .fgrid{grid-template-columns:1fr 1fr}
  .artgrid{grid-template-columns:1fr;gap:24px}
  .toc{display:none}
  nav{display:none}
  .menu-btn{display:flex}
  .mnav.open{display:block}
}
@media(max-width:600px){
  table{display:block;overflow-x:auto;-webkit-overflow-scrolling:touch}
  table th{white-space:nowrap}
  .article table tr,.spec tr,.cmp tr{display:table-row}
  .article table th,.spec th,.cmp th{white-space:nowrap}
  .btn,.of-send,.pc-btn,.a-mgr button{min-height:44px}
  button{min-height:44px}
  .leaflet-control button{min-height:auto}
  html,body{overflow-x:clip}
  .cards,.bgrid,.mgrid,.plans,.tiles{grid-template-columns:1fr}
  .stats{grid-template-columns:1fr 1fr;gap:28px 12px}
  .hero{padding:72px 0 64px}
  .prod-grid{gap:22px}
  .prod-grid img{max-width:100%;height:240px}
  .article{font-size:16.5px;line-height:1.72;max-width:none}
  .article p{margin:12px 0}
  .article .faqbox{margin-top:30px}
}

/* --- polish pass: ревизор-2026-11-06 --- */
html:not(.dark) .article table tr:nth-child(even) td,html:not(.dark) .spec tr:nth-child(even) td,html:not(.dark) .cmp tr:nth-child(even) td{background:rgba(0,0,0,.045)}html.dark .article table tr:nth-child(even) td,html.dark .spec tr:nth-child(even) td,html.dark .cmp tr:nth-child(even) td{background:rgba(255,255,255,.05)}
.article table tr:hover td,.spec tr:hover td,.cmp tr:hover td{background:rgba(1,97,239,.05)}
.spec td{padding:12px 14px}
.cmp th,.cmp td{padding:12px 10px}
.cmp td{line-height:1.5}
.article p{line-height:1.65}
.spec{font-size:15px}
.mcard b{display:block;margin-bottom:6px;line-height:1.35}
.mcard .sol{padding-top:14px}
.bcard{border-radius:16px}
.article h2{letter-spacing:-.01em}
@media(min-width:1024px){.sec{padding:68px 0}.bgrid{gap:20px}}
@media(max-width:640px){.article td,.article th,.spec td,.spec th,.cmp td,.cmp th{padding:9px 10px}.sec{padding:56px 0}}
/* --- навигация: группы + B2B-кнопка (06.11) --- */
.nav-div{width:1px;align-self:stretch;background:var(--line);margin:6px 2px}
.nav-g{align-self:center;font-size:10.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--txt-muted);padding:0 4px;white-space:nowrap}
.nav-b2b{background:var(--gold);color:#fff;font-weight:700;border-radius:999px;padding:8px 14px;font-size:14.5px;opacity:1}
.nav-b2b:hover{opacity:.9}
.icon-btn svg{width:18px;height:18px;display:block;color:var(--txt)}
.ico-sun{display:none}
html.dark .ico-sun{display:block}
html.dark .ico-moon{display:none}
.b2b-note{border:1px solid var(--line);border-left:3px solid var(--gold);border-radius:14px;padding:16px 18px;margin-top:32px;background:var(--bg2)}
.b2b-note p{font-size:14px;color:var(--txt-muted);margin:6px 0 12px}
.duo{display:grid;grid-template-columns:1fr 1fr;gap:24px}
@media(max-width:860px){.duo{grid-template-columns:1fr}}
input[type=range]{accent-color:var(--gold)}
@media(max-width:1100px){.nav-g{display:none}.nav-div{display:none}}
/* --- art-share: чиним гигантские SVG соцкнопок (06.11) --- */
.art-share{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:22px}
.art-share .lbl{font-size:13px;color:var(--txt-muted);font-weight:600}
.art-share .shbtn{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border:1px solid var(--line);border-radius:999px;background:var(--bg);color:var(--txt);text-decoration:none;transition:.15s;min-height:40px}
.art-share .shbtn svg{width:18px;height:18px;fill:currentColor}
.art-share .shbtn:hover{border-color:var(--gold);color:var(--gold)}

/* === Типографика 2.0: вдовы, выделение, ссылки, подписи === */
h1,h2,h3{text-wrap:balance}
.zh-article p{text-wrap:pretty}
::selection{background:var(--gold);color:#fff}
.zh-article a{text-underline-offset:3px;text-decoration-thickness:1px}
.zh-article figure{margin:22px 0}
.zh-article img{border-radius:12px;display:block;max-width:100%}
.zh-article figcaption{font-size:13px;color:#6b7280;text-align:center;margin-top:7px;line-height:1.45}
[id]{scroll-margin-top:84px}
.zh-article table{display:block;max-width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}
.zh-article blockquote{border-left:3px solid var(--gold);background:rgba(1,97,239,.04);padding:10px 16px;border-radius:0 10px 10px 0}

/* === Legacy-чипы из data-тела: сплошные заливки (инлайн-фоны #2563eb/#3d6fa6/#8b5cf6 и Tailwind bg-gray-100/bg-green-600) -> нейтральные чипы дизайн-системы (рамка 1px + bg2, правило «новые плашки») === */
.brand-chip{display:inline-block;width:auto!important;font-size:11.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--txt-muted)!important;background:transparent!important;border:1px solid var(--line);border-radius:999px;padding:2px 10px}
.bg-gray-100{background:var(--bg2)!important;border:1px solid var(--line)!important;color:var(--txt-muted)!important}
.bg-green-600{background:transparent!important;color:#22c55e!important;border:1px solid rgba(34,197,94,.35)!important}
/* === Таблица результатов калькулятора: фиксированный layout, чтобы колонки не прыгали при вводе данных === */
.cout{overflow-x:auto}
.cout table{table-layout:fixed;min-width:300px}
.cout table th,.cout table td{vertical-align:top}
.cout table th{white-space:nowrap;font-size:12px;padding:8px}
.cout table td:nth-child(n+2){white-space:nowrap}
.cout table th:nth-child(1){width:26%}
.cout table th:nth-child(2){width:26%}
.cout table th:nth-child(3){width:23%}
.cout table th:nth-child(4){width:25%}
@media(max-width:640px){.cout table th{font-size:11.5px;padding:6px 5px}.cout table td{font-size:13px;padding:5px 4px}.cout table th:nth-child(1){width:34%}.cout table th:nth-child(2){width:23%}.cout table th:nth-child(3){width:20%}.cout table th:nth-child(4){width:23%}}
/* === Фикс таблицы результатов калькулятора (все модели): строка-заглушка с colspan=3 не должна
   растягиваться под колонки «Время»/«Стоимость» — пересобираем в честные три ячейки. Наблюдатель, т.к.
   таблица перерисовывается скриптом калькулятора при каждом input. === */

/* === UI-полировка: меню, карточки, фокус, прогресс, спойлеры === */
@media (prefers-reduced-motion: no-preference){html{scroll-behavior:smooth}}
#nav a{background:linear-gradient(var(--gold),var(--gold)) no-repeat bottom left/0 2px;transition:background-size .25s ease}
#nav a:hover,#nav a.on{background-size:100% 2px}
.mcard,.card{transition:transform .18s ease,box-shadow .18s ease}
.mcard:hover,.card:hover{transform:translateY(-4px);box-shadow:0 10px 24px rgba(15,23,42,.12)}
:focus-visible{outline:2px solid var(--gold);outline-offset:2px;border-radius:4px}
#zprog{position:fixed;top:0;left:0;height:3px;width:0;background:var(--gold);z-index:9999;transition:width .1s linear}
#ztop{position:fixed;right:16px;bottom:16px;width:44px;height:44px;border-radius:999px;border:1px solid var(--line);background:var(--card);color:var(--txt);box-shadow:0 6px 18px rgba(15,23,42,.18);opacity:0;pointer-events:none;transform:translateY(10px);transition:opacity .2s,transform .2s;z-index:9999;display:flex;align-items:center;justify-content:center;cursor:pointer;min-height:44px}
#ztop.show{opacity:1;pointer-events:auto;transform:none}
#ztop svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
.spec tr.zs-collapsed{display:none}
.spec-btn{margin:10px 0 0;padding:9px 16px;border:1.5px solid var(--line);border-radius:10px;background:var(--card);color:var(--txt);font-size:14px;font-weight:600;cursor:pointer;min-height:44px;transition:border-color .15s,color .15s}
.spec-btn:hover{border-color:var(--gold);color:var(--gold)}
details>summary{cursor:pointer;user-select:none;list-style:none}
details>summary::-webkit-details-marker{display:none}
details>summary::before{content:'▸';display:inline-block;margin-right:8px;transition:transform .2s;color:var(--gold);font-weight:700}
details[open]>summary::before{transform:rotate(90deg)}

/* === HEADER 2.0: выравнивание, логотип, меню === */
header{box-shadow:0 1px 0 rgba(15,23,42,.03)}
.hwrap{gap:16px}
.logo{gap:10px;line-height:1}
.logo b{background:var(--gold);border-radius:10px;display:grid;place-items:center;width:34px;height:34px;box-shadow:0 2px 8px rgba(1,97,239,.25);filter:drop-shadow(0 0 9px rgba(1,97,239,.55))}
.logo b svg{width:18px;height:18px;fill:currentColor;color:#fff;filter:drop-shadow(0 0 3px rgba(190,220,255,.75))}
.logo span{font-size:17px;font-weight:800;letter-spacing:-.02em;color:var(--head)}
.logo-ev{font-size:10px;font-weight:800;letter-spacing:.14em;color:var(--gold);border:1.5px solid rgba(1,97,239,.35);border-radius:6px;padding:2px 5px;line-height:1;margin-left:1px}
#nav{margin-left:auto;align-items:center;gap:2px;display:flex}
#nav a{padding:7px 11px;border-radius:8px;font-size:14px;font-weight:400;white-space:nowrap;color:var(--txt)}
#nav a:hover{color:var(--gold)}
#nav a.nav-b2b:hover{color:#fff;filter:brightness(1.06)}
.nav-g{margin-left:10px;font-size:9.5px;opacity:.85}
@media(max-width:1100px){
  #nav a{padding:6px 8px;font-size:13.5px}
  .nav-g{display:none}
}
@media(max-width:960px){
  .logo-ev{display:none}
  .logo span{font-size:16px}
}
/* мобильное меню: выравнивание и группировка */
.mnav{padding:4px 20px 18px}
.mnav a{display:flex;align-items:center;min-height:46px;font-size:16px;font-weight:600;color:var(--txt);border-bottom:1px solid var(--line)}
.mnav a:last-of-type{border-bottom:none}
.mnav .nav-g{margin:14px 0 4px;font-size:10px;letter-spacing:.1em}
.mnav .nav-b2b{display:flex;justify-content:center;margin:14px 0 6px;border:none;background:var(--gold);color:#fff;border-radius:12px;padding:12px;font-weight:700}

/* === ФИКС nav-b2b (специфичность) + типографика всех страниц === */
#nav a.nav-b2b{color:#fff}
#nav a.nav-b2b.on{color:#fff}
.article h2{font-size:clamp(19px,2.6vw,24px);line-height:1.25;margin:28px 0 12px}
.article h3{font-size:clamp(16.5px,2.2vw,19px);line-height:1.3;margin:20px 0 10px}
.article img{border-radius:12px}
.article table th{font-size:13.5px;letter-spacing:.02em}
.article a{word-break:break-word}
p{max-width:75ch}
li{max-width:75ch}

/* === NAV 2.1: dropdown «Ещё» + чипсы/кнопки === */
.nav-more{position:relative;cursor:pointer;padding:7px 11px;border-radius:8px;font-size:14px;font-weight:600;user-select:none;white-space:nowrap;color:var(--txt);transition:color .15s}
.nav-more:hover,.nav-more:focus-visible{color:var(--gold);outline:none}
.nav-more .dd{position:absolute;top:calc(100% + 8px);right:0;background:var(--card);border:1px solid var(--line);border-radius:14px;box-shadow:0 12px 30px rgba(15,23,42,.14);padding:6px;min-width:190px;opacity:0;visibility:hidden;transform:translateY(4px);transition:opacity .18s,transform .18s,visibility .18s;z-index:300}
.nav-more:hover .dd,.nav-more:focus-within .dd{opacity:1;visibility:visible;transform:none}
.nav-more .dd a{display:block;padding:10px 12px;border-radius:9px;font-size:14px;font-weight:600;color:var(--txt);background:none}
.nav-more .dd a:hover{background:rgba(1,97,239,.08);color:var(--gold)}
.nav-more .dd a.on{color:var(--gold)}
@media(max-width:960px){.nav-more{display:none}}
.chip{min-height:36px;display:inline-flex;align-items:center}
.btn{min-height:44px}

/* === ЕДИНАЯ ТИПОГРАФИЧЕСКАЯ СЕТКА (стопы) === */
:root{--measure:70ch;--measure-wide:75ch}
p,li{max-width:var(--measure)}
p.lead,.hero p,.article p{max-width:100%}
.sec h2{max-width:var(--measure);font-size:clamp(22px,3vw,28px);line-height:1.25}
.hero h1{max-width:min(820px,94%)}
.card p,.mcard p{max-width:var(--measure)}
.article li{margin-bottom:4px}

/* === ЕДИНАЯ КРОМКА ТЕКСТА: все стопы к --measure === */
.hero h1,.sec h2,.sec-alt h2,.lede,.faqbox h2,.faqbox p,.wrap[style*="max-width"] p{max-width:var(--measure)}
.hero h1{font-size:clamp(26px,4.2vw,38px)}
.faqbox .wrap{max-width:var(--measure)}
details summary{max-width:var(--measure)}

/* === ЖЁСТКИЙ ПИКСЕЛЬНЫЙ СТОП: 760px единая кромка === */
:root{--measure:760px;--measure-wide:760px}
.hero h1,.hero p,.sec h2,.sec-alt h2,.lede,p.lead,.card p,.mcard p,.article p,details summary{max-width:100%!important}
.wrap[style*="max-width"]{max-width:808px!important}
@media(max-width:800px){.hero h1,.hero p,.sec h2,.sec-alt h2,.lede,p.lead,.card p,.mcard p,.article p{max-width:100%!important}}

/* === ВОЗДУХ: единая шкала отступов === */
.sec,.sec-alt{padding:96px 0}
@media(max-width:960px){.sec,.sec-alt{padding:64px 0}}
section+section,section+footer,footer+section{border-top:1px solid var(--line)}
.sec h2{margin-bottom:18px}
.sec .lead,.sec .lede{margin-bottom:30px}
.duo{gap:28px}
.bgrid{gap:24px}
.article p{margin-bottom:14px}

/* === МОБАЙЛ-НАВИГАЦИЯ: десктопное меню всегда скрыто, бургер в вьюпорте === */
@media(max-width:960px){
  #nav{display:none!important}
  .hwrap{justify-content:space-between}
  .menu-btn{margin-left:0;flex-shrink:0}
}

.nav-more .dd a.on{color:var(--gold);font-weight:700}

/* === ЖИВЫЕ СТАТУСЫ / GLASS / ИНФОГРАФИКА (visual pass) === */
.nav-more .dd a{text-decoration:none!important}
.glass-panel{background:rgba(255,255,255,.62);backdrop-filter:blur(14px) saturate(1.4);-webkit-backdrop-filter:blur(14px) saturate(1.4);border:1px solid rgba(1,97,239,.16);border-radius:20px;box-shadow:0 10px 36px rgba(1,97,239,.10);padding:clamp(18px,3vw,28px)}
@media(max-width:800px){.glass-panel{background:rgba(255,255,255,.72)}}
.live-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:#22c55e;position:relative;vertical-align:middle;margin-right:8px}
.live-dot::after{content:'';position:absolute;inset:-5px;border-radius:50%;border:2px solid rgba(34,197,94,.55);animation:livePulse 2.2s ease-out infinite}
@keyframes livePulse{0%{transform:scale(.5);opacity:.9}100%{transform:scale(1.7);opacity:0}}
@media(prefers-reduced-motion:reduce){.live-dot::after{animation:none}}
.cards .card{transition:transform .18s ease,box-shadow .18s ease}
.cards .card:hover{transform:translateY(-4px);box-shadow:0 14px 34px rgba(1,97,239,.12)}
.card svg.evicon{width:100%;max-height:64px;height:auto;margin-bottom:10px;display:block}
