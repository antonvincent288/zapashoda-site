---
import ZhLayout from '../../layouts/ZhLayout.astro';
import src from '../../data/legacy/baza.json';
const blogModules = import.meta.glob('../../data/articles/blog/*.json', { eager: true, import: 'default' });
const blog = Object.values(blogModules).filter((a) => a && a.slug);
const painModules = import.meta.glob('../../data/articles/pain/*.json', { eager: true, import: 'default' });
const pain = Object.values(painModules).filter((a) => a && a.slug);
const sortDesc = (arr) => arr.slice().sort((x, y) => String(y.date || '').localeCompare(String(x.date || '')));
const blogSorted = sortDesc(blog);
const painSorted = sortDesc(pain);
const refs = [
  { t: 'VIN-справочник: расшифровка и проверка', d: '17 символов: код завода, модельный год, серийник; проверка ЭПТС/СБКТС для параллельного импорта.', href: '/vin/' },
{ t: 'Матрица совместимости разъёмов', d: 'Какие станции подходят вашему разъёму: Type 2, GB/T, CCS2 — таблица переходников.', href: '/matrix/' },
  { t: 'Разъёмы зарядки: Type 2, CCS2, GB/T, CHAdeMO', d: 'Что за порт у вашей машины, чем кабель отличается от розетки на станции и какой адаптер нужен.', href: '/razemy/' },
  { t: 'PDF-гайды «Запас хода»', d: 'Интерактивные авто-гиды по М-4 «Дон», М-11 «Нева», М-12 «Восток» и зарядке на парковке ЖК.', href: '/shop/digital/' },
  { t: 'Каталог моделей', d: 'Разъёмы, мощность борта и адаптеры для каждой модели — с фильтром по марке, году и типу (BEV/EREV/PHEV).', href: '/models/' },
];
const jsonld = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'База знаний «Запас хода»', url: 'https://zapashoda-ev.ru/baza-znaniy/', mainEntity: { '@type': 'ItemList', itemListElement: [...src.map((g) => '/baza-znaniy/' + g.slug + '/'), ...blogSorted.map((a) => '/blog/' + a.slug + '/'), ...painSorted.map((a) => '/pain/' + a.slug + '/'), ...refs.map((r) => r.href)].map((u, i) => ({ '@type': 'ListItem', position: i + 1, url: 'https://zapashoda-ev.ru' + u })) } };
---
<ZhLayout title="База знаний «Запас хода»" description="База знаний «Запас хода»: руководства, разборы и решения проблем зарядки электромобилей в России." jsonld={jsonld}>
  <section class="sec"><div class="wrap">
    <div class="crumbs"><a href="/">Главная</a> / База знаний</div>
    <div class="badge">База знаний</div>
    <h1>База знаний «Запас хода»</h1>
    <p class="lead">Руководства, разборы и решения проблем — всё в одном месте. {src.length + blog.length + pain.length} материалов, обновляется каждую неделю.</p>
    <div class="card bk-card" style="border-color:rgba(0,229,255,.4);background:rgba(0,229,255,.06)">
      <h2 style="color:#7fb8f7">Не знаете, с чего начать?</h2>
      <p>Не уверены, какой разъём у машины — начните с <a href="/matrix/" style="color:#00E5FF">матрицы совместимости</a> (одна таблица — все типы станций). Заряжаетесь на трассе — сразу к <a href="/tarify/" style="color:#00E5FF">тарифам ЭЗС</a> и <a href="/charging/" style="color:#00E5FF">карте ЗУ</a>. Только что купили машину — <a href="/posle-pokupki/" style="color:#00E5FF">руководство первой недели</a>.</p>
    </div>
    <div class="bk-sec"><h2>Руководства <b>{src.length}</b></h2><div class="bk-panel" id="bk-guides">{src.map((g) => (<a class="card bk-card" href={'/baza-znaniy/' + g.slug + '/'}><h3>{g.title}</h3><p>{g.desc}</p><span class="bk-go">Читать →</span></a>))}</div></div>
    <div class="bk-sec"><h2>Разборы <b>{blog.length}</b></h2><div class="bk-panel" id="bk-blog">{blogSorted.map((a, idx) => (<a class:list={["card", "bk-card", idx >= 12 && "bk-extra"]} href={'/blog/' + a.slug + '/'}><h3>{a.title}</h3><p>{a.desc}</p><span class="bk-go">{a.category || 'Разбор'} · {a.read_min || '?'} мин →</span></a>))}{blogSorted.length > 12 && <button class="bk-more" type="button" data-more="bk-blog">Показать все {blog.length}</button>}</div></div>
    <div class="bk-sec"><h2>Проблемы и решения <b>{pain.length}</b></h2><div class="bk-panel" id="bk-pain">{painSorted.map((a, idx) => (<a class:list={["card", "bk-card", idx >= 8 && "bk-extra"]} href={'/pain/' + a.slug + '/'}><h3>{a.title}</h3><p>{a.desc}</p><span class="bk-go">Решение →</span></a>))}{painSorted.length > 8 && <button class="bk-more" type="button" data-more="bk-pain">Показать все {pain.length}</button>}</div></div>
    <div class="bk-sec"><h2>Справочники <b>{refs.length}</b></h2><div class="bk-panel" id="bk-ref">{refs.map((r) => (<a class="card bk-card" href={r.href}><h3>{r.t}</h3><p>{r.d}</p><span class="bk-go">Открыть →</span></a>))}</div></div>
    <script is:inline>
    (function(){
      document.querySelectorAll('.bk-more').forEach(function(btn){
        btn.addEventListener('click', function(){
          var panel = document.getElementById(btn.dataset.more);
          if (panel) panel.querySelectorAll('.bk-extra').forEach(function(c){ c.style.display = ''; });
          btn.style.display = 'none';
        });
      });
    })();
    </script>
  </div></section>
  <style is:global>
    
    
    
    .bk-sec h2{display:flex;align-items:center;gap:8px;margin:36px 0 14px;font-size:20px;line-height:1.2}
    .bk-sec h2 b{font-weight:700;font-size:14px;color:var(--txt-muted);background:var(--card);border:1px solid var(--line);border-radius:999px;padding:2px 10px}
    .bk-extra{display:none}
    .bk-panel{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
    
    .bk-card{padding:24px 26px}
    .bk-card h3{font-size:18px;line-height:1.35}
    .bk-card p{font-size:14px;line-height:1.55;margin-top:8px}
    .bk-go{display:block;margin-top:14px;color:#00E5FF;font-size:13px;font-weight:600}
    .bk-card:hover{transform:translateY(-2px);box-shadow:0 16px 40px rgba(0,0,0,.35)}
    .bk-more{grid-column:1/-1;padding:14px;border-radius:12px;border:1px dashed rgba(0,229,255,.5);background:transparent;color:#00E5FF;font-size:14px;font-weight:600;cursor:pointer;font-family:inherit;transition:.15s}
    .bk-more:hover{border-color:#00E5FF;background:rgba(0,229,255,.08)}
    @media (max-width:960px){.bk-panel{grid-template-columns:1fr 1fr}}
    @media (max-width:640px){.bk-panel{grid-template-columns:1fr}}
  </style>
</ZhLayout>