---
import ZhLayout from '../../layouts/ZhLayout.astro';
export async function getStaticPaths() {
  const modules = import.meta.glob('../../data/articles/pain/*.json', { eager: true, import: 'default' });
  const seen: Map<string, number> = new Map();
  return Object.values(modules).map((val) => {
    const a = val as any;
    let slug = String(a.slug || 'post');
    const n = (seen.get(slug) || 0) + 1;
    seen.set(slug, n);
    if (n > 1) slug = slug + '-' + n;
    return { params: { slug }, props: { a } };
  });
}
const { a } = Astro.props;
const extra = String(a.extra_html || '')
  .replace(/<section[^>]*class=["'][^"']*comments[^"']*\/[\s\S]*?<\/section>/gi, '')
  .replace(/<section[^>]*id=["']comments["'][^>]*>[\s\S]*?<\/section>/gi, '')
  .replace(/<form[\s\S]*?<\/form>/gi, '')
  .replace(/<script[\s\S]*?<\/script>/gi, '');
const jsonld = { '@context': 'https://schema.org', '@type': 'Article', headline: a.title, description: a.desc, datePublished: a.date, articleSection: 'Проблемы' };
---
<ZhLayout title={`${a.title} - Запас хода`} description={a.desc} og={a.og} jsonld={jsonld}>
  <section class="sec">
    <div class="wrap">
      <div class="crumbs"><a href="/">Главная</a> / <a href="/pain/">Проблемы</a> / {a.title}</div>
      <div class="artgrid">
        <aside class="toc">
          <div>Содержание</div>
          {(a.headings || []).map((h) => (
            <a href={'#' + h.id}>{h.text}</a>
          ))}
        </aside>
        <article class="article">
          <h1 style="font-size:clamp(28px,3.4vw,40px)">{a.title}</h1>
          {a.desc && <p class="lead">{a.desc}</p>}
          <div class="meta">
            <span>Проблемы</span>
            {a.category && <span>{a.category}</span>}
            {a.date && <span>{a.date}</span>}
            {a.read_min && <span>{a.read_min} мин</span>}
          </div>
          <div set:html={a.body_html} />
          {extra && <div set:html={extra} />}
                    {a.faq && (
            <div class="faqbox">
              <h2>Частые вопросы</h2>
              {a.faq.map((f) => (
                <details><summary>{f.q}</summary><p>{f.a}</p></details>
              ))}
            </div>
          )}
          {a.faq && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: a.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) })} />}
<div class="b2b-note">
            <b>Вы дилер или СТО?</b>
            <p>Каждый такой кейс у вашего клиента — репутационный риск и лишняя работа сервиса. Укомплектуйте выдачу EV адаптерами и комплектами «Запас хода» — и закройте вопрос зарядки ещё на этапе передачи машины клиенту.</p>
            <a class="btn btn-ghost" style="text-decoration:none" href="/b2b/">Дилерам: запросить условия</a>
          </div>
          <div class="share"><span>Telegram</span><span>WhatsApp</span><span>Скопировать ссылку</span></div>
        </article>
      </div>
    </div>
  </section>
</ZhLayout>
