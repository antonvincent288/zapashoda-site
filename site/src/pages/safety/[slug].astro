---
import ZhLayout from '../../layouts/ZhLayout.astro';
import { injectIntoArticle } from '../../lib/interlink';
export async function getStaticPaths() {
  const modules = import.meta.glob('../../data/articles/safety/*.json', { eager: true, import: 'default' });
  const seen: Map<string, number> = new Map();
  return Object.values(modules).map((val) => {
    const a = val as any;
    let slug = String(a.slug || 'post');
    const n = (seen.get(slug) || 0) + 1;
    seen.set(slug, n);
    if (n > 1) slug = slug + '-' + n;
    return { params: { slug }, props: { a } };
  });
}
const { a } = Astro.props;
const extra = String(a.extra_html || '')
  .replace(/<section[^>]*class=["'][^"']*comments[^"']*\/[\s\S]*?<\/section>/gi, '')
  .replace(/<section[^>]*id=["']comments["'][^>]*>[\s\S]*?<\/section>/gi, '')
  .replace(/<form[\s\S]*?<\/form>/gi, '')
  .replace(/<script[\s\S]*?<\/script>/gi, '');
const jsonld = { '@context': 'https://schema.org', '@type': 'Article', headline: a.title, description: a.desc, datePublished: a.date, articleSection: 'Безопасность' };
---
<ZhLayout title={`${a.title} - Запас хода`} description={a.desc} og={a.og} jsonld={jsonld}>
  <section class="sec">
    <div class="wrap">
      <div class="crumbs"><a href="/">Главная</a> / <a href="/safety/">Безопасность</a> / {a.title}</div>
      <div class="artgrid">
        <aside class="toc">
          <div>Содержание</div>
          {(a.headings || []).map((h) => (
            <a href={'#' + h.id}>{h.text}</a>
          ))}
        </aside>
        <article class="article">
          <h1 style="font-size:clamp(28px,3.4vw,40px)">{a.title}</h1>
          {a.desc && <p class="lead">{a.desc}</p>}
          <div class="meta">
            <span>Безопасность</span>
            {a.category && <span>{a.category}</span>}
            {a.date && <span>{a.date}</span>}
            {a.read_min && <span>{a.read_min} мин</span>}
          </div>
          <div set:html={injectIntoArticle(String(a.body_html || ''), String(a.slug || ''))} />
          {extra && <div set:html={extra} />}
                    {a.faq && (
            <div class="faqbox">
              <h2>Частые вопросы</h2>
              {a.faq.map((f) => (
                <details><summary>{f.q}</summary><p set:html={f.a} /></details>
              ))}
            </div>
          )}
          {a.faq && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: a.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: String(f.a).replace(/<[^>]*>/g,'') } })) })} />}
<div class="share"><a href={`https://t.me/share/url?url=https://zapashoda-ev.ru/safety/${slug}/`} target="_blank" rel="nofollow" aria-label="Поделиться в Telegram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M21 4.5 3.5 11.2l4.6 1.5L9.6 18l2.7-3.2 4.2 3.1L21 4.5z"/><path d="M8.1 12.7 21 4.5l-8.7 10.3"/></svg><span>Telegram</span></a><a href={`https://wa.me/?text=${encodeURIComponent('https://zapashoda-ev.ru/safety/' + slug + '/')}`} target="_blank" rel="nofollow" aria-label="Поделиться в WhatsApp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3.5a8.5 8.5 0 0 0-7.3 12.8L3.5 20.5l4.4-1.1A8.5 8.5 0 1 0 12 3.5z"/><path d="M9 8.5c.6 3 3 5.4 6 6l1.2-1.2-2-1.2-1 .7c-.8-.5-1.6-1.3-2.1-2.1l.7-1-1.2-2z"/></svg><span>WhatsApp</span></a><a href="#" data-copy={`https://zapashoda-ev.ru/safety/${slug}/`} id="copylink" aria-label="Скопировать ссылку"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="8.5" y="8.5" width="11" height="11" rx="2"/><path d="M15.5 8.5v-2a2 2 0 0 0-2-2h-7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h2"/></svg><span>Скопировать ссылку</span></a></div><script>var cl = document.getElementById('copylink');
  if (cl) cl.addEventListener('click', function (e) {
    e.preventDefault();
    if (navigator.clipboard) navigator.clipboard.writeText(cl.getAttribute('data-copy'));
    var sp = cl.querySelector('span'); if (sp) sp.textContent = 'Скопировано'; else cl.textContent = 'Скопировано';
  });
</script>
        </article>
      </div>
    </div>
  </section>
</ZhLayout>
