---
import ZhLayout from '../layouts/ZhLayout.astro';
import LegacyStyles from '../components/LegacyStyles.astro';
const all = Object.values(import.meta.glob('../data/articles/**/*.json', { eager: true, import: 'default' })) as any[];
all.sort((a, b) => String(b.date || '').localeCompare(String(a.date || '')));
const latest = all.slice(0, 3);
const stats = [
  { n: '145', t: 'моделей с разъёмами и решениями' },
  { n: '59', t: 'статей о зарядке и ремонте' },
  { n: '2073', t: 'станций на карте РФ' },
  { n: '3 шага', t: 'до готового комплекта' },
];
const pains = [
  { ico: '⚡', h: 'Не заряжается: первые действия', p: 'Алгоритм из 7 шагов: кабель, фильтр, BMS, станция. Что делать до звонка в сервис.', href: '/pain/ne-zaryazhaetsya/', label: 'Разбор' },
  { ico: '❄️', h: 'Зимняя зарядка медленнее в 1,5–2×', p: 'Почему при минусах сессия растягивается и как планировать маршрут и станции.', href: '/pain/zapas-hoda-zimoy/', label: 'Разбор' },
  { ico: 'GB/T', h: 'Разъёмы и адаптеры', p: 'Кто конвертируется, кто нет. Проверьте свою модель в каталоге перед покупкой.', href: '/models/', label: 'Каталог' },
];
const faq = [
  { q: 'У моей модели разъём GB/T — зарядиться на станции Type 2 реально?', a: 'Да, через адаптер Type 2 → GB/T. Каталог покажет вашу модель, нужный SKU и сценарий. Обратная конвертация (GB/T → Type 2) — отдельным адаптером.' },
  { q: 'Сколько реально идёт быстрая зарядка зимой?', a: 'При минусах полная сессия быстрой зарядки идёт в 1,5–2 раза дольше — планируйте запасные станции. Разбор с цифрами — в статье «Зимняя зарядка».' },
  { q: 'Вы продаёте адаптеры или только консультируете?', a: 'Подбираем и поставляем: адаптеры, кабели, держатели. Для дилеров — партнёрский пакет на странице B2B.' },
];
const shortLine = (s) => {
  const t = String(s || '');
  const p = t.split('. ')[0];
  return (p.length <= 120 ? p + '.' : t.slice(0, 96).trim() + '…');
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const orgLd = { '@context': 'https://schema.org', '@type': 'Organization', name: 'Запас хода', url: 'https://zapashoda-ev.ru', sameAs: ['https://t.me/zapashoda_ev', 'https://dzen.ru/zapashoda'],
  contactPoint: [{ '@type': 'ContactPoint', contactType: 'customer support', email: 'f-epshtein@yandex.ru' }], description: 'Практика зарядки электромобилей в России: подбор адаптеров и кабелей, карта станций, калькуляторы, B2B-комплекты для дилеров.' };
const siteLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Запас хода', url: 'https://zapashoda-ev.ru', inLanguage: 'ru-RU', description: 'Подбор зарядки и адаптеров для электромобилей в России' };
const tools = (await import('../data/legacy/tools.json')).default;
const calc = tools.find((x) => x.slug === 'calculator') || {};
const calcHtml = String(calc.body_html || '').replace(/<h1[^>]*>[\s\S]*?<\/h1>/g, '');
const calcScript = String(calc.body_script || '');
---
<ZhLayout title="Запас хода — зарядка EV в России: разъёмы, адаптеры, станции" description="Подберите зарядку и адаптеры для вашей модели в 3 шага. 145 моделей, 59 разборов, карта 2073 станций." jsonld={orgLd}>
  <div class="hero">
    <div class="wrap">
      <div class="badge">Практика зарядки EV в России</div>
      <h1>Подберите зарядку и адаптеры <span>для вашей модели</span> в 3 шага</h1>
      <p>Разъёмы, мощность борта, зимний сценарий и стоимость зарядки — по вашей марке и году.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn btn-gold" href="/quiz/">Подобрать для моей машины</a>
        <a class="btn btn-ghost" style="background:transparent;color:#f5f5f7;border-color:rgba(229,236,246,.3)" href="/blog/">Читать разборы</a>
      </div>
      <div class="chips">
        <a class="chip" href="/models/">Zeekr →</a><a class="chip" href="/models/">Li Auto →</a>
        <a class="chip" href="/models/">BYD →</a><a class="chip" href="/models/">Voyah →</a>
        <a class="chip" href="/models/">Geely →</a><a class="chip" href="/models/">Все 145 моделей →</a>
      </div>
    </div>
  </div>
  <section class="sec" style="padding-top:40px">
    <div class="wrap duo">
      <div class="card">
        <span class="ico">🔋</span>
        <h3>Владелец электромобиля</h3>
        <p>Подбор под вашу модель: разъёмы, адаптеры, кабели. Каталог 26 позиций — заявка партнёру-дилеру, оплата при получении.</p>
        <a class="btn btn-gold" style="text-decoration:none;margin-top:14px;display:inline-block" href="/quiz/">Подобрать комплект</a>
      </div>
      <div class="card">
        <span class="ico">🤝</span>
        <h3>Дилерам и СТО</h3>
        <p>Комплекты выдачи EV и защита от рекламаций клиентов: адаптер, кабель и гайд к каждой переданной машине. Оптовые условия — по запросу.</p>
        <a class="btn btn-ghost" style="text-decoration:none;margin-top:14px;display:inline-block;border-color:var(--gold)" href="/b2b/">Запросить условия</a>
      </div>
    </div>
  </section>
  <section class="sec sec-alt">
    <div class="wrap" style="max-width:860px">
      <h2>Сколько стоит зарядить ваш электромобиль</h2>
      <p class="lead">Двигайте ползунки: расход, сценарий, пробег — увидите цену за 100 км и за месяц, сравнение с бензином.</p>
      <LegacyStyles />
      <div class="article" style="max-width:none" set:html={calcHtml} />
      {calcScript && <script is:inline set:html={calcScript} />}
    </div>
  </section>
  <section class="sec">
    <div class="wrap stats">
      {stats.map((s) => (
        <div><b>{s.n}</b><span>{s.t}</span></div>
      ))}
    </div>
  </section>
  <section class="sec sec-alt">
    <div class="wrap">
      <h2>Что чаще всего ломается на практике</h2>
      <p class="lead" style="margin-bottom:36px">Каждый блок — не маркетинг, а разбор реального кейса из «Проблем».</p>
      <div class="cards">
        {pains.map((c) => (
          <a class="card" href={c.href}><span class="ico">{c.ico}</span><h3>{c.h}</h3><p>{c.p}</p></a>
        ))}
      </div>
    </div>
  </section>
  <section class="sec">
    <div class="wrap">
      <h2>Свежие разборы</h2>
      <div class="bgrid">
        {latest.map((a) => (
          <a class="bcard" href={`/blog/${a.slug}`}>
            <span class="tag">{a.category || 'Блог'}</span>
            <h3>{a.title}</h3>
            <p>{shortLine(a.desc)}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="sec sec-alt">
    <div class="wrap">
      <h2>Частые вопросы</h2>
      <div class="faqbox" style="margin-top:24px;max-width:820px">
        {faq.map((f) => (
          <details open={f.q.startsWith('У моей модели')}><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />

  <section class="sec-alt">
    <div class="wrap" style="max-width:820px">
      <h2>Что такое адаптер GB/T и зачем он нужен</h2>
      <p>Адаптер GB/T — это переходник, который соединяет китайский разъём зарядки вашего электромобиля со станциями Type 2 или CCS2, работающими в России. GB/T — стандарт разъёмов, принятый в Китае: малый (AC, до 7 кВт) и большой (DC, быстрая зарядка). Почти все электромобили, привезённые из Китая, используют именно эти разъёмы, а российские станции — европейский Type 2 и CCS2. Без адаптера такой автомобиль не зарядить на обычной станции; с адаптером — зарядка идёт на штатной мощности, кроме сверхбыстрых режимов, где нужен следующий по мощности переходник. В каталоге «Запас хода» указан разъём каждой из 145 моделей и подобранный под неё комплект: адаптер, кабель и держатель. Решение для конкретной модели — на странице модели: там же таблица совместимости и сценарий зарядки.</p>
      <h2>Как зарядить китайский электромобиль на станции Type 2?</h2>
      <p>Алгоритм простой: определите разъём модели, возьмите адаптер GB/T → Type 2 (или GB/T → CCS2 для быстрой зарядки), подключите и запустите сессию через приложение оператора станции. Мощность ограничена узким местом цепочки: бортовым зарядом автомобиля (обычно 3–11 кВт на AC) и мощностью адаптера. Быстрые станции DC для GB/T-автомобилей работают только через большой разъём адаптера; если станция отдаёт больше 60 кВт, уточните допустимый предел переходника в его описании. Каждая страница модели на «Запас хода» содержит решение под ваш разъём: адаптер, кабель, держатель — с деталями установки и обхвата станций рядом с вами на карте.</p>
      <h2>Сколько стоит зарядка электромобиля в России?</h2>
      <p>Стоимость складывается из тарифа точки зарядки и расхода машины. Дома тариф электричества ваш — обычно это самый дешёвый сценарий; на общественных станциях тариф устанавливает сеть, и на трассах он выше, чем в городе. Калькулятор на сайте считает цену за 100 км и за месяц: задайте расход, пробег и сценарий — сравнение с бензином вы получите сразу же. Тарифы операторов по-разному устроены: часть берёт за кВт·ч, часть — за минуту сессии, у части есть ночные ставки. Отдельный разбор тарифов и бесплатных трасс — в статье «Бесплатные трассы и парковка для EV» и в калькуляторе, где сценарии уже свёрстаны под российские условия.</p>
    </div>
  </section>
</ZhLayout>
