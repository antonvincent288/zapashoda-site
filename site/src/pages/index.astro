---
import ZhLayout from '../layouts/ZhLayout.astro';
const all = Object.values(import.meta.glob('../data/articles/blog/*.json', { eager: true, import: 'default' })) as any[];
const allPain = Object.values(import.meta.glob('../data/articles/pain/*.json', { eager: true, import: 'default' })) as any[];
import legacyBaza from '../data/legacy/baza.json';
all.push(...allPain, ...legacyBaza);
import fs from 'node:fs';
let STN = 3129;
try { const rawS = JSON.parse(fs.readFileSync('public/charging/stations.json', 'utf-8')); if (Array.isArray(rawS.stations)) STN = rawS.stations.length; } catch {}
const MT_HOME = Object.values(import.meta.glob('../data/models/*.json', { eager: true, import: 'default' })).length;
const BN_HOME = all.filter((a) => a && a.slug).length;
const plh = (n, one, few, many) => { const a = n % 10, b = n % 100; if (a === 1 && b !== 11) return one; if (a >= 2 && a <= 4 && (b < 12 || b > 14)) return few; return many; };
const faq = [{"q": "Какие станции поддерживают GB/T напрямую, без переходника?", "a": "В нашей базе 89 GB/T-коннекторов в Москве и области (данные 11.2026) и 1 165 станций всего. На карте дашборда включите фильтр «GB/T»."}, {"q": "Сколько реально проедет Zeekr 001 зимой при −20°?", "a": "При заряде 80% — около 283 км смешанного цикла. При 100% — до 353 км. Кольцо пробега на карте показывает это вживую для любого заряда."}, {"q": "Какой адаптер нужен для перехода с GB/T на CCS2?", "a": "Для Zeekr 001 и похожих: адаптер GB/T→CCS2 (нижний DC-порт). Каталог с проверенными комплектами — в разделе «Адаптеры». Не покупайте переходник для AC-порта в DC-разъём."}, {"q": "Сколько стоит 100 км зимой?", "a": "Дома ночью — от 97 ₽, в городской сети — от 437 ₽, на трассе — до 608 ₽. Полный калькулятор с вашей моделью — в разделе «Калькуляторы»."}];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) =>({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const orgLd = { '@context': 'https://schema.org', '@type': 'Organization', name: 'Запас хода', url: 'https://zapashoda-ev.ru', sameAs: ['https://t.me/zapashoda_ev', 'https://dzen.ru/zapashoda'],
  contactPoint: [{ '@type': 'ContactPoint', contactType: 'customer support', email: 'f-epshtein@yandex.ru' }], description: 'Практика зарядки электромобилей в России: подбор адаптеров и кабелей, карта станций, калькуляторы, B2B-комплекты для дилеров.' };
const mlData = Object.values(import.meta.glob('../data/models_light.json', { eager: true, import: 'default' }))[0] || {};
const POP_SLUGS = ['zeekr-001-001-fr','li-auto-l6-l7-l8-l9-2022-2025','byd-han-ev-song-l','aito-m5-m7','voyah-free-evr-gibrid','byd-seal','xpeng-g9-g6','tesla-model-3-y-eu'];
const POP = (mlData.models || []).filter((x) => POP_SLUGS.includes(String(x.slug))).slice(0, 8);
const ALL = (mlData.models || []).filter((m) => m.slug);
const BRANDS = Array.from(new Set(ALL.map((m) => String(m.brand || '—')))).sort();
const POP_BRANDS = ['Zeekr','Li Auto','BYD','AITO','Voyah','XPeng','Tesla','Nissan'].filter((b) => BRANDS.includes(b));
---
<ZhLayout title="Запас хода — зарядка EV в России: разъёмы, адаптеры, станции" description={`Подберите зарядку и адаптеры для вашей модели в 3 шага. ${MT_HOME} ${plh(MT_HOME, 'модель', 'модели', 'моделей')}, ${BN_HOME} материалов, карта ${Math.floor(STN / 100) * 100}+ станций.`} jsonld={orgLd}>
<div class="hw-hero"><div class="wrap hw-wrap">
<div class="hw-left">
<div class="hw-badge"><i></i> {STN} станций на карте · {BN_HOME} материалов · обновлено 11.2026</div>
<h1 class="hw-h1">Зарядка и <em>реальный запас хода</em> EV в России</h1>
<p class="hw-sub">Разъёмы, адаптеры, зимний расход и карта проверенных ЭЗС — под вашу модель и погоду. <b>Честные цифры</b> вместо паспортных сказок.</p>
<div class="hw-chips">
<a class="hw-chip on" href="/models/">Zeekr</a>
<a class="hw-chip" href="/models/">Li Auto</a>
<a class="hw-chip" href="/models/">BYD</a>
<a class="hw-chip" href="/models/">AITO</a>
<a class="hw-chip" href="/models/">Voyah</a>
<a class="hw-chip" href="/models/">XPeng</a>
<a class="hw-chip" href="/models/">Tesla</a>
</div>
<div class="hw-note">Виджет справа — живой пример расчёта · Zeekr 001 · 100 кВт·ч · заряд 80%. Ваша модель и точный расход — в полном калькуляторе ниже.</div>
</div>
<div class="hw-widget">
<div class="dw-head"><div class="dw-title">Запас хода <span>Zeekr 001 · 100 кВт·ч</span></div><div class="dw-live"><i></i> пересчёт 0,4 с</div></div>
<div class="dw-body">
<div class="gauge"><svg viewBox="0 0 176 176" aria-hidden="true"><circle cx="88" cy="88" r="76" fill="none" stroke="rgba(148,163,184,.15)" stroke-width="9"/><circle id="hw-arc" cx="88" cy="88" r="76" fill="none" stroke="url(#hw-ga)" stroke-width="9" stroke-linecap="round" stroke-dasharray="477.5" stroke-dashoffset="262.6" style="filter:drop-shadow(0 0 6px rgba(255,143,51,.5));transition:stroke-dashoffset .4s"/><defs><linearGradient id="hw-ga" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#FF8F33"/><stop offset="1" stop-color="#E85002"/></linearGradient></defs></svg><div class="g-val"><div class="g-num" id="hw-rkm">282</div><div class="g-cap">км реальных · при 80% заряда</div></div></div>
<div class="dw-rows">
<div class="dw-row"><span class="k">Заряд сейчас</span><span class="v">80% <small>· 80 кВт·ч</small></span></div>
<div class="dw-row"><span class="k">Расход</span><span class="v" id="hw-cons">28,4 <small>кВт·ч/100</small></span></div>
<div class="dw-row"><span class="k">Печка + обогрев</span><span class="v hw-accent" id="hw-heat">4,6 <small>кВт·ч/ч</small></span></div>
<div class="dw-row"><span class="k">Порт</span><span class="v">GB/T <small>· нужен переходник</small></span></div>
<div class="dw-row"><span class="k">Температура</span><span class="v hw-accent" id="hw-tval">−20°</span></div>
</div>
<div class="dw-temp"><input type="range" id="hw-trange" min="-30" max="25" step="5" value="-20" aria-label="Температура воздуха"></div>
</div>
<div class="dw-cta">
<a class="btn main" href="/charging/?mode=drive">Открыть живую карту с кольцом пробега →</a>
<a class="btn ghost" href="/models/zeekr-001-001-fr/">Паспорт модели</a>
</div>
</div>
</div>
<div class="zh-strip" aria-label={`Все ${MT_HOME} ${plh(MT_HOME, 'модель', 'модели', 'моделей')} — переход в каталог`}><div class="zh-strip-track">{ALL.filter((m)=>m.slug).map((m)=>(<a class="zh-strip-item" href={`/models/${m.slug}/`}>{m.name}</a>))}{ALL.filter((m)=>m.slug).map((m)=>(<a class="zh-strip-item" aria-hidden="true" tabindex="-1" href={`/models/${m.slug}/`}>{m.name}</a>))}</div></div>
<script is:inline>(function(){function boot(){var s=document.querySelector(".zh-strip"),t=document.querySelector(".zh-strip-track");if(!s||!t)return;var x=0,paused=false,dragging=false,half=t.getBoundingClientRect().width/2,last=null,lastX=0,startX=0;function apply(){t.style.transform="translateX("+x+"px)";}window.addEventListener("resize",function(){half=t.getBoundingClientRect().width/2;});function step(ts){if(last==null)last=ts;var dt=Math.min(ts-last,64);last=ts;if(!paused&&!dragging){x-=dt*0.045;if(-x>=half)x=0;apply();}requestAnimationFrame(step);}requestAnimationFrame(step);s.addEventListener("mouseenter",function(){paused=true;});s.addEventListener("mouseleave",function(){paused=false;});s.addEventListener("pointerdown",function(e){dragging=true;lastX=e.clientX;startX=x;paused=true;try{s.setPointerCapture(e.pointerId);}catch(_){}});s.addEventListener("pointermove",function(e){if(!dragging)return;x=startX+(e.clientX-lastX);if(x>0)x=0;if(-x>=half)x=0;apply();});["pointerup","pointercancel","touchend","touchcancel"].forEach(function(ev){s.addEventListener(ev,function(){dragging=false;setTimeout(function(){paused=false;},700);});});s.addEventListener("wheel",function(e){if(Math.abs(e.deltaX)>Math.abs(e.deltaY)){e.preventDefault();x+=e.deltaX;if(x>0)x=0;if(-x>=half)x=0;apply();paused=true;clearTimeout(s._t);s._t=setTimeout(function(){paused=false;},900);}},{passive:false});}if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",boot);else boot();})();</script>
</div>

<section class="sec-blk"><div class="wrap">
<h2 class="sec">Популярные модели<small>Бейджи — ваши разъёмы и совместимость с нашими станциями</small></h2>
<div class="m-frow" role="group" aria-label="Фильтр по бренду" data-mfilter>
<button class="m-chip on" type="button" data-brand="Все">Все</button>
{POP_BRANDS.map((br) => (
<button class="m-chip" type="button" data-brand={br}>{br}</button>
))}
</div>
<div class="m-grid8" data-mcards>
{POP.map((mo) => (
<a class="m-card" href={'/models/' + mo.slug + '/'} data-brand={mo.brand}>
<span class="m-name">{mo.name}</span>
<span class="m-spec">{mo.years}</span>
<span class="m-badges"><span class="bdg">{mo.port === 'EU' ? 'CCS2' : mo.port}</span><span class={'bdg' + (mo.port === 'EU' ? ' cool' : '')}>{mo.port === 'EU' ? 'CCS2 напрямую' : 'Нужен адаптер'}</span></span>
</a>
))}
</div>
<div class="m-frow" style="margin-top:16px"><a class="m-btn-ghost" href="/models/">Все {MT_HOME} {plh(MT_HOME, 'модель', 'модели', 'моделей')} →</a></div>
</div></section>

<section class="sec sec-alt"><div class="wrap">
<h2>Инструменты и трассы</h2>
<p class="lead">Считаем деньги и километры честно, без маркетинга</p>
<div class="hw-split">
 <div class="hw-calc">
  <h3>Цена 100 км: электричество vs бензин</h3>
  <p class="hw-hint">Тариф зависит от места зарядки — выберите сценарий</p>
  <div class="hw-presets">
   <button class="hw-preset on" data-p="4" type="button"><b>4 ₽/кВт·ч</b>Дома ночью</button>
   <button class="hw-preset" data-p="18" type="button"><b>18 ₽/кВт·ч</b>Город, сеть</button>
   <button class="hw-preset" data-p="25" type="button"><b>25 ₽/кВт·ч</b>Трасса, fast</button>
  </div>
  <div class="hw-out"><div><div class="hw-big" id="hw-out">437 ₽</div><div class="hw-cmp">за 100 км зимой (−10°, расход 24,3 кВт·ч/100)</div></div><div style="text-align:right"><div class="hw-big hw-dim">≈ 496 ₽</div><div class="hw-cmp">та же поездка на бензине (8 л/100 × 62 ₽)</div></div></div>
  <div style="margin-top:14px"><a class="hw-btn" href="/calculator/">Полный калькулятор с вашей машиной →</a></div>
 </div>
 <div class="hw-routes">
  <a class="hw-route" href="/shop/digital/"><span class="hw-rn">М-4</span><span class="hw-rt"><b>Москва — Воронеж — Краснодар</b><span>гайд · ЭЗС-хабы · тёплые стоянки</span></span><span class="hw-ra">→</span></a>
  <a class="hw-route" href="/shop/digital/"><span class="hw-rn">М-11</span><span class="hw-rt"><b>Москва — Санкт-Петербург</b><span>гайд · 4 хаба · 24/7 · зоны отдыха</span></span><span class="hw-ra">→</span></a>
  <a class="hw-route" href="/shop/digital/"><span class="hw-rn">М-12</span><span class="hw-rt"><b>Москва — Казань — Екатеринбург</b><span>гайд · новейшая трасса · 240 кВт</span></span><span class="hw-ra">→</span></a>
 </div>
</div>
<script is:inline>
(function(){
  var con=24.3;
  Array.prototype.forEach.call(document.querySelectorAll('.hw-preset'),function(b){
    b.addEventListener('click',function(){
      Array.prototype.forEach.call(document.querySelectorAll('.hw-preset'),function(x){x.classList.remove('on')});
      b.classList.add('on');
      var p=+b.getAttribute('data-p');
      document.getElementById('hw-out').textContent=Math.round(con*p).toLocaleString('ru-RU')+' ₽';
    });
  });
})();
</script>
</div></section>

<section class="sec-blk"><div class="wrap">
<h2 class="sec">База знаний<small>Живые разборы из нашей практики — {BN_HOME} материалов</small></h2>
<div class="kbgrid">
<a class="kbcard" href="/blog/"><span class="ktag">Разбор · 12 мин</span><h4>Не заряжается на морозе: 7 шагов за 3 минуты</h4><p>Пошагово: от «пин не защёлкнулся» до полной перезагрузки станции. Работает у Sitronics и «Энергии Москвы».</p></a>
<a class="kbcard" href="/blog/"><span class="ktag">Зима · 9 мин</span><h4>−20°: сколько реально ест печка и обогрев</h4><p>Распад по потребителям: батарея, печь, руль. С цифрами из реальных поездок Zeekr 001.</p></a>
<a class="kbcard" href="/blog/"><span class="ktag">12В · 6 мин</span><h4>АКБ 12В: кто садится и что делать</h4><p>Топ-3 сценария разряда и честная таблица восстановления на разных машинах.</p></a>
</div>
<div class="m-faq">
{faq.map((f) => (
<details><summary>{f.q}</summary><p>{f.a}</p></details>
))}
</div>
<p style="margin-top:14px"><a href="/blog/" style="color:var(--cyan,#00E5FF);font-size:14px;text-decoration:none">Все материалы базы знаний →</a></p>
</div></section>

<section class="sec sec-alt"><div class="wrap"><h2>Всё о твоей машине за 30 секунд</h2><p class="lead">Марка → модель → разъёмы, адаптеры и сценарий зарядки — результат сразу на экране.</p><div style="max-width:560px;margin:10px auto 0"><div class="zh-quiz" aria-label="Подбор комплекта за 30 секунд"><div class="zq-title">Всё о твоей машине</div><div class="zq-sub">Марка → модель → болячки и решения</div><div class="zq-field"><span class="zq-label">Марка</span><span class="zq-selwrap"><select id="zq-brand-sel" class="zq-select"><option value="">Выберите марку</option><optgroup label="Популярные">{POP_BRANDS.map((b) =>(<option value={b}>{b}</option>))}</optgroup><optgroup label="Все марки">{BRANDS.filter((b) => !POP_BRANDS.includes(b)).map((b) =>(<option value={b}>{b}</option>))}</optgroup></select></span></div><div class="zq-field" id="zq-model-wrap" style="display:none"><span class="zq-label">Модель</span><span class="zq-selwrap"><select id="zq-model-sel" class="zq-select"><option value="">Выберите модель</option></select></span></div><div id="zq-result" style="display:none"><div id="zq-out"></div><a id="zq-model-btn" class="btn btn-gold" style="text-decoration:none;display:inline-block;margin-top:14px" href="/models/">Карточка модели</a><button class="zq-back" type="button">← заново</button></div></div><script define:vars={{ ALL }}>(function(){var M=(ALL||[]).filter(function(m){return m&&m.slug;});var bSel=document.getElementById('zq-brand-sel'),mSel=document.getElementById('zq-model-sel');var mWrap=document.getElementById('zq-model-wrap'),res=document.getElementById('zq-result');bSel.addEventListener('change',function(){var v=bSel.value;if(!v){mWrap.style.display='none';mSel.innerHTML='';return;}mSel.innerHTML='<option value="">Выберите модель</option>';M.filter(function(m){return m.brand===v;}).forEach(function(m){var o=document.createElement('option');o.value=m.slug;o.textContent=m.name||m.slug;mSel.appendChild(o);});mWrap.style.display='';res.style.display='none';});mSel.addEventListener('change',function(){var slug=mSel.value;var m=null;for(var i=0;i<M.length;i++)if(M[i].slug===slug){m=M[i];break;}if(m)showResult(m);});function plugSlug(p){p=String(p||'');return p.indexOf('GB/T')>=0?'gbt':(p.indexOf('CHAdeMO')>=0?'chademo':(p.indexOf('Type1')>=0?'type1':'type2'));}function plugImg(p){p=String(p||'');var k=p.indexOf('GB/T')>=0?'gbt-dc':(p.indexOf('CHAdeMO')>=0?'chademo':(p.indexOf('Type1')>=0?'type1':'type2'));return '<img src="/assets/img/plugs/zsh-'+k+'.svg" width="18" height="18" alt="" style="vertical-align:-4px;margin-right:4px">';}function showResult(m){var port=String(m.port||'');var adapters=[];if(/GB\/T/i.test(port))adapters.push('Адаптер Type 2 → GB/T (AC, 22 кВт) — ваш основной переходник');if(/CCS/i.test(port))adapters.push('Прямое подключение CCS2 на быстрых станциях');if(!adapters.length)adapters.push('Прямое подключение Type 2 — переходник не нужен');document.getElementById('zq-out').innerHTML='<b>'+(m.name||'')+'</b>'+(m.years?'<div class="zq-y">'+m.years+'</div>':'')+'<div class="zq-ports"><b>Разъёмы:</b> '+(port?plugImg(port)+' '+port+' <a href="/razemy/'+plugSlug(port)+'/" style="color:var(--cyan,#00E5FF);font-size:14px;text-decoration:none">что за разъём →</a>':'—')+'</div>'+'<div style="margin-top:10px"><b>Что понадобится:</b><ul>'+adapters.map(function(a){return '<li>'+a+'</li>';}).join('')+'</ul></div>';document.getElementById('zq-model-btn').href='/models/'+m.slug+'/';document.getElementById('zq-model-btn').style.display='inline-block';res.style.display='';}Array.prototype.forEach.call(document.querySelectorAll('.zq-back'),function(btn){btn.addEventListener('click',function(){res.style.display='none';mWrap.style.display='none';mSel.innerHTML='';bSel.value='';});});})();</script></div></div></section>
<script is:inline>
(function(){
  var CIRC=477.5, BATT=100, CH=0.8, RMAX=Math.round(100*BATT/16);
  function cons(t){ return 16 + Math.max(0,(15-t))*0.35; }
  function upd(){
    var r=document.getElementById('hw-trange'); if(!r) return;
    var t=+r.value, c=cons(t), range=Math.round(100*BATT*CH/c);
    var a=document.getElementById('hw-arc'); if(a) a.style.strokeDashoffset=(CIRC*(1-Math.min(1,range/RMAX))).toFixed(1);
    var e=document.getElementById('hw-rkm'); if(e) e.textContent=range;
    e=document.getElementById('hw-cons'); if(e) e.innerHTML=(Math.round(c*10)/10).toString().replace('.',',')+' <small>кВт·ч/100</small>';
    e=document.getElementById('hw-heat'); if(e) e.innerHTML=(t>=15?'0,8':(4.6-0.11*(t+20)).toFixed(1).replace('.0','').replace('.',',').replace('-','−'))+' <small>кВт·ч/ч</small>';
    e=document.getElementById('hw-tval'); if(e) e.textContent=(t>0?'+':'−')+Math.abs(t)+'°';
  }
  var r=document.getElementById('hw-trange');
  if(r) r.addEventListener('input',upd);
  upd();
})();
</script>
<script is:inline>
(function(){
  Array.prototype.forEach.call(document.querySelectorAll('[data-mfilter] .m-chip'),function(b){
    b.addEventListener('click',function(){
      Array.prototype.forEach.call(document.querySelectorAll('[data-mfilter] .m-chip'),function(x){x.classList.remove('on')});
      b.classList.add('on');
      var br=b.getAttribute('data-brand');
      Array.prototype.forEach.call(document.querySelectorAll('[data-mcards] .m-card'),function(c){
        c.style.display=(br==='Все'||c.getAttribute('data-brand')===br)?'':'none';
      });
    });
  });
})();
</script>

<style is:global>
.zh-strip{position:relative;z-index:1;margin-top:52px;padding:15px 0 17px;border-top:1px solid rgba(255,255,255,.08);overflow:hidden;cursor:grab;touch-action:pan-y}
.zh-strip-track{display:flex;align-items:center;gap:26px;width:max-content}
.zh-strip:hover .zh-strip-track{animation-play-state:paused}
.zh-strip-item{color:#00E5FF;font-size:15px;letter-spacing:.01em;white-space:nowrap;text-decoration:none;text-shadow:0 1px 9px rgba(0,0,0,.8);transition:color .18s ease;padding:12px 6px;margin:-12px -6px}
.zh-strip-item:hover{color:#a9d2ff}
.zh-strip-item:nth-child(even){color:#f5f5f7}
.zh-strip-item:nth-child(even):hover{color:#fff}
.zh-strip-item::after{content:'\00B7';display:inline-block;margin-left:26px;color:rgba(255,255,255,.18);pointer-events:none}

.zh-quiz{background:rgba(11,12,17,.92);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.09);border-radius:20px;padding:28px 28px 24px;box-shadow:0 24px 70px rgba(0,0,0,.45);align-self:start;margin-top:3px}
.zh-quiz{box-shadow:0 24px 70px rgba(0,0,0,.45),0 0 80px rgba(255,111,0,.16)}
.hw-hero{position:relative;padding:56px 0 0}
.hw-wrap{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:30px;align-items:start}
.hw-badge{display:inline-flex;align-items:center;gap:9px;font-size:12.5px;color:var(--dim,#8E99A8);border:1px solid rgba(148,163,184,.15);background:rgba(15,17,22,.7);border-radius:999px;padding:7px 14px}
.hw-badge i{width:7px;height:7px;border-radius:50%;background:#37D67A;box-shadow:0 0 8px #37D67A;flex-shrink:0}
.hw-h1{font-size:clamp(40px,5.4vw,68px)!important;line-height:1.04;letter-spacing:-.03em;font-weight:800;color:#fff;margin:16px 0 12px!important;max-width:none!important}
.hw-h1 em{font-style:normal;background:linear-gradient(92deg,#FF8F33,#FFD1A8 70%);-webkit-background-clip:text;background-clip:text;color:transparent}
.hw-sub{font-size:16.5px;color:var(--dim,#8E99A8)!important;max-width:470px;margin:0 0 20px!important;text-shadow:none!important}
.hw-sub b{color:#E9ECF2}
.hw-chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.hw-chip{font-size:13px;color:var(--dim,#8E99A8);border:1px solid rgba(148,163,184,.15);background:rgba(10,12,16,.6);border-radius:999px;padding:7px 13px;text-decoration:none;transition:.15s}
.hw-chip:hover,.hw-chip.on{color:#FFB27A;border-color:rgba(232,80,2,.55);background:rgba(232,80,2,.13)}
.hw-note{font-size:12px;color:var(--dim2,#5C6673);margin-top:14px;max-width:430px}
.hw-widget{background:rgba(13,15,19,.88);border:1px solid rgba(148,163,184,.3);border-radius:20px;overflow:hidden;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
.hw-widget .btn{display:flex;align-items:center;justify-content:center;gap:9px;border-radius:14px;padding:14px 16px;font-weight:700;font-size:14px;text-decoration:none}
.hw-widget .btn.main{background:linear-gradient(135deg,#FF8F33,#E85002);color:#fff;box-shadow:0 10px 26px rgba(232,80,2,.4)}
.hw-widget .btn.ghost{border:1px solid rgba(148,163,184,.3);color:#E9ECF2;background:rgba(255,255,255,.03);font-size:13px}
.hw-split{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:18px}
.hw-calc{background:rgba(13,15,19,.88);border:1px solid rgba(148,163,184,.3);border-radius:20px;padding:20px 22px}
.hw-calc h3{font-size:15px;font-weight:700;color:#fff;margin:0 0 4px}
.hw-hint{font-size:12.5px;color:#8E99A8;margin:0 0 14px}
.hw-presets{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px}
.hw-preset{background:rgba(255,255,255,.03);border:1px solid rgba(148,163,184,.15);border-radius:10px;padding:9px 6px;text-align:center;cursor:pointer;font-size:12px;color:#8E99A8;font-family:inherit}
.hw-preset.on{border-color:rgba(232,80,2,.55);background:rgba(232,80,2,.12);color:#FFB27A}
.hw-preset b{display:block;font-size:13.5px;color:#E9ECF2;font-family:ui-monospace,Menlo,Consolas,monospace}
.hw-preset.on b{color:#fff}
.hw-out{display:flex;justify-content:space-between;align-items:center;background:#111318;border:1px solid rgba(148,163,184,.15);border-radius:12px;padding:13px 15px}
.hw-big{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:26px;font-weight:700;color:#fff}
.hw-dim{color:#8E99A8;font-size:17px!important}
.hw-cmp{font-size:12.5px;color:#8E99A8}
.hw-routes{display:grid;gap:10px}
.hw-route{display:flex;align-items:center;gap:13px;background:rgba(13,15,19,.88);border:1px solid rgba(148,163,184,.15);border-radius:14px;padding:13px 15px;text-decoration:none;transition:.15s}
.hw-route:hover{border-color:rgba(232,80,2,.45)}
.hw-rn{font-family:ui-monospace,Menlo,Consolas,monospace;font-weight:700;font-size:14px;color:#FFB27A;border:1px solid rgba(232,80,2,.45);background:rgba(232,80,2,.1);border-radius:9px;padding:6px 9px;flex-shrink:0}
.hw-rt{min-width:0}
.hw-ra{margin-left:auto;color:#39D7FF;font-size:13px}
.hw-btn{display:flex;width:100%;justify-content:center;border-radius:14px;padding:14px 18px;background:linear-gradient(135deg,#FF8F33,#E85002);color:#fff;font-weight:700;font-size:14.5px;box-shadow:0 10px 26px rgba(232,80,2,.4);text-decoration:none}
@keyframes hwBl{0%,100%{opacity:1}50%{opacity:.4}}

/* === МАКЕТ: секции главной === */
.sec-blk{padding:26px 0 40px}
h2.sec{font-size:30px;font-weight:800;letter-spacing:-.03em;color:#fff;margin:0 0 6px}
h2.sec small{display:block;font-size:13px;font-weight:500;color:#8E99A8;letter-spacing:0;margin-top:5px}
.m-grid8{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:18px}
.m-card{background:rgba(13,15,19,.88);border:1px solid rgba(148,163,184,.15);border-radius:16px;padding:16px;display:flex;flex-direction:column;gap:8px;text-decoration:none;transition:.15s}
.m-card:hover{border-color:rgba(232,80,2,.45);transform:translateY(-2px)}
.m-name{font-weight:700;font-size:15px;color:#fff}
.m-spec{font-size:12.5px;color:#8E99A8}
.m-badges{display:flex;gap:6px;margin-top:auto;flex-wrap:wrap}
.m-frow{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}
.m-chip{font-size:13px;color:#8E99A8;border:1px solid rgba(148,163,184,.15);background:rgba(10,12,16,.6);border-radius:999px;padding:7px 13px;cursor:pointer;font-family:inherit}
.m-chip.on{color:#FFB27A;border-color:rgba(232,80,2,.55);background:rgba(232,80,2,.13)}
.m-btn-ghost{display:inline-flex;padding:12px 18px;border:1px solid rgba(148,163,184,.3);color:#E9ECF2;background:rgba(255,255,255,.03);border-radius:12px;font-size:14px;text-decoration:none}
.kbgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:18px}
.kbcard{background:rgba(13,15,19,.88);border:1px solid rgba(148,163,184,.15);border-radius:16px;padding:16px;text-decoration:none;transition:.15s}
.kbcard:hover{border-color:rgba(232,80,2,.45);transform:translateY(-2px)}
.ktag{font-size:11px;color:#5C6673}
.kbcard h4{font-size:15px;color:#fff;margin:7px 0 5px}
.kbcard p{font-size:13px;color:#8E99A8;margin:0}
.m-faq{margin-top:22px;border-top:1px solid rgba(148,163,184,.15)}
.m-faq details{border-bottom:1px solid rgba(148,163,184,.15)}
.m-faq summary{cursor:pointer;list-style:none;padding:14px 4px;font-size:14.5px;color:#E9ECF2;display:flex;justify-content:space-between;align-items:center}
.m-faq summary::-webkit-details-marker{display:none}
.m-faq summary::after{content:'+';color:#5C6673;font-size:18px;flex-shrink:0;margin-left:12px}
.m-faq details[open] summary::after{content:'−'}
.m-faq details p{padding:0 4px 14px;font-size:13.5px;color:#8E99A8;margin:0}
/* единый стиль заголовков секций (квиз и прочие) */
.sec .wrap > h2, .sec-alt .wrap > h2{font-size:30px;font-weight:800;letter-spacing:-.03em;color:#fff;margin:0 0 6px}
.sec .wrap > p.lead, .sec-alt .wrap > p.lead{color:#8E99A8;font-size:14.5px;margin:0 0 22px}
@media(max-width:1020px){.m-grid8{grid-template-columns:repeat(2,1fr)}.kbgrid{grid-template-columns:1fr}}
@media(max-width:560px){.m-grid8{grid-template-columns:1fr}}

</style>
