---
import ZhLayout from '../layouts/ZhLayout.astro';
import LegacyStyles from '../components/LegacyStyles.astro';
const all = Object.values(import.meta.glob('../data/articles/**/*.json', { eager: true, import: 'default' })) as any[];
all.sort((a, b) =>String(b.date || '').localeCompare(String(a.date || '')));
const latest = all.slice(0, 3);
const stats = [
  { n: '145', t: 'моделей с разъёмами и решениями' },
  { n: '59', t: 'статей о зарядке и ремонте' },
  { n: '2073', t: 'станций на карте РФ' },
  { n: '3 шага', t: 'до готового комплекта' },
];
const pains = [
  { ico: '', zx: 13, zy: 41, h: 'Не заряжается: первые действия', p: 'Алгоритм из 7 шагов: кабель, фильтр, BMS, станция. Что делать до звонка в сервис.', href: '/pain/ne-zaryazhaetsya/', label: 'Разбор' },
  { ico: '', zx: 60, zy: 22, h: 'Зимняя зарядка медленнее в 1,5–2×', p: 'Почему при минусах сессия растягивается и как планировать маршрут и станции.', href: '/pain/zapas-hoda-zimoy/', label: 'Разбор' },
  { ico: 'GB/T', zx: 24, zy: 27, h: 'Разъёмы и адаптеры', p: 'Кто конвертируется, кто нет. Проверьте свою модель в каталоге перед покупкой.', href: '/models/', label: 'Каталог' },
];
const faq = [
  { q: 'У моей модели разъём GB/T — зарядиться на станции Type 2 реально?', a: 'Да, через адаптер Type 2 → GB/T. Каталог покажет вашу модель, нужный SKU и сценарий. Обратная конвертация (GB/T → Type 2) — отдельным адаптером.' },
  { q: 'Сколько реально идёт быстрая зарядка зимой?', a: 'При минусах полная сессия быстрой зарядки идёт в 1,5–2 раза дольше — планируйте запасные станции. Разбор с цифрами — в статье «Зимняя зарядка».' },
  { q: 'Вы продаёте адаптеры или только консультируете?', a: 'Подбираем и поставляем: адаптеры, кабели, держатели. Для дилеров — партнёрский пакет на странице B2B.' },
];
const shortLine = (s) =>{
  const t = String(s || '');
  const p = t.split('. ')[0];
  return (p.length <= 120 ? p + '.' : t.slice(0, 96).trim() + '…');
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) =>({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const orgLd = { '@context': 'https://schema.org', '@type': 'Organization', name: 'Запас хода', url: 'https://zapashoda-ev.ru', sameAs: ['https://t.me/zapashoda_ev', 'https://dzen.ru/zapashoda'],
  contactPoint: [{ '@type': 'ContactPoint', contactType: 'customer support', email: 'f-epshtein@yandex.ru' }], description: 'Практика зарядки электромобилей в России: подбор адаптеров и кабелей, карта станций, калькуляторы, B2B-комплекты для дилеров.' };
const siteLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Запас хода', url: 'https://zapashoda-ev.ru', inLanguage: 'ru-RU', description: 'Подбор зарядки и адаптеров для электромобилей в России' };
const tools = (await import('../data/legacy/tools.json')).default;
const calc = tools.find((x) =>x.slug === 'calculator') || {};
const calcHtml = String(calc.body_html || '').replace(/<h1[^>]*>[\s\S]*?<\/h1>/g, '');
const calcScript = String(calc.body_script || '');
const mlData = Object.values(import.meta.glob('../data/models_light.json', { eager: true, import: 'default' }))[0] || {};
const POP_SLUGS = ['zeekr-001-001-fr','li-auto-l6-l7-l8-l9-2022-2025','byd-han-ev-song-l','aito-m5-m7','voyah-free-evr-gibrid','byd-seal','xpeng-g9-g6','tesla-model-3-y-eu'];
const POP = (mlData.models || []).filter((x) => POP_SLUGS.includes(String(x.slug))).slice(0, 8);
const ALL = (mlData.models || []).filter((m) => m.slug);
---
<ZhLayout title="Запас хода — зарядка EV в России: разъёмы, адаптеры, станции" description="Подберите зарядку и адаптеры для вашей модели в 3 шага. 145 моделей, 59 разборов, карта 2073 станций." jsonld={orgLd}><div class="hero zh-hero-big"><div class="wrap"><div class="badge">Практика зарядки EV в России</div><h1>Если тоже за*бался <span>с этими зарядками&hellip;</span></h1><p>Мы затрахались делать этот сайт, но нашли разъёмы, мощность борта, зимний сценарий и стоимость зарядки — по вашей марке и году.</p></div>
        </div><section class="sec" style="padding-top:40px"><div class="wrap">
        <div class="roleseg" data-roleseg role="tablist" aria-label="Кому подбираем">
          <button class="seg-btn on" type="button" data-role="b2c" aria-selected="true">Я владелец EV</button>
          <button class="seg-btn" type="button" data-role="b2b" aria-selected="false">Я дилер / СТО</button>
        </div>
        <div data-role-block="b2c">
          <div class="card" style="max-width:640px"><span class="ico"></span><h3>Подбор под ваш автомобиль</h3><p>Разъёмы, адаптеры, кабели и держатели. Каталог 26 позиций — заявка партнёру-дилеру, оплата при получении.</p><a class="btn btn-gold" style="text-decoration:none;margin-top:14px;display:inline-block" href="/quiz/">Подобрать комплект</a></div>
        </div>
        <div data-role-block="b2b" style="display:none">
          <div class="card" style="max-width:640px;border-color:var(--gold)"><span class="ico"></span><h3>Дилерам и СТО</h3><p>Комплекты выдачи EV и защита от рекламаций клиентов: адаптер, кабель и гайд к каждой переданной машине. Оптовые условия — по запросу.</p><a class="btn btn-ghost" style="text-decoration:none;margin-top:14px;display:inline-block;border-color:var(--gold)" href="/b2b/">Запросить условия</a></div>
        </div>
      </div></section><section class="sec sec-alt"><div class="wrap" style="max-width:860px"><h2>Сколько стоит зарядить ваш электромобиль</h2><p class="lead">Ваш расход, сценарий и тариф — мгновенный расчёт за 100 км и за месяц, с сравнением с бензином.</p><LegacyStyles /><div class="ev-battery" aria-hidden="true" style="margin:18px 0 10px"><span class="shell"><span class="fill"></span></span><span>Считается живьём: ползунок — мгновенный пересчёт</span></div><div class="article glass-panel" style="max-width:none" set:html={calcHtml} />{calcScript && <script is:inline set:html={calcScript} />}
    <div class="bridge" style="margin-top:22px">
          <div class="bridge-l"><b>Посчитали цену простоя?</b><span>Комплект автономности — адаптер, кабель и держатель — вернёт вам эти деньги в дороге.</span></div>
          <a class="btn btn-gold" href="/quiz/">Собрать комплект</a>
        </div></div></section><section class="sec"><div class="wrap stats">{stats.map((s) =>(
        <div><b data-count={/^[0-9]+$/.test(String(s.n)) ? s.n : undefined}>{s.n}</b>{String(s.t).includes('станц') ? <span class="live-dot" aria-hidden="true"></span> : null}<span>{s.t}</span>{String(s.t).includes('станц') ? <small class="fresh">Обновлено: ноябрь 2026</small> : null}</div>))}
    </div></section><section class="sec sec-alt"><div class="wrap">
        <h2>Как это работает: одна схема</h2>
        <p class="lead">Станция РФ (Type 2 / CCS2) → адаптер → ваш EV с разъёмом GB/T. Дальше — обычная зарядка.</p>
        <div class="gbt-flow" aria-hidden="true">
          <div class="node"><svg viewBox="0 0 34 34" fill="none"><rect x="8" y="3" width="14" height="21" rx="3" stroke="#0161EF" stroke-width="2" fill="rgba(1,97,239,.08)"/><path d="M15 8 l-3 5 h4 l-3 5" stroke="#0161EF" stroke-width="2" fill="none" stroke-linecap="round"/><path d="M11 24 v7 h12 M23 24 v-4 c0-2.5 3-2.5 3 0 v11" stroke="#0161EF" stroke-width="2" fill="none" stroke-linecap="round"/></svg><b>Станция РФ</b><span>Type 2 / CCS2</span></div>
          <span class="arrow">→</span>
          <div class="node"><svg viewBox="0 0 34 34" fill="none"><rect x="5" y="10" width="24" height="12" rx="4" stroke="#0161EF" stroke-width="2" fill="rgba(1,97,239,.08)"/><circle cx="12" cy="16" r="2.2" fill="#0161EF"/><circle cx="22" cy="16" r="2.2" fill="#0161EF"/><path d="M10 22 v7 M24 22 v7" stroke="#0161EF" stroke-width="2" stroke-linecap="round"/></svg><b>Адаптер</b><span>переходник</span></div>
          <span class="arrow">→</span>
          <div class="node"><svg viewBox="0 0 34 34" fill="none"><path d="M5 22 l2-7 q1-3 5-3 h12 q4 0 6 3 l2 7" stroke="#0161EF" stroke-width="2" fill="rgba(1,97,239,.08)" stroke-linecap="round"/><path d="M4 22 h26 v5 h-4 M4 22 v5 h4" stroke="#0161EF" stroke-width="2" fill="none" stroke-linecap="round"/><circle cx="10" cy="27" r="3" stroke="#0161EF" stroke-width="2"/><circle cx="24" cy="27" r="3" stroke="#0161EF" stroke-width="2"/></svg><b>Ваш EV</b><span>разъём GB/T</span></div>
        </div>
      </div></section><section class="sec"><div class="wrap">
        <h2>Популярные модели в каталоге</h2>
        <p class="lead">145 моделей в базе: у каждой — разъём, годы, комплект зарядки и таблица совместимости.</p>
        <div class="mfilter" role="group" aria-label="Фильтр по бренду" data-mfilter>
          {['Все'].concat([...new Set(POP.map((m) => m.brand))]).map((br) => (
            <button class={br === 'Все' ? 'fchip on' : 'fchip'} type="button" data-brand={br}>{br}</button>
          ))}
        </div>
        <div class="bgrid as-slider" style="margin-top:20px" data-mcards>
          {POP.map((mo) => (
            <a class="card" href={'/models/' + mo.slug + '/'} data-brand={mo.brand}>
              <span class="tag">{mo.port}</span>
              <h3 class="bh" style="font-size:16.5px;margin:10px 0 6px">{mo.name}</h3>
              <p style="margin:0;font-size:14px;color:var(--txt-muted)">{mo.years}</p>
            </a>
          ))}
        </div>
        
        <div style="margin-top:20px"><a class="btn btn-ghost" href="/models/">Все 145 моделей</a></div>
      </div></section><section class="sec sec-alt"><div class="wrap"><h2>База знаний: опыт выживания EV в РФ</h2><p class="lead" style="margin-bottom:36px">Реальные кейсы и свежие разборы — без маркетинга.</p><div class="cards">{pains.map((c) =>(
          <a class="card" href={c.href}><svg class="evicon" viewBox="0 0 120 64" aria-hidden="true"><path d="M8 46 L10 34 Q12 28 20 27 L32 26 L42 16 Q45 13 52 13 L82 13 Q89 13 94 17 L104 26 L112 28 Q116 30 116 35 L115 46" stroke="#0161EF" stroke-width="2.5" fill="rgba(1,97,239,.06)" stroke-linecap="round"/><circle cx="26" cy="48" r="8" stroke="#0161EF" stroke-width="2.5" fill="none"/><circle cx="96" cy="48" r="8" stroke="#0161EF" stroke-width="2.5" fill="none"/><circle class="zone" cx={c.zx} cy={c.zy} r="7" fill="#4A9EF0"/></svg><span class="ico">{c.ico}</span><h3>{c.h}</h3><p>{c.p}</p></a>))}
      </div>
        <h3 style="margin:38px 0 16px">Свежие разборы</h3>
        <div class="bgrid">{latest.map((a) =>(
          <a class="bcard" href={`/blog/${a.slug}`}><span class="tag">{a.category || 'Блог'}</span><h3>{a.title}</h3><p>{shortLine(a.desc)}</p></a>))}
        </div>
        <div style="margin-top:20px"><a class="btn btn-ghost" href="/blog/">Все статьи</a></div>
      </div></section><section class="sec"><div class="wrap"><h2>Частые вопросы</h2><div class="faqbox glass-panel" style="margin-top:24px;max-width:820px">{faq.map((f) =>(
          <details open={f.q.startsWith('У моей модели')}><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div></div></section><section class="sec-alt"><div class="wrap" style="max-width:808px"><h2>Справочник: развёрнутые руководства</h2><p class="lead">Развёрнутые руководства — раскрываются по клику. Тексты остаются в разметке: для поисковиков и ИИ-поиска.</p><details class="seo-faq"><summary>Что такое адаптер GB/T и зачем он нужен</summary><p>Адаптер GB/T — это переходник, который соединяет китайский разъём зарядки вашего электромобиля со станциями Type 2 или CCS2, работающими в России. GB/T — стандарт разъёмов, принятый в Китае: малый (AC, до 7 кВт) и большой (DC, быстрая зарядка). Почти все электромобили, привезённые из Китая, используют именно эти разъёмы, а российские станции — европейский Type 2 и CCS2. Без адаптера такой автомобиль не зарядить на обычной станции; с адаптером — зарядка идёт на штатной мощности, кроме сверхбыстрых режимов, где нужен следующий по мощности переходник. В каталоге «Запас хода» указан разъём каждой из 145 моделей и подобранный под неё комплект: адаптер, кабель и держатель. Решение для конкретной модели — на странице модели: там же таблица совместимости и сценарий зарядки.</p></details><details class="seo-faq"><summary>Как зарядить китайский электромобиль на станции Type 2?</summary><p>Алгоритм простой: определите разъём модели, возьмите адаптер GB/T → Type 2 (или GB/T → CCS2 для быстрой зарядки), подключите и запустите сессию через приложение оператора станции. Мощность ограничена узким местом цепочки: бортовым зарядом автомобиля (обычно 3–11 кВт на AC) и мощностью адаптера. Быстрые станции DC для GB/T-автомобилей работают только через большой разъём адаптера; если станция отдаёт больше 60 кВт, уточните допустимый предел переходника в его описании. Каждая страница модели на «Запас хода» содержит решение под ваш разъём: адаптер, кабель, держатель — с деталями установки и обхвата станций рядом с вами на карте.</p></details><details class="seo-faq"><summary>Сколько стоит зарядка электромобиля в России?</summary><p>Стоимость складывается из тарифа точки зарядки и расхода машины. Дома тариф электричества ваш — обычно это самый дешёвый сценарий; на общественных станциях тариф устанавливает сеть, и на трассах он выше, чем в городе. Калькулятор на сайте считает цену за 100 км и за месяц: задайте расход, пробег и сценарий — сравнение с бензином вы получите сразу же. Тарифы операторов по-разному устроены: часть берёт за кВт·ч, часть — за минуту сессии, у части есть ночные ставки. Отдельный разбор тарифов и бесплатных трасс — в статье «Бесплатные трассы и парковка для EV» и в калькуляторе, где сценарии уже свёрстаны под российские условия.</p></details></div></section><style is:global>
/* === HERO v2: фото-фон, крупный текст, анимация (только главная) === */
.zh-hero-big{position:relative;background:#060a0e;padding:120px 0 96px;overflow:hidden}
.zh-hero-big::before{content:'';position:absolute;inset:0;background-image:linear-gradient(100deg,rgba(6,9,12,.92) 0%,rgba(6,9,12,.78) 42%,rgba(6,9,12,.38) 100%),url('/assets/img/hero-ev.webp');background-size:cover;background-position:center 30%;opacity:.92;z-index:0}
.zh-hero-big .wrap{position:relative;z-index:1}
.zh-hero-big h1{font-size:clamp(40px,7.5vw,72px)!important;line-height:1.06;letter-spacing:-.02em;max-width:min(900px,96%)!important;text-wrap:balance}
.zh-hero-big h1 span{color:var(--gold);white-space:nowrap}
.zh-hero-big p{color:rgba(233,239,246,.85);font-size:clamp(19px,2.6vw,32px)!important;line-height:1.42;max-width:min(760px,96%)!important;margin-bottom:0;text-shadow:0 1px 14px rgba(0,0,0,.45)}
.zh-hero-big .badge{font-size:13px;letter-spacing:.12em}
/* появление текста */
.zh-hero-big .badge,.zh-hero-big h1,.zh-hero-big p{animation:zhRise .85s cubic-bezier(.22,.61,.36,1) both}
.zh-hero-big .badge{animation-delay:.05s}
.zh-hero-big h1{animation-delay:.18s}
.zh-hero-big p{animation-delay:.4s}
.zh-hero-big h1 span{animation:zhGold 1.6s ease .9s both}
@keyframes zhRise{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:none}}
@keyframes zhGold{from{text-shadow:none}to{text-shadow:0 0 26px rgba(212,175,55,.35)}}
@media (prefers-reduced-motion:reduce){.zh-hero-big .badge,.zh-hero-big h1,.zh-hero-big p,.zh-hero-big h1 span{animation:none}}
@media (max-width:760px){
  .zh-hero-big{padding:88px 0 72px}
  .zh-hero-big::before{background-image:linear-gradient(180deg,rgba(6,9,12,.9) 0%,rgba(6,9,12,.84) 55%,rgba(6,9,12,.55) 100%),url('/assets/img/hero-ev.webp');background-position:center 22%}
  .zh-hero-big h1 span{white-space:normal}
}
</style></ZhLayout>