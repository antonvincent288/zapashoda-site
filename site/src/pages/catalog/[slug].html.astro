<ZhLayout title={"«"+d.title+"» — купить | Запас хода"} description={String(d.lead||d.desc||"").slice(0,160)} jsonld={[prodLd, faqLd, crumbLd].filter(Boolean)}>
  <div class="wrap960">
    <div class="crumb" style="margin-top:18px"><a href="/" style="color:#7d8794;text-decoration:none">Главная</a> / <a href="/catalog/" style="color:#7d8794;text-decoration:none">Каталог</a> / <b>{d.title}</b></div>
    <Fragment set:html={heroHtml} />
    <div class="tabs">
      <a class="tab" href="#desc">Описание</a>
      <a class="tab" href="#specs">Характеристики</a>
      <a class="tab" href="#compat">Совместимость</a>
      <a class="tab" href="#limits">Честные ограничения</a>
      <a class="tab" href="#bundle">С этим покупают</a>
      <a class="tab" href="#reviews">Отзывы</a>
    </div>
    <Fragment set:html={descHtml} />
    <Fragment set:html={specsHtml} />
    <Fragment set:html={compatHtml} />
    <Fragment set:html={limHtml} />
    <Fragment set:html={bundleHtml} />
    <Fragment set:html={rvHtml} />
    <Fragment set:html={faqHtml} />
    <div style="margin-top:34px"><a class="btn btn-ghost" style="text-decoration:none" href="/quiz/">Подобрать под свою модель →</a></div>
    <OrderForm model={d.title} />
    <script is:inline set:html={ofScript} />
    <script is:inline set:html={jsCode} />
    <script is:inline set:html={rvCode} />
  </div>
  <style is:inline set:html={cssCode} />
</ZhLayout>
