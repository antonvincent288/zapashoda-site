---
export async function getStaticPaths() {
  const src = (await import('../../data/sku.json')).default;
  return (src.items || []).map((d) => ({ params: { slug: d.slug }, props: { d } }));
}
const { d } = Astro.props;
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"><title>{d.title} — Запас хода</title><link rel="canonical" href={`/catalog/${d.slug}/`}/><meta name="robots" content="noindex,follow"/><meta http-equiv="refresh" content={`0;url=/catalog/${d.slug}/`}/></head><body><script is:inline define:vars={{ slug: d.slug }}>location.replace('/catalog/' + slug + '/');</script><noscript><p>Страница переехала: <a href={`/catalog/${d.slug}/`}>{d.title}</a></p></noscript></body></html>