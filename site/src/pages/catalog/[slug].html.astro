const cssCode = '\n\n*{box-sizing:border-box;margin:0;padding:0}\n\n.wrap{max-width:1080px;margin:0 auto;padding:0 20px}\n.site-header{position:sticky;top:0;z-index:100;background:rgba(11,11,13,.92);border-bottom:1px solid rgba(255,255,255,.07)}\n.hwrap{display:flex;gap:18px;align-items:center;height:62px}\n.logo{display:flex;align-items:center;gap:8px;text-decoration:none;color:#f5f5f7;font-weight:800;font-size:17px;letter-spacing:-.01em;white-space:nowrap}\n.logo b{display:flex}\n.logo-ev{font-size:10px;font-weight:800;letter-spacing:.1em;color:#5aa9ff;border:1px solid rgba(90,169,255,.45);border-radius:6px;padding:2px 5px}\n.hsearch input{background:#15161c;border:1px solid rgba(255,255,255,.12);border-radius:10px;color:#f5f5f7;font:14px/1.4 inherit;padding:9px 14px;width:200px;outline:none}\n.hsearch input::placeholder{color:#7d8794}\n#nav{display:flex;gap:4px;align-items:center;margin-left:auto}\n#nav a{color:#aeb6c2;text-decoration:none;font-size:14.5px;font-weight:600;padding:8px 11px;border-radius:9px;white-space:nowrap}\n#nav a.on{color:#5aa9ff;background:rgba(90,169,255,.1)}\n#nav a.nav-b2b{color:#5aa9ff;border:1px solid rgba(90,169,255,.4)}\n.menu-btn{display:none;background:#15161c;border:1px solid rgba(255,255,255,.12);border-radius:9px;padding:10px;cursor:pointer}\n.crv{vertical-align:middle;margin-left:2px}\n.menu-btn span{display:block;width:16px;height:2px;background:#f5f5f7;margin:3px 0;border-radius:2px}\n.crumb{color:#7d8794;font-size:13px;margin:22px 0 8px}\n.crumb b{color:#f5f5f7}\nh1{font-size:28px;letter-spacing:-.02em;line-height:1.2;color:#f5f5f7}\n.hero{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:30px;margin-top:18px;align-items:start}\n.gal{display:grid;gap:10px}\n.ph{height:150px;border-radius:14px;background:radial-gradient(90% 100% at 50% 15%,#1d2230,#12151c);border:1px solid rgba(255,255,255,.07);display:flex;align-items:center;justify-content:center}\n.ph.main{height:290px}\n.ph svg{width:64px;height:64px;opaci