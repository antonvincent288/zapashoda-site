const cssCode = ".tabs{position:sticky;top:0;z-index:40;background:rgba(11,11,13,.95);display:flex;gap:8px;overflow-x:auto;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.07);margin-top:18px}.tabs a.tab{white-space:nowrap;color:#aeb6c2;text-decoration:none;font-size:13.5px;font-weight:600;padding:8px 13px;border-radius:9px;border:1px solid rgba(255,255,255,.12)}.tabs a.tab:hover{color:#f5f5f7;border-color:rgba(90,169,255,.5)}.wrap960{max-width:1080px;margin:0 auto;padding:0 20px}.crumb{color:#7d8794;font-size:13px}.crumb b{color:#f5f5f7}"
