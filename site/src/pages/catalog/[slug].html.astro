color:#aeb6c2;text-decoration:none}\n.tab:hover{border-color:#5aa9ff;color:#f5f5f7}\nsection{background:#151518;border:1px solid rgba(255,255,255,.07);border-radius:16px;padding:26px;margin-top:26px;box-shadow:0 10px 30px rgba(0,0,0,.3)}\nsection h2{font-size:20px;letter-spacing:-.01em;margin-bottom:12px;color:#f5f5f7}\nsection p{color:#c6cdd7;font-size:15px;margin:8px 0}\ntable{width:100%;border-collapse:collapse;margin-top:12px;font-size:14px}\nth,td{text-align:left;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,.07);vertical-align:top}\nth{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:#7d8794}\ntd.us{font-weight:600;color:#4ade80}\ntd.bad{font-weight:600;color:#f87171}\ntd.pl{color:#f5f5f7}\n.lim{margin:6px 0 0 0;padding:0;list-style:none}\n.lim li{margin:0;padding:12px 0 12px 32px;font-size:15px;color:#c6cdd7;position:relative;border-bottom:1px dashed rgba(255,255,255,.12)}\n.lim li:last-child{border-bottom:none}\n.lim li b{color:#f5f5f7}\n.lim li:before{content:"!";position:absolute;left:4px;top:15px;width:17px;height:17px;border-radius:50%;background:rgba(255,176,32,.12);border:1px solid rgba(255,176,32,.4);font-weight:800;font-size:12px;color:#ffb020;text-align:center;line-height:16px}\n.mini{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:14px}\n.mini article{border:1px solid rgba(255,255,255,.07);border-radius:14px;padding:16px;background:#15161c}\n.mini .n{font-weight:700;font-size:14px;color:#f5f5f7}\n.mini .d{font-size:12.5px;color:#aeb6c2;margin-top:5px}\n.mini .btn-sm{margin-top:10px;width:100%;padding:9px;font-size:13.5px}\n.honest{background:rgba(255,176,32,.12);border:1px solid rgba(255,176,32,.4);border-radius:12px;padding:13px 15px;font-size:14px;color:#ffd48a;margin-top:12px;line-height:1.5}\n.invite{background:rgba(34,197,94,.08);border:1px dashed rgba(34,197,94,.4);border-radius:12px;padding:14px 16px;font-size:14.5px;color:#c6cdd7;line-height:1.55}\n.invite b{color:#4ade80}\n.topbar{position:fixed;top:0;left:0;right:0;z-index:60;background:rgba(21,21,24,.96);border-bottom:1px solid rgba(255,255,255,.12);box-shadow:0 10px 30px rgba(0,0,0,.5);transform:translateY(-110%);transition:transform .25s}\n.topbar.on{transform:translateY(0)}\n.topbar .inner{max-width:1080px;margin:0 auto;padding:10px 20px;display:flex;gap:12px;align-items:center}\n.topbar .n{font-weight:700;font-size:14.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.topbar .p{margin-left:auto;font-size:14px;font-weight:700;white-space:nowrap;color:#f5f5f7}\n.compat{display:flex;gap:12px;align-items:center;flex-wrap:wrap;background:#15161c;border:1px solid rgba(255,255,255,.12);border-radius:12px;padding:14px;margin-top:16px}\n.compat select{padding:9px 12px;border:1px solid rgba(255,255,255,.12);border-radius:10px;font:14px/1.4 inherit;color:#f5f5f7;background:#1b1c23;max-width:260px}\n.compat span{flex:1;min-width:230px}\n.site-footer{margin-top:60px;border-top:1px solid rgba(255,255,255,.07);background:#0a0a0c;padding:44px 0 28px}\n.fgrid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.2fr;gap:26px}\n.fgrid .logo{color:#fff}\n.fdesc{margin-top:14px;font-size:13.5px;color:#aeb6c2;max-width:300px}\n.fgrid h4{font-size:14px;color:#f5f5f7;margin-bottom:10px}\n.fgrid a{display:block;color:#aeb6c2;text-decoration:none;font-size:13.5px;padding:4px 0}\n.fgrid a:hover{color:#5aa9ff}\n.copy{display:flex;gap:16px;justify-content:space-between;flex-wrap:wrap;border-top:1px solid rgba(255,255,255,.07);margin-top:26px;padding-top:18px;font-size:12.5px;color:#7d8794}\n@media(max-width:960px){#nav{display:none}.menu-btn{display:block}.hero{grid-template-columns:1fr}.specgrid{grid-template-columns:1fr 1fr}.mini{grid-template-columns:1fr}.fgrid{grid-template-columns:1fr 1fr}}\n@media(max-width:560px){.fgrid{grid-template-columns:1fr}.hsearch{display:none}}\n\n.ac{position:relative;flex:1 1 280px;min-width:240px}\n.txt2{width:100%;background:#1b1c23;border:1px solid rgba(255,255,255,.12);border-radius:10px;padding:10px 14px;font:15px/1.4 inherit;color:#f5f5f7;outline:none}\n.txt2::placeholder{color:#7d8794}\n.ac-list{position:absolute;top:calc(100% + 6px);left:0;right:0;background:#15161c;border:1px solid rgba(255,255,255,.12);border-radius:12px;z-index:50;display:none;max-height:264px;overflow:auto;box-shadow:0 18px 44px rgba(0,0,0,.55)}\n.ac-list.on{display:block}\n.ac-item{padding:9px 12px;cursor:pointer;font-size:14.5px;color:#e5ecf6}\n.ac-item small{color:#7d8794;margin-left:7px}\n.ac-item:hover{background:rgba(90,169,255,.09)}\n.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}\n.pchip{border:1px solid rgba(255,255,255,.12);background:#15161c;border-radius:99px;padding:7px 13px;font-size:13.5px;font-weight:600;color:#aeb6c2;cursor:pointer;white-space:nowrap}\n.pchip:hover,.pchip.on{border-color:#5aa9ff;color:#f5f5f7}\n.ic{vertical-align:middle}\n.inl{display:inline-block;margin-right:4px;transform:translateY(2px)}\n.cta-plate{margin-top:16px;display:flex;gap:14px;align-items:center;justify-content:space-between;flex-wrap:wrap;background:rgba(90,169,255,.08);border:1px solid rgba(90,169,255,.4);border-radius:14px;padding:14px 16px}\n.cta-plate .cp-t{font-size:14px;color:#aeb6c2;max-width:520px}\n\n\n\n\n.fb-row{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-top:10px}\n.fb-row .btn{padding:8px 13px;font-size:13px}\n.fb-row a{text-decoration:none}\n\n.tabs{position:sticky;top:0;z-index:40;background:rgba(11,11,13,.95);display:flex;gap:8px;overflow-x:auto;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.07)}\n.tabs a.tab{white-space:nowrap;color:#aeb6c2;text-decoration:none;font-size:13.5px;font-weight:600;padding:8px 13px;border-radius:9px;border:1px solid rgba(255,255,255,.12)}\n.tabs a.tab:hover{color:#f5f5f7;border-color:rgba(90,169,255,.5)}\n.wrap960{max-width:1080px;margin:0 auto;padding:0 20px}\n';
