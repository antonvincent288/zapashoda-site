---
import ZhLayout from '../../layouts/ZhLayout.astro';
import OrderForm from '../../components/OrderForm.astro';
import { priceOut, PRICES_ON } from '../../lib/prices';
import NAMES from '../../data/model_names.json';
export async function getStaticPaths() {
  const src = (await import('../../data/sku.json')).default;
  const ofp = (await import('../../data/of_products.json')).default;
  const map = {};
  (ofp || []).forEach((p) => { map[p.slug] = p; });
  return (src.items || []).map((d) => ({ params: { slug: d.slug }, props: { d, of: map[d.slug] } }));
}
const { d, of } = Astro.props;
const ofpAll = (await import('../../data/of_products.json')).default;
const skuAll = (await import('../../data/sku.json')).default;
const skuMap = {};
(skuAll.items || []).forEach((x) => { skuMap[x.slug] = x; });
const relProds = (d.related || []).map((r) => ({ r, s: skuMap[r.href.replace('/catalog/','').replace('.html','')] })).filter((x) => x.s);
const fit = (d.fit || []).filter((f) => typeof f === 'object');
const faqLd = d.faq && d.faq.length ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) } : null;
const prodLd = { '@context': 'https://schema.org', '@type': 'Product', name: d.title, description: d.desc, image: d.image ? 'https://zapashoda-ev.ru' + d.image : undefined, offers: PRICES_ON ? { '@type': 'Offer', price: String(d.price), priceCurrency: 'RUB', availability: 'https://schema.org/InStock' } : undefined };
const crumbLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [ { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://zapashoda-ev.ru/' }, { '@type': 'ListItem', position: 2, name: 'Каталог', item: 'https://zapashoda-ev.ru/catalog/' }, { '@type': 'ListItem', position: 3, name: d.title, item: 'https://zapashoda-ev.ru/catalog/' + d.slug + '.html' } ] };
const ofScript = 'var OF_MODEL=' + JSON.stringify(d.title) + ';var OF_PRODUCTS=' + JSON.stringify(ofpAll) + ';var MODEL_NAMES=' + JSON.stringify(NAMES) + ';';
---
<ZhLayout og={d.image || undefined} title={d.title + ' — купить | Запас хода'} description={d.desc || (PRICES_ON ? (d.title + ' — купить по РРЦ ' + d.price + ' ₽. Совместимость и подбор под модель — «Запас хода».') : (d.title + ' — купить. Совместимость и подбор под модель — «Запас хода».'))} jsonld={[prodLd, faqLd, crumbLd].filter(Boolean)}>
  <section class="sec">
    <div class="wrap sk-wrap">
      <div class="crumbs"><a href="/">Главная</a> / <a href="/catalog/">Каталог</a> / {d.title}</div>
      <h1>{d.title}</h1>
      <div class="sk-hero">
        <div class="sk-imgcol">
          {d.image && <div class="sk-imgbox"><img src={d.image} alt={d.title} loading="eager" /></div>}
        </div>
        <div class="sk-buy">
          <p class="lead" style="margin:0">{d.lead}</p>
          {d.spec.slice(0, 3).map(([k, v]) => <span class="tag">{k}: {v}</span>)}
          <b class="sk-price">{priceOut(d.price)}</b>
          <button class="btn btn-gold sk-cta" type="button" onclick={`ofAdd(${of ? of.id : 0},this)`}>В заявку</button>
          <a class="btn btn-ghost sk-cta2" style="text-decoration:none" href="/catalog/#order-form">Оформить заявку →</a>
          <p class="sk-trust">Оплата при получении · Заберёте у партнёра-дилера в вашем городе</p>
        </div>
      </div>
      {d.spec.length > 0 && (
        <>
          <h2 style="margin-top:44px">Характеристики</h2>
          <table class="spec" style="margin-top:14px">
            <tbody>{d.spec.map(([k, v]) => <tr><td>{k}</td><td><b>{v}</b></td></tr>)}</tbody>
          </table>
        </>
      )}
      {fit.length > 0 && (
        <>
          <h2 style="margin-top:44px">Подходит для</h2>
          <p style="color:var(--txt-muted);font-size:15px;margin-top:10px">Проверьте совместимость по разъёмам — на странице каждой модели:</p>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:14px">
            {fit.slice(0, 24).map((f) => <a class="chip" style="text-decoration:none" href={f.href.replace('.html', '/')}>{f.title}</a>)}
            {fit.length > 24 && <a class="chip" style="text-decoration:none" href="/catalog/">+ ещё {fit.length - 24} моделей — подбор в каталоге</a>}
          </div>
        </>
      )}
      {d.faq.length > 0 && (
        <>
          <h2 style="margin-top:44px">Частые вопросы</h2>
          <div class="faqbox" style="margin-top:14px">
            {d.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
          </div>
        </>
      )}
      {relProds.length > 0 && (
        <>
          <h2 style="margin-top:44px">Похожие товары</h2>
          <div class="sk-rel" style="margin-top:14px">
            {relProds.map(({ r, s }) => (
              <a class="sk-relcard" href={r.href}>
                {s.image && <img src={s.image} alt={r.title} loading="lazy" decoding="async" />}
                <span class="sk-reltitle">{r.title}</span>
                <span class="sk-relprice">{priceOut(s.price)}</span>
              </a>
            ))}
          </div>
        </>
      )}
      <div style="margin-top:40px">
        <a class="btn btn-ghost" style="text-decoration:none" href="/quiz/">Подобрать под свою модель →</a>
      </div>
<section class="rv-sec" style="margin-top:40px;background:var(--bg2);border:1px solid var(--line);border-radius:24px;padding:28px" data-sku={d.slug} data-title={d.title}>
      <h2 style="margin-bottom:6px">Отзыв о товаре</h2>
      <p style="color:var(--txt-muted);font-size:14px;max-width:640px">Купили через наших партнёров? Расскажите, как комплект показал себя. Отзывы публикуем после проверки — честные в обе стороны, без модерации под звёзды.</p>
      <div class="rv-stars" role="radiogroup" aria-label="Оценка от 1 до 5">
        <button type="button" class="rv-star" data-v="1" role="radio" aria-checked="false" aria-label="1 из 5">1</button>
        <button type="button" class="rv-star" data-v="2" role="radio" aria-checked="false" aria-label="2 из 5">2</button>
        <button type="button" class="rv-star" data-v="3" role="radio" aria-checked="false" aria-label="3 из 5">3</button>
        <button type="button" class="rv-star" data-v="4" role="radio" aria-checked="false" aria-label="4 из 5">4</button>
        <button type="button" class="rv-star" data-v="5" role="radio" aria-checked="false" aria-label="5 из 5">5</button>
      </div>
      <input name="rv-name" placeholder="Имя (можно не указывать)" aria-label="Имя" class="of-inp" style="margin-top:12px" />
      <textarea name="rv-text" rows="3" placeholder="Как комплект показал себя: установка, зарядка, зима" aria-label="Текст отзыва" class="of-inp" style="margin-top:10px"></textarea>
      <label style="display:block;font-size:12.5px;color:var(--txt-muted);margin-top:10px"><input type="checkbox" required class="rv-consent" style="margin-right:7px;vertical-align:middle" />Я согласен на обработку персональных данных — <a href="/privacy/" target="_blank" style="color:#1d4ed8;text-decoration:underline">Политика конфиденциальности</a></label>
      <button class="btn btn-gold rv-send" type="button" style="width:100%;margin-top:12px">Отправить отзыв</button>
      <div class="rv-status" style="margin-top:8px"></div>
    </section>
    <style is:inline>
      .rv-stars{display:flex;gap:8px;margin-top:14px}
      .rv-star{width:40px;height:40px;border-radius:12px;border:1.5px solid var(--line);background:var(--bg);color:var(--txt);font-size:15px;font-weight:700;cursor:pointer;min-height:44px;transition:all .18s}
      .rv-star:hover{border-color:rgba(77,155,245,.6)}
      .rv-star.on{background:var(--gold);border-color:var(--gold);color:#0b0b0d}
    </style>
    <script is:inline>
    (function(){
      var sec=document.querySelector('.rv-sec');if(!sec)return;
      var stars=sec.querySelectorAll('.rv-star'),r=0;
      stars.forEach(function(b){b.addEventListener('click',function(){r=+b.getAttribute('data-v');stars.forEach(function(x){var on=(x===b);x.classList.toggle('on',on);x.setAttribute('aria-checked',on?'true':'false')})})});
      var st=sec.querySelector('.rv-status');
      function msg(html){if(st)st.innerHTML=html}
      sec.querySelector('.rv-send').addEventListener('click',function(){
        var text=sec.querySelector('[name=rv-text]').value.trim();
        var cons=sec.querySelector('.rv-consent').checked;
        if(!r){msg('<p style="color:#f87171;font-size:13.5px;margin:0">Поставьте оценку от 1 до 5</p>');return}
        if(!text){msg('<p style="color:#f87171;font-size:13.5px;margin:0">Добавьте пару слов об опыте</p>');return}
        if(!cons){msg('<p style="color:#f87171;font-size:13.5px;margin:0">Нужно согласие на обработку данных</p>');return}
        var gas=(window.ZS_LEAD_CFG&&window.ZS_LEAD_CFG.gas)||window.OF_GAS||'';
        if(!gas){msg('<p style="color:#f87171;font-size:13.5px;margin:0">Не удалось отправить — напишите отзыв в Telegram @zapashoda_ev_bot</p>');return}
        msg('<p style="color:var(--txt-muted);font-size:14px;margin:0">Отправляем…</p>');
        var d={t:'review',sku:sec.getAttribute('data-sku')||'',sku_title:sec.getAttribute('data-title')||'',model:(new URLSearchParams(location.search).get('model')||''),rating:r,name:sec.querySelector('[name=rv-name]').value.trim(),text:text,consent:'yes',consent_ts:new Date().toISOString(),policy_version:'1.0',page:location.pathname};
        fetch(gas,{method:'POST',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(d)}).then(function(resp){if(!resp.ok)throw new Error('http '+resp.status);return resp.json()}).then(function(){
          sec.querySelector('[name=rv-text]').value='';
          sec.querySelector('[name=rv-name]').value='';
          stars.forEach(function(x){x.classList.remove('on');x.setAttribute('aria-checked','false')});r=0;
          msg('<p style="background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.5);border-radius:12px;padding:12px 14px;font-size:14px;color:var(--txt);margin:0">Спасибо! Отзыв отправлен — покажем после проверки.</p>');
          if(window.ym&&window.YM_ID){try{ym(window.YM_ID,'reachGoal','review_send')}catch(e2){}}
        }).catch(function(){msg('<p style="color:#f87171;font-size:13.5px;margin:0">Не ушло — напишите отзыв в Telegram @zapashoda_ev_bot</p>')});
      });
    })();
    </script>
          <OrderForm model={d.title} />
    <script is:inline>
    (function(){
      var q=new URLSearchParams(location.search).get('model');
      if(!q) return;
      var nm=(window.MODEL_NAMES||{})[q];
      if(!nm) return;
      try{localStorage.setItem('zs_car',q)}catch(e){}
      var box=document.querySelector('.sk-buy');
      if(!box) return;
      var b=document.createElement('div');
      b.style.cssText='margin-top:4px;font-size:13.5px;color:var(--txt-muted);display:flex;gap:8px;align-items:center';
      b.innerHTML='<span style="width:7px;height:7px;border-radius:99px;background:#22c55e;flex-shrink:0;display:inline-block"></span>Подобрано для: <b style="color:var(--txt)">'+nm+'</b>';
      box.insertBefore(b, box.firstChild);
    })();
    </script>
    </div>
  </section>
  <style is:inline>
    .sk-wrap{max-width:960px}
    .sk-hero{display:grid;grid-template-columns:400px minmax(0,1fr);gap:36px;align-items:start;margin-top:10px}
    .sk-imgbox{background:linear-gradient(180deg,#fff 0%,#f2f3f5 100%);border:1px solid var(--line);border-radius:16px;padding:14px;display:flex;align-items:center;justify-content:center;min-height:320px}
    .sk-imgbox img{max-width:100%;max-height:340px;object-fit:contain;border-radius:8px}
    .sk-buy{display:flex;flex-direction:column;align-items:flex-start;gap:14px}
    .sk-buy .lead{font-size:16.5px;line-height:1.5;color:var(--txt-muted)}
    .sk-price{font-size:34px;color:var(--gold);line-height:1;margin-top:4px}
    .sk-cta{font-size:16px;padding:14px 28px;width:100%;text-align:center}
    .sk-cta2{width:100%;text-align:center}
    .sk-trust{font-size:13px;color:var(--txt-muted);margin:2px 0 0;display:flex;gap:8px;align-items:center}
    .sk-trust::before{content:'';width:7px;height:7px;border-radius:999px;background:#22c55e;flex-shrink:0}
    .sk-rel{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
    .sk-relcard{display:flex;flex-direction:column;gap:8px;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px;text-decoration:none;transition:border-color .18s,transform .18s}
    .sk-relcard:hover{border-color:rgba(77,155,245,.45);transform:translateY(-2px)}
    .sk-relcard img{width:100%;height:110px;object-fit:contain;background:linear-gradient(180deg,#fff 0%,#f2f3f5 100%);border-radius:10px;padding:6px}
    .sk-reltitle{color:var(--head);font-weight:600;font-size:14px;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .sk-relprice{color:var(--gold);font-weight:700;font-size:15px;margin-top:auto}
    @media (max-width:860px){.sk-hero{grid-template-columns:1fr;gap:20px}.sk-imgbox{min-height:0}.sk-cta,.sk-cta2{width:auto}}
  </style>
  <script is:inline set:html={ofScript} />
</ZhLayout>
