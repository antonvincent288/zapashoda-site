const rvCode = '(function(){\n  var sec=document.querySelector(\'.rv-sec\'); if(!sec) return;\n  var form=sec.querySelector(\'form\'); if(!form) return;\n  var done=sec.querySelector(\'.done\');\n  form.addEventListener(\'submit\',function(ev){\n    ev.preventDefault();\n    var sel=form.querySelector(\'[name=rv-model]\');\n    var mile=form.querySelector(\'[name=rv-mileage]\');\n    var tx=form.querySelector(\'[name=rv-text]\');\n    var con=form.querySelector(\'.rv-consent\');\n    var text=(tx&&tx.value.trim())||\'\';\n    if(!text){ if(done){done.style.display=\'block\';done.textContent=\'Напишите пару слов об опыте — так отзывы полезнее.\';} return; }\n    var gas=(window.ZS_LEAD_CFG&&window.ZS_LEAD_CFG.gas)||window.OF_GAS||\'\';\n    if(!gas){ if(done){done.style.display=\'block\';done.textContent=\'Приёмник недоступен — напишите в Telegram @zapashoda_ev_bot.\';} return; }\n    if(con&&!con.checked){ if(done){done.style.display=\'block\';done.textContent=\'Отметьте согласие на публикацию.\';} return; }\n    var btn=form.querySelector(\'button[type=submit]\'); if(btn){btn.disabled=true;btn.textContent=\'Отправляем…\';}\n    var fd=new FormData();\n    fd.append(\'t\',\'review\');\n    fd.append(\'sku\',sec.getAttribute(\'data-sku\')||\'\');\n    fd.append(\'sku_title\',sec.getAttribute(\'data-title\')||\'\');\n    fd.append(\'model\',(sel&&sel.value)||\'\');\n    fd.append(\'mileage\',(mile&&parseInt(mile.value,10))||\'\');\n    fd.append(\'text\',text);\n    fd.append(\'page\',location.pathname);\n    fd.append(\'ts\',new Date().toISOString());\n    fetch(gas,{method:\'POST\',body:fd,redirect:\'follow\'}).then(function(r){return r.text();}).then(function(){\n      if(done){done.style.display=\'block\';done.textContent=\'Спасибо! Отзыв передан редактору — опубликуем с маркой авто и пробегом, без чистки.\';}\n      Array.prototype.forEach.call(form.querySelectorAll(\'textarea,input\'),function(el){ if(el.type!==\'checkbox\') el.value=\'\'; });\n      if(btn){btn.disabled=false;btn.textContent=\'Отправить отзыв\';}\n    }).catch(function(){\n      if(btn){btn.disabled=false;btn.textContent=\'Отправить отзыв\';}\n      if(done){done.style.display=\'block\';done.textContent=\'Не удалось отправить — напишите в Telegram @zapashoda_ev_bot.\';}\n    });\n  });\n})();';
const cssCode = "\n:root{--bg:#0b0b0d;--panel:#151518;--panel2:#15161c;--card-hi:#1b1c23;--line:#ffffff12;--line2:#ffffff1f;\n--txt:#f5f5f7;--mut:#aeb6c2;--faint:#7d8794;--acc:#5aa9ff;--acc2:#0161ef;--green:#22c55e;\n--okbg:rgba(34,197,94,.13);--oktx:#4ade80;--okbd:rgba(34,197,94,.4);\n--nbgh:rgba(255,255,255,.06);--ntx:#9aa4b2;--nbd:#ffffff1f;\n--ubg:rgba(255,176,32,.12);--utx:#ffb020;--ubd:rgba(255,176,32,.4)}\n*{box-sizing:border-box;margin:0;padding:0}\nbody{background:var(--bg);color:var(--txt);font:16px/1.6 Inter,-apple-system,'Segoe UI',Roboto,Helvetica Neue,Arial,sans-serif}\n.wrap{max-width:1080px;margin:0 auto;padding:0 20px}\n.site-header{position:sticky;top:0;z-index:100;background:rgba(11,11,13,.92);border-bottom:1px solid var(--line)}\n.hwrap{display:flex;gap:18px;align-items:center;height:62px}\n.logo{display:flex;align-items:center;gap:8px;text-decoration:none;color:var(--txt);font-weight:800;font-size:17px;letter-spacing:-.01em;white-space:nowrap}\n.logo b{display:flex}\n.logo-ev{font-size:10px;font-weight:800;letter-spacing:.1em;color:var(--acc);border:1px solid rgba(90,169,255,.45);border-radius:6px;padding:2px 5px}\n.hsearch input{background:var(--panel2);border:1px solid var(--line2);border-radius:10px;color:var(--txt);font:14px/1.4 inherit;padding:9px 14px;width:200px;outline:none}\n.hsearch input::placeholder{color:var(--faint)}\n#nav{display:flex;gap:4px;align-items:center;margin-left:auto}\n#nav a{color:var(--mut);text-decoration:none;font-size:14.5px;font-weight:600;padding:8px 11px;border-radius:9px;white-space:nowrap}\n#nav a.on{color:var(--acc);background:rgba(90,169,255,.1)}\n#nav a.nav-b2b{color:var(--acc);border:1px solid rgba(90,169,255,.4)}\n.menu-btn{display:none;background:var(--panel2);border:1px solid var(--line2);border-radius:9px;padding:10px;cursor:pointer}\n.crv{vertical-align:middle;margin-left:2px}\n.menu-btn span{display:block;width:16px;height:2px;background:var(--txt);margin:3px 0;border-radius:2px}\n.crumb{color:var(--faint);font-size:13px;margin:22px 0 8px}\n.crumb b{color:var(--txt)}\nh1{font-size:28px;letter-spacing:-.02em;line-height:1.2;color:var(--txt)}\n.hero{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:30px;margin-top:18px;align-items:start}\n.gal{display:grid;gap:10px}\n.ph{height:150px;border-radius:14px;background:radial-gradient(90% 100% at 50% 15%,#1d2230,#12151c);border:1px solid var(--line);display:flex;align-items:center;justify-content:center}\n.ph.main{height:290px}\n.ph svg{width:64px;height:64px;opacity:.95;filter:drop-shadow(0 0 18px rgba(90,169,255,.4))}\n.subline{color:var(--mut);margin-top:8px;font-size:15px}\n.badge-ok{display:inline-block;background:var(--okbg);color:var(--oktx);border:1px solid var(--okbd);border-radius:99px;padding:5px 12px;font-size:13.5px;font-weight:700;margin-top:12px}\n.specgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:18px}\n.spec{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px 10px;text-align:center;box-shadow:0 2px 12px rgba(0,0,0,.3)}\n.spec .v{font-weight:800;font-size:17px;color:var(--txt)}\n.spec .k{font-size:11.5px;color:var(--faint);letter-spacing:.04em;text-transform:uppercase}\n.buybox{background:linear-gradient(160deg,#15161c,#101820);border:1px solid var(--line2);border-radius:16px;padding:20px;margin-top:16px;box-shadow:0 14px 40px rgba(0,0,0,.45)}\n.price{font-size:20px;font-weight:800;color:var(--txt)}\n.price small{display:block;font-size:12.5px;color:var(--faint);font-weight:500;margin-top:4px}\n.guar{font-size:13.5px;color:var(--mut);margin-top:10px}\n.guar b{color:var(--txt)}\n.cta{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}\n.btn{border:none;border-radius:11px;padding:13px 16px;font:700 15px/1.2 inherit;cursor:pointer;text-align:center;display:inline-block}\n.btn-main{background:linear-gradient(135deg,#6cb2ff,#3b8de8);color:#0b1018}\n.btn-ghost{background:var(--panel2);border:1px solid var(--line2);c