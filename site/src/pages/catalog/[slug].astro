---
import ZhLayout from '../../layouts/ZhLayout.astro';
import catalog from '../../data/catalog.json';
const all = (catalog.products || []).filter((p) => p.slug !== 'catalog');
export function getStaticPaths() {
  return all.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const related = all.filter((x) => x.slug !== p.slug && x.cat && x.cat === p.cat).slice(0, 3);
const faqLd = p.faq && p.faq.length ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: p.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) } : null;
const prodLd = { '@context': 'https://schema.org', '@type': 'Product', name: p.title, description: p.desc || '', image: p.og ? ('https://zapashoda-ev.ru' + p.og) : undefined, offers: { '@type': 'Offer', price: String(p.price || 0), priceCurrency: 'RUB', availability: 'https://schema.org/InStock' } };
---
<ZhLayout title={`${p.title} — Запас хода`} description={p.desc || p.title} og={p.og} jsonld={prodLd}>
  <section class="sec">
    <div class="wrap" style="max-width:860px">
      <div class="crumbs"><a href="/">Главная</a> / <a href="/catalog/">Каталог</a> / {p.cat || 'Товар'}</div>
      <div style="display:grid;grid-template-columns:1fr;gap:28px;align-items:start" class="prod-grid">
        <div>
          {p.img && <img src={p.img} alt={p.title} decoding="async" style="width:100%;max-width:420px;height:300px;object-fit:contain;background:#fff;border:1px solid var(--line);border-radius:16px;padding:16px" />}
        </div>
        <div>
          <h1>{p.title}</h1>
          {p.spec && <div class="badge">{p.spec}</div>}
          <p class="lead">{p.desc}</p>
          <div style="display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin-top:20px">
            <b style="font-size:30px;letter-spacing:-.02em">{p.price ? p.price.toLocaleString('ru-RU') + ' ₽' : 'по запросу'}</b>
            <a class="btn btn-gold" style="text-decoration:none" href={`https://zapashoda-ev.ru/catalog/${p.slug}.html`} rel="nofollow">Купить на проде</a>
          </div>
          {p.fits && p.fits.length > 0 && (
            <>
              <h2 style="margin-top:36px">Подходит для</h2>
              <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:14px">
                {p.fits.map((f) => (
                  <a class="chip" href={`/models/${f.slug}/`}>{f.name}</a>
                ))}
              </div>
              <p class="lead" style="margin-top:10px;font-size:13.5px">Разъёмы и сценарии — на страницах моделей.</p>
            </>
          )}
        </div>
      </div>
      {p.about && p.about.length > 0 && (
        <>
          <h2 style="margin-top:44px">О товаре</h2>
          {p.about.map((a) => <p style="margin:14px 0;max-width:780px">{a}</p>)}
        </>
      )}
      {p.faq && p.faq.length > 0 && (
        <>
          <h2 style="margin-top:44px">Частые вопросы</h2>
          <div class="faqbox" style="margin-top:16px">
            {p.faq.map((f) => (
              <details><summary>{f.q}</summary><p>{f.a}</p></details>
            ))}
          </div>
        </>
      )}
      {related.length > 0 && (
        <>
          <h2 style="margin-top:44px">Похожие товары</h2>
          <div class="mgrid" style="margin-top:20px">
            {related.map((r) => (
              <a class="mcard" href={`/catalog/${r.slug}/`}>
                {r.img && <img src={r.img} alt={r.title} loading="lazy" style="width:100%;height:120px;object-fit:contain;background:#fff;border-radius:12px 12px 0 0;padding:6px" />}
                <b>{r.title}</b>
                <div class="sol"><b>{r.price ? r.price.toLocaleString('ru-RU') + ' ₽' : ''}</b></div>
              </a>
            ))}
          </div>
        </>
      )}
    </div>
  </section>
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
</ZhLayout>
<style is:global>
@media(min-width:760px){.prod-grid{grid-template-columns:1fr 1.2fr}}
</style>
