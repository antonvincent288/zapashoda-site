import ZhLayout from '../../layouts/ZhLayout.astro';
import OrderForm from '../../components/OrderForm.astro';
import { PRICES_ON } from '../../lib/prices';
export async function getStaticPaths() {
  const src = (await import('../../data/sku.json')).default;
  const ofp = (await import('../../data/of_products.json')).default;
  const map = {}; (ofp || []).forEach((p) => { map[p.slug] = p; });
  return (src.items || []).map((d) => ({ params: { slug: d.slug }, props: { d, of: map[d.slug] } }));
}
const { d, of } = Astro.props;
const PN = {"gbt": "GB/T", "type2": "Type 2", "nacs": "NACS", "type1": "Type 1", "chademo": "CHAdeMO"};
const ofpAll = (await import('../../data/of_products.json')).default;
const skuAll = (await import('../../data/sku.json')).default;
const skuMap = {}; (skuAll.items || []).forEach((x) => { skuMap[x.slug] = x; });
const fit = (d.fit || []).filter((f) => typeof f === 'object');
const FAQJ = {"adapter-ccs2-gbt-dc": [["Подойдёт ли к моей машине?", "Под порт GB/T — да: Zeekr, Li Auto, Voyah, BYD, Geely и другие китайские EV. Полный список — в блоке «Совместимость» выше; если модели нет — проверим порт по VIN или фото лючка в Telegram @zapashoda_ev_bot."], ["Адаптер греется — это нормально?", "Лёгкий нагрев на максимуме тока — норма: контакты рассчитаны на это. Если корпус обжигает руку — остановите зарядку и напишите нам, подскажем, в чём дело."], ["Можно ли оставлять адаптер на станции на ночь?", "На быстрой станции нельзя — по завершении сессии адаптер нужно снять, чтобы не занимать колонку. «Оставить на ночь» — это про домашнюю зарядку от розетки."], ["У адаптера есть защита от перегрева?", "Да: термодатчик отключает цепь при +85 °C — это защита контактов и зарядного порта машины."], ["Адаптер работает от розетки 220 В?", "Нет: это адаптер для станций. Дома GB/T-машину заряжает портативная зарядка или станция — они в каталоге."], ["Сколько стоит доставка и как оплатить?", "Заявку обрабатывает партнёр-дилер в вашем городе: стоимость и способ доставки он оговаривает при подтверждении. Оплата — при получении у дилера, заявка ни к чему не обязывает."], ["Как оформить и отменить заявку?", "Нажмите «Зафиксировать цену у дилера»: заявка уходит партнёру в вашем городе, он свяжется с вами. Отменить можно в любой момент — без объяснений."]], "adapter-type2-gbt-base": [["Подойдёт ли к моей машине?", "Под порт GB/T — да: Zeekr, Li Auto, Voyah, BYD, Geely и другие китайские EV. Полный список — в блоке «Совместимость» выше; если модели нет — проверим порт по VIN или фото лючка в Telegram @zapashoda_ev_bot."], ["Адаптер греется — это нормально?", "Лёгкий нагрев на максимуме тока — норма: контакты рассчитаны на это. Если корпус обжигает руку — остановите зарядку и напишите нам, подскажем, в чём дело."], ["Чем премиум-версия отличается от базовой?", "Токовая часть та же: разница в комплекте и фиксации. Для большинства GB/T-машин достаточно базовой; сомневаетесь — напишите в Telegram, поможем выбрать, чем продавать лишнее."], ["Сколько кВт реально будет?", "Потолок задаёт машина: у большинства GB/T-моделей бортовой зарядник однофазный — реальный максимум 7 кВт. Трёхфазные 22 кВт имеет смысл только при трёхфазном OBC — проверим по VIN."], ["Сколько стоит доставка и как оплатить?", "Заявку обрабатывает партнёр-дилер в вашем городе: стоимость и способ доставки он оговаривает при подтверждении. Оплата — при получении у дилера, заявка ни к чему не обязывает."], ["Как оформить и отменить заявку?", "Нажмите «Зафиксировать цену у дилера»: заявка уходит партнёру в вашем городе, он свяжется с вами. Отменить можно в любой момент — без объяснений."]], "adapter-type2-gbt-premium": [["Подойдёт ли к моей машине?", "Под порт GB/T — да: Zeekr, Li Auto, Voyah, BYD, Geely и другие китайские EV. Полный список — в блоке «Совместимость» выше; если модели нет — проверим порт по VIN или фото лючка в Telegram @zapashoda_ev_bot."], ["Адаптер греется — это нормально?", "Лёгкий нагрев на максимуме тока — норма: контакты рассчитаны на это. Если корпус обжигает руку — остановите зарядку и напишите нам, подскажем, в чём дело."], ["Чем премиум-версия отличается от базовой?", "Токовая часть та же: у премиум усиленная фиксация и расширенный комплект. Для большинства GB/T-машин достаточно базовой; сомневаетесь — напишите в Telegram."], ["Сколько кВт реально будет?", "Потолок задаёт машина: у большинства GB/T-моделей бортовой зарядник однофазный — реальный максимум 7 кВт, даже на 22-киловаттном адаптере."], ["Сколько стоит доставка и как оплатить?", "Заявку обрабатывает партнёр-дилер в вашем городе: стоимость и способ доставки он оговаривает при подтверждении. Оплата — при получении у дилера, заявка ни к чему не обязывает."], ["Как оформить и отменить заявку?", "Нажмите «Зафиксировать цену у дилера»: заявка уходит партнёру в вашем городе, он свяжется с вами. Отменить можно в любой момент — без объяснений."]], "perekhodnik-gbt-220v": [["Подойдёт ли к моей машине?", "Под порт GB/T — да: Zeekr, Li Auto, Voyah, BYD, Geely и другие китайские EV. Полный список — в блоке «Совместимость» выше; если модели нет — проверим порт по VIN или фото лючка в Telegram @zapashoda_ev_bot."], ["Адаптер греется — это нормально?", "Лёгкий нагрев на максимуме тока — норма: контакты рассчитаны на это. Если корпус обжигает руку — остановите зарядку и напишите нам, подскажем, в чём дело."], ["Подойдёт ли к обычной домашней розетке?", "Да, к 220 В на 16 А. От слабой проводки полные 3,5 кВт не получить — розетка и вилка греются; ограничьте ток в настройках машины или используйте выделенную линию."], ["Можно ли оставлять на ночь?", "Да: домашняя зарядка 3,5 кВт — это ночная норма. Проверьте в первые полчаса, что розетка и вилка не греются."], ["Сколько стоит доставка и как оплатить?", "Заявку обрабатывает партнёр-дилер в вашем городе: стоимость и способ доставки он оговаривает при подтверждении. Оплата — при получении у дилера, заявка ни к чему не обязывает."], ["Как оформить и отменить заявку?", "Нажмите «Зафиксировать цену у дилера»: заявка уходит партнёру в вашем городе, он свяжется с вами. Отменить можно в любой момент — без объяснений."]], "adapter-gbt-type2-reverse": [["Подойдёт ли к моей машине?", "Для Type 2/CCS2-машин: Tesla EU, VW, Evolute, Москвич, корейские и другие EV. Сомневаетесь — проверим вашу модель по VIN в Telegram @zapashoda_ev_bot."], ["Адаптер греется — это нормально?", "Лёгкий нагрев на максимуме тока — норма. Если корпус обжигает руку — остановите зарядку и напишите нам."], ["Зарядит ли быстро на GB/T-станции?", "Не гарантированно: быстрые GB/T-колонки согласуются не со всеми EV-машинами. Медленные GB/T-розетки работают предсказуемо. Скорость ограничивают машина и станция, не адаптер."], ["Какие станции подойдут?", "Любые GB/T-станции и розетки. Планируйте трассу через CCS2 — для Type 2/CCS2-машин она открывается напрямую, без адаптеров."], ["Сколько стоит доставка и как оплатить?", "Заявку обрабатывает партнёр-дилер в вашем городе: стоимость и способ доставки он оговаривает при подтверждении. Оплата — при получении у дилера, заявка ни к чему не обязывает."], ["Как оформить и отменить заявку?", "Нажмите «Зафиксировать цену у дилера»: заявка уходит партнёру в вашем городе, он свяжется с вами. Отменить можно в любой момент — без объяснений."]], "adapter-nacs-ccs2-type2": [["Подойдёт ли к моей машине?", "Для Type 2/CCS2-машин: Tesla EU, VW, Evolute, Москвич, корейские и другие EV. Сомневаетесь — проверим вашу модель по VIN в Telegram @zapashoda_ev_bot."], ["Адаптер греется — это нормально?", "Лёгкий нагрев на максимуме тока — норма. Если корпус обжигает руку — остановите зарядку и напишите нам."], ["Работает ли Supercharger?", "Суперчарджеры в РФ не развёрнуты. Адаптер открывает CCS2-сети (быстрая) и Type 2 (медленная) — большую часть российских станций."], ["Нужен ли переходник для домашней розетки?", "Для зарядки от 220 В Tesla US нужен отдельный переходник под NACS — уточним комплект по VIN, не покупайте лишнего."], ["Сколько стоит доставка и как оплатить?", "Заявку обрабатывает партнёр-дилер в вашем городе: стоимость и способ доставки он оговаривает при подтверждении. Оплата — при получении у дилера, заявка ни к чему не обязывает."], ["Как оформить и отменить заявку?", "Нажмите «Зафиксировать цену у дилера»: заявка уходит партнёру в вашем городе, он свяжется с вами. Отменить можно в любой момент — без объяснений."]], "adapter-type1-type2": [["Подойдёт ли к моей машине?", "Для Type 2/CCS2-машин: Tesla EU, VW, Evolute, Москвич, корейские и другие EV. Сомневаетесь — проверим вашу модель по VIN в Telegram @zapashoda_ev_bot."], ["Адаптер греется — это нормально?", "Лёгкий нагрев на максимуме тока — норма. Если корпус обжигает руку — остановите зарядку и напишите нам."], ["Для каких машин подходит?", "Для машин с Type 1 (SAE J1772): большинство американских EV и подключаемых гибридов. Проверим вашу модель по VIN или фото лючка."], ["Есть ли CHAdeMO-вариант?", "Нет и намеренно: сеть CHAdeMO в РФ умирает — держать товар под умирающий стандарт было бы обманом покупателя."], ["Сколько стоит доставка и как оплатить?", "Заявку обрабатывает партнёр-дилер в вашем городе: стоимость и способ доставки он оговаривает при подтверждении. Оплата — при получении у дилера, заявка ни к чему не обязывает."], ["Как оформить и отменить заявку?", "Нажмите «Зафиксировать цену у дилера»: заявка уходит партнёру в вашем городе, он свяжется с вами. Отменить можно в любой момент — без объяснений."]], "kabel-razryada-v2l-gbt": [["Подойдёт к моей машине?", "Под стандартный разъём из блока «Совместимость» выше; если модели нет — проверим порт по VIN или фото лючка в Telegram @zapashoda_ev_bot."], ["Кабель греется — это нормально?", "Тёплый на предельном токе — да. Важно, чтобы жилы были медью по заявленному сечению: дешёвые кабели «на 32 А» с рынка греются заметно сильнее."], ["Для каких машин?", "Для GB/T-машин с функцией V2L (разрядка в нагрузку): Li Auto, Voyah, BYD и другие. У части ранних Li Auto V2L отключён программно — кабель его не «включит»; проверим вашу комплектацию по VIN."], ["Как подключить электроприбор?", "Кабель даёт розетку 220 В от батареи: чайник, обогреватель, инвертор. Не нагружайте выше лимита машины (обычно 3,3–3,5 кВт)."], ["Сколько стоит доставка и как оплатить?", "Заявку обрабатывает партнёр-дилер в вашем городе: стоимость и способ доставки он оговаривает при подтверждении. Оплата — при получении у дилера, заявка ни к чему не обязывает."], ["Как оформить и отменить заявку?", "Нажмите «Зафиксировать цену у дилера»: заявка уходит партнёру в вашем городе, он свяжется с вами. Отменить можно в любой момент — без объяснений."]], "kabel-type2-gbt-10m-32a": [["Подойдёт к моей машине?", "Под стандартный разъём из блока «Совместимость» выше; если модели нет — проверим порт по VIN или фото лючка в Telegram @zapashoda_ev_bot."], ["Кабель греется — это нормально?", "Тёплый на предельном токе — да. Важно, чтобы жилы были медью по заявленному сечению: дешёвые кабе