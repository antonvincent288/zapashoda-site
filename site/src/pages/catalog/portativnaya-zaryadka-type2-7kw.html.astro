---
import ZhLayout from '../../layouts/ZhLayout.astro';
const d = JSON.parse({"slug": "portativnaya-zaryadka-type2-7kw", "url": "/catalog/portativnaya-zaryadka-type2-7kw.html", "title": "Портативная зарядка Type 2, 7 кВт, 32 А", "price": 12500, "lead": "Переносная зарядка Type 2 для электромобиля: Evolute, VW, Tesla EU, BMW, Moskvich 3e и других. От силовой розетки (CEE) или бытовой с регулировкой тока до 32 А. Дача, гараж, поездка — станция не нужна.", "specs": [], "fit": [{"title": "Avatr 11 / 12 (официально RU)", "href": "/models/avatr-11-12-ofitsialno-ru.html"}, {"title": "BYD Yuan Plus / Atto 3 / Yuan Up / Pro", "href": "/models/byd-yuan-plus-atto-3-yuan-up-pro.html"}, {"title": "BYD Dolphin", "href": "/models/byd-dolphin.html"}, {"title": "Evolute i-Jet / i-Pro / i-Space / i-Joy / i-JOA", "href": "/models/evolute-i-jet-i-pro-i-space-i-joy-i-joa.html"}, {"title": "Moskvich 3e / 6", "href": "/models/moskvich-3e-6.html"}, {"title": "Tesla Model 3 / Y (EU)", "href": "/models/tesla-model-3-y-eu.html"}, {"title": "VW ID.3 / ID.4 / ID.5 / ID.Buzz", "href": "/models/vw-id-3-id-4-id-5-id-buzz.html"}, {"title": "BMW i3 / i4 / iX / iX1", "href": "/models/bmw-i3-i4-ix-ix1.html"}, {"title": "Renault Zoe", "href": "/models/renault-zoe.html"}, {"title": "Hyundai Ioniq 5 / Ioniq 6 (KR)", "href": "/models/hyundai-ioniq-5-ioniq-6-kr.html"}, {"title": "Kia EV6 (KR)", "href": "/models/kia-ev6-kr.html"}, {"title": "Nissan Leaf ZE1 (JP / EU)", "href": "/models/nissan-leaf-ze1-jp-eu.html"}], "faq": [{"q": "Можно ли заряжать от обычной розетки?", "a": "Портативка 3,5 кВт — да, от бытовой 220 В с 16 А. 7-киловаттной нужна силовая розетка (CEE 380 В). Обычная бытовая розетка должна быть целой, с заземлением и без тройников."}, {"q": "Сколько времени занимает зарядка от розетки?", "a": "3,5 кВт добавляет примерно 15–20 км хода за час ночёвки; 7 кВт (силовая розетка) — 30–40 км в час. Точные цифры — на странице вашей модели."}, {"q": "Портативку можно оставить на морозе?", "a": "Да, но не заряжайте в сильный мороз с мокрыми контактами — дайте разъёму оттаять и просохнуть."}, {"q": "Сколько стоит доставка?", "a": "Стоимость и способ доставки согласует дилер при подтверждении заявки: обычно это встреча в вашем городе или передача через салон-партнёр."}, {"q": "Как оплатить?", "a": "Оплатите дилеру при получении: детали (наличные/перевод) согласуете при встрече."}, {"q": "Как оформляется заявка", "a": "Отправляете заявку с телефоном — подтверждаем наличие и доставку в ваш город через ближайший салон-дилера. Оплата — при получении, без предоплаты."}], "image": "/assets/sku/portable-type2.webp", "related": [{"href": "/catalog/portativnaya-zaryadka-gbt-7kw.html", "title": "Зарядки"}], "desc": "Переносная зарядка Type 2 для электромобиля: Evolute, VW, Tesla EU, BMW, Moskvich 3e и других. От силовой розетки (CEE) или бытовой с регулировкой тока до 32 А."});
const fit = (d.fit || []).filter((f) => typeof f === 'object');
const faqLd = d.faq && d.faq.length ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) } : null;
const prodLd = { '@context': 'https://schema.org', '@type': 'Product', name: d.title, description: d.desc, image: d.image ? 'https://zapashoda-ev.ru' + d.image : undefined, offers: { '@type': 'Offer', price: String(d.price), priceCurrency: 'RUB', availability: 'https://schema.org/InStock' } };
---
<ZhLayout title={d.title + ' — заказать | Запас хода'} description={d.desc} jsonld={[prodLd, faqLd].filter(Boolean)}>
  <section class="sec">
    <div class="wrap" style="max-width:820px">
      <div class="crumbs"><a href="/">Главная</a> / <a href="/catalog/">Каталог</a> / {d.title}</div>
      <h1>{d.title}</h1>
      {d.image && <img src={d.image} alt={d.title} loading="lazy" style="width:100%;max-width:460px;border-radius:16px;margin:6px 0 8px" />}
      <p class="lead">{d.lead}</p>
      <div style="display:flex;align-items:center;gap:18px;margin-top:26px">
        <b style="font-size:28px;white-space:nowrap">{d.price} ₽</b>
        <a class="btn btn-gold" style="text-decoration:none" href={'https://zapashoda-ev.ru' + d.url} rel="nofollow">Заказать</a>
      </div>
      {d.spec.length > 0 && (
        <>
          <h2 style="margin-top:44px">Характеристики</h2>
          <table class="spec" style="margin-top:14px">
            <tbody>{d.spec.map(([k, v]) => <tr><td>{k}</td><td><b>{v}</b></td></tr>)}</tbody>
          </table>
        </>
      )}
      {fit.length > 0 && (
        <>
          <h2 style="margin-top:44px">Подходит для</h2>
          <p style="color:var(--txt-muted);font-size:15px;margin-top:10px">Проверьте совместимость по разъёмам — на странице каждой модели:</p>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:14px">
            {fit.map((f) => <a class="chip" style="text-decoration:none" href={f.href.replace('.html', '/')}>{f.title}</a>)}
          </div>
        </>
      )}
      {d.faq.length > 0 && (
        <>
          <h2 style="margin-top:44px">Частые вопросы</h2>
          <div class="faqbox" style="margin-top:14px">
            {d.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
          </div>
        </>
      )}
      {d.related.length > 0 && (
        <>
          <h2 style="margin-top:44px">Похожие товары</h2>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:14px">
            {d.related.map((r) => <a class="chip" style="text-decoration:none" href={r.href}>{r.title}</a>)}
          </div>
        </>
      )}
      <div style="margin-top:40px">
        <a class="btn btn-ghost" style="text-decoration:none" href="/quiz/">Подобрать под свою модель →</a>
      </div>
    </div>
  </section>
</ZhLayout>
