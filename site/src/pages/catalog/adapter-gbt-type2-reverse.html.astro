---
import ZhLayout from '../../layouts/ZhLayout.astro';
const d = JSON.parse({"slug": "adapter-gbt-type2-reverse", "url": "/catalog/adapter-gbt-type2-reverse.html", "title": "Адаптер GB/T → Type 2 (обратный), 22 кВт", "price": 6500, "lead": "Машина с европейскими разъёмами (Tesla EU, VW, Evolute, Москвич, корейские) подключается к китайским GB/T-станциям — гаражные комплексы, частные паркинги. До 22 кВт.", "specs": [["Мощность", "до 22 кВт"], ["Разъёмы", "GB/T → Type 2 (обратный)"], ["Применение", "Type 2/CCS2-машина на GB/T-станции"], ["Гарантия", "12 месяцев"]], "fit": [{"title": "Mini Cooper SE", "href": "/models/mini-cooper-se.html"}, {"title": "Citroën ë-C4 / ë-SpaceTourer", "href": "/models/citron-c4-spacetourer.html"}, {"title": "Opel Corsa-e / Mokka-e", "href": "/models/opel-corsa-e-mokka-e.html"}, {"title": "Fiat 500e", "href": "/models/fiat-500e.html"}, {"title": "Dacia Spring", "href": "/models/dacia-spring.html"}, {"title": "Renault Megane e-Tech / Kangoo E-Tech", "href": "/models/renault-megane-e-tech-kangoo-e-tech.html"}, {"title": "MG ZS EV / MG5 (EU)", "href": "/models/mg-zs-ev-mg5-eu.html"}, {"title": "Cupra Born", "href": "/models/cupra-born.html"}, {"title": "Jaguar I-Pace", "href": "/models/jaguar-i-pace.html"}, {"title": "Nissan Ariya (JP)", "href": "/models/nissan-ariya-jp.html"}, {"title": "Toyota bZ4X (JP)", "href": "/models/toyota-bz4x-jp.html"}, {"title": "Lexus RZ (JP)", "href": "/models/lexus-rz-jp.html"}], "faq": [{"q": "Адаптер греется — это нормально?", "a": "Небольшой нагрев на максимальном токе нормален. Если корпус горячее 60–70 °C или плавится вилка — снимайте и меняйте: дешёвые адаптеры без термозащиты ставить не стоит."}, {"q": "Можно ли оставить адаптер на станции на ночь?", "a": "Да, для медленной зарядки это штатный сценарий. Перед зимней зарядкой очистите контакты от снега и наледи."}, {"q": "Чем премиум-версия отличается от базовой?", "a": "Материалом корпуса и фиксацией: премиум держит плотнее и рассчитан на ежедневную зарядку, базовый — запасной или редких поездок."}, {"q": "Сколько стоит доставка?", "a": "Стоимость и способ доставки согласует дилер при подтверждении заявки: обычно это встреча в вашем городе или передача через салон-партнёр."}, {"q": "Как оплатить?", "a": "Оплатите дилеру при получении: детали (наличные/перевод) согласуете при встрече."}, {"q": "Как оформляется заявка", "a": "Отправляете заявку с телефоном — подтверждаем наличие и доставку в ваш город через ближайший салон-дилера. Оплата — при получении, без предоплаты."}], "image": "/assets/sku/adapter-reverse.webp", "related": [{"href": "/catalog/adapter-type2-gbt-premium.html", "title": "Адаптеры"}], "desc": "Машина с европейскими разъёмами (Tesla EU, VW, Evolute, Москвич, корейские) подключается к китайским GB/T-станциям — гаражные комплексы, частные паркинги. До 22"});
const fit = (d.fit || []).filter((f) => typeof f === 'object');
const faqLd = d.faq && d.faq.length ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) } : null;
const prodLd = { '@context': 'https://schema.org', '@type': 'Product', name: d.title, description: d.desc, image: d.image ? 'https://zapashoda-ev.ru' + d.image : undefined, offers: { '@type': 'Offer', price: String(d.price), priceCurrency: 'RUB', availability: 'https://schema.org/InStock' } };
---
<ZhLayout title={d.title + ' — заказать | Запас хода'} description={d.desc} jsonld={[prodLd, faqLd].filter(Boolean)}>
  <section class="sec">
    <div class="wrap" style="max-width:820px">
      <div class="crumbs"><a href="/">Главная</a> / <a href="/catalog/">Каталог</a> / {d.title}</div>
      <h1>{d.title}</h1>
      {d.image && <img src={d.image} alt={d.title} loading="lazy" style="width:100%;max-width:460px;border-radius:16px;margin:6px 0 8px" />}
      <p class="lead">{d.lead}</p>
      <div style="display:flex;align-items:center;gap:18px;margin-top:26px">
        <b style="font-size:28px;white-space:nowrap">{d.price} ₽</b>
        <a class="btn btn-gold" style="text-decoration:none" href={'https://zapashoda-ev.ru' + d.url} rel="nofollow">Заказать</a>
      </div>
      {d.spec.length > 0 && (
        <>
          <h2 style="margin-top:44px">Характеристики</h2>
          <table class="spec" style="margin-top:14px">
            <tbody>{d.spec.map(([k, v]) => <tr><td>{k}</td><td><b>{v}</b></td></tr>)}</tbody>
          </table>
        </>
      )}
      {fit.length > 0 && (
        <>
          <h2 style="margin-top:44px">Подходит для</h2>
          <p style="color:var(--txt-muted);font-size:15px;margin-top:10px">Проверьте совместимость по разъёмам — на странице каждой модели:</p>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:14px">
            {fit.map((f) => <a class="chip" style="text-decoration:none" href={f.href.replace('.html', '/')}>{f.title}</a>)}
          </div>
        </>
      )}
      {d.faq.length > 0 && (
        <>
          <h2 style="margin-top:44px">Частые вопросы</h2>
          <div class="faqbox" style="margin-top:14px">
            {d.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
          </div>
        </>
      )}
      {d.related.length > 0 && (
        <>
          <h2 style="margin-top:44px">Похожие товары</h2>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:14px">
            {d.related.map((r) => <a class="chip" style="text-decoration:none" href={r.href}>{r.title}</a>)}
          </div>
        </>
      )}
      <div style="margin-top:40px">
        <a class="btn btn-ghost" style="text-decoration:none" href="/quiz/">Подобрать под свою модель →</a>
      </div>
    </div>
  </section>
</ZhLayout>
