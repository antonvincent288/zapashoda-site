const bodyHtml = '\n<div class="wrap">\n  <div class="crumb">Главная / <b>Каталог</b></div>\n  <h1>Каталог: зарядное и аксессуары</h1>\n  <p class="sub">26 позиций: адаптеры, кабели, зарядки, станции и аксессуары. Формат предзаказа: фиксируем цену у дилера в заявке, оплата при получении, заявка ни к чему не обязывает.</p>\n  <div class="carbar" id="carbar">\n    <span class="lbl">Моя машина</span>\n    <div class="ac"><input class="txt2" id="carSearch" placeholder="Начните печатать: Zeekr, Зикр, Li 7, Воя…" autocomplete="off"><div class="ac-list" id="acList"></div></div>\n    <div class="chips"><button class="pchip" data-model="zeekr-001-001-fr">Zeekr 001</button><button class="pchip" data-model="li-auto-l6-l7-l8-l9-2022-2025">Li Auto L7 / L9</button><button class="pchip" data-model="voyah-free-evr-gibrid">Voyah Free</button><button class="pchip" data-model="byd-song-plus-ev">BYD Song</button><button class="pchip" data-model="evolute-i-jet-i-pro-i-space-i-joy-i-joa">Evolute</button><button class="pchip" data-model="tesla-model-3-y-eu">Tesla Model Y</button></div>\n    <button class="btn btn-ghost" id="reset" style="display:none">Сбросить</button>\n    <div class="state" id="state">\n      <span class="cc ok" id="cnt-ok">—</span><span class="cc no" id="cnt-no">—</span>\n      <label style="display:flex;gap:6px;align-items:center;font-size:13.5px;color:var(--mut)"><input type="checkbox" id="hideNo"> Скрыть несовместимые</label>\n    </div>\n    <div class="uhint" id="uhint"></div>\n  </div>\n  <div class="cats" id="cats">\n    <button class="cat on" data-cat="all">Все (26)</button>\n    <button class="cat" data-cat="adapter">Адаптеры (7)</button>\n    <button class="cat" data-cat="cable">Кабели (9)</button>\n    <button class="cat" data-cat="charger">Зарядки (4)</button>\n    <button class="cat" data-cat="wall">Станции (4)</button>\n    <button class="cat" data-cat="acc">Аксессуары (2)</button>\n  </div>\n  <div class="layout">\n    <aside class="side">\n      <h3>Инженерный фильтр</h3>\n      <div class="grp">\n        <label><input type="checkbox" class="f-power" value="3,5 кВт"> до 3,5 кВт</label>\n        <label><input type="checkbox" class="f-power" value="7 кВт"> 7 кВт</label>\n        <label><input type="checkbox" class="f-power" value="22 кВт"> 22 кВт</label>\n        <label><input type="checkbox" class="f-power" value="250 кВт"> 250+ кВт (DC)</label></div>\n      <div class="grp">\n        <label><input type="checkbox" class="f-amp" value="16 А"> ток 16 А</label>\n        <label><input type="checkbox" class="f-amp" value="32 А"> ток 32 А</label>\n        <label><input type="checkbox" class="f-amp" value="300 А"> ток 250–300 А (DC)</label></div>\n      <div class="grp"><label><input type="checkbox" id="f-temp"> есть датчик температуры</label></div>\n      <div class="hint">Наличие у дилеров проверяет партнёр при заявке — мы не обещаем «сегодня в наличии», чтобы не вводить в заблуждение.</div>\n    </aside>\n    <div>\n      <div class="grid" id="grid"><article class="pcard" id="adapter-ccs2-gbt-dc" data-price="" data-cat="adapter" data-fits="gbt" data-exc="" data-power="до 250 кВт" data-amp="до 300 А" data-temp="1">\n  <div class="photo"><svg viewBox="0 0 24 24" fill="none" stroke="#5aa9ff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width:84px;height:84px"><path d="M4 12h5"/><rect x="9" y="7" width="6" height="10" rx="2"/><path d="M15 12h2.5"/><circle cx="19.5" cy="12" r="1.6"/></svg></div>\n  <span class="cat-tag"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#5aa9ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4.5 13.5H11l-1 8.5L19.5 10H13l0-8z"/></svg> Адаптеры</span>\n  <h3 class="name"><a href="/catalog/adapter-ccs2-gbt-dc.html">Адаптер CCS2 → GB/T DC, 250–300 А</a></h3>\n  <div class="desc">Быстрый порт GB/T машины — к основной сети быстрых станций CCS2 в России.</div>\n  <div class="specs"><span class="spec"><b>DC</b> до 250 кВт</span><span class="spec"><b>Ток</b> до 300 А</span><span class="spec"><b>Термодатчик</b> есть</span></div>\n  <span class="badge none" data-state="none"></span>\n  <div class="prow"><span class="price">Фикс. цена у дилера<span>зафиксируем в заявке · оплата при получении</span></span><button class="btn btn-main btn-sm pc-add">В заявку</button></div>\n</article>\n<article class="pcard" id="adapter-type2-gbt-premium" data-price="" data-cat="adapter" data-fits="gbt" data-exc="" data-power="22 кВт" data-amp="32 А" data-temp="0">\n  <div class="photo"><svg viewBox="0 0 24 24" fill="none" stroke="#5aa9ff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width:84px;height:84px"><path d="M4 12h5"/><rect x="9" y="7" width="6" height="10" rx="2"/><path d="M15 12h2.5"/><circle cx="19.5" cy="12" r="1.6"/></svg></div>\n  <span class="cat-tag"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#5aa9ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4.5 13.5H11l-1 8.5L19.5 10H13l0-8z"/></svg> Адаптеры</span>\n  <h3 class="name"><a href="/catalog/adapter-type2-gbt-premium.html">Адаптер Type 2 → GB/T, 22 кВт, премиум</a></h3>\n  <div class="desc">GB/T-машина на городских Type 2-станциях и розетках без потери мощности.</div>\n  <div class="specs"><span class="spec"><b>AC</b> 22 кВт</span><span class="spec"><b>Ток</b> 32 А</span><span class="spec"><b>Фазы</b> 3</span></div>\n  <span class="badge none" data-state="none"></span>\n  <div class="prow"><span class="price">Фикс. цена у дилера<span>зафиксируем в заявке · оплата при получении</span></span><button class="btn btn-main btn-sm pc-add">В заявку</button></div>\n</article>\n<article class="pcard" id="adapter-type2-gbt-base" data-price="" data-cat="adapter" data-fits="gbt" data-exc="" data-power="22 кВт" data-amp="32 А" data-temp="0">\n  <div class="photo"><svg viewBox="0 0 24 24" fill="none" stroke="#5aa9ff" stroke-width="1.5" stroke-linecap="round" stroke-line