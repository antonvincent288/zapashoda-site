---
import ZhLayout from '../../layouts/ZhLayout.astro';
import sku from '../../data/sku.json';
const items = (sku.items || []);
const catFor = (t) => {
  const s = (t || '').toLowerCase();
  if (s.includes('адаптер') || s.includes('переходник')) return 'Адаптеры';
  if (s.includes('кабель') || s.includes('удлинитель')) return 'Кабели';
  if (s.includes('портативная зарядка')) return 'Зарядки';
  if (s.includes('станция')) return 'Станции';
  return 'Аксессуары';
};
const prods = items.map((p) => ({ ...p, cat: catFor(p.title) }));
const cats = Array.from(new Set(prods.map((p) => p.cat))).sort((a, b) => a.localeCompare(b, 'ru'));
const ld = { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: items.map((p, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Product', name: p.title, image: p.image ? 'https://zapashoda-ev.ru' + p.image : undefined, offers: { '@type': 'Offer', price: String(p.price), priceCurrency: 'RUB', availability: 'https://schema.org/InStock' } } })) };
const specLine = (p) => {
  const pairs = (p.spec || []).filter(Array.isArray).slice(0, 2).map(([k, v]) => `${k}: ${v}`).join(' · ');
  return pairs || (p.desc ? String(p.desc).slice(0, 90) : '');
};
---
<ZhLayout title="Каталог аксессуаров для зарядки — Запас хода" description="Адаптеры Type 2 → GB/T, кабели, портативные зарядки, настенные станции. Цены, совместимость и подбор под вашу модель." jsonld={ld}>
  <section class="sec">
    <div class="wrap">
      <div class="crumbs"><a href="/">Главная</a> / Каталог</div>
      <h1>Каталог аксессуаров для зарядки</h1>
      <p class="lead">{prods.length} позиций: адаптеры, кабели, зарядки, станции и аксессуары. Совместимость — по карточкам моделей.</p>
      <div id="cat-chips" style="display:flex;gap:10px;flex-wrap:wrap;margin-top:24px">
        <button class="chip" type="button" data-cat="all" style="background:var(--gold);color:#1d1d1f;border-color:var(--gold)">Все ({prods.length})</button>
        {cats.map((c) => (
          <button class="chip" type="button" data-cat={c}>{c} ({prods.filter((p) => p.cat === c).length})</button>
        ))}
      </div>
      <div class="mgrid" style="margin-top:32px">
        {prods.map((p) => (
          <a class="mcard" data-cat={p.cat} href={`/catalog/${p.slug}.html`}>
            {p.image && <img src={p.image} alt={p.title} loading="lazy" decoding="async" style="width:100%;height:170px;object-fit:contain;background:#fff;border-radius:12px 12px 0 0;padding:8px" />}
            <b>{p.title}</b>
            <span class="tag">{specLine(p)}</span>
            <div class="sol" style="margin-top:auto"><b style="font-size:18px">{p.price ? p.price.toLocaleString('ru-RU') + ' ₽' : 'по запросу'}</b></div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <script define:vars={{ cats }}>
    document.querySelectorAll('#cat-chips .chip').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var c = btn.getAttribute('data-cat');
        document.querySelectorAll('#cat-chips .chip').forEach(function (b) { b.style.background = ''; b.style.color = ''; b.style.borderColor = ''; });
        btn.style.background = 'var(--gold)'; btn.style.color = '#1d1d1f'; btn.style.borderColor = 'var(--gold)';
        document.querySelectorAll('.mcard[data-cat]').forEach(function (card) {
          card.style.display = (c === 'all' || card.getAttribute('data-cat') === c) ? '' : 'none';
        });
      });
    });
  </script>
</ZhLayout>
