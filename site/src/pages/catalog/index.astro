hideNo\').checked;\n  document.querySelectorAll(\'.pcard\').forEach(function(c){\n    var show=(cat===\'all\'||c.dataset.cat===cat);\n    if(show&&pow.length) show=pow.some(function(p){return (c.dataset.power||\'\').indexOf(p)>=0});\n    if(show&&amp.length) show=amp.some(function(a){return (c.dataset.amp||\'\').indexOf(a)>=0});\n    if(show&&temp&&c.dataset.temp!==\'1\') show=false;\n    if(show&&hideNo&&c.dataset.state===\'no\') show=false;\n    c.classList.toggle(\'hide\',!show);\n  });\n}\nvar ALIAS={\'зикр\':\'zeekr\',\'зеекр\':\'zeekr\',\'ли\':\'li\',\'воя\':\'voyah\',\'войа\':\'voyah\',\'бид\':\'byd\',\'байди\':\'byd\',\'биди\':\'byd\',\'джили\':\'geely\',\'эволют\':\'evolute\',\'иволют\':\'evolute\',\'тесла\':\'tesla\',\'сяоми\':\'xiaomi\',\'аватар\':\'avatr\',\'су7\':\'su7\',\'хавал\':\'haval\',\'танк\':\'tank\',\'мсквич\':\'moskvich\'};\nfunction nz(s){return s.toLowerCase().replace(/ё/g,\'е\').replace(/[^a-zа-я0-9]/g,\'\');}\nfunction searchModels(q){\n  q=nz(q); if(!q)return [];\n  var extra=\'\';\n  for(var a in ALIAS){ if(q.indexOf(a)>=0){extra=ALIAS[a];break;} }\n  return MODELS.filter(function(m){\n    var n=nz(m.brand+\' \'+m.name), s=nz(m.id);\n    return n.indexOf(q)>=0 || s.indexOf(q)>=0 || (extra&&(n.indexOf(extra)>=0));\n  }).slice(0,8);\n}\nfunction renderAC(items){\n  var box=document.getElementById(\'acList\');\n  if(!items.length){box.classList.remove(\'on\');return;}\n  box.innerHTML=items.map(function(m){return \'<div class="ac-item" data-mid="\'+m.id+\'">\'+m.name+\'<small>\'+m.brand+(m.port?(\' · порт \'+({\'gbt\':\'GB/T\',\'type2\':\'Type 2\',\'nacs\':\'NACS\',\'type1\':\'Type 1\',\'chademo\':\'CHAdeMO\'})[m.port]):\' · порт не проверен\')+\'</small></div>\';}).join(\'\');\n  box.classList.add(\'on\');\n}\n(function(){\n  var inp=document.getElementById(\'carSearch\'), box=document.getElementById(\'acList\');\n  inp.addEventListener(\'input\',function(){renderAC(searchModels(this.value))});\n  inp.addEventListener(\'focus\',function(){if(inp.value)renderAC(searchModels(inp.value))});\n  box.addEventListener(\'click\',function(e){\n    var it=e.target.closest(\'.ac-item\'); if(!it)return;\n    box.classList.remove(\'on\'); inp.value=\'\';\n    var mid=it.dataset.mid; var m=MODELS.find(x=>x.id===mid);\n    document.querySelectorAll(\'.pchip\').forEach(function(c){c.classList.toggle(\'on\',c.dataset.model===mid)});\n    setCar(mid);\n  });\n  document.addEventListener(\'click\',function(e){if(!e.target.closest(\'.ac\'))box.classList.remove(\'on\')});\n  document.querySelectorAll(\'.pchip\').forEach(function(c){\n    c.addEventListener(\'click\',function(){\n      document.querySelectorAll(\'.pchip\').forEach(function(x){x.classList.toggle(\'on\',x===c)});\n      var mid=c.dataset.model; var m=MODELS.find(x=>x.id===mid);\n      setCar(mid);\n    });\n  });\n})();\ndocument.getElementById(\'reset\').addEventListener(\'click\',resetCar);\ndocument.getElementById(\'hideNo\').addEventListener(\'change\',applyFilters);\ndocument.getElementById(\'cats\').addEventListener(\'click\',function(e){\n  if(!e.target.classList.contains(\'cat\'))return;\n  document.querySelectorAll(\'.cat\').forEach(function(b){b.classList.remove(\'on\')});\n  e.target.classList.add(\'on\'); applyFilters();\n});\ndocument.querySelectorAll(\'.f-power,.f-amp\').forEach(function(i){i.addEventListener(\'change\',applyFilters)});\ndocument.getElementById(\'f-temp\').addEventListener(\'change\',applyFilters);\n\n(function(){\n  var q=new URLSearchParams(location.search).get(\'model\');\n  var saved=null; try{saved=localStorage.getItem(\'zs_car\')}catch(e){}\n  if(q){ var m=MODELS.find(x=>x.id===q); if(m)setCar(q); }\n  else if(saved&&MODELS.some(x=>x.id===saved)){ setCar(saved); }\n})();\n';
const cssCode = "\n\n*{box-sizing:border-box;margin:0;padding:0}\nbody{background:#0b0b0d;color:#f5f5f7;font:16px/1.6 Inter,-apple-system,'Segoe UI',Roboto,Helvetica Neue,Arial,sans-serif}\n.wrap{max-width:1180px;margin:0 auto;padding:0 20px}\n.site-header{position:sticky;top:0;z-index:100;background:rgba(11,11,13,.92);border-bottom:1px solid rgba(255,255,255,.07)}\n.hwrap{display:flex;gap:18px;align-items:center;height:62px}\n.logo{display:flex;align-items:center;gap:8px;text-decoration:none;color:#f5f5f7;font-weight:800;font-size:17px;letter-spacing:-.01em;white-space:nowrap}\n.logo b{display:flex}\n.logo-ev{font-size:10px;font-weight:800;letter-spacing:.1em;color:#5aa9ff;border:1px solid rgba(90,169,255,.45);border-radius:6px;padding:2px 5px}\n.hsearch input{background:#15161c;border:1px solid rgba(255,255,255,.12);border-radius:10px;color:#f5f5f7;font:14px/1.4 inherit;padding:9px 14px;width:200px;outline:none}\n.hsearch input::placeholder{color:#7d8794}\n#nav{display:flex;gap:4px;align-items:center;margin-left:auto}\n#nav a{color:#aeb6c2;text-decoration:none;font-size:14.5px;font-weight:600;padding:8px 11px;border-radius:9px;white-space:nowrap}\n#nav a:hover{color:#f5f5f7;background:rgba(255,255,255,.06)}\n#nav a.on{color:#5aa9ff;background:rgba(90,169,255,.1)}\n#nav a.nav-b2b{color:#5aa9ff;border:1px solid rgba(90,169,255,.4)}\n.menu-btn{display:none;background:#15161c;border:1px solid rgba(255,255,255,.12);border-radius:9px;padding:10px;cursor:pointer}\n.menu-btn span{display:block;width:16px;height:2px;background:#f5f5f7;margin:3px 0;border-radius:2px}\n.crumb{color:#7d8794;font-size:13px;margin:22px 0 8px}\n.crumb b{color:#f5f5f7}\nh1{font-size:30px;line-height:1.2;letter-spacing:-.02em;color:#f5f5f7}\n.sub{color:#aeb6c2;margin-top:8px;max-width:680px}\n.carbar{position:sticky;top:62px;z-index:30;background:linear-gradient(160deg,#15161c,#101318);border:1px solid rgba(255,255,255,.12);border-radius:16px;margin-top:20px;padding:16px;display:flex;gap:12px;align-items:center;flex-wrap:wrap;box-shadow:0 10px 34px rgba(0,0,0,.45)}\n.lbl{font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:#7d8794;font-weight:700}\nselect{appearance:none;background:#1b1c23;border:1px solid rgba(255,255,255,.12);border-radius:10px;padding:10px 14px;font:15px/1.4 inherit;color:#f5f5f7;outline:none;max-width:320px}\nselect:disabled{opacity:.55}\n.btn{border:none;border-radius:11px;padding:11px 18px;font:700 15px/1.2 inherit;cursor:pointer}\n.btn-main{background:linear-gradient(135deg,#6cb2ff,#3b8de8);color:#0b1018}\n.btn-ghost{background:#15161c;border:1px solid rgba(255,255,255,.12);color:#f5f5f7}\n.btn-sm{padding:8px 13px;font-size:14px}\n.state{display:none;align-items:center;gap:8px;font-size:14px;color:#aeb6c2;flex-wrap:wrap}\n.state.on{display:flex}\n.chipcounts{display:flex;gap:8px;flex-wrap:wrap;margin-left:auto;align-items:center}\n.cc{border-radius:99px;padding:6px 12px;font-size:13px;font-weight:700}\n.cc.ok{background:rgba(34,197,94,.13);color:#4ade80;border:1px solid rgba(34,197,94,.4)}\n.cc.no{background:rgba(255,255,255,.06);color:#9aa4b2;border:1px solid rgba(255,255,255,.12)}\n.cc.unk{background:rgba(255,176,32,.12);color:#ffb020;border:1px solid rgba(255,176,32,.4)}\n.uhint{display:none;width:100%;font-size:13px;color:#ffb020;background:rgba(255,176,32,.12);border:1px solid rgba(255,176,32,.4);border-radius:10px;padding:8px 12px}\n.uhint.on{display:block}\n\n.ac{position:relative;flex:1 1 280px;min-width:240px}\n.txt2{width:100%;background:#1b1c23;border:1px solid rgba(255,255,255,.12);border-radius:10px;padding:10px 14px;font:15px/1.4 inherit;color:#f5f5f7;outline:none}\n.txt2::placeholder{color:#7d8794}\n.ac-list{position:absolute;top:calc(100% + 6px);left:0;right:0;background:#15161c;border:1px solid rgba(255,255,255,.12);border-radius:12px;z-index:50;display:none;max-height:264px;overflow:auto;box-shadow:0 18px 44px rgba(0,0,0,.55)}\n.ac-list.on{display:block}\n.ac-item{padding:9px 12px;cursor:pointer;font-size:14.5px;color:#e5ecf6}\n.ac-item small{color:#7d8794;margin-left:7px}\n.ac-item:hover{background:rgba(90,169,255,.09)}\n.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}\n.pchip{border:1px solid rgba(255,255,255,.12);background:#15161c;border-radius:99px;padding:7px 13px;font-size:13.5px;font-weight:600;color:#aeb6c2;cursor:pointer;white-space:nowrap}\n.pchip:hover,.pchip.on{border-color:#5aa9ff;color:#f5f5f7}\n.ic{vertical-align:middle}\n.inl{display:inline-block;margin-right:4px;transform:translateY(2px)}\n.fb-row{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-top:12px}\n.fb-row .btn{padding:9px 14px;font-size:13.5px}\n\n.cats{display:flex;gap:8px;flex-wrap:wrap;margin:22px 0 0}\n.cat{border:1px solid rgba(255,255,255,.12);background:#15161c;border-radius:99px;padding:10px 16px;font-size:14px;font-weight:600;cursor:pointer;color:#aeb6c2}\n.cat.on{background:linear-gradient(135deg,#4d9bf5,#0161ef);color:#0b1018;border-color:transparent}\n.layout{display:grid;grid-template-columns:250px 1fr;gap:26px;margin-top:22px;align-items:start}\n.side{background:linear-gradient(165deg,#17181d,#131318);border:1px solid rgba(255,255,255,.12);border-radius:16px;padding:18px;position:sticky;top:100px;box-shadow:0 12px 34px rgba(0,0,0,.5)}\n.side h3{font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:#7d8794;margin:0 0 12px}\n.side .grp{margin-bottom:18px}\n.side label{display:flex;gap:9px;align-items:center;font-size:15px;color:#e5ecf6;padding:8px 0;cursor:pointer}\n.side input{accent-color:#5aa9ff;width:16px;height:16px}\n.side .hint{font-size:12.5px;color:#7d8794;border-top:1px dashed rgba(255,255,255,.12);padding-top:12px;line-height:1.5}\n.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\n.pcard{background:linear-gradient(165deg,#191b21 0%,#131318 60%);border:1px solid rgba(255,255,255,.12);border-radius:16px;padding:20px;display:flex;flex-direction:column;gap:12px;box-shadow:0 12px 34px rgba(0,0,0,.5)}\n.photo{aspect-ratio:16/9;width:100%;height:auto;border-radius:12px;background:#0E1117;display:flex;align-items:center;justify-content:center;border:1px solid rgba(255,255,255,.12)}\n.photo svg{width:52px;height:52px;opacity:.95;filter:drop-shadow(0 0 14px rgba(90,169,255,.35))}\n.cat-tag{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:#7d8794}\n.pcard .name{font-weight:700;font-size:16px;line-height:1.3;letter-spacing:-.01em;min-height:42px;color:#f5f5f7}\n.pcard .desc{font-size:13.5px;color:#aeb6c2;min-height:63px}\n.specs{display:flex;gap:6px;flex-wrap:wrap}\n.spec{border:1px solid rgba(255,255,255,.12);border-radius:8px;padding:4px 9px;font-size:12px;color:#aeb6c2;white-space:nowrap;background:rgba(255,255,255,.03)}\n.spec b{color:#f5f5f7;font-weight:700}\n.badge{align-self:flex-start;border-radius:99px;padding:4px 11px;font-size:12.5px;font-weight:700}\n.badge.ok{background:rgba(34,197,94,.13);color:#4ade80;border:1px solid rgba(34,197,94,.4)}\n.badge.no{background:rgba(255,255,255,.06);color:#9aa4b2;border:1px solid rgba(255,255,255,.12)}\n.badge.unk{background:rgba(255,176,32,.12);color:#ffb020;border:1px solid rgba(255,176,32,.4)}\n.badge.none{display:none}\n.prow{margin-top:auto;display:flex;gap:10px;align-items:center;border-top:1px solid rgba(255,255,255,.07);padding-top:12px}\n.price{font-size:13.5px;font-weight:700;color:#f5f5f7}\n.price span{display:block;font-size:11px;font-weight:500;color:#7d8794}\n.prow .btn{margin-left:auto}\n.prow a{text-decoration:none}\n.hide{display:none!important}\n.bunsec{margin-top:36px}\n.bunsec h2{font-size:22px;letter-spacing:-.02em}\n.bun-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}\n.bcard{background:linear-gradient(160deg,#15161c 0%,#101820 100%);border:1px solid rgba(1,97,239,.6);border-radius:16px;padding:22px}\n.bcard .t{font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:#5aa9ff;font-weight:700}\n.bcard h3{font-size:18px;margin:5px 0 6px}\n.bcard .d{font-size:14px;color:#aeb6c2}\n.bcard ul{margin:12px 0 0;padding:0;list-style:none}\n.bcard li{font-size:14.5px;padding:8px 0 8px 24px;position:relative;color:#e5ecf6}\n.bcard li:before{content:'';position:absolute;left:2px;top:13px;width:12px;height:7px;border-left:2px solid #5aa9ff;border-bottom:2px solid #5aa9ff;transform:rotate(-45deg)}\n.bcard .foot{display:flex;gap:10px;align-items:center;margin-top:14px;flex-wrap:wrap}\n.note{background:#15161c;border:1px dashed rgba(255,255,255,.12);border-radius:16px;padding:16px;font-size:13.5px;color:#aeb6c2;margin-top:24px;line-height:1.55}\n.note b{color:#f5f5f7}\n.site-footer{margin-top:60px;border-top:1px solid rgba(255,255,255,.07);background:#0a0a0c;padding:44px 0 28px}\n.fgrid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.2fr;gap:26px}\n.fgrid .logo{color:#fff}\n.fdesc{margin-top:14px;font-size:13.5px;color:#aeb6c2;max-width:300px}\n.fgrid h4{font-size:14px;color:#f5f5f7;margin-bottom:10px}\n.fgrid a{display:block;color:#aeb6c2;text-decoration:none;font-size:13.5px;padding:4px 0}\n.fgrid a:hover{color:#5aa9ff}\n.copy{display:flex;gap:16px;justify-content:space-between;flex-wrap:wrap;border-top:1px solid rgba(255,255,255,.07);margin-top:26px;padding-top:18px;font-size:12.5px;color:#7d8794}\n@media(max-width:960px){#nav{display:none}.menu-btn{display:block}.layout{grid-template-columns:1fr}.side{position:static}.grid{grid-template-columns:1fr 1fr}.bun-grid{grid-template-columns:1fr}.fgrid{grid-template-columns:1fr 1fr}}\n@media(max-width:560px){.grid{grid-template-columns:1fr}.fgrid{grid-template-columns:1fr}.hsearch{display:none}}\n\n\n\n\n\nh3.name a{color:inherit;text-decoration:none}h3.name a:hover{color:#6db3ff}\n.bcard li a{color:#e5ecf6;text-decoration:none}.bcard li a:hover{color:#6db3ff}\n";
