---
import ZhLayout from '../../layouts/ZhLayout.astro';
import OrderForm from '../../components/OrderForm.astro';
import sku from '../../data/sku.json';
import ofp from '../../data/of_products.json';
const items = (sku.items || []);
const ofMap = {};
(ofp || []).forEach((p) => { ofMap[p.slug] = p; });
const catFor = (t) => {
  const s = (t || '').toLowerCase();
  if (s.includes('адаптер') || s.includes('переходник')) return 'Адаптеры';
  if (s.includes('кабель') || s.includes('удлинитель')) return 'Кабели';
  if (s.includes('портативная зарядка')) return 'Зарядки';
  if (s.includes('станция')) return 'Станции';
  return 'Аксессуары';
};
const prods = items.map((p) => ({ ...p, cat: catFor(p.title), of: ofMap[p.slug] }));
const catOrder = ['Станции', 'Зарядки', 'Адаптеры', 'Кабели', 'Аксессуары'];
const cats = catOrder.filter((c) => prods.some((p) => p.cat === c)).concat(Array.from(new Set(prods.map((p) => p.cat))).filter((c) => !catOrder.includes(c)));
const ld = { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: prods.map((p, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Product', name: p.title, image: p.image ? 'https://zapashoda-ev.ru' + p.image : undefined, offers: { '@type': 'Offer', price: String(p.price), priceCurrency: 'RUB', availability: 'https://schema.org/InStock' } } })) };
const specLine = (p) => {
  const pairs = (p.spec || []).filter(Array.isArray).slice(0, 2).map(([k, v]) => `${k}: ${v}`).join(' · ');
  return pairs || (p.desc ? String(p.desc).slice(0, 90) : '');
};
const ofScript = 'var OF_MODEL="Каталог аксессуаров";var OF_PRODUCTS=' + JSON.stringify(ofp) + ';';
---
<ZhLayout title="Зарядные станции для электромобилей купить — цены от 6 500 ₽ | Запас хода" description="Купить зарядную станцию для электромобиля: настенные 7–22 кВт, портативные зарядки, адаптеры Type 2 → GB/T, кабели и удлинители. Цены РРЦ, подбор под вашу модель, оплата при получении." jsonld={ld}>
  <section class="sec">
    <div class="wrap">
      <div class="crumbs"><a href="/">Главная</a> / Каталог</div>
      <h1>Зарядные станции и аксессуары для электромобиля — купить</h1>
      <p class="lead">{prods.length} позиций: адаптеры, кабели, зарядки, станции и аксессуары. Добавляйте в заявку — заберёте у партнёра-дилера в вашем городе, оплата при получении.</p>
      <div id="cat-chips" style="display:flex;gap:10px;flex-wrap:wrap;margin-top:24px">
        <button class="chip" type="button" data-cat="all" style="background:var(--gold);color:#1d1d1f;border-color:var(--gold)">Все ({prods.length})</button>
        {cats.map((c) => (
          <button class="chip" type="button" data-cat={c}>{c} ({prods.filter((p) => p.cat === c).length})</button>
        ))}
      </div>
      <div class="mgrid" style="margin-top:32px">
        {prods.map((p) => (
          <div class="mcard" data-cat={p.cat}>
            {p.image && <a href={`/catalog/${p.slug}.html`}><img src={p.image} alt={p.title} loading="lazy" decoding="async" style="width:100%;height:170px;object-fit:contain;background:#fff;border-radius:12px 12px 0 0;padding:8px" /></a>}
            <a href={`/catalog/${p.slug}.html`}><b>{p.title}</b></a>
            <span class="tag">{specLine(p)}</span>
            <div class="sol" style="margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap">
              <b style="font-size:18px">{p.price ? p.price.toLocaleString('ru-RU') + ' ₽' : 'по запросу'}</b>
              <button class="btn btn-gold" type="button" style="font-size:13px;padding:8px 14px" onclick={`ofAdd(${p.of ? p.of.id : 0},this)`}>В заявку</button>
            </div>
          </div>
        ))}
      </div>
      <OrderForm model="Каталог аксессуаров" />
    </div>
  </section>
  <style is:inline>.mcard a{color:inherit;text-decoration:none}</style>
  <script is:inline set:html={ofScript} />
  <script define:vars={{ cats }}>
    document.querySelectorAll('#cat-chips .chip').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var c = btn.getAttribute('data-cat');
        document.querySelectorAll('#cat-chips .chip').forEach(function (b) { b.style.background = ''; b.style.color = ''; b.style.borderColor = ''; });
        btn.style.background = 'var(--gold)'; btn.style.color = '#1d1d1f'; btn.style.borderColor = 'var(--gold)';
        document.querySelectorAll('.mcard[data-cat]').forEach(function (card) {
          card.style.display = (c === 'all' || card.getAttribute('data-cat') === c) ? '' : 'none';
        });
      });
    });
  </script>
</ZhLayout>
