---
import ZhLayout from '../layouts/ZhLayout.astro';
import sku from '../data/sku.json';
const items = (sku.items || []);
const ld = { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: items.map((p, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Product', name: p.title, offers: { '@type': 'Offer', price: String(p.price), priceCurrency: 'RUB', availability: 'https://schema.org/InStock' } } })) };
---
<ZhLayout title="Каталог зарядного оборудования — Запас хода" description="Адаптеры, кабели и зарядки для электромобилей: каталог 26 позиций с ценами, спецификациями и ответами на частые вопросы." jsonld={ld}>
  <section class="sec">
    <div class="wrap">
      <div class="crumbs"><a href="/">Главная</a> / Каталог</div>
      <h1>Каталог зарядного оборудования</h1>
      <p class="lead">Адаптеры, кабели и зарядки: ходовые позиции в наличии, доставка по России. На карточке — спецификации, совместимость и ответы на частые вопросы.</p>
      <div class="mgrid" style="margin-top:36px">
        {items.map((p) => (
          <a class="mcard" href={`/catalog/${p.slug}.html`}>
            <b>{p.title}</b>
            <div class="ports">{p.spec.slice(0, 2).map(([k, v]) => `${k}: ${v}`).join(' · ') || p.desc}</div>
            <div style="display:flex;align-items:center;justify-content:space-between;margin-top:6px">
              <b style="font-size:19px">{p.price} ₽</b>
              <span class="tag">в наличии</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</ZhLayout>
