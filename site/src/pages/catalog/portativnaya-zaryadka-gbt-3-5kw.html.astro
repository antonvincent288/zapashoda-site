---
import ZhLayout from '../../layouts/ZhLayout.astro';
const d = JSON.parse({"slug": "portativnaya-zaryadka-gbt-3-5kw", "url": "/catalog/portativnaya-zaryadka-gbt-3-5kw.html", "title": "Портативная зарядка GB/T, 3,5 кВт, 16 А", "price": 9500, "lead": "Переносная зарядка GB/T 3,5 кВт: аварийная и ночная зарядка от обычной домашней розетки. Компактная, живёт в багажнике.", "specs": [["Мощность", "до 3,5 кВт"], ["Разъём", "GB/T"], ["Питание", "бытовая розетка 220 В"], ["Ток", "16 А"], ["Гарантия", "12 месяцев"]], "fit": [{"title": "Zeekr 001 / 001 FR", "href": "/models/zeekr-001-001-fr.html"}, {"title": "Zeekr 007 / 007GT", "href": "/models/zeekr-007-007gt.html"}, {"title": "Zeekr 7X / X / MIX", "href": "/models/zeekr-7x-x-mix.html"}, {"title": "Li Auto L6 / L7 / L8 / L9 (2022–2025)", "href": "/models/li-auto-l6-l7-l8-l9-2022-2025.html"}, {"title": "Voyah Free EVR (гибрид)", "href": "/models/voyah-free-evr-gibrid.html"}, {"title": "Xiaomi SU7 / SU7 Ultra", "href": "/models/xiaomi-su7-su7-ultra.html"}, {"title": "FAW Bestune NAT", "href": "/models/faw-bestune-nat.html"}, {"title": "Changan Qiyuan A05 / A06 / A07", "href": "/models/changan-qiyuan-a05-a06-a07.html"}, {"title": "BYD Song Plus EV", "href": "/models/byd-song-plus-ev.html"}, {"title": "BYD Song Plus DM-i / Sealion 05", "href": "/models/byd-song-plus-dm-i-sealion-05.html"}, {"title": "Deepal S07 (RU официальная)", "href": "/models/deepal-s07-ru-ofitsialnaya.html"}, {"title": "Leapmotor C10 / C11 / C01 / B10 / A05", "href": "/models/leapmotor-c10-c11-c01-b10-a05.html"}], "faq": [{"q": "Можно ли заряжать от обычной розетки?", "a": "Портативка 3,5 кВт — да, от бытовой 220 В с 16 А. 7-киловаттной нужна силовая розетка (CEE 380 В). Обычная бытовая розетка должна быть целой, с заземлением и без тройников."}, {"q": "Сколько времени занимает зарядка от розетки?", "a": "3,5 кВт добавляет примерно 15–20 км хода за час ночёвки; 7 кВт (силовая розетка) — 30–40 км в час. Точные цифры — на странице вашей модели."}, {"q": "Портативку можно оставить на морозе?", "a": "Да, но не заряжайте в сильный мороз с мокрыми контактами — дайте разъёму оттаять и просохнуть."}, {"q": "Сколько стоит доставка?", "a": "Стоимость и способ доставки согласует дилер при подтверждении заявки: обычно это встреча в вашем городе или передача через салон-партнёр."}, {"q": "Как оплатить?", "a": "Оплатите дилеру при получении: детали (наличные/перевод) согласуете при встрече."}, {"q": "Как оформляется заявка", "a": "Отправляете заявку с телефоном — подтверждаем наличие и доставку в ваш город через ближайший салон-дилера. Оплата — при получении, без предоплаты."}], "image": "/assets/sku/portable-gbt35.webp", "related": [{"href": "/catalog/portativnaya-zaryadka-gbt-7kw.html", "title": "Зарядки"}], "desc": "Переносная зарядка GB/T 3,5 кВт: аварийная и ночная зарядка от обычной домашней розетки. Компактная, живёт в багажнике."});
const fit = (d.fit || []).filter((f) => typeof f === 'object');
const faqLd = d.faq && d.faq.length ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) } : null;
const prodLd = { '@context': 'https://schema.org', '@type': 'Product', name: d.title, description: d.desc, image: d.image ? 'https://zapashoda-ev.ru' + d.image : undefined, offers: { '@type': 'Offer', price: String(d.price), priceCurrency: 'RUB', availability: 'https://schema.org/InStock' } };
---
<ZhLayout title={d.title + ' — заказать | Запас хода'} description={d.desc} jsonld={[prodLd, faqLd].filter(Boolean)}>
  <section class="sec">
    <div class="wrap" style="max-width:820px">
      <div class="crumbs"><a href="/">Главная</a> / <a href="/catalog/">Каталог</a> / {d.title}</div>
      <h1>{d.title}</h1>
      {d.image && <img src={d.image} alt={d.title} loading="lazy" style="width:100%;max-width:460px;border-radius:16px;margin:6px 0 8px" />}
      <p class="lead">{d.lead}</p>
      <div style="display:flex;align-items:center;gap:18px;margin-top:26px">
        <b style="font-size:28px;white-space:nowrap">{d.price} ₽</b>
        <a class="btn btn-gold" style="text-decoration:none" href={'https://zapashoda-ev.ru' + d.url} rel="nofollow">Заказать</a>
      </div>
      {d.spec.length > 0 && (
        <>
          <h2 style="margin-top:44px">Характеристики</h2>
          <table class="spec" style="margin-top:14px">
            <tbody>{d.spec.map(([k, v]) => <tr><td>{k}</td><td><b>{v}</b></td></tr>)}</tbody>
          </table>
        </>
      )}
      {fit.length > 0 && (
        <>
          <h2 style="margin-top:44px">Подходит для</h2>
          <p style="color:var(--txt-muted);font-size:15px;margin-top:10px">Проверьте совместимость по разъёмам — на странице каждой модели:</p>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:14px">
            {fit.map((f) => <a class="chip" style="text-decoration:none" href={f.href.replace('.html', '/')}>{f.title}</a>)}
          </div>
        </>
      )}
      {d.faq.length > 0 && (
        <>
          <h2 style="margin-top:44px">Частые вопросы</h2>
          <div class="faqbox" style="margin-top:14px">
            {d.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
          </div>
        </>
      )}
      {d.related.length > 0 && (
        <>
          <h2 style="margin-top:44px">Похожие товары</h2>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:14px">
            {d.related.map((r) => <a class="chip" style="text-decoration:none" href={r.href}>{r.title}</a>)}
          </div>
        </>
      )}
      <div style="margin-top:40px">
        <a class="btn btn-ghost" style="text-decoration:none" href="/quiz/">Подобрать под свою модель →</a>
      </div>
    </div>
  </section>
</ZhLayout>
