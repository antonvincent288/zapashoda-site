---
import ZhLayout from '../../layouts/ZhLayout.astro';
const d = JSON.parse({"slug": "portativnaya-zaryadka-type2-3-5kw", "url": "/catalog/portativnaya-zaryadka-type2-3-5kw.html", "title": "Портативная зарядка Type 2, 3,5 кВт, 16 А", "price": 7500, "lead": "Переносная зарядка Type 2 3,5 кВт: аварийная и ночная зарядка от бытовой розетки 220 В. Для гибридов (PHEV) это то, что нужно: больше мощности бортовое зарядное всё равно не примет.", "specs": [], "fit": [{"title": "Evolute i-Jet / i-Pro / i-Space / i-Joy / i-JOA", "href": "/models/evolute-i-jet-i-pro-i-space-i-joy-i-joa.html"}, {"title": "Hyundai Ioniq 5 / Ioniq 6 (KR)", "href": "/models/hyundai-ioniq-5-ioniq-6-kr.html"}, {"title": "Kia EV6 (KR)", "href": "/models/kia-ev6-kr.html"}, {"title": "Mitsubishi Outlander PHEV (JP / EU)", "href": "/models/mitsubishi-outlander-phev-jp-eu.html"}, {"title": "Lynk & Co 01 PHEV (EU-версия)", "href": "/models/lynk-co-01-phev-eu-versiya.html"}, {"title": "Volvo XC90 / XC60 T8 (PHEV)", "href": "/models/volvo-xc90-xc60-t8-phev.html"}, {"title": "MG HS PHEV / MG 07 (CN)", "href": "/models/mg-hs-phev-mg-07-cn.html"}, {"title": "Hyundai Kona Electric (KR)", "href": "/models/hyundai-kona-electric-kr.html"}, {"title": "Kia EV9 (KR)", "href": "/models/kia-ev9-kr.html"}, {"title": "Kia Soul EV (ранние)", "href": "/models/kia-soul-ev-rannie.html"}, {"title": "Genesis GV60 / Electrified G80 / GV70", "href": "/models/genesis-gv60-electrified-g80-gv70.html"}, {"title": "Chevrolet Bolt EV / EUV", "href": "/models/chevrolet-bolt-ev-euv.html"}], "faq": [{"q": "Можно ли заряжать от обычной розетки?", "a": "Портативка 3,5 кВт — да, от бытовой 220 В с 16 А. 7-киловаттной нужна силовая розетка (CEE 380 В). Обычная бытовая розетка должна быть целой, с заземлением и без тройников."}, {"q": "Сколько времени занимает зарядка от розетки?", "a": "3,5 кВт добавляет примерно 15–20 км хода за час ночёвки; 7 кВт (силовая розетка) — 30–40 км в час. Точные цифры — на странице вашей модели."}, {"q": "Портативку можно оставить на морозе?", "a": "Да, но не заряжайте в сильный мороз с мокрыми контактами — дайте разъёму оттаять и просохнуть."}, {"q": "Сколько стоит доставка?", "a": "Стоимость и способ доставки согласует дилер при подтверждении заявки: обычно это встреча в вашем городе или передача через салон-партнёр."}, {"q": "Как оплатить?", "a": "Оплатите дилеру при получении: детали (наличные/перевод) согласуете при встрече."}, {"q": "Как оформляется заявка", "a": "Отправляете заявку с телефоном — подтверждаем наличие и доставку в ваш город через ближайший салон-дилера. Оплата — при получении, без предоплаты."}], "image": "/assets/sku/portable-type2.webp", "related": [{"href": "/catalog/portativnaya-zaryadka-gbt-7kw.html", "title": "Зарядки"}], "desc": "Переносная зарядка Type 2 3,5 кВт: аварийная и ночная зарядка от бытовой розетки 220 В. Для гибридов (PHEV) это то, что нужно: больше мощности бортовое зарядное"});
const fit = (d.fit || []).filter((f) => typeof f === 'object');
const faqLd = d.faq && d.faq.length ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) } : null;
const prodLd = { '@context': 'https://schema.org', '@type': 'Product', name: d.title, description: d.desc, image: d.image ? 'https://zapashoda-ev.ru' + d.image : undefined, offers: { '@type': 'Offer', price: String(d.price), priceCurrency: 'RUB', availability: 'https://schema.org/InStock' } };
---
<ZhLayout title={d.title + ' — заказать | Запас хода'} description={d.desc} jsonld={[prodLd, faqLd].filter(Boolean)}>
  <section class="sec">
    <div class="wrap" style="max-width:820px">
      <div class="crumbs"><a href="/">Главная</a> / <a href="/catalog/">Каталог</a> / {d.title}</div>
      <h1>{d.title}</h1>
      {d.image && <img src={d.image} alt={d.title} loading="lazy" style="width:100%;max-width:460px;border-radius:16px;margin:6px 0 8px" />}
      <p class="lead">{d.lead}</p>
      <div style="display:flex;align-items:center;gap:18px;margin-top:26px">
        <b style="font-size:28px;white-space:nowrap">{d.price} ₽</b>
        <a class="btn btn-gold" style="text-decoration:none" href={'https://zapashoda-ev.ru' + d.url} rel="nofollow">Заказать</a>
      </div>
      {d.spec.length > 0 && (
        <>
          <h2 style="margin-top:44px">Характеристики</h2>
          <table class="spec" style="margin-top:14px">
            <tbody>{d.spec.map(([k, v]) => <tr><td>{k}</td><td><b>{v}</b></td></tr>)}</tbody>
          </table>
        </>
      )}
      {fit.length > 0 && (
        <>
          <h2 style="margin-top:44px">Подходит для</h2>
          <p style="color:var(--txt-muted);font-size:15px;margin-top:10px">Проверьте совместимость по разъёмам — на странице каждой модели:</p>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:14px">
            {fit.map((f) => <a class="chip" style="text-decoration:none" href={f.href.replace('.html', '/')}>{f.title}</a>)}
          </div>
        </>
      )}
      {d.faq.length > 0 && (
        <>
          <h2 style="margin-top:44px">Частые вопросы</h2>
          <div class="faqbox" style="margin-top:14px">
            {d.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
          </div>
        </>
      )}
      {d.related.length > 0 && (
        <>
          <h2 style="margin-top:44px">Похожие товары</h2>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:14px">
            {d.related.map((r) => <a class="chip" style="text-decoration:none" href={r.href}>{r.title}</a>)}
          </div>
        </>
      )}
      <div style="margin-top:40px">
        <a class="btn btn-ghost" style="text-decoration:none" href="/quiz/">Подобрать под свою модель →</a>
      </div>
    </div>
  </section>
</ZhLayout>
