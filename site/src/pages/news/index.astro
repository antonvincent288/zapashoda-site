---
import ZhLayout from '../../layouts/ZhLayout.astro';
const cards = [{"href": "/news/2026-10-29-adapter-type2-gbt-glavnyj.html", "title": "Адаптер Type 2 → GB/T: главный аксессуар китайского EV", "desc": "Без него китайский электромобиль не зарядится от наших станций. На что смотреть при выборе."}, {"href": "/news/2026-10-29-stoimost-100-km.html", "title": "Сколько стоит 100 км на электромобиле: считаем в рублях", "desc": "Дома ночью — 250–350 ₽ за 100 км. На быстрой станции — в разы дороже. Разбор с цифрами."}, {"href": "/news/2026-10-29-zima-30-40-procentov.html", "title": "Зимой электромобиль теряет до 30–40% запаса хода. Что делать", "desc": "Минус за окном — минус километры на приборке. Приёмы, которые возвращают часть запаса хода."}, {"href": "/news/2026-10-30-5-oshibok-novichka-zimoy.html", "title": "5 ошибок новичка зимой на электромобиле", "desc": "Ловить 100% на морозе, гонять на 90+, игнорировать подогрев — разбираем по пунктам."}, {"href": "/news/2026-10-30-gbt-kak-zaryazhat-kitajcev.html", "title": "Разъёмы GB/T: как заряжать китайский электромобиль в России", "desc": "У Zeekr, Voyah, BYD и Li Auto свой разъём. Рассказываем, какие адаптеры нужны и почему."}, {"href": "/news/2026-10-30-karta-zaryadnyh-stancij.html", "title": "Карта зарядных станций теперь на сайте", "desc": "Живая карта ЗУ по данным OpenStreetMap: Москва, СПб, Казань, Екатеринбург и другие города."}, {"href": "/news/2026-10-30-vin-epts-sbkts-proverka.html", "title": "VIN, ЭПТС и СБКТС: что проверить перед покупкой параллельного импорта", "desc": "Совпадение VIN на кузове и в ЭПТС, наличие СБКТС, бесплатная проверка ГИБДД — чек-лист."}, {"href": "/news/2026-10-30-wltp-vs-realnost.html", "title": "Заявленный запас хода и реальный: почему WLTP врёт на 20–35%", "desc": "WLTP, EPA и CLTC считают по-разному. Реальный пробег — на 20–35% меньше заявленного."}, {"href": "/news/2026-10-31-skolko-zhivet-batareya.html", "title": "Сколько живёт батарея электромобиля: факты вместо страшилок", "desc": "Деградация 10–15% за 5–7 лет при нормальной эксплуатации. Что реально убивает батарею."}];
---
<ZhLayout title="Новости и разборы — Запас хода" description="Новости сайта, разборы и обновления зарядной инфраструктуры для электромобилей в России.">
  <section class="sec">
    <div class="wrap">
      <div class="crumbs"><a href="/">Главная</a> / Новости</div>
      <h1>Новости и разборы</h1>
      <p class="lead">Что нового на «Запасе хода»: обновления каталога, новые гайды и разборы.</p>
      <div class="mgrid" style="margin-top:36px">
        {cards.map((c) => (
          <a class="mcard" href={c.href}>
            <b>{c.title}</b>
            <div class="ports">{c.desc}</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</ZhLayout>
