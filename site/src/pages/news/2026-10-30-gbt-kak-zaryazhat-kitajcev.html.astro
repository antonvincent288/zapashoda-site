import ZhLayout from '../../layouts/ZhLayout.astro';
const d = JSON.parse({"title": "Разъёмы GB/T: как заряжать китайский электромобиль в России", "desc": "У Zeekr, Voyah, BYD и Li Auto свой разъём. Рассказываем, какие адаптеры нужны и почему.", "body": "<a class=\"back\" href=\"/news/\">← Все новости</a><h1>Разъёмы GB/T: как заряжать китайский электромобиль в России</h1><p class=\"newsdate\">30 октября 2026 · Запас хода</p><p>Машины, ввезённые из Китая, заряжаются через разъём GB/T — китайский стандарт. Он отличается от европейских Type 2/CCS2, которые стоят на наших станциях.</p><p><b>Дома.</b> Для медленной зарядки от Type 2-станции нужен адаптер <b>Type 2 → GB/T</b>. Обычные домашние сети в России работают на 22 кВт — адаптер должен тянуть ту же мощность, иначе получите 3–7 кВт вместо положенных.</p><p><b>На трассе.</b> Для быстрой зарядки на CCS2-станциях нужен DC-адаптер <b>CCS2 → GB/T</b>. Это отдельная, более дорогая история: он работает с жидкостным охлаждением и тянуть большие мощности.</p><p><b>Проверьте свой порт.</b> Разъём зависит от рынка вывоза, а не от марки. Машины для Европы часто имеют Type 2/CCS2 без адаптеров — смотрите фото лючка или VIN.</p><p>Полное руководство — <a href=\u0027/pain/adapter-gbt.html\u0027>«Адаптеры для китайских электромобилей»</a>.</p><h2>Связанные страницы справочника</h2><p class=\"note\"><a href=\u0027/pain/adapter-gbt.html\u0027>Адаптеры GB/T: какие нужны</a>, <a href=\u0027/models/zeekr-001-001-fr.html\u0027>Zeekr 001: разъёмы</a>, <a href=\u0027/models/voyah-free-ev-rannie-ofitsialnye-ru.html\u0027>Voyah Free: разъёмы</a></p><hr class=\"sep\">"});
---
