---
import Layout from '~/layouts/Layout.astro';

const title = `Страница не найдена`;
---

<Layout metadata={{ title }}>
  <section class="flex items-center h-full p-16">
    <div class="container flex flex-col items-center justify-center px-5 mx-auto my-8">
      <div class="max-w-md text-center">
        <h2 class="mb-8 font-bold text-9xl">
          <span class="sr-only">Error</span>
          <span class="text-primary">404</span>
        </h2>
        <p class="text-3xl font-semibold md:text-3xl">Такой страницы нет — возможно, она переехала.</p>
        <p class="mt-4 mb-8 text-lg text-muted dark:text-slate-400">
          Загляните в каталог моделей, блог или карту зарядных станций.
        </p>
        <div class="flex gap-3 justify-center flex-wrap">
          <a rel="noopener noreferrer" href="/" class="btn">На главную</a>
          <a rel="noopener noreferrer" href="/models/" class="btn">Каталог моделей</a>
          <a rel="noopener noreferrer" href="/charging/" class="btn">Карта станций</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  // Старые прод-URL (*.html) ведут на директории новой структуры.
  if (location.pathname.endsWith('.html') && !location.pathname.startsWith('/assets/')) {
    var t = location.pathname.slice(0, -5);
    var q = location.search;
    location.replace(t.endsWith('/') ? t + q : t + '/' + q);
  }
</script>
