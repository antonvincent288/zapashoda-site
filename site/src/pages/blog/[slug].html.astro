---
export async function getStaticPaths() {
  const mods = import.meta.glob('/src/data/articles/blog/*.json', { eager: true, import: 'default' });
  const entries = Object.entries(mods).map(([p, a]) => {
    const file = p.split('/').pop().replace(/\.json$/, '');
    return { file, real: String((a as any).slug || file) };
  });
  return entries.map((e) => ({ params: { slug: e.file }, props: { real: e.real } }));
}
const { real } = Astro.props;
const target = 'https://zapashoda-ev.ru/blog/' + real + '/';
---
<!doctype html>
<html lang="ru-RU"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex, follow">
<link rel="canonical" href={target}>
<meta http-equiv="refresh" content={"0; url=" + target}>
<title>Страница переехала</title>
</head>
<body>
<script is:inline set:html={"location.replace(" + JSON.stringify(target) + ");"}></script>
<p>Страница переехала: <a href={target}>{target}</a></p>
</body>
</html>
