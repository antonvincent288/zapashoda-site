---
import LeadCTA from '../../components/LeadCTA.astro';
import ZhLayout from '../../layouts/ZhLayout.astro';
import { priceFix } from '../../lib/prices';
export async function getStaticPaths() {
  const modules = import.meta.glob('../../data/articles/blog/*.json', { eager: true, import: 'default' });
  const seen: Map<string, number>= new Map();
  return Object.values(modules).map((val) =>{
    const a = val as any;
    let slug = String(a.slug || 'post');
    const n = (seen.get(slug) || 0) + 1;
    seen.set(slug, n);
    if (n >1) slug = slug + '-' + n;
    return { params: { slug }, props: { a } };
  });
}
const { a } = Astro.props;
const extraRaw = String(a.extra_html || '')
  .replace(/<section[^>]*class=["'][^"']*comments[^"']*\/[\s\S]*?<\/section>/gi, '')
  .replace(/<section[^>]*id=["']comments["'][^>]*>[\s\S]*?<\/section>/gi, '')
  .replace(/<form[\s\S]*?<\/form>/gi, '')
  .replace(/<script[\s\S]*?<\/script>/gi, '');
const extra = priceFix(extraRaw)
  .replace(/<section[^>]*class=["'][^"']*comments[^"']*[\/][\s\S]*?<\/section>/gi, '')
  .replace(/<section[^>]*id=["']comments["'][^>]*>[\s\S]*?<\/section>/gi, '')
  .replace(/<form[\s\S]*?<\/form>/gi, '')
  .replace(/<script[\s\S]*?<\/script>/gi, '');
const jsonld = { '@context': 'https://schema.org', '@type': 'Article', headline: a.title, description: a.desc, datePublished: a.date, dateModified: a.date, author: { '@type': 'Organization', name: 'Запас хода', url: 'https://zapashoda-ev.ru' }, articleSection: 'Блог' };
---
<ZhLayout publishedTime={a.date} modifiedTime={a.date} title={`${a.title} - Запас хода`} description={a.desc} og={a.og} jsonld={jsonld}><section class="sec"><div class="wrap"><div class="crumbs"><a href="/">Главная</a>/ <a href="/blog/">Блог</a>/ {a.title}</div><div class="artgrid"><aside class="toc"><div>Содержание</div>{(a.headings || []).map((h) =>(
            <a href={'#' + h.id}>{h.text}</a>))}
        </aside><article class="article"><div class="badge">{a.category || "Блог"}</div><h1 style="font-size:clamp(30px,3.8vw,48px)">{a.title}</h1>{a.desc && <p class="lede">{a.desc}</p>}
          <div class="meta">{a.read_min && <span>{a.read_min} мин чтения</span>}
            {a.category && <span>{a.category}</span>}
            {a.date && <span>Обновлено: {a.date}</span>}
          </div><div set:html={priceFix(a.body_html)} />{extra && <div set:html={extra} />}
                    {a.faq && (
            <div class="faqbox"><h2>Частые вопросы</h2>{a.faq.map((f) =>(
                <details><summary>{f.q}</summary><p>{f.a}</p></details>))}
            </div>)}
          {a.faq && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: a.faq.map((f) =>({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) })} />}
<div class="share"><a href={`https://t.me/share/url?url=https://zapashoda-ev.ru/blog/${a.slug}/`} target="_blank" rel="nofollow">Telegram</a><a href="https://t.me/zapashoda_ev" rel="nofollow">Наш канал</a><a href={`https://wa.me/?text=${encodeURIComponent('https://zapashoda-ev.ru/blog/' + a.slug + '/')}`} target="_blank" rel="nofollow">WhatsApp</a><a href="#" data-copy={`https://zapashoda-ev.ru/blog/${a.slug}/`} id="copylink">Скопировать ссылку</a></div><script>var cl = document.getElementById('copylink');
  if (cl) cl.addEventListener('click', function (e) {
    e.preventDefault();
    if (navigator.clipboard) navigator.clipboard.writeText(cl.getAttribute('data-copy'));
    cl.textContent = 'Скопировано ';
  });
</script></article></div></div></section><LeadCTA />
</ZhLayout>