---
import ZhLayout from '../../layouts/ZhLayout.astro';
import LegacyStyles from '../../components/LegacyStyles.astro';
import src from '../../data/legacy/tools.json';
const d = src.find((x) => x.slug === 'compare');
---

<ZhLayout title={d.title} description={d.desc}>
  <section class="sec"><div class="wrap">
    <LegacyStyles />
    <div class="crumbs"><a href="/">Главная</a> / Сравнение моделей</div>

    <style is:global>
      .wz{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px;margin:26px 0}
      .wz-q{font-weight:800;font-size:16.5px;margin:18px 0 10px}
      .wz-q:first-child{margin-top:0}
      .wz-q small{display:block;font-weight:400;color:var(--txt-muted);font-size:13px;margin-top:2px}
      .wz-chips{display:flex;flex-wrap:wrap;gap:10px}
      .wz-chip{padding:12px 18px;border:1.5px solid var(--line);border-radius:14px;background:var(--bg);color:var(--txt);font-size:15.5px;font-weight:600;cursor:pointer;min-height:52px;display:inline-flex;align-items:center;user-select:none;transition:all .15s;font-family:inherit}
      .wz-chip:hover:not(.on){border-color:#0161EF;color:#0161EF}
      .wz-chip.pick1{background:#0161EF;border-color:#0161EF;color:#fff}
      .wz-chip.pick2{background:#d4af37;border-color:#d4af37;color:#1d1d1f}
      details.pro{margin-top:26px;border:1px solid var(--line);border-radius:14px;padding:16px 18px;background:var(--card)}
      details.pro summary{font-weight:700;cursor:pointer;font-size:15.5px;color:var(--txt)}
      details.pro summary .hint{color:var(--txt-muted);font-weight:400;font-size:13px;margin-left:8px}
    </style>

    <h1>Сравнение моделей EV: разъёмы и зарядка</h1>
    <p class="lede">Нажмите сначала первую машину, потом вторую — сравнение появится сразу: разъёмы, скорость зарядки, что докупить. Вводить цифры не нужно.</p>

    <div class="wz" id="wzc">
      <div class="wz-q">Выберите две машины <small>первая подсветится синим (№1), вторая — золотым (№2). Нет вашей в списке — откройте «Все модели» ниже</small></div>
      <div class="wz-chips" id="wzc-models"></div>
    </div>

    <div class="article" set:html={d.body_html} />
    {d.body_script && <script is:inline set:html={d.body_script} />}

    <script is:inline>
    (function(){
      var POP=[
        'Zeekr 001 / 001 FR','Zeekr 007 / 007GT','Zeekr 7X / X / MIX','Zeekr 009 / 009 Grand',
        'Li Auto L6 / L7 / L8 / L9 (2022–2025)','Li Auto Mega','Voyah Free EVR (гибрид)',
        'Voyah Dream / Dreamer (PHEV)','Avatr 11 / 12 (официально RU)','Xiaomi SU7 / SU7 Ultra',
        'BYD Song Plus EV','BYD Seal','BYD Yuan Plus / Atto 3 / Yuan Up / Pro',
        'Deepal S07 (RU официальная)','Geely Galaxy E5 / E8 / TT','Xpeng G9 / G6',
        'Hongqi E-HS9','Leapmotor C10 / C11 / C01 / B10 / A05'
      ];
      var pickA=-1,pickB=-1;
      function getFormBox(){
        var sel=document.getElementById('c-a');
        if(!sel) return null;
        var box=sel.closest('.of-grid');
        return box ? (box.parentElement || box) : null;
      }
      function showFullList(){
        var form=getFormBox();
        if(form){
          if(form.style.display==='none'){
            form.style.display='';
            form.scrollIntoView({behavior:'smooth'});
          }
        }
      }
      function label(b){
        b.textContent=b.textContent.replace(/^① |^② /,'');
        if(b.dataset.pick==='1') b.textContent='① '+b.textContent;
        if(b.dataset.pick==='2') b.textContent='② '+b.textContent;
      }
      function paint(){
        Array.prototype.forEach.call(document.getElementById('wzc-models').children,function(b){
          b.dataset.pick='0';
          if(parseInt(b.dataset.idx,10)===pickA) b.dataset.pick='1';
          if(parseInt(b.dataset.idx,10)===pickB) b.dataset.pick='2';
          b.classList.toggle('pick1',b.dataset.pick==='1');
          b.classList.toggle('pick2',b.dataset.pick==='2');
          label(b);
        });
      }
      function pick(idx,btn){
        if(pickA===idx){pickA=-1;pickB=-1;paint();return;}
        if(pickB===idx){pickB=-1;paint();return;}
        if(pickA<0){pickA=idx;paint();return;}
        pickB=idx;paint();
        if(pickA>=0&&pickB>=0){
          document.getElementById('c-a').value=pickA;
          document.getElementById('c-b').value=pickB;
          if(typeof cShow==='function') cShow();
        }
      }
      function waitReady(tries){
        var a=document.getElementById('c-a');
        if(a){
          var box=document.getElementById('wzc-models');
          POP.forEach(function(name){
            var idx=-1;
            Array.prototype.forEach.call(a.options,function(o,i){
              if(o.textContent.trim()===name) idx=i;
            });
            if(idx<0) return;
            var b=document.createElement('button');
            b.type='button';b.className='wz-chip';b.textContent=name;
            b.dataset.idx=idx;
            b.addEventListener('click',function(){pick(idx,b)});
            box.appendChild(b);
          });
          var tb=document.createElement('button');
          tb.type='button';tb.className='wz-chip';
          tb.textContent='🔍 Все модели (141) — поиск в полном списке';
          tb.addEventListener('click',function(){
            showFullList();
          });
          box.appendChild(tb);
          var form=getFormBox();
          if(form) form.style.display='none';
          paint();
        }else if(tries<25){
          setTimeout(function(){waitReady(tries+1)},80);
        }
      }
      waitReady(0);
    })();
    </script>
  </div></section>
</ZhLayout>
