    </div>
    <div class="share-actions">
      <button class="btn-route" onclick="copyShare()">Скопировать текст</button>
      <button class="btn-ghost" onclick="closeShare()">Закрыть</button>
    </div>
  </div>

  <!-- Нижняя легенда -->
  <div class="bottom-legend">
    <div class="leg-item"><span class="dot dc"></span>Быстрая DC (напрямую)</div>
    <div class="leg-item"><span class="dot adp"></span>Через переходник</div>
    <div class="leg-item"><span class="dot ac"></span>Медленная AC</div>
    <div class="leg-item"><span class="dot unv"></span>Не проверено</div>
    <div class="leg-item"><span style="width:9px;height:9px;border-radius:50%;background:rgba(11,11,13,0.78);border:1.5px dashed #646464;"></span>Точка Яндекса</div>
    <div class="leg-item"><span style="width:9px;height:9px;border-radius:50%;background:rgba(232,80,2,0.15);border:1.5px dashed #E85002;"></span>Кольцо — докуда доедете</div>
  </div>

  <!-- Панель городов снизу, поверх карты -->
  <div id="citySheet" class="city-sheet">
    <div class="city-sheet-head">
      <div>
        <div class="city-sheet-title">Города в базе</div>
        <div class="city-sheet-sub">36 городов России · клик переносит карту и пересчитывает изохрону пробега</div>
      </div>
      <button class="btn-ghost" style="padding: 6px 12px;" onclick="closeCitySheet()">✕</button>
    </div>
    <div class="city-grid" id="cityGrid"></div>
  </div>

  <div class="toast" id="toast"></div>

  <script is:inline src="/dashboard.js"></script>

  <div id="carModal" class="modal-backdrop" onclick="if(event.target===this) closeCarModal()">
    <div class="modal-box">
      <div class="modal-head">
        <div class="modal-title">Выберите электромобиль (154 модели)</div>
        <button class="btn-ghost" style="padding: 6px 12px;" onclick="closeCarModal()">✕</button>
      </div>
      <input id="carFilterInput" class="city-search-input" style="width: 100%;" placeholder="Поиск: Zeekr, BYD, Tesla, Li Auto, Evolute..." oninput="filterModels(this.value)" />
      <div id="modelList" class="model-list"></div>
    </div>
  </div>
</body>
</html>
