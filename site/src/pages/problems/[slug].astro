---
import ZhLayout from '../../layouts/ZhLayout.astro';
export async function getStaticPaths() {
  const modules = import.meta.glob('../../data/articles/pain/*.json', {{ eager: true, import: 'default' }});
  return Object.entries(modules).map(([path, val]) => {{
    const a = val as any;
    let slug = String(a.slug || path.split('/').pop()!.replace('.json', ''));
    return {{ params: {{ slug }}, props: {{ a }} }};
  }});
}
const { a } = Astro.props;
const jsonld = {{ '@context': 'https://schema.org', '@type': 'Article', headline: a.title, description: a.desc, datePublished: a.date, articleSection: 'Проблемы' }};
---
<ZhLayout title={`${a.title} — Запас хода`} description={a.desc} og={a.og} jsonld={jsonld}>
  <section class="sec">
    <div class="wrap">
      <div class="crumbs"><a href="/">Главная</a> / <a href="/problems/">Проблемы</a> / {a.title}</div>
      <div class="artgrid">
        <aside class="toc">
          <div>Содержание</div>
          {a.headings && <Fragment set:html={a.headings} />}
        </aside>
        <article class="article">
          <h1 style="font-size:clamp(28px,3.4vw,40px)">{a.title}</h1>
          {a.desc && <p class="lead">{a.desc}</p>}
          <div class="meta">
            {a.category && <span>{a.category}</span>}
            {a.date && <span>📅 {a.date}</span>}
            {a.read_min && <span>⏱ {a.read_min} мин</span>}
          </div>
          <div set:html={a.body_html} />
          {a.extra_html && <div set:html={a.extra_html} />}
          <div class="share"><span>Telegram</span><span>WhatsApp</span><span>Скопировать ссылку</span></div>
        </article>
      </div>
    </div>
  </section>
</ZhLayout>
