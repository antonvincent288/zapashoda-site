---
import ZhLayout from '../../layouts/ZhLayout.astro';
import models from '../../data/models_light.json';
const M = (models.models || []);
const ld = { '@context': 'https://schema.org', '@type': 'WebPage', name: 'Подбор комплекта зарядки', description: 'Подбор адаптеров и зарядки для электромобиля за 30 секунд: марка, модель, разъёмы.' };
---
<ZhLayout title="Подбор адаптеров и зарядки за 30 секунд — Запас хода" description="Ответьте на два вопроса — покажем разъёмы вашей модели, нужные адаптеры и сценарий зарядки." jsonld={ld}>
  <section class="sec">
    <div class="wrap" style="max-width:820px">
      <div class="crumbs"><a href="/">Главная</a> / Подбор</div>
      <h1>Подбор комплекта зарядки под вашу модель</h1>
      <p class="lead">Два шага — и вы видите разъёмы вашей машины, нужные адаптеры и что купить.</p>
      <div id="step-brand">
        <h2>Шаг 1. Марка</h2>
        <div id="brand-chips" style="display:flex;gap:10px;flex-wrap:wrap;margin-top:18px">        <button class="chip" data-brand="AITO">AITO</button>
        <button class="chip" data-brand="Audi">Audi</button>
        <button class="chip" data-brand="Avatr">Avatr</button>
        <button class="chip" data-brand="BMW">BMW</button>
        <button class="chip" data-brand="BYD">BYD</button>
        <button class="chip" data-brand="Changan">Changan</button>
        <button class="chip" data-brand="Chery">Chery</button>
        <button class="chip" data-brand="Chevrolet">Chevrolet</button>
        <button class="chip" data-brand="Citroën">Citroën</button>
        <button class="chip" data-brand="Cupra">Cupra</button>
        <button class="chip" data-brand="Dacia">Dacia</button>
        <button class="chip" data-brand="Deepal">Deepal</button>
        <button class="chip" data-brand="Denza (BYD)">Denza (BYD)</button>
        <button class="chip" data-brand="Dongfeng">Dongfeng</button>
        <button class="chip" data-brand="Evolute">Evolute</button>
        <button class="chip" data-brand="Exeed">Exeed</button>
        <button class="chip" data-brand="FAW">FAW</button>
        <button class="chip" data-brand="Fiat">Fiat</button>
        <button class="chip" data-brand="Ford">Ford</button>
        <button class="chip" data-brand="GAC">GAC</button>
        <button class="chip" data-brand="GMC">GMC</button>
        <button class="chip" data-brand="Geely">Geely</button>
        <button class="chip" data-brand="Genesis">Genesis</button>
        <button class="chip" data-brand="Haval">Haval</button>
        <button class="chip" data-brand="HiPhi">HiPhi</button>
        <button class="chip" data-brand="Honda">Honda</button>
        <button class="chip" data-brand="Hongqi">Hongqi</button>
        <button class="chip" data-brand="Hyundai">Hyundai</button>
        <button class="chip" data-brand="IM Motors">IM Motors</button>
        <button class="chip" data-brand="JAC">JAC</button>
        <button class="chip" data-brand="Jaecoo">Jaecoo</button>
        <button class="chip" data-brand="Jaguar">Jaguar</button>
        <button class="chip" data-brand="Jetour">Jetour</button>
        <button class="chip" data-brand="Kaiyi">Kaiyi</button>
        <button class="chip" data-brand="Kia">Kia</button>
        <button class="chip" data-brand="Leapmotor">Leapmotor</button>
        <button class="chip" data-brand="Lexus">Lexus</button>
        <button class="chip" data-brand="Li Auto">Li Auto</button>
        <button class="chip" data-brand="Livan">Livan</button>
        <button class="chip" data-brand="Lotus">Lotus</button>
        <button class="chip" data-brand="Lucid">Lucid</button>
        <button class="chip" data-brand="Luxeed (Chery/Huawei)">Luxeed (Chery/Huawei)</button>
        <button class="chip" data-brand="Lynk &amp; Co">Lynk &amp; Co</button>
        <button class="chip" data-brand="M-Hero">M-Hero</button>
        <button class="chip" data-brand="MG">MG</button>
        <button class="chip" data-brand="Mazda">Mazda</button>
        <button class="chip" data-brand="Mercedes">Mercedes</button>
        <button class="chip" data-brand="Mini">Mini</button>
        <button class="chip" data-brand="Mitsubishi">Mitsubishi</button>
        <button class="chip" data-brand="Moskvich">Moskvich</button>
        <button class="chip" data-brand="Neta">Neta</button>
        <button class="chip" data-brand="Nissan">Nissan</button>
        <button class="chip" data-brand="Onvo (NIO)">Onvo (NIO)</button>
        <button class="chip" data-brand="Opel">Opel</button>
        <button class="chip" data-brand="Ora">Ora</button>
        <button class="chip" data-brand="Peugeot">Peugeot</button>
        <button class="chip" data-brand="Polestar">Polestar</button>
        <button class="chip" data-brand="Porsche">Porsche</button>
        <button class="chip" data-brand="Renault">Renault</button>
        <button class="chip" data-brand="Rivian">Rivian</button>
        <button class="chip" data-brand="Roewe">Roewe</button>
        <button class="chip" data-brand="SWM">SWM</button>
        <button class="chip" data-brand="Seres">Seres</button>
        <button class="chip" data-brand="Skoda">Skoda</button>
