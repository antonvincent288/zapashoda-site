        <button class="chip" data-brand="Smart">Smart</button>
        <button class="chip" data-brand="Stelato (BAIC/Huawei)">Stelato (BAIC/Huawei)</button>
        <button class="chip" data-brand="Tank">Tank</button>
        <button class="chip" data-brand="Tesla">Tesla</button>
        <button class="chip" data-brand="Toyota">Toyota</button>
        <button class="chip" data-brand="VW">VW</button>
        <button class="chip" data-brand="Volvo">Volvo</button>
        <button class="chip" data-brand="Voyah">Voyah</button>
        <button class="chip" data-brand="Wuling / Hongguang">Wuling / Hongguang</button>
        <button class="chip" data-brand="Xiaomi">Xiaomi</button>
        <button class="chip" data-brand="Xpeng">Xpeng</button>
        <button class="chip" data-brand="Zeekr">Zeekr</button>
        <button class="chip" data-brand="iCAR">iCAR</button>
      </div>
      </div>
      <div id="step-model" style="display:none">
        <h2 style="margin-top:36px">Шаг 2. Модель</h2>
        <a class="chip" style="cursor:pointer" onclick="document.getElementById('step-model').style.display='none';document.getElementById('step-brand').style.display=''">← другая марка</a>
        <div id="model-chips" style="display:flex;gap:10px;flex-wrap:wrap;margin-top:18px"></div>
      </div>
      <div id="step-result" style="display:none">
        <h2 style="margin-top:36px">Ваш комплект</h2>
        <div id="result" style="margin-top:18px"></div>
        <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:24px">
          <a id="res-model" class="btn btn-gold" style="text-decoration:none" href="/models/">Карточка модели</a>
          <a class="btn btn-ghost" style="text-decoration:none" href="/charging/">Карта станций</a>
        </div>
        <a class="chip" style="cursor:pointer;margin-top:18px" onclick="this.closest('#step-result').style.display='none';document.getElementById('step-brand').style.display=''">← начать заново</a>
      </div>
    </div>
  </section>
  <script define:vars={{ M }}>
    (function () {
      var box1 = document.getElementById('brand-chips');
      var brands = Array.from(new Set(M.map(function (m) { return String(m.brand || '—'); }))).sort();
      Array.prototype.forEach.call(box1.querySelectorAll('button.chip'), function (c) {
        var b = c.textContent;
        c.addEventListener('click', function () {
          var box2 = document.getElementById('model-chips');
          box2.innerHTML = '';
          M.filter(function (m) { return m.brand === b; }).forEach(function (m) {
            var c2 = document.createElement('button');
            c2.className = 'chip'; c2.textContent = m.name || m.slug;
            c2.addEventListener('click', function () { showResult(m); });
            box2.appendChild(c2);
          });
          document.getElementById('step-brand').style.display = 'none';
          document.getElementById('step-model').style.display = '';
        });
        box1.appendChild(c);
      });
        function plugSlug(p) { p = String(p || ''); return p.indexOf('GB/T') >= 0 ? 'gbt' : (p.indexOf('CHAdeMO') >= 0 ? 'chademo' : (p.indexOf('Type1') >= 0 ? 'type1' : 'type2')); }
        function plugImg(p) { p = String(p || ''); var k = p.indexOf('GB/T') >= 0 ? 'gbt-dc' : (p.indexOf('CHAdeMO') >= 0 ? 'chademo' : (p.indexOf('Type1') >= 0 ? 'type1' : 'type2')); return '<img src="/assets/img/plugs/zsh-' + k + '.svg" width="18" height="18" alt="" style="vertical-align:-4px;margin-right:4px">'; }
      function showResult(m) {
        var port = String(m.port || '');
        var adapters = [];
        if (/GB\/T/i.test(port)) adapters.push('Адаптер Type 2 → GB/T (AC, 22 кВт) — ваш основной переходник');
        if (/CCS/i.test(port)) adapters.push('Прямое подключение CCS2 на быстрых станциях');
        if (!adapters.length) adapters.push('Прямое подключение Type 2 — переходник не нужен');
        document.getElementById('result').innerHTML =
          '<b style="font-size:19px">' + (m.brand || '') + ' ' + (m.name || '') + '</b>' +
          (m.years ? '<div style="color:var(--txt-muted);margin-top:4px">' + m.years + '</div>' : '') +
          '<div style="margin-top:14px"><b>Разъёмы:</b> ' + (port ? plugImg(port) + ' ' + port + ' <a href="/razemy/' + plugSlug(port) + '/" style="color:var(--gold);font-size:13.5px;text-decoration:none">что за разъём →</a>' : '—') + '</div>' +
          '<div style="margin-top:10px"><b>Что понадобится:</b><ul style="margin:8px 0 0 18px">' + adapters.map(function (a) { return '<li>' + a + '</li>'; }).join('') + '</ul></div>';
        document.getElementById('res-model').href = '/models/' + m.slug + '/';
        document.getElementById('step-model').style.display = 'none';
        document.getElementById('step-result').style.display = '';
      }
    })();
  </script>
</ZhLayout>
