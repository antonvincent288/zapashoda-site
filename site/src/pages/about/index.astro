---
import ZhLayout from '../../layouts/ZhLayout.astro';
const paras = ["Запас хода — проект о практической зарядке электромобилей в России. Мы собираем то, чего нет ни у кого: разъёмы каждой модели на российском рынке, реальные сценарии зарядки, карты станций и честную цену владения.", "Каталог моделей — какой у вашей машины разъём, какой адаптер нужен и сколько это стоит. Карта ЗУ — 2000+ зарядных станций по всей стране. Разделы «Проблемы» и «Блог» — решения реальных кейсов владельцев.", "Для бизнеса — B2B-поставки зарядного оборудования автосалонам, ТЦ и паркингам: дилерские цены, пилотные партии и готовая витрина компетенции.", "Мы работаем, чтобы владелец электромобиля в России платил за зарядку меньше и нервов тратил тоже меньше."];
const ld = { '@context': 'https://schema.org', '@type': 'AboutPage', name: 'О проекте «Запас хода»' };
---
<ZhLayout title="О проекте — Запас хода" description="Запас хода: практика зарядки электромобилей в России — каталог моделей, карта станций, проблемы и решения." jsonld={ld}>
  <section class="sec">
    <div class="wrap" style="max-width:780px">
      <div class="crumbs"><a href="/">Главная</a> / О проекте</div>
      <h1>О проекте</h1>
      <p class="lead">Практика зарядки EV в России: разъёмы, адаптеры, станции, деньги.</p>
      {paras.map((p) => <p style="margin:16px 0">{p}</p>)}
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:28px">
        <a class="btn btn-gold" style="text-decoration:none" href="/quiz/">Подобрать зарядку</a>
        <a class="btn btn-ghost" style="text-decoration:none" href="/blog/">Читать разборы</a>
      </div>
    </div>
  </section>
</ZhLayout>
