---
import ZhLayout from '../../layouts/ZhLayout.astro';
import src from '../../data/pages_about.json';
const d = src.items[0];
const ld = { '@context': 'https://schema.org', '@type': 'AboutPage', name: 'О проекте «Запас хода»' };
---
<ZhLayout title="О проекте — Запас хода" description={d.desc} jsonld={ld}>
  <section class="sec">
    <div class="wrap">
      <div class="crumbs"><a href="/">Главная</a> / О проекте</div>
      <div class="article" set:html={d.body} />
    </div>
  </section>
</ZhLayout>
