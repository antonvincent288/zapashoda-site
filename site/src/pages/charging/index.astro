      var PORT_ADAPT = { 'gb/t': ['type2', 'type2_socket', 'ccs2'], 'eu': ['gbt_dc', 'gbt_ac'], 'type1/ccs1': ['type2', 'type2_socket'], 'jp/chademo': ['type2', 'type1'] };
      var ADAPTER_LABEL = { 'gb/t': 'GB/T → Type 2', 'eu': 'Type 2 → GB/T', 'type1/ccs1': 'Type 1 → Type 2', 'jp/chademo': 'Type 2 → CHAdeMO (где есть)' };
      var carSel = null, carPort = null, carEntry = null, curTemp = null;
      function fitOk(s) { return !carSel || !!s.__fit; }
      function classifyAll() {
        ALL.forEach(function (m) {
          var s = m.__s, c = s.__c || {};
          var direct = PORT_DIRECT[carPort] || [], adapt = PORT_ADAPT[carPort] || [];
          var fit = null;
          if (direct.some(function (k) { return c[k]; })) fit = 'direct';
          else if (adapt.some(function (k) { return c[k]; })) fit = 'adapt';
          else fit = 'unknown';
          s.__fit = fit;
          if (carSel && m.setStyle) {
            m.setStyle({ color: (fit === 'direct' ? (s.__dc ? '#2563eb' : '#16a34a') : fit === 'adapt' ? (s.__dc ? '#f97316' : '#eab308') : '#8a8f98'), fillColor: (fit === 'direct' ? (s.__dc ? '#2563eb' : '#16a34a') : fit === 'adapt' ? (s.__dc ? '#f97316' : '#eab308') : '#8a8f98') });
          } else if (!carSel && m.setStyle) {
            m.setStyle({ color: s.__dc ? '#2563eb' : '#16a34a', fillColor: s.__dc ? '#2563eb' : '#16a34a' });
          }
        });
      }
      function tempFactor(t) {
        if (t === null || t === undefined || isNaN(t)) return 1;
        if (t <= 15) return Math.max(0.55, 1 - 0.018 * (15 - t));
        if (t >= 25) return Math.max(0.82, 1 - 0.007 * (t - 25));
        return 1;
      }
      var SCN_FACTORS = { base: 1, cold: 0.72, ac: 0.9, hw: 0.85 };
      var SCN_NAMES = { cold: 'Мороз', ac: 'Кондиционер', hw: 'Трасса 110+' };
      var scnCur = 'base';
      function updateRange() {
        var big = document.getElementById('range-big'), capl = document.getElementById('range-cap'), note = document.getElementById('range-note');
        if (!big) return;
        if (!carEntry || !carEntry.cap) { big.textContent = '— км'; capl.textContent = 'выберите модель — покажем реальный запас'; if (note) note.textContent = ''; return; }
        var soc = Number((document.getElementById('range-soc') || {}).value || 80);
        var socVal = document.getElementById('soc-val'); if (socVal) socVal.textContent = soc + '%';
        var summer = Math.round(carEntry.cap * 6.2 * soc / 100);
        var tF = tempFactor(curTemp), sF = SCN_FACTORS[scnCur] || 1;
        var real = Math.round(summer * tF * sF);
        big.textContent = '~' + real + ' км';
        capl.textContent = 'реальный запас сейчас · при заряде ' + soc + '%';
        var parts = [];
        if (tF < 1) parts.push('погода ' + (curTemp > 0 ? '+' : '') + curTemp + ' °C (−' + Math.round((1 - tF) * 100) + '%)');
        if (sF < 1) parts.push('сценарий «' + SCN_NAMES[scnCur] + '» (−' + Math.round((1 - sF) * 100) + '%)');
        if (note) note.textContent = parts.length
          ? ('Паспортный запас ' + summer + ' км · ' + parts.join(' · ') + '. Оценка по среднему расходу 16 кВт·ч/100 км.')
          : ('Паспортный запас ' + summer + ' км — погода и сценарий его не режут.');
      }
      function fetchTemp(lat, lon, label) {
        var chip = document.getElementById('weather-chip');
        if (!chip) return;
        chip.style.display = '';
        chip.innerHTML = chipHTML('погода…');
        try {
          fetch('https://api.open-meteo.com/v1/forecast?latitude=' + lat.toFixed(3) + '&longitude=' + lon.toFixed(3) + '&current=temperature_2m')
            .then(function (r) { return r.json(); })
            .then(function (d) {
              var t = d && d.current && typeof d.current.temperature_2m === 'number' ? Math.round(d.current.temperature_2m) : null;
              if (t === null) { chip.innerHTML = chipHTML('погода недоступна'); return; }
              curTemp = t;
              chip.innerHTML = chipHTML((t > 0 ? '+' : '') + t + ' °C' + (label ? ' · ' + label : ' · рядом с вами'));
              updateRange();
            })
            .catch(function () { chip.innerHTML = chipHTML('погода недоступна'); });
        } catch (e) { chip.innerHTML = chipHTML('погода недоступна'); }
      }
      function setModel(slug) {
        carEntry = null; carSel = slug || null; carPort = null;
        if (slug) {
          carEntry = MODELS.filter(function (m) { return m.slug === slug; })[0] || null;
          if (carEntry) carPort = String(carEntry.port || '').toLowerCase();
        }
        var info = document.getElementById('car-info');
        if (carSel && carEntry) {
          classifyAll();
          // сброс чипов, чтобы показать весь совместимый набор
          active = {};
          document.querySelectorAll('.cchip').forEach(function (x) { x.classList.remove('on'); });
          var box = document.getElementById('conn-chips');
          if (box) { var allb = box.querySelector('.cchip:last-child'); if (allb && allb.textContent === 'Все станции') allb.classList.add('on'); }
          var direct = ALL.filter(function (m) { return m.__s.__fit === 'direct'; }).length; var ddc = ALL.filter(function (m) { return m.__s.__fit === 'direct' && m.__s.__dc; }).length;
          var adapt = ALL.filter(function (m) { return m.__s.__fit === 'adapt'; }).length; var adc = ALL.filter(function (m) { return m.__s.__fit === 'adapt' && m.__s.__dc; }).length;
          var unk = ALL.filter(function (m) { return m.__s.__fit === 'unknown'; }).length;
          var portName = String(carEntry.port || '');
          info.innerHTML = '<b style="color:var(--txt)">' + (carEntry.brand ? carEntry.brand + ' ' : '') + carEntry.name + '</b> · порт ' + portName +
            (carEntry.type ? ' · ' + carEntry.type : '') +
            (carEntry.cap ? ' · ' + carEntry.cap + ' кВт·ч' : '') +
            '<div style="margin-top:8px;display:flex;flex-direction:column;gap:6px">' +
            '<div>Синие — быстрые DC напрямую: <b style="color:#2563eb">' + ddc + '</b></div>' +
            '<div>Зелёные — AC напрямую: <b style="color:#16a34a">' + (direct - ddc) + '</b></div>' +
            '<div>Оранжевые — быстрые DC через адаптер: <b style="color:#f97316">' + adc + '</b></div>' +
            '<div>Жёлтые — AC через адаптер: <b style="color:#eab308">' + (adapt - adc) + '</b></div>' +
            '<div>Серые — разъём не подтверждён: <b style="color:#8a8f98">' + unk + '</b> (не блокируем)</div>' +
            '</div><a href="/catalog/?model=' + encodeURIComponent(slug) + '" style="color:#4d9bf5;text-decoration:underline;display:inline-block;margin-top:10px">' + (adapt > 0 && ADAPTER_LABEL[carPort] ? 'Нужен адаптер ' + ADAPTER_LABEL[carPort] + ' — подобрать в каталоге' : 'Адаптеры и кабели для вашей модели') + '</a>';
          applyFilter();
        } else {
          classifyAll();
          info.textContent = '';
          applyFilter();
        }
        try { var qp2 = new URLSearchParams(location.search); if (slug) qp2.set('model', slug); else qp2.delete('model'); var qs2 = qp2.toString(); history.replaceState(null, '', location.pathname + (qs2 ? '?' + qs2 : '') + location.hash); } catch (e) {}
        updateRange();
      }
      var selCar = document.getElementById('car-model');
      if (selCar) selCar.addEventListener('change', function () { setModel(selCar.value || null); try { if (selCar.value) localStorage.setItem('zh_selected_car', selCar.value); else localStorage.removeItem('zh_selected_car'); } catch (e) {} });
            // комбо-поиск модели + память выбора (localStorage)
      var carInput = document.getElementById('car-search'), carList = document.getElementById('car-list'), carClear = document.getElementById('car-clear');
      if (carInput && carList && selCar) {
        var SYN = { 'zeekr': 'зик зикр зекр', 'li auto': 'ли лисян ли авто', 'voyah': 'воя воях вояж', 'byd': 'бид буд', 'tesla': 'тесла', 'geely': 'джили', 'changan': 'чанган', 'avatr': 'аватр', 'hongqi': 'хунцы хончи', 'xpeng': 'икспенг экспенг', 'xiaomi': 'сяоми ксяоми', 'volkswagen': 'фольксваген фв', 'vw': 'фольксваген фв', 'bmw': 'бмв', 'mercedes': 'мерседес мерс', 'audi': 'ауди', 'nissan': 'ниссан лиф', 'evolute': 'эволют', 'moskvich': 'москвич', 'amberauto': 'амберавто' };
        var carItems = [];
        selCar.querySelectorAll('option[value]').forEach(function (o) {
          if (!o.value) return;
          var lab = o.textContent, brand = lab.split(' · ')[0].toLowerCase();
          carItems.push({ slug: o.value, label: lab, search: (lab + ' ' + (SYN[brand] || '') + ' ' + o.value).toLowerCase() });
        });
        var renderCarList = function (q) {
          q = String(q || '').trim().toLowerCase();
          var hits = carItems.filter(function (it) { return !q || it.search.indexOf(q) >= 0; });
          carList.innerHTML = '';
          hits.slice(0, 30).forEach(function (it) {
            var b = document.createElement('button');
            b.type = 'button'; b.setAttribute('role', 'option');
            b.style.cssText = 'display:block;width:100%;text-align:left;padding:11px 12px;border:0;border-radius:8px;background:transparent;color:var(--txt);font-size:15px;cursor:pointer;min-height:44px;font-family:inherit';
            b.textContent = it.label;
            b.addEventListener('click', function () { pickCar(it); });
            b.addEventListener('mouseenter', function () { b.style.background = 'rgba(77,155,245,.12)'; });
            b.addEventListener('mouseleave', function () { b.style.background = 'transparent'; });
            carList.appendChild(b);
          });
          if (!hits.length) {
            var e = document.createElement('div');
            e.style.cssText = 'padding:12px;color:var(--txt-muted);font-size:14px';
            e.textContent = 'Не нашли «' + (q || '…') + '» — напишите в Telegram, добавим.';
            carList.appendChild(e);
          }
          carList.style.display = 'block';
        };
        var pickCar = function (it) {
          selCar.value = it.slug;
          selCar.dispatchEvent(new Event('change'));
          carInput.value = it.label;
          if (carClear) carClear.style.display = '';
          carList.style.display = 'none';
        };
        var syncCarInput = function () {
          var o = selCar.options[selCar.selectedIndex];
          if (o && o.value) { carInput.value = o.textContent; if (carClear) carClear.style.display = ''; }
          else { carInput.value = ''; if (carClear) carClear.style.display = 'none'; }
        };
        carInput.addEventListener('input', function () { renderCarList(carInput.value); if (carClear) carClear.style.display = carInput.value ? '' : 'none'; });
        carInput.addEventListener('focus', function () { renderCarList(carInput.value); });
        carInput.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') { var f = carList.querySelector('[role=option]'); if (f) { e.preventDefault(); f.click(); } }
          else if (e.key === 'Escape') { carList.style.display = 'none'; }
        });
        if (carClear) carClear.addEventListener('click', function () {
          carInput.value = ''; carClear.style.display = 'none';
          selCar.value = ''; selCar.dispatchEvent(new Event('change'));
          carList.style.display = 'none'; carInput.focus();
        });
        document.addEventListener('click', function (e) { if (!carList.contains(e.target) && e.target !== carInput) carList.style.display = 'none'; });
        syncCarInput();
      }
      document.querySelectorAll('.soc-preset').forEach(function (b) {
        b.addEventListener('click', function () {
          var r = document.getElementById('range-soc');
          if (!r) return;
          r.value = b.getAttribute('data-soc');
          r.dispatchEvent(new Event('input', { bubbles: true }));
        });
      });
      var socEl = document.getElementById('range-soc');
      if (socEl) socEl.addEventListener('input', updateRange);
      var scnRow = document.getElementById('scn-row');
      if (scnRow) scnRow.addEventListener('click', function (ev) {
        var b = ev.target && ev.target.closest ? ev.target.closest('.scn') : null;
        if (!b) return;
        scnCur = b.getAttribute('data-scn') || 'base';
        scnRow.querySelectorAll('.scn').forEach(function (x) { x.classList.toggle('on', x === b); x.setAttribute('aria-checked', x === b ? 'true' : 'false'); });
        var sn = document.getElementById('scn-name'); if (sn) sn.textContent = b.textContent || '';
        updateRange();
      });
      try { if (window.innerWidth < 881) { var rt = document.getElementById('range-tune'); if (rt) rt.removeAttribute('open'); } } catch (e) {}
      // авто-погода на старте: Москва как нейтральная точка; после геолокации/города пересчитается
      fetchTemp(55.7559, 37.6177, 'Москва');

      // ===== Памятка: текст, копирование, Telegram, диплинк =====
      var memoKey = null, memoTemp = null;
      function connLine(s) {
        var seen = {}, out = [];
        (s.s || []).forEach(function (raw) {
          var k = normConn(raw);
          if (k && !seen[k]) { seen[k] = 1; out.push(k); }
        });
        return out.join(', ');
      }
      function memoText(s) {
        var L = ['ПАМЯТКА · zapashoda-ev.ru'];
        if (carEntry) L.push('Машина: ' + (carEntry.brand ? carEntry.brand + ' ' : '') + carEntry.name + ' · порт ' + carEntry.port);
        L.push('Станция: ' + (s.n || 'Станция') + (s.a ? ' · ' + s.a : ''));
        var cl = connLine(s);
        if (cl) L.push('Разъёмы: ' + cl);
        if (s.pw) L.push('Мощность: ' + s.pw + ' кВт');
        L.push('Подключение: ' + (s.__fit === 'direct' ? 'прямое — адаптер не нужен' : s.__fit === 'adapt' ? 'нужен адаптер ' + (ADAPTER_LABEL[carPort] || '') : 'разъём станции не подтверждён — сверьтесь по ссылке 2Chargers'));
        L.push('Температура на станции: ' + (memoTemp !== null ? memoTemp + ' °C' : 'загружаем…'));
        if (carEntry && carEntry.cap) {
          var soc = Number((document.getElementById('range-soc') || {}).value || 80);
          var f = tempFactor(curTemp) * (SCN_FACTORS[scnCur] || 1);
          L.push('Запас при заряде ' + soc + '%: ~' + Math.round(carEntry.cap * 6.2 * soc / 100 * f) + ' км');
        }
        if (s.pw && carEntry && carEntry.cap) L.push('Сессия 20 → 80%: ~' + sessMin(carEntry, Number(s.pw)) + ' мин');
        L.push('Карта и фильтры: ' + memoLink());
        return L.join('\n');
      }
      function escHtml(t) { return String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
      function memoHTML(s) {
        var rows = [];
        if (carEntry) rows.push('<b>' + escHtml((carEntry.brand ? carEntry.brand + ' ' : '') + carEntry.name) + '</b> · порт ' + escHtml(carEntry.port));
        rows.push('<b>' + escHtml(s.n || 'Станция') + '</b>' + (s.a ? ' · ' + escHtml(s.a) : ''));
        var cl = connLine(s);
        if (cl) rows.push('Разъёмы: ' + escHtml(cl));
        if (s.pw) rows.push('Мощность: ' + s.pw + ' кВт');
        rows.push('Подключение: ' + (s.__fit === 'direct' ? '<span style="color:#16a34a;font-weight:600">прямое — адаптер не нужен</span>' : s.__fit === 'adapt' ? '<span style="color:#f59e0b;font-weight:600">нужен адаптер ' + escHtml(ADAPTER_LABEL[carPort] || '') + '</span>' : '<span style="color:#8a8f98">разъём не подтверждён</span>'));
        rows.push('Температура на станции: <b id="memo-temp">загружаем…</b>');
        if (carEntry && carEntry.cap) {
          var soc = Number((document.getElementById('range-soc') || {}).value || 80);
          var f = tempFactor(curTemp) * (SCN_FACTORS[scnCur] || 1);
          rows.push('Запас при заряде ' + soc + '%: <b>~' + Math.round(carEntry.cap * 6.2 * soc / 100 * f) + ' км</b>');
        }
        if (s.pw && carEntry && carEntry.cap) rows.push('Сессия 20 → 80%: <b>~' + sessMin(carEntry, Number(s.pw)) + ' мин</b>');
        var link = memoLink();
        return rows.map(function (r) { return '<div style="margin-bottom:4px">' + r + '</div>'; }).join('') +
          '<div style="margin-top:8px;word-break:break-all"><a href="' + link + '" style="color:#4d9bf5;text-decoration:underline">' + link + '</a></div>' +
          '<div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:9px">' +
          '<button type="button" class="chip" style="padding:6px 10px;font-size:12.5px;cursor:pointer" data-copytext="' + memoKey + '">Скопировать текст</button>' +
          '<a class="chip" style="padding:6px 10px;font-size:12.5px;text-decoration:none" href="https://t.me/share/url?url=' + encodeURIComponent(link) + '&text=' + encodeURIComponent(memoText(s)) + '" target="_blank" rel="noopener">В Telegram</a>' +
          '<a class="chip" style="padding:6px 10px;font-size:12.5px;text-decoration:none" href="https://t.me/zapashoda_ev_bot?text=' + encodeURIComponent(memoText(s)) + '" target="_blank" rel="noopener">На телефон</a>' +
          '</div>';
      }
      function fetchMemoTemp(lat, lon) {
        memoTemp = null;
        try {
          fetch('https://api.open-meteo.com/v1/forecast?latitude=' + lat.toFixed(3) + '&longitude=' + lon.toFixed(3) + '&current=temperature_2m')
            .then(function (r) { return r.json(); })
            .then(function (d) {
              var t = d && d.current && typeof d.current.temperature_2m === 'number' ? Math.round(d.current.temperature_2m) : null;
              if (t !== null) { memoTemp = t; var el = document.getElementById('memo-temp'); if (el) el.textContent = t + ' °C'; }
              else { var e2 = document.getElementById('memo-temp'); if (e2) e2.textContent = 'нет данных'; }
            }).catch(function () { var e3 = document.getElementById('memo-temp'); if (e3) e3.textContent = 'нет данных'; });
        } catch (e) { var e4 = document.getElementById('memo-temp'); if (e4) e4.textContent = 'нет данных'; }
      }
      function openMemo(key) {
        var m = findStationByCoords(key);
        if (!m) return;
        memoKey = key;
        var body = document.getElementById('memo-body');
        if (body) { body.innerHTML = memoHTML(m.__s); body.style.display = ''; }
        fetchMemoTemp(m.__s.lat, m.__s.lon);
      }
      function copyText(text, btn) {
        var done = function () {
          if (!btn) return;
          var old = btn.textContent;
          btn.textContent = 'Скопировано';
          setTimeout(function () { btn.textContent = old; }, 1400);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) { navigator.clipboard.writeText(text).then(done, function () { fallbackCopy(text); done(); }); }
        else { fallbackCopy(text); done(); }
      }
      function fallbackCopy(text) {
        try {
          var ta = document.createElement('textarea');
          ta.value = text; ta.style.cssText = 'position:fixed;opacity:0';
          document.body.appendChild(ta); ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
        } catch (e) {}
      }
      document.addEventListener('click', function (ev) {
        var t = ev.target;
        var el = t && t.closest ? t.closest('[data-memo],[data-copy],[data-copytext]') : null;
        if (!el) return;
        ev.preventDefault();
        if (el.hasAttribute('data-memo')) openMemo(el.getAttribute('data-memo'));
        else if (el.hasAttribute('data-copy')) {
          var s2 = findStationByCoords(el.getAttribute('data-copy'));
          var link2 = location.origin + '/charging/' + (carSel ? '?model=' + encodeURIComponent(carSel) : '') + '&st=' + el.getAttribute('data-copy');
          copyText(link2, el);
        }
        else if (el.hasAttribute('data-copytext')) {
          var s3 = findStationByCoords(el.getAttribute('data-copytext'));
          if (s3) copyText(memoText(s3.__s), el);
        }
      });

      // ===== Вкладки: Яндекс-виджет vs наша фильтр-карта =====
      var yaActive = false, yaFrame = null, yaLL = '37.62,55.75', yaZ = 5, yaText = 'электрозаправки';
      function buildYaUrl() {
        return 'https://yandex.ru/map-widget/v1/?text=' + encodeURIComponent(yaText) + '&ll=' + yaLL + '&z=' + yaZ + '&l=map';
      }
      function ensureYaFrame() {
        if (yaFrame) return;
        yaFrame = document.createElement('iframe');
        yaFrame.style.cssText = 'width:100%;height:100%;border:0';
        yaFrame.src = buildYaUrl();
        yaFrame.title = 'Поиск зарядных станций на Яндекс.Картах';
        yaFrame.loading = 'lazy';
        document.getElementById('map-ya').appendChild(yaFrame);
      }
      function loadYaWidget(pts, city) {
        ensureYaFrame();
        if (pts && pts.length) {
          var lat = pts.reduce(function (a, p) { return a + p[0]; }, 0) / pts.length;
          var lon = pts.reduce(function (a, p) { return a + p[1]; }, 0) / pts.length;
          yaLL = lon.toFixed(4) + ',' + lat.toFixed(4);
          yaZ = Math.max(10, Math.min(14, 11 + (pts.length > 40 ? 1 : 0)));
        }
        if (city) yaText = 'электрозаправки ' + city;
        yaFrame.src = buildYaUrl();
        var note = document.getElementById('geo-note');
        if (note) note.textContent = 'Открыли поиск Яндекс.Карт: «' + yaText + '». Там видны все станции Яндекса, включая живой статус.' ;
      }
      var tYa = document.getElementById('tab-ya'), tOwn = document.getElementById('tab-own');
      function setTab(ya) {
        yaActive = ya;
        document.getElementById('map-ya').style.display = ya ? '' : 'none';
        document.getElementById('map').style.display = ya ? 'none' : '';
        tYa.classList.toggle('on', ya);
        tOwn.classList.toggle('on', !ya);
        if (ya) ensureYaFrame();
        else setTimeout(function () { map.invalidateSize(); }, 50);
        try { history.replaceState(null, '', ya ? '#view=ya' : '#view=own'); } catch (e) {}
      }
      if (tYa) tYa.addEventListener('click', function () { setTab(true); });
      if (tOwn) tOwn.addEventListener('click', function () { setTab(false); });
      try { if (location.hash.indexOf('#view=ya') === 0) setTab(true); } catch (e) {}
