---
import ZhLayout from '../../layouts/ZhLayout.astro';
import fs from 'node:fs';
import modelsLight from '../../data/models_light.json';
import modelsBattery from '../../data/models_battery.json';
const MODELS = (modelsLight.models || [])
  .filter((m) => m && m.slug && m.port)
  .map((m) => {
    const b = modelsBattery[m.slug];
    let cap = null;
    if (b && b.cap) { const v = parseFloat(String(b.cap).replace(',', '.')); if (isFinite(v)) cap = v; }
    return { slug: m.slug, brand: m.brand || '', name: m.name, port: m.port, type: m.type || '', cap: cap };
  })
  .sort((a, b2) => { const ca = /[\u0400-\u04FF]/.test(a.brand) ? 1 : 0; const cb = /[\u0400-\u04FF]/.test(b2.brand) ? 1 : 0; if (ca !== cb) return ca - cb; const na = a.name.startsWith(a.brand + ' ') ? a.name.slice(a.brand.length + 1) : a.name; const nb = b2.name.startsWith(b2.brand + ' ') ? b2.name.slice(b2.brand.length + 1) : b2.name; return (a.brand + na).localeCompare(b2.brand + nb, 'ru'); });
const MODELS_JSON = JSON.stringify(MODELS).replace(/<\//g, '<\\/');
const MODEL_TOTAL = (modelsLight.models || []).filter((m) => m && m.slug).length;
let STN = 3129; let STN_UPD = '12 ноября'; let STN_UPD_FULL = '12 ноября 2026';
try { const rawS = JSON.parse(fs.readFileSync('public/charging/stations.json', 'utf-8')); if (Array.isArray(rawS.stations)) STN = rawS.stations.length;
const mmo = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(rawS.updated || ''));
if (mmo) { const MO = ['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря']; STN_UPD = parseInt(mmo[3], 10) + ' ' + MO[parseInt(mmo[2], 10) - 1]; STN_UPD_FULL = STN_UPD + ' ' + mmo[1]; }
} catch {}
const stnWord = (n) => { const a = n % 10, b = n % 100; return (a === 1 && b !== 11) ? 'станция' : (a >= 2 && a <= 4 && (b < 12 || b > 14)) ? 'станции' : 'станций'; };
const modelWord = (n) => { const a = n % 10, b = n % 100; return (a === 1 && b !== 11) ? 'модель' : (a >= 2 && a <= 4 && (b < 12 || b > 14)) ? 'модели' : 'моделей'; };
const modelGen = (n) => { const a = n % 10, b = n % 100; return (a === 1 && b !== 11) ? 'модели' : 'моделей'; };
const ld = { '@context': 'https://schema.org', '@type': 'WebPage', name: 'Карта зарядных станций', description: 'Карта зарядных станций России: фильтр по вашей модели (GB/T, Type 2, CCS2, CHAdeMO, Type 1), пересчёт запаса хода по реальной температуре за окном, поиск по городу и мощности.' };
---
<ZhLayout title="Карта зарядных станций — Запас хода" description={`Карта ${STN} зарядных станций России: выберите свою модель — покажем только совместимые станции, пересчёт запаса хода по текущей температуре.`} jsonld={ld}>
  <section class="sec zh-cockpit-page">
    <div class="wrap">
      <div class="crumbs"><a href="/">Главная</a> / Карта ЗУ</div>
      <div class="zh-head">
        <div class="zh-head-l">
          <h1>Карта зарядных станций для электромобилей</h1>
          <span class="zh-badge"><span id="stn-count" data-stn-count>{STN}</span> проверенных ЭЗС · без рекламы</span>
        </div>
        <div id="map-tabs" class="zh-seg" role="tablist" aria-label="Режим карты">
          <button id="tab-own" class="zh-seg-btn on" type="button">Наша база</button>
          <button id="tab-ya" class="zh-seg-btn" type="button">Яндекс.Карты</button>
        </div>
      </div>
      <p class="zh-lead-sub">База обновлена <span id="stn-upd">{STN_UPD}</span>. По умолчанию — наша карта с фильтрами по разъёмам (GB/T, Type 1, CCS2, CHAdeMO) и мощности — без рекламы. Нужен полный индекс с живым статусом — вкладка Яндекс.Карт.</p>
<div id="os-widget" style="margin-top:22px;border-radius:20px;padding:20px;overflow:hidden">
        <div class="zh-grid3">
          <div class="zh-cell">
            <label for="car-search" class="zh-label">Ваша машина</label>
            <div style="margin-top:8px">
              <div style="position:relative">
              <select id="car-model" aria-hidden="true" tabindex="-1" style="position:absolute;width:1px;height:1px;opacity:0;pointer-events:none;left:0;top:0">
                <option value="">— выберите модель —</option>
                {MODELS.map((m) => { const n = (m.brand && m.name.toLowerCase().startsWith(m.brand.toLowerCase())) ? m.name.slice(m.brand.length).replace(/^\s+/, '') : m.name; return (<option value={m.slug}>{m.brand ? m.brand + ' · ' : ''}{n}</option>); })}
              </select>
              <span class="zh-inp-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"/></svg></span><input id="car-search" type="text" autocomplete="off" enterkeyhint="search" placeholder="Найдите машину: Zeekr, зик, тесла…" aria-label="Поиск модели автомобиля" style="width:100%;padding:11px 38px;border-radius:12px;border:1px solid rgba(77,155,245,.30);background:rgba(10,16,28,.65);color:var(--txt);font-size:16px;min-height:46px;box-sizing:border-box" />
              <button id="car-clear" type="button" aria-label="Очистить выбор модели" style="position:absolute;right:6px;top:50%;transform:translateY(-50%);width:30px;height:30px;border-radius:50%;border:0;background:transparent;color:var(--txt-muted);font-size:20px;line-height:1;cursor:pointer;display:none">×</button>
              <div id="car-list" role="listbox" aria-label="Список моделей" style="display:none;position:absolute;z-index:60;top:calc(100% + 6px);left:0;right:0;max-height:280px;overflow:auto;background:var(--card);border:1px solid var(--line);border-radius:12px;box-shadow:0 14px 34px rgba(0,0,0,.4);padding:6px"></div>
              </div>
            </div>
          </div>
          <div class="zh-cell zh-soc-cell">
            <label for="range-soc" class="zh-label">Запас хода</label>
            <details id="range-tune" open style="margin-top:8px;position:relative">
              <summary class="zh-capsule">
                <span id="range-big" class="zh-caps-big">— км</span>
                <span class="zh-caps-badges"><b id="soc-val">80%</b><i id="scn-name">База</i></span>
              </summary>
              <div class="zh-pop-inner">
                <div id="range-cap" style="font-size:12.5px;color:#9ecbff;margin-bottom:10px">выберите модель — покажем реальный запас</div>
                <div style="max-width:380px">
                  <label for="range-soc" style="font-size:12.5px;color:var(--txt-muted)">Заряд сейчас</label>
                  <input id="range-soc" type="range" min="10" max="100" step="5" value="80" style="width:100%" />
<div id="soc-presets" style="display:flex;gap:8px;margin-top:10px"><button type="button" class="chip soc-preset" data-soc="20">20%</button><button type="button" class="chip soc-preset" data-soc="50">50%</button><button type="button" class="chip soc-preset" data-soc="80">80%</button><button type="button" class="chip soc-preset" data-soc="100">100%</button></div>
                </div>
                <div id="scn-row" role="radiogroup" aria-label="Сценарий поездки — активен один режим" title="Сценарии исключают друг друга: активен один режим" style="display:flex;gap:8px;flex-wrap:wrap;margin-top:13px">
                  <button type="button" role="radio" aria-checked="true" class="chip scn on" data-scn="base" title="Без поправок: паспортный запас и погода">База</button>
                  <button type="button" role="radio" aria-checked="false" class="chip scn" data-scn="cold" title="Мороз: шины, масло, отопление">Мороз</button>
                  <button type="button" role="radio" aria-checked="false" class="chip scn" data-scn="ac" title="Жара: кондиционер">Кондиционер</button>
                  <button type="button" role="radio" aria-checked="false" class="chip scn" data-scn="hw" title="Трасса: 110 км/ч и выше">Трасса</button>
                </div>
                <div id="range-note" style="margin-top:13px;font-size:12.5px;color:var(--txt-muted)"></div>
              </div>
            </details>
          </div>
          <div class="zh-cell">
            <label for="city-search" class="zh-label">Локация</label>
            <div class="zh-loc" style="margin-top:8px">
              <input id="city-search" type="text" placeholder="Ваш город или адрес: например, Краснодар" style="flex:1;min-width:0;padding:10px 14px;border:0;background:transparent;color:var(--txt);font-size:16px" />
              <div class="zh-loc-btns">
                <button id="city-go" class="chip" type="button">Найти</button>
                <span class="zh-loc-div" aria-hidden="true"></span>
                <button id="geo-btn" class="chip" type="button" title="Показать станции рядом с вами" style="gap:7px"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><span>Рядом со мной</span></button>
              </div>
            </div>
          </div>
        </div>
        <div id="car-kpi" style="margin-top:12px;font-size:13.5px;color:var(--txt-muted);line-height:1.6">
          <div id="car-info">Выберите модель — покажем совместимость, запас хода и адаптеры. Цвета точек — в легенде над картой.</div>
        </div>
        <div id="city-chips" style="display:flex;gap:10px;flex-wrap:wrap;margin-top:14px"></div>
        <p id="geo-note" style="font-size:13px;color:var(--txt-muted);margin:10px 0 0"></p>
        <div class="zh-ribbon">
          <div class="zh-chips">
            <div id="conn-chips" aria-label="Фильтр по разъёму" style="display:flex;gap:8px;align-items:center"></div>
            <span class="zh-chips-div" aria-hidden="true"></span>
            <div id="pw-chips" aria-label="Фильтр по мощности" style="display:flex;gap:8px;align-items:center"></div>
          </div>
          <div class="zh-ribbon-right">
            <div id="weather-wrap"><span id="weather-chip" class="chip" style="display:none;gap:7px" title="Онлайн-погода в точке карты"></span></div>
            <div id="map-legend" aria-label="Легенда цветов карты" style="display:flex;gap:7px 12px;flex-wrap:wrap;align-items:center;margin:4px 0 0;font-size:13px;color:var(--txt-muted)"><span class="lg-item" style="display:inline-flex;align-items:center;gap:6px"><span style="width:8px;height:8px;border-radius:50%;display:inline-block;flex:none;background:#2563eb"></span>DC</span><span class="lg-item" style="display:inline-flex;align-items:center;gap:6px"><span style="width:8px;height:8px;border-radius:50%;display:inline-block;flex:none;background:#16a34a"></span>AC</span><span class="lg-item" style="display:inline-flex;align-items:center;gap:6px"><span style="width:8px;height:8px;border-radius:50%;display:inline-block;flex:none;background:#f97316"></span>DC адаптер</span><span class="lg-item" style="display:inline-flex;align-items:center;gap:6px"><span style="width:8px;height:8px;border-radius:50%;display:inline-block;flex:none;background:#eab308"></span>AC адаптер</span><span class="lg-item" style="display:inline-flex;align-items:center;gap:6px"><span style="width:8px;height:8px;border-radius:50%;display:inline-block;flex:none;background:#8a8f98"></span>Не проверено</span></div>
          </div>
        </div>
        <p id="conn-note" style="font-size:13px;color:var(--txt-muted);margin:10px 0 0"></p>
        <p class="zh-subnote">Фильтры работают на вкладке «Наша база»; на Яндекс.Картах — нет, но выбор машины сохраняется в адресе страницы: ссылкой можно делиться.</p>
      </div>
      <script is:inline type="application/json" id="car-models-json" set:html={MODELS_JSON}></script>
      <div id="map-ya" class="zh-map-h" style="border-radius:16px;overflow:hidden;border:1px solid var(--line);margin-top:14px;display:none"></div>
      <div style="position:relative;margin-top:14px"><div id="map" class="zh-map-h" style="border-radius:16px;overflow:hidden;border:1px solid var(--line);touch-action:pan-y"></div><div id="empty-note" role="status" style="display:none;position:absolute;z-index:850;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(13,17,23,.88);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid rgba(77,155,245,.30);border-radius:14px;padding:16px;max-width:300px;box-shadow:0 20px 38px -8px rgba(0,0,0,.55)"><div style="display:flex;justify-content:space-between;gap:10px;align-items:start"><div id="empty-title" style="font-weight:700;font-size:14px">В нашей проверенной базе здесь пока пусто</div><button id="empty-x" type="button" aria-label="Закрыть" style="border:0;background:transparent;color:var(--txt-muted);font-size:18px;line-height:1;cursor:pointer;min-width:44px;min-height:44px;flex:none">×</button></div><p id="empty-text-base" style="font-size:13px;color:var(--txt-muted);margin:8px 0 0">В этой области нет точек из нашей базы (<b id="empty-stn">{STN}</b> подтверждённых станций по всей России). Полный индекс — на Яндекс.Картах.</p><p id="empty-text-filter" style="display:none;font-size:13px;color:var(--txt-muted);margin:8px 0 0">В районе есть станции нашей базы, но они не проходят по активным фильтрам. Сбросьте фильтры, чтобы их увидеть.</p><button id="empty-ya" type="button" class="chip" style="margin-top:10px;background:#0161EF;color:#fff;border-color:#0161EF;font-weight:700">Показать станции на Яндекс.Картах</button><button id="empty-reset" type="button" class="chip" style="display:none;margin-top:10px;background:#0161EF;color:#fff;border-color:#0161EF;font-weight:700">Сбросить фильтры</button></div></div>
      <p style="font-size:13.5px;color:var(--txt-muted);margin-top:8px">Нажмите на точку на карте — адрес, коннекторы, мощность и кнопки: маршрут в Яндекс.Картах, памятка для себя, ссылка кому-то.</p>
      <div style="margin-top:34px">
        <h2 style="font-size:20px;font-weight:800;letter-spacing:-.01em">Как пользоваться картой зарядных станций</h2>
        <div class="zh-bento-grid">
        <div class="zh-bcard"><div class="zh-bcard-ic"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="9" r="2.6"/><circle cx="15" cy="7" r="2.6"/><circle cx="11" cy="15" r="2.6"/></svg></div><h3>Как читать цвета станций</h3><p style="font-size:14px;color:var(--txt-muted);margin-top:10px">Выберите вашу модель в списке — карта сразу подсветит станции, которые она заряжает напрямую (синие — быстрые DC, зелёные — AC), и станции, где понадобится переходник (оранжевые — быстрые DC, жёлтые — AC). Серые точки — разъём станции пока не подтверждён: перед поездкой уточните тип коннектора в приложении оператора или напишите нам — <a href="https://t.me/zapashoda_ev" rel="noopener" style="color:#4d9bf5;text-decoration:underline">Telegram</a>, проверим и обновим базу.</p>
        </div>
        <div class="zh-bcard"><div class="zh-bcard-ic"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v6l4 2v6l-4 2-4-2v-6l4-2"/><path d="M17 5.5a5.5 5.5 0 0 1 0 6"/></svg></div><h3>Совместимость и модели</h3><p style="font-size:14px;color:var(--txt-muted);margin-top:10px">Если вашей модели в списке нет — откройте страницу модели из <a href="/models/" style="color:#4d9bf5;text-decoration:underline">каталога {MODEL_TOTAL} {modelGen(MODEL_TOTAL)}</a>: там таблица разъёмов, инструкция по подключению и список подходящих адаптеров. Зарядные станции GB/T в Москве, точка зарядки для Zeekr 001 или CCS2-коннектор рядом с трассой — такие вопросы решаются одним выбором в фильтрах выше. Фильтр сохраняется в адресе страницы, ссылку удобно переслать.</p>
        </div>
        <div class="zh-bcard"><div class="zh-bcard-ic"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="19" r="2"/><circle cx="17" cy="5" r="2"/><path d="M8 19h8a3 3 0 0 0 0-6H9a3 3 0 0 1 0-6h7"/></svg></div><h3>Актуальность базы и трассы</h3><p style="font-size:14px;color:var(--txt-muted);margin-top:8px">База обновляется вручную и по открытым источникам: {STN} {stnWord(STN)} на {STN_UPD_FULL} — это выбранная база, где у каждой станции указаны коннекторы и совместимость с моделями. Полный индекс публичных ЭЗС (около 9 900) — в обзоре <a href="/blog/karta-elektrozapravok/" style="color:#4d9bf5;text-decoration:underline">«Карта электрозаправок России 2026»</a>. О неточности — напишите в <a href="https://t.me/zapashoda_ev" rel="noopener" style="color:#4d9bf5;text-decoration:underline">Telegram</a>, поправим в течение суток. Гайды по трассам М-4, М-11 и М-12 — в <a href="/baza-znaniy/zaryadki-na-trassah-m4-m11-m12/" style="color:#4d9bf5;text-decoration:underline">разборе трасс</a>, правила аренды жилья с зарядкой и другие сценарии — в <a href="/blog/" style="color:#4d9bf5;text-decoration:underline">блоге</a>.</p>
        </div>
        </div>
      </div>
    </div>
  </section>
  <link rel="stylesheet" href="/assets/leaflet/leaflet.css" />
  <link rel="stylesheet" href="/assets/leaflet/MarkerCluster.css" />
  <link rel="stylesheet" href="/assets/leaflet/MarkerCluster.Default.css" />
  <script is:inline src="/assets/leaflet/leaflet.js"></script>
  <script is:inline src="/assets/leaflet/leaflet.markercluster.js"></script>
  <script is:inline>
    (function () {
      var map, cluster, ALL = [];
      var SVG_THERM = '<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 14.76V5a2 2 0 0 0-4 0v9.76a4 4 0 1 0 4 0z"/></svg>';
      var SVG_BOLT = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"/></svg>';
      function chipHTML(txt) { return SVG_THERM + '<span>' + txt + '</span>'; }
      function plural(n, one, few, many) {
        var m10 = n % 10, m100 = n % 100;
        if (m10 === 1 && m100 !== 11) return one;
        if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return few;
        return many;
      }
      // Нормализация значений коннекторов из stations.json (CCS2, chademo, chademo:current, type2_combo, gb_dc:output, Type 2 кабель, type2_cable, schuko, type1, type1_combo...)
      function normConn(raw) {
        var s = String(raw || '').trim().toLowerCase();
        if (!s) return '';
        s = s.replace(/:(current|output|voltage)$/, '');
        if (/^(ccs2|type2_combo)/.test(s)) return 'CCS2';
        if (/^chademo/.test(s)) return 'CHAdeMO';
        if (/^gb_dc|^gbt$|^gb\/t$/.test(s)) return 'GB/T DC';
        if (/^gb_ac/.test(s)) return 'GB/T AC';
        if (/^type2|^type 2/.test(s)) return 'Type 2';
        if (/^(type1|type 1|type1_combo|ccs1)/.test(s)) return 'Type 1';
        if (/^schuko/.test(s)) return 'Розетка 220 В';
        return '';
      }
      var FILTERS = [
        ['ccs2', 'CCS2', 'zsh-ccs2'],
        ['gbt_dc', 'GB/T DC', 'zsh-gbt-dc'],
        ['gbt_ac', 'GB/T AC', 'zsh-gbt-ac'],
        ['type2', 'Type 2', 'zsh-type2'],
        ['type2_socket', 'Type 2 розетка', 'zsh-type2-socket'],
        ['chademo', 'CHAdeMO', 'zsh-chademo'],
        ['type1', 'Type 1', 'zsh-type1'],
        ['schuko', 'Розетка 220 В', 'zsh-schuko'],
      ];
      var active = {};
      var zhVisibleStations = [];
      var PW_PREDS = {
