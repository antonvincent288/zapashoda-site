    /* zh-plate: двухэтажная тёмная плашка фильтров 3×2, «Показать все» */
    .bottom-legend{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);z-index:30;display:grid;grid-template-columns:repeat(3,auto);gap:4px;background:rgba(11,11,13,.94);border:1px solid var(--border-hairline);border-radius:14px;padding:6px;-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);box-shadow:0 14px 40px rgba(0,0,0,.6);max-width:min(94vw,860px)}
    .leg-chip{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:30px;background:transparent;border:1px solid transparent;border-radius:9px;color:var(--text-muted);padding:0 12px;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;white-space:nowrap;min-width:0}
    .leg-chip:hover{border-color:rgba(255,255,255,.28);color:#fff}
    .leg-chip.leg-all{color:var(--text-white)}
    .leg-chip.leg-all.active{border-color:var(--orange);background:rgba(232,80,2,.16)}
    .leg-item{display:none}
    @media(min-width:821px){.top-bar .menu-btn{display:none!important}}
    @media(max-width:820px){
      .bottom-legend{bottom:calc(66px + env(safe-area-inset-bottom));grid-template-columns:repeat(3,1fr);gap:4px;padding:6px;border-radius:12px;max-width:calc(100vw - 20px)}
      .leg-chip{height:30px;padding:0 9px;font-size:12px;gap:5px}
      .leg-chip .cnt{display:none}
    }
    
    .leg-chip .all-short{display:none}
    @media(max-width:820px){.leg-chip .all-long{display:none}.leg-chip .all-short{display:inline}}
    
    /* zh-plate: индикаторы чипов — фиксированные цвета поверх старых правил */
    .leg-chip .dot{width:8px!important;height:8px!important;border:2px solid transparent!important;box-shadow:none!important;background:transparent!important}
    .leg-chip .dot.dc{background:#E85002!important}
    .leg-chip .dot.adp{background:#D9C3AB!important}
    .leg-chip .dot.ac{background:#F59E0B!important}
    .leg-chip .dot.unv{background:#8a919c!important}
    .leg-chip .dot.ya{background:#3FA9F5!important}
    
    .leg-chip .lbl-short{display:none}
    @media(max-width:820px){
      .leg-chip .lbl-long{display:none}
      .leg-chip .lbl-short{display:inline}
      body:has(.hud-left.open) .bottom-legend{display:none}
    }
    /* zh-plate: тосты — по центру экрана по вертикали */
    .toast{top:50%!important;bottom:auto!important;transform:translateX(-50%) translateY(-50%)!important}
    .toast.show{transform:translateX(-50%) translateY(-50%)!important}
    
    /* zh-plate: телефон в горизонтали остаётся мобильным (бар, таббар, плашка) */
    @media (orientation: landscape) and (max-height: 560px){
      .mobile-tabbar{display:flex!important}
      .bar-mid,.bar-side .vline,.nav-tabs,.seg-group{display:none!important}
      .top-bar .bar-side:last-child{display:flex!important}
      .bar-geo-chip,.bar-weather-chip,.drive-chip{display:flex!important}
      .top-bar .btn-ghost,.top-bar .btn-primary{display:none!important}
      .glass-pill{height:44px!important;padding:0 8px!important}
      .brand span{font-size:12px!important}
      .bottom-legend{position:absolute!important;bottom:calc(58px + env(safe-area-inset-bottom))!important;left:50%!important;transform:translateX(-50%)!important;display:grid!important;grid-template-columns:repeat(3,1fr)!important;gap:4px!important;background:rgba(11,11,13,.94)!important;border:1px solid var(--border-hairline)!important;border-radius:12px!important;padding:6px!important;max-width:calc(100vw - 20px)!important}
      .leg-chip{height:30px!important;padding:0 9px!important;font-size:12px!important}
      .leg-chip .cnt{display:none!important}
      .leg-chip .lbl-long{display:none!important}
      .leg-chip .lbl-short{display:inline!important}
    }
    /* zh-plate: мобайл — бренд компактнее, зазоры меньше (освободить место для «За рулём») */
    @media(max-width:820px){
      .brand span{font-size:12px!important}
      .bar-side{gap:8px!important}
    }
    
    /* zh-plate: на мобиле погоду в баре не держим — освобождает место для «За рулём» */
    @media(max-width:820px){.bar-weather-chip{display:none!important}}
    </style>
