          var soc = Number((document.getElementById('range-soc') || {}).value || 80);
          var f = tempFactor(curTemp) * (SCN_FACTORS[scnCur] || 1);
          rows.push('Запас при заряде ' + soc + '%: <b>~' + Math.round(carEntry.cap * 6.2 * soc / 100 * f) + ' км</b>');
        }
        if (s.pw && carEntry && carEntry.cap) rows.push('Сессия 20 → 80%: <b>~' + sessMin(carEntry, Number(s.pw)) + ' мин</b>');
        var link = memoLink();
        return rows.map(function (r) { return '<div style="margin-bottom:4px">' + r + '</div>'; }).join('') +
          '<div style="margin-top:8px;word-break:break-all"><a href="' + link + '" style="color:#4d9bf5;text-decoration:underline">' + link + '</a></div>' +
          '<div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:9px">' +
          '<button type="button" class="chip" style="padding:6px 10px;font-size:12.5px;cursor:pointer" data-copytext="' + memoKey + '">Скопировать текст</button>' +
          '<a class="chip" style="padding:6px 10px;font-size:12.5px;text-decoration:none" href="https://t.me/share/url?url=' + encodeURIComponent(link) + '&text=' + encodeURIComponent(memoText(s)) + '" target="_blank" rel="noopener">В Telegram</a>' +
          '<a class="chip" style="padding:6px 10px;font-size:12.5px;text-decoration:none" href="https://t.me/zapashoda_ev_bot?text=' + encodeURIComponent(memoText(s)) + '" target="_blank" rel="noopener">На телефон</a>' +
          '</div>';
      }
      function fetchMemoTemp(lat, lon) {
        memoTemp = null;
        try {
          fetch('https://api.open-meteo.com/v1/forecast?latitude=' + lat.toFixed(3) + '&longitude=' + lon.toFixed(3) + '&current=temperature_2m')
            .then(function (r) { return r.json(); })
            .then(function (d) {
              var t = d && d.current && typeof d.current.temperature_2m === 'number' ? Math.round(d.current.temperature_2m) : null;
              if (t !== null) { memoTemp = t; var el = document.getElementById('memo-temp'); if (el) el.textContent = t + ' °C'; }
              else { var e2 = document.getElementById('memo-temp'); if (e2) e2.textContent = 'нет данных'; }
            }).catch(function () { var e3 = document.getElementById('memo-temp'); if (e3) e3.textContent = 'нет данных'; });
        } catch (e) { var e4 = document.getElementById('memo-temp'); if (e4) e4.textContent = 'нет данных'; }
      }
      function openMemo(key) {
        var m = findStationByCoords(key);
        if (!m) return;
        memoKey = key;
        var body = document.getElementById('memo-body');
        if (body) { body.innerHTML = memoHTML(m.__s); body.style.display = ''; }
        fetchMemoTemp(m.__s.lat, m.__s.lon);
      }
      function copyText(text, btn) {
        var done = function () {
          if (!btn) return;
          var old = btn.textContent;
          btn.textContent = 'Скопировано';
          setTimeout(function () { btn.textContent = old; }, 1400);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) { navigator.clipboard.writeText(text).then(done, function () { fallbackCopy(text); done(); }); }
        else { fallbackCopy(text); done(); }
      }
      function fallbackCopy(text) {
        try {
          var ta = document.createElement('textarea');
          ta.value = text; ta.style.cssText = 'position:fixed;opacity:0';
          document.body.appendChild(ta); ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
        } catch (e) {}
      }
      document.addEventListener('click', function (ev) {
        var t = ev.target;
        var el = t && t.closest ? t.closest('[data-memo],[data-copy],[data-copytext]') : null;
        if (!el) return;
        ev.preventDefault();
        if (el.hasAttribute('data-memo')) openMemo(el.getAttribute('data-memo'));
        else if (el.hasAttribute('data-copy')) {
          var s2 = findStationByCoords(el.getAttribute('data-copy'));
          var link2 = location.origin + '/charging/' + (carSel ? '?model=' + encodeURIComponent(carSel) : '') + '&st=' + el.getAttribute('data-copy');
          copyText(link2, el);
        }
        else if (el.hasAttribute('data-copytext')) {
          var s3 = findStationByCoords(el.getAttribute('data-copytext'));
          if (s3) copyText(memoText(s3.__s), el);
        }
      });

      // ===== Вкладки: Яндекс-виджет vs наша фильтр-карта =====
      var yaActive = false, yaFrame = null, yaLL = '37.62,55.75', yaZ = 5, yaText = 'электрозаправки';
      function buildYaUrl() {
        return 'https://yandex.ru/map-widget/v1/?text=' + encodeURIComponent(yaText) + '&ll=' + yaLL + '&z=' + yaZ + '&l=map';
      }
      function ensureYaFrame() {
        if (yaFrame) return;
        yaFrame = document.createElement('iframe');
        yaFrame.style.cssText = 'width:100%;height:100%;border:0';
        yaFrame.src = buildYaUrl();
        yaFrame.title = 'Поиск зарядных станций на Яндекс.Картах';
        yaFrame.loading = 'lazy';
        document.getElementById('map-ya').appendChild(yaFrame);
      }
      function loadYaWidget(pts, city) {
        ensureYaFrame();
        if (pts && pts.length) {
          var lat = pts.reduce(function (a, p) { return a + p[0]; }, 0) / pts.length;
          var lon = pts.reduce(function (a, p) { return a + p[1]; }, 0) / pts.length;
          yaLL = lon.toFixed(4) + ',' + lat.toFixed(4);
          yaZ = Math.max(10, Math.min(14, 11 + (pts.length > 40 ? 1 : 0)));
        }
        if (city) yaText = 'электрозаправки ' + city;
        yaFrame.src = buildYaUrl();
        var note = document.getElementById('geo-note');
        if (note) note.textContent = 'Открыли поиск Яндекс.Карт: «' + yaText + '». Там видны все станции Яндекса, включая живой статус.' ;
      }
      var tYa = document.getElementById('tab-ya'), tOwn = document.getElementById('tab-own');
      function setTab(ya) {
        yaActive = ya;
        document.getElementById('map-ya').style.display = ya ? '' : 'none';
        document.getElementById('map').style.display = ya ? 'none' : '';
        tYa.style.borderColor = ya ? '#4d9bf5' : '';
        tYa.style.background = ya ? 'rgba(77,155,245,.12)' : '';
        tOwn.style.borderColor = ya ? '' : '#4d9bf5';
        tOwn.style.background = ya ? '' : 'rgba(77,155,245,.12)';
        if (ya) ensureYaFrame();
        else setTimeout(function () { map.invalidateSize(); }, 50);
        try { history.replaceState(null, '', ya ? '#view=ya' : '#view=own'); } catch (e) {}
      }
      if (tYa) tYa.addEventListener('click', function () { setTab(true); });
      if (tOwn) tOwn.addEventListener('click', function () { setTab(false); });
      try { if (location.hash.indexOf('#view=ya') === 0) setTab(true); } catch (e) {}
    })();
  </script>
