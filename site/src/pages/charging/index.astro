---
import ZhLayout from '../../layouts/ZhLayout.astro';
import fs from 'node:fs';
import modelsLight from '../../data/models_light.json';
import modelsBattery from '../../data/models_battery.json';
const MODELS = (modelsLight.models || [])
  .filter((m) => m && m.slug && m.port)
  .map((m) => {
    const b = modelsBattery[m.slug];
    let cap = null;
    if (b && b.cap) { const v = parseFloat(String(b.cap).replace(',', '.')); if (isFinite(v)) cap = v; }
    return { slug: m.slug, brand: m.brand || '', name: m.name, port: m.port, type: m.type || '', cap: cap };
  })
  .sort((a, b2) => (a.brand + a.name).localeCompare(b2.brand + b2.name, 'ru'));
const MODELS_JSON = JSON.stringify(MODELS).replace(/<\//g, '<\\/');
const MODEL_TOTAL = (modelsLight.models || []).filter((m) => m && m.slug).length;
let STN = 3129; let STN_UPD = '12 ноября'; let STN_UPD_FULL = '12 ноября 2026';
try { const rawS = JSON.parse(fs.readFileSync('public/charging/stations.json', 'utf-8')); if (Array.isArray(rawS.stations)) STN = rawS.stations.length;
const mmo = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(rawS.updated || ''));
if (mmo) { const MO = ['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря']; STN_UPD = parseInt(mmo[3], 10) + ' ' + MO[parseInt(mmo[2], 10) - 1]; STN_UPD_FULL = STN_UPD + ' ' + mmo[1]; }
} catch {}
const stnWord = (n) => { const a = n % 10, b = n % 100; return (a === 1 && b !== 11) ? 'станция' : (a >= 2 && a <= 4 && (b < 12 || b > 14)) ? 'станции' : 'станций'; };
const modelWord = (n) => { const a = n % 10, b = n % 100; return (a === 1 && b !== 11) ? 'модель' : (a >= 2 && a <= 4 && (b < 12 || b > 14)) ? 'модели' : 'моделей'; };
const modelGen = (n) => { const a = n % 10, b = n % 100; return (a === 1 && b !== 11) ? 'модели' : (a >= 2 && a <= 4 && (b < 12 || b > 14)) ? 'модели' : 'моделей'; };
const ld = { '@context': 'https://schema.org', '@type': 'WebPage', name: 'Карта зарядных станций', description: 'Карта зарядных станций России: фильтр по вашей модели (GB/T, Type 2, CCS2, CHAdeMO, Type 1), пересчёт запаса хода по реальной температуре за окном, поиск по городу и мощности.' };
---
<ZhLayout title="Карта зарядных станций — Запас хода" description={`Карта ${STN} зарядных станций России: выберите свою модель — покажем только совместимые станции, пересчёт запаса хода по текущей температуре.`} jsonld={ld}>
  <section class="sec">
    <div class="wrap">
      <div class="crumbs"><a href="/">Главная</a> / Карта ЗУ</div>
      <h1>Карта зарядных станций для электромобилей</h1>
      <p class="lead"><span id="stn-count" data-stn-count>{STN}</span> {stnWord(STN)} в нашей базе · обновлено <span id="stn-upd">{STN_UPD}</span>. По умолчанию — наша карта с фильтрами по разъёмам (GB/T, Type 1, CCS2, CHAdeMO) и мощности — без рекламы. Нужен полный индекс с живым статусом — вкладка Яндекс.Карт.</p>
<div id="os-widget" style="margin-top:26px;border-radius:20px;padding:24px;overflow:hidden">
        <div style="display:flex;justify-content:space-between;align-items:baseline;gap:13px;flex-wrap:wrap">
          <div style="font-weight:800;font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:#9ecbff">Запас хода · виджет</div>
          <div id="weather-wrap"></div>
        </div>
        <div class="os-row" style="margin-top:13px;align-items:center">
          <div>
            <label for="car-model" style="font-size:11.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--txt-muted)">Ваша машина</label>
            <div style="display:flex;gap:13px;margin-top:8px;align-items:center">
              <select id="car-model" style="flex:1;min-width:220px;padding:10px 14px;border-radius:12px;border:1px solid var(--line);background:var(--card);color:var(--txt);font-size:14px">
                <option value="">— выберите модель —</option>
                {MODELS.map((m) => { const n = (m.brand && m.name.toLowerCase().startsWith(m.brand.toLowerCase())) ? m.name.slice(m.brand.length).replace(/^\s+/, '') : m.name; return (<option value={m.slug}>{m.brand ? m.brand + ' · ' : ''}{n}</option>); })}
              </select>
              <button id="car-reset" class="chip" type="button" style="display:none">Сброс</button>
            </div>
          </div>
          <div style="display:flex;justify-content:flex-end;align-items:center">
            <span id="weather-chip" class="chip" style="display:none;gap:7px" title="Онлайн-погода в точке карты"></span>
          </div>
        </div>
        <div class="os-row" style="margin-top:21px">
          <div>
            <div style="display:flex;align-items:baseline;gap:13px;flex-wrap:wrap">
              <span id="range-big" style="font-size:clamp(30px,4.6vw,44px);font-weight:800;line-height:1.05;letter-spacing:-.02em">— км</span>
              <span id="range-cap" style="font-size:12.5px;color:var(--txt-muted)">выберите модель — покажем реальный запас</span>
            </div>
            <details id="range-tune" open style="margin-top:13px">
              <summary style="font-size:12.5px;color:#7fa8d9;cursor:pointer;user-select:none">Настройка расчёта — заряд, сценарий</summary>
              <div style="margin-top:11px">
                <div style="max-width:380px">
                  <label for="range-soc" style="font-size:12.5px;color:var(--txt-muted)">Заряд сейчас: <b id="soc-val">80%</b></label>
                  <input id="range-soc" type="range" min="10" max="100" step="5" value="80" style="width:100%" />
                </div>
                <div id="scn-row" style="display:flex;gap:8px;flex-wrap:wrap;margin-top:13px">
                  <button type="button" class="chip scn on" data-scn="base" title="Без поправок: паспортный запас и погода">База</button>
                  <button type="button" class="chip scn" data-scn="cold" title="Мороз: шины, масло, отопление">Мороз</button>
                  <button type="button" class="chip scn" data-scn="ac" title="Жара: кондиционер">Кондиционер</button>
                  <button type="button" class="chip scn" data-scn="hw" title="Трасса: 110 км/ч и выше">Трасса</button>
                </div>
                <div id="range-note" style="margin-top:13px;font-size:12.5px;color:var(--txt-muted)"></div>
              </div>
            </details>
          </div>
          <div id="car-kpi" style="font-size:13.5px;color:var(--txt-muted);line-height:1.6">
            <div id="car-info">Выберите модель — карта подсветит совместимые станции: зелёные точки заряжают напрямую, янтарные — через адаптер, серые — разъём не подтверждён.</div>
          </div>
        </div>
        <div class="os-row os-mid" style="margin-top:21px">
          <div style="display:flex;gap:13px;flex-wrap:wrap;align-items:center">
            <input id="city-search" type="text" placeholder="Ваш город или адрес: например, Краснодар" style="flex:1;min-width:200px;padding:10px 14px;border-radius:12px;border:1px solid var(--line);background:var(--card);color:var(--txt);font-size:14px" />
            <button id="city-go" class="chip" type="button">Найти</button>
            <button id="geo-btn" class="chip" type="button" title="Показать станции рядом с вами" style="gap:7px"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><span>Рядом со мной</span></button>
          </div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end" id="map-tabs">
            <button id="tab-own" class="chip" type="button" style="border-color:#4d9bf5;background:rgba(77,155,245,.12)">Наша база</button>
            <button id="tab-ya" class="chip" type="button">Яндекс.Карты</button>
          </div>
        </div>
        <div id="city-chips" style="display:flex;gap:10px;flex-wrap:wrap;margin-top:21px"></div>
        <p id="geo-note" style="font-size:13px;color:var(--txt-muted);margin:13px 0 0"></p>
        <div style="margin-top:21px;padding-top:17px;border-top:1px solid rgba(77,155,245,.18)">
          <div class="os-row">
            <div><div class="os-label">Фильтр по разъёму</div><div id="conn-chips" style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px"></div></div>
            <div><div class="os-label">Фильтр по мощности</div><div id="pw-chips" style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px"></div></div>
          </div>
          <p id="conn-note" style="font-size:13px;color:var(--txt-muted);margin:10px 0 0"></p>
          <p style="font-size:13px;color:var(--txt-muted);margin:4px 0 0">Ничего не выбрано — показаны все станции. Цвет заливки без выбранной машины: синие — быстрые DC, зелёные — AC. С машиной цвет — совместимость: зелёные — прямое подключение, янтарные — через адаптер, серые — не подтверждён. Тип тока виден по обводке: сплошная — быстрые DC, пунктирная — AC. Выбранный фильтр сохраняется в адресе страницы — ссылкой можно делиться. Фильтры работают на вкладке «Наша база»; на Яндекс.Картах они не действуют, но выбор машины и запас хода сохраняются.</p>
        </div>
      </div>
      <script is:inline type="application/json" id="car-models-json" set:html={MODELS_JSON}></script>
      <div id="map-ya" style="height:80vh;min-height:560px;border-radius:16px;overflow:hidden;margin-top:14px;border:1px solid var(--line);display:none"></div>
      <div id="map" style="height:80vh;min-height:560px;border-radius:16px;overflow:hidden;margin-top:14px;border:1px solid var(--line)"></div>
      <p style="font-size:13.5px;color:var(--txt-muted);margin-top:8px">Нажмите на точку на карте — адрес, коннекторы, мощность и кнопки: маршрут в Яндекс.Картах, памятка для себя, ссылка кому-то.</p>
      <div style="margin-top:34px">
        <h2 style="font-size:20px;font-weight:800;letter-spacing:-.01em">Как пользоваться картой зарядных станций</h2>
        <p style="font-size:14px;color:var(--txt-muted);margin-top:10px">Выберите вашу модель в списке — карта сразу подсветит станции, которые она заряжает напрямую (зелёные), и станции, где понадобится переходник (янтарные). Если вашей модели в списке нет — откройте страницу модели из <a href="/models/" style="color:#4d9bf5;text-decoration:underline">каталога {MODEL_TOTAL} {modelGen(MODEL_TOTAL)}</a>: там таблица разъёмов, инструкция по подключению и список подходящих адаптеров. Зарядные станции GB/T в Москве, точка зарядки для Zeekr 001 или CCS2-коннектор рядом с трассой — такие вопросы решаются одним выбором в фильтрах выше. Фильтр сохраняется в адресе страницы, ссылку удобно переслать.</p>
        <p style="font-size:14px;color:var(--txt-muted);margin-top:8px">База обновляется вручную и по открытым источникам: {STN} {stnWord(STN)} на {STN_UPD_FULL}. О неточности — напишите в <a href="https://t.me/zapashoda_ev" rel="noopener" style="color:#4d9bf5;text-decoration:underline">Telegram</a>, поправим в течение суток. Гайды по трассам М-4, М-11 и М-12 — в <a href="/baza-znaniy/zaryadki-na-trassah-m4-m11-m12/" style="color:#4d9bf5;text-decoration:underline">разборе трасс</a>, правила аренды жилья с зарядкой и другие сценарии — в <a href="/blog/" style="color:#4d9bf5;text-decoration:underline">блоге</a>.</p>
      </div>
    </div>
  </section>
  <link rel="stylesheet" href="/assets/leaflet/leaflet.css" />
  <link rel="stylesheet" href="/assets/leaflet/MarkerCluster.css" />
  <link rel="stylesheet" href="/assets/leaflet/MarkerCluster.Default.css" />
  <script is:inline src="/assets/leaflet/leaflet.js"></script>
  <script is:inline src="/assets/leaflet/leaflet.markercluster.js"></script>
  <script is:inline>
    (function () {
      var map, cluster, ALL = [];
      var SVG_THERM = '<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 14.76V5a2 2 0 0 0-4 0v9.76a4 4 0 1 0 4 0z"/></svg>';
      var SVG_BOLT = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"/></svg>';
      function chipHTML(txt) { return SVG_THERM + '<span>' + txt + '</span>'; }
      function plural(n, one, few, many) {
        var m10 = n % 10, m100 = n % 100;
        if (m10 === 1 && m100 !== 11) return one;
        if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return few;
        return many;
      }
      // Нормализация значений коннекторов из stations.json (CCS2, chademo, chademo:current, type2_combo, gb_dc:output, Type 2 кабель, type2_cable, schuko, type1, type1_combo...)
      function normConn(raw) {
        var s = String(raw || '').trim().toLowerCase();
        if (!s) return '';
        s = s.replace(/:(current|output|voltage)$/, '');
        if (/^(ccs2|type2_combo)/.test(s)) return 'CCS2';
        if (/^chademo/.test(s)) return 'CHAdeMO';
        if (/^gb_dc|^gbt$|^gb\/t$/.test(s)) return 'GB/T DC';
        if (/^gb_ac/.test(s)) return 'GB/T AC';
        if (/^type2|^type 2/.test(s)) return 'Type 2';
        if (/^(type1|type 1|type1_combo|ccs1)/.test(s)) return 'Type 1';
        if (/^schuko/.test(s)) return 'Розетка 220 В';
        return '';
      }
      var FILTERS = [
        ['ccs2', 'CCS2', 'zsh-ccs2'],
        ['gbt_dc', 'GB/T DC', 'zsh-gbt-dc'],
        ['gbt_ac', 'GB/T AC', 'zsh-gbt-ac'],
        ['type2', 'Type 2', 'zsh-type2'],
        ['type2_socket', 'Type 2 розетка', 'zsh-type2-socket'],
        ['chademo', 'CHAdeMO', 'zsh-chademo'],
        ['type1', 'Type 1', 'zsh-type1'],
        ['schuko', 'Розетка 220 В', 'zsh-schuko'],
      ];
      var active = {};
      var PW_PREDS = {
        pw100: function (s) { return (Number(s.pw) || 0) >= 100; },
        pw50: function (s) { var p = Number(s.pw) || 0; return p >= 50 && p < 100; },
        pw22: function (s) { var p = Number(s.pw) || 0; return p > 0 && p < 50; }
      };
      var PW_LABELS = [
        ['pw100', SVG_BOLT + '<span>100 кВт и быстрее (DC)</span>'],
        ['pw50', SVG_BOLT + '<span>50–99 кВт (DC)</span>'],
        ['pw22', SVG_BOLT + '<span>до 50 кВт (AC и медленный DC)</span>']
      ];
      fetch('/charging/stations.json').then(function (r) { return r.json(); }).then(function (data) {
        var st = data.stations || [];
        document.getElementById('stn-count').textContent = st.length;
        document.getElementById('stn-upd').textContent = (function (v) { var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(v || ''); if (!m) return v || ''; var mo = ['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря']; return parseInt(m[3], 10) + ' ' + mo[parseInt(m[2], 10) - 1]; })(data.updated) || '';
        st.forEach(function (s) {
          s.__c = {};
          (s.s || []).forEach(function (raw) {
            var k = normConn(raw);
            if (!k) return;
            var low = String(raw).toLowerCase();
            if (k === 'Type 2') {
              if (low.indexOf('cable') >= 0 || low.indexOf('кабель') >= 0) s.__c.type2 = true;
              else if (low.indexOf('socket') >= 0) s.__c.type2_socket = true;
              else s.__c.type2 = true;
            } else if (k === 'CCS2') s.__c.ccs2 = true;
            else if (k === 'CHAdeMO') s.__c.chademo = true;
            else if (k === 'GB/T DC') s.__c.gbt_dc = true;
            else if (k === 'GB/T AC') s.__c.gbt_ac = true;
            else if (k === 'Type 1') s.__c.type1 = true;
            else if (k === 'Розетка 220 В') s.__c.schuko = true;
          });
        });
        var cityCount = {}, cityPts = {};
        st.forEach(function (s) {
          var c = String(s.a || '').split(',')[0].trim() || 'Без адреса';
          cityCount[c] = (cityCount[c] || 0) + 1;
          (cityPts[c] = cityPts[c] || []).push([s.lat, s.lon]);
        });
        var chips = Object.entries(cityCount).sort(function (x, y) { return y[1] - x[1]; }).slice(0, 12);
        var chipsBox = document.getElementById('city-chips');
        chips.forEach(function (pair) {
          var b = document.createElement('button');
          b.className = 'chip';
          b.textContent = pair[0] + ' (' + pair[1] + ')';
          b.addEventListener('click', function () {
            var pts = cityPts[pair[0]] || [];
            if (yaActive) {
              loadYaWidget(pts, pair[0]);
            } else if (pts.length) {
              map.fitBounds(L.latLngBounds(pts).pad(0.25), { maxZoom: 12 });
            }
            if (pts.length) {
              var lat = pts.reduce(function (a, p) { return a + p[0]; }, 0) / pts.length;
              var lon = pts.reduce(function (a, p) { return a + p[1]; }, 0) / pts.length;
              fetchTemp(lat, lon, pair[0]);
            }
          });
          chipsBox.appendChild(b);
        });
        if (!map) {
          map = L.map('map').setView([55.75, 37.62], 5);
          var _tl=L.tileLayer('https://core-renderer-tile.maps.yandex.net/2.0/tiles?l=map&x={x}&y={y}&z={z}&scale=1&v=2024.06.03.16.17-4',{maxZoom:18}).addTo(map);var _mapFb=false;_tl.on('tileerror',function(){if(_mapFb)return;_mapFb=true;_tl.remove();L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:18,attribution:'&copy; OpenStreetMap'}).addTo(map);});
          cluster = L.markerClusterGroup();
          st.forEach(function (s) {
            if (typeof s.lat !== 'number' || typeof s.lon !== 'number') return;
            var conn = (s.s || []).join(' ');
            var pw = Number(s.pw) || 0;
            var dc = /CCS|CHAdeMO|GB\/T DC|type2_combo|gb_dc/i.test(conn) || pw >= 50;
            s.__dc = dc;
            var m = L.circleMarker([s.lat, s.lon], { radius: 7, color: dc ? '#2563eb' : '#16a34a', fillColor: dc ? '#2563eb' : '#16a34a', fillOpacity: 0.85, dashArray: dc ? undefined : '2 2' });
            m.bindPopup(function () { return '<b>' + (s.n || 'Станция') + '</b>' + (s.op ? ' · ' + s.op : '') + '<br>' + (s.a || '') + '<br>' + (conn || '') + (pw ? ' · ' + pw + ' кВт' : '') + (s.src === 'osm' ? '<br><span style="font-size:11px;color:#888">данные OSM (ODbL)</span>' : '') + '<br><a href="https://yandex.ru/maps/?pt=' + s.lon + ',' + s.lat + '&z=17&l=map" target="_blank" rel="noopener" style="color:#4d9bf5;font-size:13px;text-decoration:underline">Открыть в Яндекс.Картах →</a> | <a href="https://2chargers.ru/" target="_blank" rel="noopener" style="color:#4d9bf5;font-size:13px;text-decoration:underline">Статус в 2Chargers →</a>' + '<br><a href="https://t.me/zapashoda_ev_bot?text=' + encodeURIComponent('Статус станции: ' + (s.n || '') + (s.a ? ' — ' + s.a : '') + '. Разъёмы: ' + (conn || '—') + (pw ? ', ' + pw + ' кВт' : '') + '. Отметка: ') + '" target="_blank" rel="noopener" style="color:#4d9bf5;font-size:13px;text-decoration:underline">Сообщить статус станции →</a>'
              + (carSel ? (s.__fit === 'direct' ? '<br><span style="color:#16a34a;font-weight:600;display:inline-flex;align-items:center;gap:5px"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Прямое подключение для вашей модели</span>' : s.__fit === 'adapt' ? '<br><span style="color:#f59e0b;font-weight:600;display:inline-flex;align-items:center;gap:5px"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Через адаптер — подходит для вашей модели</span>' : '<br><span style="color:#8a8f98">Разъём не подтверждён — уточните по ссылке выше</span>') : '')
