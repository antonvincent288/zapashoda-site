---
import ZhLayout from '../../layouts/ZhLayout.astro';
const stations = (await import('../../public/charging/stations.json')).default;
const total = Array.isArray(stations.stations) ? stations.stations.length : 0;
const cities = Array.isArray(stations.stations)
  ? Object.entries(stations.stations.reduce((acc, s) => { const c = String(s.city || s.address || '—').slice(0, 40); acc[c] = (acc[c] || 0) + 1; return acc; }, {}))
      .sort((a, b) => b[1] - a[1]).slice(0, 12)
  : [];
const ld = { '@context': 'https://schema.org', '@type': 'WebPage', name: 'Карта зарядных станций', description: `Карта ${total} зарядных станций России на базе Яндекса. Поиск по городу.` };
---
<ZhLayout title="Карта зарядных станций — Запас хода" description={`Карта ${total} зарядных станций России: быстрый поиск по городу, мощность и коннекторы.`} jsonld={ld}>
  <section class="sec">
    <div class="wrap">
      <div class="crumbs"><a href="/">Главная</a> / Карта ЗУ</div>
      <h1>Зарядные станции рядом</h1>
      <p class="lead">{total} станций на карте. Синие — быстрые (DC), зелёные — медленные (AC).</p>
      <div id="map" style="height:64vh;min-height:420px;border-radius:16px;overflow:hidden;margin-top:28px;border:1px solid var(--line)"></div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:18px">
        {cities.map(([c, n]) => (
          <button class="chip" type="button" data-city={c}>{c} ({n})</button>
        ))}
      </div>
    </div>
  </section>
  <link rel="stylesheet" href="/assets/leaflet/leaflet.css" />
  <link rel="stylesheet" href="/assets/leaflet/MarkerCluster.css" />
  <link rel="stylesheet" href="/assets/leaflet/MarkerCluster.Default.css" />
  <script src="/assets/leaflet/leaflet.js"></script>
  <script src="/assets/leaflet/leaflet.markercluster.js"></script>
  <script define:vars={{ citiesJson: cities }}>
    (function () {
      var map, cluster, stationsData = null;
      var API_KEY = 'bbc56954-2cf8-4bc9-b2a6-d4a1f1e6b7bb';
      fetch('/charging/stations.json').then(function (r) { return r.json(); }).then(function (data) {
        stationsData = data.stations || [];
        map = L.map('map').setView([55.75, 37.62], 5);
        L.tileLayer('https://core-renderer-tile.maps.yandex.net/2.0/tiles?l=map&x={x}&y={y}&z={z}&scale=1&v=2024.06.03.16.17-4', { maxZoom: 18 }).addTo(map);
        cluster = L.markerClusterGroup();
        stationsData.forEach(function (s) {
          var lat = s.lat !== undefined ? s.lat : (s.latitude !== undefined ? s.latitude : (s.coords ? s.coords[0] : null));
          var lon = s.lon !== undefined ? s.lon : (s.longitude !== undefined ? s.longitude : (s.coords ? s.coords[1] : null));
          if (lat === null || lon === null) return;
          var dc = /dc|fast|GB\/T DC|CCS|CHAdeMO/i.test(String(s.type || s.connector || ''));
          var m = L.circleMarker([lat, lon], { radius: 5, color: dc ? '#2563eb' : '#16a34a', fillColor: dc ? '#2563eb' : '#16a34a', fillOpacity: 0.8 });
          m.bindPopup('<b>' + (s.name || 'Станция') + '</b><br>' + (s.address || s.city || ''));
          cluster.addLayer(m);
        });
        map.addLayer(cluster);
        document.querySelectorAll('.chip[data-city]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var city = btn.getAttribute('data-city');
            var pts = stationsData.filter(function (s) { return String(s.city || s.address || '—').slice(0, 40) === city; })
              .map(function (s) { return [s.lat !== undefined ? s.lat : (s.coords ? s.coords[0] : null), s.lon !== undefined ? s.lon : (s.coords ? s.coords[1] : null)]; })
              .filter(function (p) { return p[0] !== null; });
            if (pts.length) { map.fitBounds(L.latLngBounds(pts).pad(0.2), { maxZoom: 12 }); }
          });
        });
      });
    })();
  </script>
</ZhLayout>
