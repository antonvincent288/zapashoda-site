---
import ZhLayout from '../../layouts/ZhLayout.astro';
const ld = { '@context': 'https://schema.org', '@type': 'WebPage', name: 'Карта зарядных станций', description: 'Карта зарядных станций России: поиск по городу, коннекторы и мощность.' };
---
<ZhLayout title="Карта зарядных станций — Запас хода" description="Карта 2073 зарядных станций России: поиск по городу, коннекторы и мощность." jsonld={ld}>
  <section class="sec">
    <div class="wrap">
      <div class="crumbs"><a href="/">Главная</a> / Карта ЗУ</div>
      <h1>Зарядные станции рядом</h1>
      <p class="lead"><span id="stn-count">2073</span> станций в нашей базе (<span id="stn-upd">2026-11-01</span>). <b>По умолчанию — поиск на Яндекс.Картах:</b> там все станции с живым статусом. Наша вкладка — единственный фильтр по GB/T, Type 1 и мощности в рунете.</p>
      <div style="margin-top:28px;display:flex;gap:10px;flex-wrap:wrap" id="map-tabs">
        <button id="tab-ya" class="chip" type="button" style="border-color:#4d9bf5;background:rgba(77,155,245,.12)">Поиск на Яндекс.Картах — все станции</button>
        <button id="tab-own" class="chip" type="button">Фильтр по разъёмам — наша база</button>
      </div>
      <div id="map-ya" style="height:64vh;min-height:420px;border-radius:16px;overflow:hidden;margin-top:14px;border:1px solid var(--line)"></div>
      <div id="map" style="height:64vh;min-height:420px;border-radius:16px;overflow:hidden;margin-top:14px;border:1px solid var(--line);display:none"></div>
      <div style="margin-top:22px"><div style="font-weight:700;font-size:15px;margin-bottom:8px">Фильтр по разъёму</div><div id="conn-chips" style="display:flex;gap:8px;flex-wrap:wrap"></div><div style="font-weight:700;font-size:15px;margin:14px 0 8px">Фильтр по мощности</div><div id="pw-chips" style="display:flex;gap:8px;flex-wrap:wrap"></div><p id="conn-note" style="font-size:13px;color:var(--txt-muted);margin:8px 0 0"></p><p style="font-size:13px;color:var(--txt-muted);margin:4px 0 0">Ничего не выбрано — показаны все станции. Синие точки — быстрые DC, зелёные — AC. Выбранный фильтр сохраняется в адресе страницы — ссылкой можно делиться.</p></div>
      <div style="margin-top:18px;display:flex;gap:10px;align-items:center;flex-wrap:wrap"><input id="city-search" type="text" placeholder="Ваш город или адрес: например, Краснодар" style="flex:1;min-width:220px;max-width:380px;padding:10px 14px;border-radius:12px;border:1px solid var(--line);background:var(--card);color:var(--txt);font-size:14px" /><button id="city-go" class="chip" type="button">Найти</button><button id="geo-btn" class="chip" type="button" title="Показать станции рядом с вами">📍 Рядом со мной</button></div>
      <div id="city-chips" style="display:flex;gap:10px;flex-wrap:wrap;margin-top:18px"></div>
      <p id="geo-note" style="font-size:13px;color:var(--txt-muted);margin-top:12px"></p>
      <p style="font-size:13.5px;color:var(--txt-muted);margin-top:6px">Нажмите на точку на карте — откроется адрес станции, коннекторы и мощность. Синие точки — быстрые DC, зелёные — AC.</p>
    </div>
  </section>
  <link rel="stylesheet" href="/assets/leaflet/leaflet.css" />
  <link rel="stylesheet" href="/assets/leaflet/MarkerCluster.css" />
  <link rel="stylesheet" href="/assets/leaflet/MarkerCluster.Default.css" />
  <script is:inline src="/assets/leaflet/leaflet.js"></script>
  <script is:inline src="/assets/leaflet/leaflet.markercluster.js"></script>
  <script is:inline>
    (function () {
      var map, cluster, ALL = [];
      // Нормализация значений коннекторов из stations.json (CCS2, chademo, chademo:current, type2_combo, gb_dc:output, Type 2 кабель, type2_cable, schuko, type1, type1_combo...)
      function normConn(raw) {
        var s = String(raw || '').trim().toLowerCase();
        if (!s) return '';
        s = s.replace(/:(current|output|voltage)$/, '');
        if (/^(ccs2|type2_combo)/.test(s)) return 'CCS2';
        if (/^chademo/.test(s)) return 'CHAdeMO';
        if (/^gb_dc|^gbt$|^gb\/t$/.test(s)) return 'GB/T DC';
        if (/^gb_ac/.test(s)) return 'GB/T AC';
        if (/^type2|^type 2/.test(s)) return 'Type 2';
        if (/^(type1|type 1|type1_combo|ccs1)/.test(s)) return 'Type 1';
        if (/^schuko/.test(s)) return 'Розетка 220 В';
        return '';
      }
      var FILTERS = [
        ['ccs2', 'CCS2', 'zsh-ccs2'],
        ['gbt_dc', 'GB/T DC', 'zsh-gbt-dc'],
        ['gbt_ac', 'GB/T AC', 'zsh-gbt-ac'],
        ['type2', 'Type 2', 'zsh-type2'],
        ['type2_socket', 'Type 2 розетка', 'zsh-type2-socket'],
        ['chademo', 'CHAdeMO', 'zsh-chademo'],
        ['type1', 'Type 1', 'zsh-type1'],
        ['schuko', 'Розетка 220 В', 'zsh-schuko'],
      ];
      var active = {};
      var PW_PREDS = {
        pw100: function (s) { return (Number(s.pw) || 0) >= 100; },
        pw50: function (s) { var p = Number(s.pw) || 0; return p >= 50 && p < 100; },
        pw22: function (s) { var p = Number(s.pw) || 0; return p > 0 && p < 50; }
      };
      var PW_LABELS = [
        ['pw100', '⌁ 100 кВт и быстрее (DC)'],
        ['pw50', '⌁ 50–99 кВт (DC)'],
        ['pw22', '⌁ до 50 кВт (AC и медленный DC)']
      ];
      fetch('/charging/stations.json').then(function (r) { return r.json(); }).then(function (data) {
        var st = data.stations || [];
        document.getElementById('stn-count').textContent = st.length;
        document.getElementById('stn-upd').textContent = data.updated || '';
        st.forEach(function (s) {
          s.__c = {};
          (s.s || []).forEach(function (raw) {
            var k = normConn(raw);
            if (!k) return;
            var low = String(raw).toLowerCase();
            if (k === 'Type 2') {
              if (low.indexOf('cable') >= 0 || low.indexOf('кабель') >= 0) s.__c.type2 = true;
              else if (low.indexOf('socket') >= 0) s.__c.type2_socket = true;
              else s.__c.type2 = true;
            } else if (k === 'CCS2') s.__c.ccs2 = true;
            else if (k === 'CHAdeMO') s.__c.chademo = true;
            else if (k === 'GB/T DC') s.__c.gbt_dc = true;
            else if (k === 'GB/T AC') s.__c.gbt_ac = true;
            else if (k === 'Type 1') s.__c.type1 = true;
            else if (k === 'Розетка 220 В') s.__c.schuko = true;
          });
        });
        var cityCount = {}, cityPts = {};
        st.forEach(function (s) {
          var c = String(s.a || '').split(',')[0].trim() || 'Без адреса';
          cityCount[c] = (cityCount[c] || 0) + 1;
          (cityPts[c] = cityPts[c] || []).push([s.lat, s.lon]);
        });
        var chips = Object.entries(cityCount).sort(function (x, y) { return y[1] - x[1]; }).slice(0, 12);
        var chipsBox = document.getElementById('city-chips');
        chips.forEach(function (pair) {
          var b = document.createElement('button');
          b.className = 'chip';
          b.textContent = pair[0] + ' (' + pair[1] + ')';
          b.addEventListener('click', function () {
            var pts = cityPts[pair[0]] || [];
            if (yaActive) {
              loadYaWidget(pts, pair[0]);
            } else if (pts.length) {
              map.fitBounds(L.latLngBounds(pts).pad(0.25), { maxZoom: 12 });
            }
          });
          chipsBox.appendChild(b);
        });
        if (!map) {
          map = L.map('map').setView([55.75, 37.62], 5);
          var _tl=L.tileLayer('https://core-renderer-tile.maps.yandex.net/2.0/tiles?l=map&x={x}&y={y}&z={z}&scale=1&v=2024.06.03.16.17-4',{maxZoom:18}).addTo(map);var _mapFb=false;_tl.on('tileerror',function(){if(_mapFb)return;_mapFb=true;_tl.remove();L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:18,attribution:'&copy; OpenStreetMap'}).addTo(map);});
          cluster = L.markerClusterGroup();
          st.forEach(function (s) {
            if (typeof s.lat !== 'number' || typeof s.lon !== 'number') return;
            var conn = (s.s || []).join(' ');
            var pw = Number(s.pw) || 0;
            var dc = /CCS|CHAdeMO|GB\/T DC|type2_combo|gb_dc/i.test(conn) || pw >= 50;
            var m = L.circleMarker([s.lat, s.lon], { radius: 7, color: dc ? '#2563eb' : '#16a34a', fillColor: dc ? '#2563eb' : '#16a34a', fillOpacity: 0.85 });
            m.bindPopup('<b>' + (s.n || 'Станция') + '</b>' + (s.op ? ' · ' + s.op : '') + '<br>' + (s.a || '') + '<br>' + (conn || '') + (pw ? ' · ' + pw + ' кВт' : '') + (s.src === 'osm' ? '<br><span style="font-size:11px;color:#888">данные OSM (ODbL)</span>' : '') + '<br><a href="https://yandex.ru/maps/?pt=' + s.lon + ',' + s.lat + '&z=17&l=map" target="_blank" rel="noopener" style="color:#4d9bf5;font-size:13px;text-decoration:underline">Открыть в Яндекс.Картах →</a> | <a href="https://2chargers.ru/" target="_blank" rel="noopener" style="color:#4d9bf5;font-size:13px;text-decoration:underline">Статус в 2Chargers →</a>' + '<br><a href="https://t.me/zapashoda_ev_bot?text=' + encodeURIComponent('Статус станции: ' + (s.n || '') + (s.a ? ' — ' + s.a : '') + '. Разъёмы: ' + (conn || '—') + (pw ? ', ' + pw + ' кВт' : '') + '. Отметка: ') + '" target="_blank" rel="noopener" style="color:#4d9bf5;font-size:13px;text-decoration:underline">Сообщить статус станции →</a>');
            m.__s = s;
            ALL.push(m);
          });
          map.addLayer(cluster);
          buildConnChips();
          applyFilter();
        }
        var sBtn = document.getElementById('city-go');
        if (sBtn) sBtn.addEventListener('click', function () {
          var q = String(document.getElementById('city-search').value || '').trim().toLowerCase();
          var note = document.getElementById('geo-note');
          if (!q) return;
          var hits = ALL.filter(function (m) { return String(m.__s.a || '').toLowerCase().indexOf(q) >= 0; });
          if (hits.length) {
            cluster.clearLayers();
            hits.forEach(function (m) { cluster.addLayer(m); });
            map.fitBounds(L.latLngBounds(hits.map(function (m) { return [m.__s.lat, m.__s.lon]; })).pad(0.3), { maxZoom: 12 });
            if (note) note.textContent = 'Найдено ' + hits.length + ' станций по запросу «' + q + '». Кликните по фильтру разъёмов, чтобы сбросить поиск.';
          } else if (note) {
            note.textContent = 'По запросу «' + q + '» ничего не найдено в базе. Попробуйте название города без улицы.';
          }
        });
        var gBtn = document.getElementById('geo-btn');
        if (gBtn) gBtn.addEventListener('click', function () {
          var note = document.getElementById('geo-note');
          if (!navigator.geolocation) { if (note) note.textContent = 'Браузер не поддерживает геолокацию — воспользуйтесь поиском города.'; return; }
          navigator.geolocation.getCurrentPosition(function (pos) {
            var lat = pos.coords.latitude, lon = pos.coords.longitude, R = 6371;
            function hav(a) { var d = Math.PI / 180; var x = Math.sin((a[0]-lat)*d/2), y = Math.sin((a[1]-lon)*d/2); return 2*R*Math.asin(Math.sqrt(x*x + Math.cos(a[0]*d)*Math.cos(lat*d)*y*y)); }
            var near = ALL.filter(function (m) { return m.__s.lat && m.__s.lon && hav([m.__s.lat, m.__s.lon]) <= 50; });
            if (near.length) {
              cluster.clearLayers();
              near.forEach(function (m) { cluster.addLayer(m); });
              map.fitBounds(L.latLngBounds(near.map(function (m) { return [m.__s.lat, m.__s.lon]; })).pad(0.3), { maxZoom: 12 });
              if (note) note.textContent = 'Рядом (до 50 км): ' + near.length + ' станций. Фильтр разъёмов работает поверх — выберите свой разъём выше.';
            } else if (note) {
              note.textContent = 'В радиусе 50 км станций не нашлось. Покажем всю карту.';
              map.setView([lat, lon], 9);
            }
          }, function () {
            if (note) note.textContent = 'Не удалось получить геолокацию — найдите свой город поиском выше.';
          });
        });
      });
      function hasAny(s) {
        for (var k in active) {
          if (!active[k]) continue;
          if (PW_PREDS[k]) { if (PW_PREDS[k](s)) return true; }
          else if (s.__c && s.__c[k]) return true;
        }
        return false;
      }
      function applyFilter() {
        if (!cluster) return;
        var keys = Object.keys(active).filter(function (k) { return active[k]; });
        cluster.clearLayers();
        var shown = 0;
        ALL.forEach(function (m) {
          var ok = keys.length === 0 || hasAny(m.__s);
          if (ok) { cluster.addLayer(m); shown++; }
        });
        var note = document.getElementById('conn-note');
        if (note) note.textContent = keys.length ? ('Показано ' + shown + ' из ' + ALL.length + ' станций') : '';
        try {
          var hk = keys.filter(function (k) { return FILTERS.some(function (f) { return f[0] === k; }) || PW_PREDS[k]; }).join(',');
          history.replaceState(null, '', hk ? '#f=' + hk : location.pathname + location.search);
        } catch (e) {}
      }
      function buildConnChips() {
        var box = document.getElementById('conn-chips');
        if (!box) return;
        FILTERS.forEach(function (f) {
          var b = document.createElement('button');
          b.className = 'chip cchip';
          b.dataset.k = f[0];
          var ic = document.createElement('img');
          ic.src = '/assets/img/plugs/' + f[2] + '.svg';
          ic.width = 18; ic.height = 18; ic.alt = '';
          b.appendChild(ic);
          b.appendChild(document.createTextNode(f[1]));
          b.addEventListener('click', function () {
            active[f[0]] = !active[f[0]];
            b.classList.toggle('on', !!active[f[0]]);
            applyFilter();
          });
          box.appendChild(b);
        });
        var all = document.createElement('button');
        all.className = 'chip cchip on';
        all.textContent = 'Все станции';
        all.addEventListener('click', function () {
          active = {};
          document.querySelectorAll('.cchip').forEach(function (x) { x.classList.toggle('on', x === all); });
          applyFilter();
        });
        box.appendChild(all);
        var pwBox = document.getElementById('pw-chips');
        PW_LABELS.forEach(function (f) {
          var b = document.createElement('button');
          b.className = 'chip cchip';
          b.dataset.k = f[0];
          b.textContent = f[1];
          b.addEventListener('click', function () {
            active[f[0]] = !active[f[0]];
            b.classList.toggle('on', !!active[f[0]]);
            applyFilter();
          });
          pwBox.appendChild(b);
        });
        try {
          var hh = String(location.hash || '');
          if (hh.indexOf('#f=') === 0) {
            hh.slice(3).split(',').forEach(function (k) {
              k = decodeURIComponent(k);
              if (FILTERS.some(function (f) { return f[0] === k; }) || PW_PREDS[k]) { active[k] = true; }
            });
            document.querySelectorAll('.cchip').forEach(function (x) {
              if (active[x.dataset.k]) x.classList.add('on');
              else if (x.dataset.k) x.classList.remove('on');
            });
          }
        } catch (e) {}
      }

      // ===== Вкладки: Яндекс-виджет vs наша фильтр-карта =====
      var yaActive = true, yaFrame = null, yaLL = '37.62,55.75', yaZ = 5, yaText = 'электрозаправки';
      function buildYaUrl() {
        return 'https://yandex.ru/map-widget/v1/?text=' + encodeURIComponent(yaText) + '&ll=' + yaLL + '&z=' + yaZ + '&l=map';
      }
      function ensureYaFrame() {
        if (yaFrame) return;
        yaFrame = document.createElement('iframe');
        yaFrame.style.cssText = 'width:100%;height:100%;border:0';
        yaFrame.src = buildYaUrl();
        yaFrame.title = 'Поиск зарядных станций на Яндекс.Картах';
        yaFrame.loading = 'lazy';
        document.getElementById('map-ya').appendChild(yaFrame);
      }
      function loadYaWidget(pts, city) {
        ensureYaFrame();
        if (pts && pts.length) {
          var lat = pts.reduce(function (a, p) { return a + p[0]; }, 0) / pts.length;
          var lon = pts.reduce(function (a, p) { return a + p[1]; }, 0) / pts.length;
          yaLL = lon.toFixed(4) + ',' + lat.toFixed(4);
          yaZ = Math.max(10, Math.min(14, 11 + (pts.length > 40 ? 1 : 0)));
        }
        if (city) yaText = 'электрозаправки ' + city;
        yaFrame.src = buildYaUrl();
        var note = document.getElementById('geo-note');
        if (note) note.textContent = 'Открыли поиск Яндекс.Карт: «' + yaText + '». Там видны все станции Яндекса, включая живой статус.' ;
      }
      var tYa = document.getElementById('tab-ya'), tOwn = document.getElementById('tab-own');
      function setTab(ya) {
        yaActive = ya;
        document.getElementById('map-ya').style.display = ya ? '' : 'none';
        document.getElementById('map').style.display = ya ? 'none' : '';
        tYa.style.borderColor = ya ? '#4d9bf5' : '';
        tYa.style.background = ya ? 'rgba(77,155,245,.12)' : '';
        tOwn.style.borderColor = ya ? '' : '#4d9bf5';
        tOwn.style.background = ya ? '' : 'rgba(77,155,245,.12)';
        if (ya) ensureYaFrame();
        else setTimeout(function () { map.invalidateSize(); }, 50);
        try { history.replaceState(null, '', ya ? '#view=ya' : '#view=own'); } catch (e) {}
      }
      if (tYa) tYa.addEventListener('click', function () { setTab(true); });
      if (tOwn) tOwn.addEventListener('click', function () { setTab(false); });
      ensureYaFrame();
      try { if (location.hash.indexOf('#view=own') === 0) setTab(false); } catch (e) {}
    })();
  </script>
<style is:global>.cchip{display:inline-flex;gap:7px;align-items:center;cursor:pointer;font-family:inherit}.cchip.on{border-color:#4d9bf5;background:rgba(77,155,245,.12);color:#9ecbff}.leaflet-tile-pane{filter:invert(1) hue-rotate(185deg) brightness(.95) contrast(1.05) saturate(.75)}#map{background:#0b0b0d}</style>
</ZhLayout>
