---
import ZhLayout from '../../layouts/ZhLayout.astro';
const ld = { '@context': 'https://schema.org', '@type': 'WebPage', name: 'Дашборд зарядных станций (бета)', description: 'Бортовой дашборд EV: карта ЭЗС, совместимость, запас хода. Бета-версия нового интерфейса.' };
---
<ZhLayout title="Зарядные станции — дашборд (бета) · Запас хода" description="Дашборд ЭЗС: карта станций России, совместимость с вашей моделью, реальный запас хода. Бета-версия нового интерфейса." jsonld={ld}>
  <style>
    :root {
      --bg-base: #050507;
      --bg-surface: rgba(13, 14, 18, 0.88);
      --border-subtle: rgba(255, 255, 255, 0.08);
      --border-highlight: rgba(255, 255, 255, 0.16);
      --orange: #FF6F00;
      --red-deep: #C10801;
      --orange-bright: #FF8F33;
      --sand-gold: #D9C3AB;
      --text-primary: #F9F9F9;
      --text-secondary: #A7A7A7;
      --text-muted: #646464;
      --green: #10B981;
      --brand-grad: linear-gradient(90deg, #C10801 0%, #FF6F00 45%, #FF8F33 75%, #D9C3AB 100%);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Inter", "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    body {
      background: var(--bg-base);
      color: var(--text-primary);
    }

    .app-shell {
      position: relative;
      height: 100vh;
      overflow: hidden;
      margin: 0 calc(50% - 50vw);
      width: 100vw;
    }

    /* Интерактивная векторная темная карта города (автономная, без внешних зависимостей) */
    .map-viewport {
      position: absolute;
      inset: 0;
      background: #08090C;
      overflow: hidden;
      z-index: 1;
      cursor: grab;
    }

    .map-viewport:active {
      cursor: grabbing;
    }

    .left-vignette {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 490px;
      background: linear-gradient(90deg, rgba(5,5,7,0.94) 0%, rgba(5,5,7,0.62) 68%, transparent 100%);
      pointer-events: none;
      z-index: 2;
    }

    /* Верхняя капсула навигации */
    .top-bar {
      position: absolute;
      top: 18px;
      left: 20px;
      right: 20px;
      z-index: 20;
      display: flex;
      justify-content: space-between;
      align-items: center;
      pointer-events: none;
    }

    .glass-pill {
      pointer-events: auto;
      background: var(--bg-surface);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid var(--border-subtle);
      border-top-color: var(--border-highlight);
      border-radius: 16px;
      padding: 6px;
      display: flex;
      align-items: center;
      gap: 6px;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.55);
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 4px 12px 4px 6px;
    }

    .brand-mark {
      width: 30px;
      height: 30px;
      border-radius: 9px;
      background: var(--brand-grad);
      color: #000;
      font-weight: 800;
      font-size: 15px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .brand-name {
      font-size: 14px;
      font-weight: 600;
      letter-spacing: -0.02em;
    }

    .seg-btn {
      background: transparent;
      border: none;
      color: var(--text-secondary);
      font-size: 12px;
      font-weight: 500;
      padding: 7px 12px;
      border-radius: 11px;
      cursor: pointer;
      transition: 0.2s;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .seg-btn:hover {
      color: var(--text-primary);
      background: rgba(255,255,255,0.05);
    }

    .seg-btn.active {
      background: #1E2028;
      color: var(--text-primary);
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.1);
    }

    .seg-btn.active .dot-live {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--orange);
      box-shadow: 0 0 8px var(--orange);
    }

    .cta-orange {
      background: var(--orange);
      color: #FFF;
      border: none;
      border-radius: 11px;
      padding: 8px 14px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      transition: 0.2s;
      box-shadow: 0 4px 16px rgba(232, 80, 2, 0.35);
    }

    .cta-orange:hover {
      background: var(--orange-bright);
    }

    /* Левый стек телеметрии */
    .telemetry-stack {
      position: absolute;
      top: 78px;
      left: 20px;
      bottom: 20px;
      width: 416px;
      z-index: 15;
      display: flex;
      flex-direction: column;
      gap: 14px;
      overflow-y: auto;
      padding-right: 4px;
    }

    .telemetry-stack::-webkit-scrollbar {
      width: 0px;
    }

    .hud-card {
      background: var(--bg-surface);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid var(--border-subtle);
      border-top-color: var(--border-highlight);
      border-radius: 22px;
      padding: 20px;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.55);
      flex-shrink: 0;
    }

    .card-eyebrow {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-secondary);
      margin-bottom: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    /* 1. Премиальный триггер модели */
    .car-trigger {
      background: linear-gradient(145deg, #161820 0%, #0E0F14 100%);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 16px;
      padding: 14px 16px;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: 0.2s;
    }

    .car-trigger:hover {
      border-color: var(--orange);
      background: #191B24;
    }

    .car-model-title {
      font-size: 18px;
      font-weight: 600;
      letter-spacing: -0.02em;
      margin-bottom: 5px;
    }

    .car-model-meta {
      font-size: 12px;
      color: var(--text-secondary);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .port-tag {
      color: var(--sand-gold);
      background: rgba(232, 80, 2, 0.14);
      border: 1px solid rgba(232, 80, 2, 0.3);
      padding: 2px 8px;
      border-radius: 6px;
      font-weight: 600;
      font-size: 11px;
    }

    .change-pill {
      background: rgba(255,255,255,0.06);
      color: var(--text-primary);
      font-size: 12px;
      font-weight: 500;
      padding: 7px 12px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,0.08);
    }

    /* 2. Выбор города сразу под моделью */
    .city-row {
      display: flex;
      gap: 8px;
      margin-bottom: 12px;
    }

    .city-search-input {
      flex: 1;
      background: #121318;
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
      padding: 10px 14px;
      color: var(--text-primary);
      font-size: 13px;
      outline: none;
    }

    .city-search-input:focus {
      border-color: var(--orange);
    }

    .gps-btn {
      background: #161820;
      border: 1px solid var(--border-subtle);
      color: var(--text-primary);
      border-radius: 12px;
      padding: 0 14px;
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      white-space: nowrap;
      transition: 0.2s;
    }

    .gps-btn:hover {
      border-color: var(--orange);
      color: var(--orange);
    }

    .city-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .city-chip {
      background: #121318;
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      font-size: 12px;
      padding: 6px 11px;
      border-radius: 10px;
      cursor: pointer;
      transition: 0.2s;
    }

    .city-chip b {
      color: var(--text-muted);
      font-weight: 500;
      margin-left: 3px;
    }

    .city-chip.active {
      background: rgba(232, 80, 2, 0.15);
      border-color: var(--orange);
      color: var(--text-primary);
    }

    .city-chip.active b {
      color: var(--orange);
    }

    /* 3. Главный виджет запаса хода */
    .range-hero-card {
      background: radial-gradient(circle at 50% 125%, rgba(232, 80, 2, 0.24), rgba(193, 8, 1, 0.05) 55%, var(--bg-surface) 85%);
    }

    .range-main-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 16px;
    }

    .km-huge {
      font-size: 52px;
      font-weight: 600;
      line-height: 0.95;
      letter-spacing: -0.04em;
      font-variant-numeric: tabular-nums;
    }

    .km-unit {
      font-size: 18px;
      font-weight: 400;
      color: var(--text-secondary);
      margin-left: 4px;
    }

    .passport-note {
      font-size: 12px;
      color: var(--text-secondary);
      margin-top: 6px;
    }

    .pct-display {
      text-align: right;
    }

    .pct-big {
      font-size: 28px;
      font-weight: 600;
      color: var(--sand-gold);
      font-variant-numeric: tabular-nums;
      line-height: 1;
    }

    .slider-container {
      margin-bottom: 12px;
    }

    input[type="range"] {
      -webkit-appearance: none;
      width: 100%;
      height: 8px;
      border-radius: 6px;
      background: var(--brand-grad);
      outline: none;
      cursor: pointer;
    }

    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: #FFF;
      border: 4px solid var(--orange);
      box-shadow: 0 0 14px rgba(232, 80, 2, 0.8);
      cursor: pointer;
    }

    .pct-presets {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
    }

    .preset-pill {
      background: rgba(255,255,255,0.04);
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      font-size: 12px;
      font-weight: 500;
      padding: 7px 0;
      border-radius: 10px;
      cursor: pointer;
      transition: 0.15s;
    }

    .preset-pill.active, .preset-pill:hover {
      border-color: var(--orange);
      color: var(--text-primary);
      background: rgba(232, 80, 2, 0.15);
    }

    /* 4. Крупный виджет погоды */
    .weather-banner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #12141B;
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 16px;
      padding: 14px 16px;
      margin-bottom: 12px;
    }

    .weather-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .weather-temp {
      font-size: 26px;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      letter-spacing: -0.03em;
    }

    .weather-desc {
      font-size: 12px;
      color: var(--text-secondary);
    }

    .impact-badge {
      display: inline-block;
      padding: 4px 9px;
      border-radius: 8px;
      font-weight: 600;
      background: rgba(232, 80, 2, 0.15);
      color: var(--orange-bright);
    }

    .scenario-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
    }

    .scen-btn {
      background: #121318;
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      font-size: 11px;
      font-weight: 500;
      padding: 9px 4px;
      border-radius: 11px;
      cursor: pointer;
      text-align: center;
      transition: 0.2s;
    }

    .scen-btn.active {
      background: var(--orange);
      border-color: var(--orange);
      color: #FFF;
      font-weight: 600;
      box-shadow: 0 4px 14px rgba(232, 80, 2, 0.4);
    }

    /* 5. Разъемы */
    .connector-chips {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-top: 12px;
    }

    .conn-chip {
      font-size: 11px;
      padding: 5px 10px;
      border-radius: 8px;
      border: 1px solid var(--border-subtle);
      background: #121318;
      color: var(--text-secondary);
      cursor: pointer;
    }

    .conn-chip.direct {
      border-color: var(--orange);
      color: var(--text-primary);
      background: rgba(232, 80, 2, 0.14);
    }

    .conn-chip.adapter {
      border-style: dashed;
      border-color: var(--sand-gold);
      color: var(--sand-gold);
    }

    /* Правая лента ЭЗС (Сплит-режим) */
    .right-drawer {
      position: absolute;
      top: 78px;
      right: 20px;
      width: 350px;
      max-height: calc(100vh - 98px);
      z-index: 15;
      display: flex;
      flex-direction: column;
      gap: 12px;
      overflow-y: auto;
    }

    .right-drawer::-webkit-scrollbar {
      width: 0px;
    }

    .station-item {
      background: var(--bg-surface);
      backdrop-filter: blur(24px);
      border: 1px solid var(--border-subtle);
      border-top-color: var(--border-highlight);
      border-radius: 20px;
      padding: 18px;
      transition: 0.2s;
      cursor: pointer;
    }

    .station-item.selected, .station-item:hover {
      border-color: var(--orange);
    }

    .st-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 10px;
    }

    .st-name {
      font-size: 15px;
      font-weight: 600;
      margin-bottom: 3px;
    }

    .st-addr {
      font-size: 12px;
      color: var(--text-secondary);
    }

    .st-kw {
      background: rgba(232, 80, 2, 0.16);
      color: var(--orange-bright);
      font-weight: 700;
      font-size: 13px;
      padding: 5px 10px;
      border-radius: 10px;
      white-space: nowrap;
    }

    .st-metrics {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      background: rgba(0,0,0,0.35);
      padding: 10px;
      border-radius: 12px;
      margin-bottom: 12px;
      font-size: 11px;
      color: var(--text-secondary);
    }

    .st-metrics div b {
      display: block;
      color: var(--text-primary);
      font-size: 13px;
      margin-top: 2px;
    }

    .st-actions {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 6px;
    }

    .btn-ghost {
      background: #161820;
      border: 1px solid var(--border-subtle);
      color: var(--text-primary);
      border-radius: 10px;
      padding: 8px 6px;
      font-size: 11px;
      font-weight: 500;
      cursor: pointer;
      text-align: center;
    }

    /* Модальное окно выбора из 154 авто */
    .modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.78);
      backdrop-filter: blur(12px);
      z-index: 50;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .modal-backdrop.open {
      display: flex;
    }

    .modal-box {
      width: 100%;
      max-width: 520px;
      background: #101116;
      border: 1px solid var(--border-highlight);
      border-radius: 24px;
      padding: 22px;
      box-shadow: 0 30px 80px rgba(0,0,0,0.85);
    }

    .model-list {
      max-height: 340px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-top: 12px;
    }

    .model-option {
      background: #161820;
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      padding: 12px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
    }

    .model-option:hover {
      border-color: var(--orange);
    }

    /* Легенда карты внизу */
    .map-legend {
      position: absolute;
      bottom: 20px;
      left: 50%;
      transform: translateX(-35%);
      z-index: 10;
      background: var(--bg-surface);
      backdrop-filter: blur(20px);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      padding: 9px 16px;
      display: flex;
      gap: 16px;
      font-size: 11px;
      color: var(--text-secondary);
    }

    .leg-item {
      display: flex;
      align-items: center;
      gap: 6px;
    }
  </style>
  

<div class="app-shell">
  <div class="map-viewport" id="mapViewport">
    <svg id="cityMapSvg" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" style="width:100%;height:100%;">
      <rect width="1440" height="900" fill="#08090C" />
      <path d="M 380 0 Q 440 240, 620 340 T 860 560 T 1180 900" fill="none" stroke="#0D1520" stroke-width="44" />
      <g id="roadGrid" stroke="#181B24" stroke-width="2.5" fill="none">
        <circle cx="760" cy="440" r="140" />
        <circle cx="760" cy="440" r="260" />
        <circle cx="760" cy="440" r="390" />
        <line x1="760" y1="0" x2="760" y2="900" />
        <line x1="200" y1="440" x2="1440" y2="440" />
        <line x1="340" y1="60" x2="1220" y2="860" />
        <line x1="1220" y1="80" x2="340" y2="820" />
        <path d="M 480 180 L 1060 180 L 1140 680 L 460 720 Z" stroke="#13161E" stroke-width="1.5" />
      </g>
      <circle id="rangeIsochrone" cx="760" cy="440" r="240" fill="rgba(232, 80, 2, 0.06)" stroke="#FF6F00" stroke-width="1.5" stroke-dasharray="7,7" />

      <g id="pinsOurBase">
        <g transform="translate(690, 360)" style="cursor:pointer" onclick="highlightStation(0)">
          <circle r="24" fill="rgba(232, 80, 2, 0.25)" />
          <circle r="17" fill="#FF6F00" stroke="#FFF" stroke-width="2" />
          <text y="4" text-anchor="middle" fill="#FFF" font-size="11" font-weight="700">150</text>
        </g>
        <g transform="translate(820, 410)" style="cursor:pointer" onclick="highlightStation(1)">
          <circle r="17" fill="#FF6F00" stroke="#FFF" stroke-width="2" />
          <text y="4" text-anchor="middle" fill="#FFF" font-size="11" font-weight="700">120</text>
        </g>
        <g transform="translate(730, 510)" style="cursor:pointer" onclick="highlightStation(2)">
          <circle r="16" fill="#0D0E12" stroke="#FF6F00" stroke-width="2.5" />
          <text y="4" text-anchor="middle" fill="#FF6F00" font-size="10" font-weight="700">CCS</text>
        </g>
        <g transform="translate(910, 320)">
          <circle r="15" fill="#0D1F18" stroke="#10B981" stroke-width="2" />
          <text y="4" text-anchor="middle" fill="#10B981" font-size="10" font-weight="700">22</text>
        </g>
        <g transform="translate(610, 470)">
          <circle r="13" fill="#181A20" stroke="#646464" stroke-width="1.5" />
          <text y="4" text-anchor="middle" fill="#A7A7A7" font-size="10">?</text>
        </g>
      </g>

      <g id="pinsYandexBase" style="display:none;">
        <path d="M 520 300 L 980 580" stroke="#EF4444" stroke-width="4" opacity="0.7" />
        <path d="M 640 200 L 890 700" stroke="#F59E0B" stroke-width="3.5" opacity="0.7" />
        <circle cx="670" cy="340" r="10" fill="#10B981" stroke="#FFF" stroke-width="1.5" />
        <circle cx="710" cy="390" r="10" fill="#10B981" stroke="#FFF" stroke-width="1.5" />
        <circle cx="790" cy="430" r="10" fill="#3B82F6" stroke="#FFF" stroke-width="1.5" />
        <circle cx="840" cy="480" r="10" fill="#10B981" stroke="#FFF" stroke-width="1.5" />
        <circle cx="750" cy="530" r="10" fill="#3B82F6" stroke="#FFF" stroke-width="1.5" />
        <circle cx="880" cy="350" r="10" fill="#10B981" stroke="#FFF" stroke-width="1.5" />
        <circle cx="620" cy="450" r="10" fill="#10B981" stroke="#FFF" stroke-width="1.5" />
      </g>

      <g transform="translate(760, 440)">
        <circle r="14" fill="rgba(232, 80, 2, 0.28)" />
        <circle r="6" fill="#FF6F00" stroke="#FFF" stroke-width="2" />
      </g>
    </svg>
  </div>

  <div class="left-vignette"></div>

  <header class="top-bar">
    <div class="glass-pill">
      <div class="brand-logo">
        <div class="brand-mark">Z</div>
        <span class="brand-name">Запас хода EV</span>
      </div>
      <button class="seg-btn active" id="btnBaseOur" onclick="switchSource('our')">
        <span class="dot-live"></span>Наша база · 3 129
      </button>
      <button class="seg-btn" id="btnBaseYa" onclick="switchSource('ya')">
        Яндекс.Карты · 9 900
      </button>
    </div>

    <div class="glass-pill">
      <button class="seg-btn active" id="btnViewSplit" onclick="switchView('split')">⧉ Сплит</button>
      <button class="seg-btn" id="btnViewMap" onclick="switchView('map')">🗺 Карта</button>
      <button class="cta-orange" onclick="copyShareUrl()">Поделиться URL</button>
    </div>
  </header>

  <aside class="telemetry-stack">
    <div class="hud-card">
      <div class="card-eyebrow">
        <span>1. Ваш электромобиль</span>
        <span style="color: var(--text-muted);">База: 154 модели</span>
      </div>
      <div class="car-trigger" onclick="openCarModal()">
        <div>
