<script>
  const MODELS = [
    { name: "Zeekr 001 (100 кВт·ч)", base: 540, port: "GB/T DC · 200 кВт" },
    { name: "Zeekr 007 (75 кВт·ч)", base: 480, port: "GB/T DC · 240 кВт" },
    { name: "BYD Song Plus EV", base: 460, port: "GB/T DC · 90 кВт" },
    { name: "BYD Han EV", base: 510, port: "GB/T DC · 120 кВт" },
    { name: "Tesla Model Y Long Range (EU)", base: 490, port: "CCS2 · 250 кВт" },
    { name: "Tesla Model 3 Highland (EU)", base: 515, port: "CCS2 · 250 кВт" },
    { name: "Li Auto L7 (батарея EV)", base: 180, port: "GB/T DC · 75 кВт" },
    { name: "Avatr 11 (официально RU)", base: 525, port: "GB/T DC · 240 кВт" },
    { name: "Xiaomi SU7 Max", base: 620, port: "GB/T DC · 260 кВт" },
    { name: "Evolute i-Pro", base: 340, port: "GB/T DC · 60 кВт" }
  ];

  let state = { baseKm: 540, pct: 80, mult: 1.0, city: "Москва" };

  function recalc() {
    const real = Math.round(state.baseKm * (state.pct / 100) * state.mult);
    document.getElementById('uiRealKm').textContent = real;
    document.getElementById('uiPctVal').textContent = state.pct + '%';
    document.getElementById('uiPassportNote').textContent = `Из ${state.baseKm} км по паспорту (100%)`;
    document.getElementById('rangeIsochrone').setAttribute('r', Math.max(90, Math.round(real * 0.55)));
  }

  function onChargeChange(val) {
    state.pct = parseInt(val, 10);
    document.querySelectorAll('.preset-pill').forEach(b => b.classList.remove('active'));
    recalc();
  }

  function setPct(val, btn) {
    state.pct = val;
    document.getElementById('chargeSlider').value = val;
    document.querySelectorAll('.preset-pill').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    recalc();
  }

  function setScenario(mult, temp, icon, desc, impact, svgX, btn) {
    state.mult = mult;
    document.querySelectorAll('.scen-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('uiWeatherTemp').textContent = temp;
    document.getElementById('uiWeatherIcon').textContent = icon;
    document.getElementById('uiWeatherCity').textContent = `${state.city} · ${desc}`;
    document.getElementById('uiImpactBadge').textContent = impact;
    document.getElementById('uiScenBadge').textContent = `${btn.textContent} · ${temp}`;
    document.getElementById('svgMarkerLine').setAttribute('x1', svgX);
    document.getElementById('svgMarkerLine').setAttribute('x2', svgX);
    document.getElementById('svgMarkerDot').setAttribute('cx', svgX);
    recalc();
  }

  function selectCity(name, count, btn) {
    state.city = name;
    document.getElementById('cityInput').value = name;
    document.getElementById('uiCityCount').textContent = `${count} ЭЗС в базе`;
    document.getElementById('uiWeatherCity').textContent = `${name} · Живой прогноз`;
    if (btn) {
      document.querySelectorAll('.city-chip').forEach(c => c.classList.remove('active'));
      btn.classList.add('active');
    }
  }

  function switchSource(src) {
    document.getElementById('btnBaseOur').classList.toggle('active', src === 'our');
    document.getElementById('btnBaseYa').classList.toggle('active', src === 'ya');
    document.getElementById('pinsOurBase').style.display = src === 'our' ? 'block' : 'none';
    document.getElementById('pinsYandexBase').style.display = src === 'ya' ? 'block' : 'none';
    document.getElementById('connectorsCard').style.opacity = src === 'ya' ? '0.45' : '1';
  }

  function switchView(view) {
    document.getElementById('btnViewSplit').classList.toggle('active', view === 'split');
    document.getElementById('btnViewMap').classList.toggle('active', view === 'map');
    document.getElementById('rightDrawer').style.display = view === 'split' ? 'flex' : 'none';
  }

  function highlightStation(idx) {
    document.querySelectorAll('.station-item').forEach((el, i) => el.classList.toggle('selected', i === idx));
  }

  function copyShareUrl() {
    alert('Ссылка с выбранным авто, городом и уровнем заряда скопирована!');
  }

  function renderModels(list) {
    const container = document.getElementById('modelList');
    container.innerHTML = list.map(m => `
      <div class="model-option" onclick="chooseModel('${m.name}', ${m.base}, '${m.port}')">
        <div>
          <div style="font-weight: 600; font-size: 14px;">${m.name}</div>
          <div style="font-size: 12px; color: var(--text-secondary);">Паспортный запас: ${m.base} км</div>
        </div>
        <span class="port-tag">${m.port}</span>
      </div>
    `).join('');
  }

  function openCarModal() {
    renderModels(MODELS);
    document.getElementById('carModal').classList.add('open');
  }

  function closeCarModal() {
    document.getElementById('carModal').classList.remove('open');
  }

  function filterModels(q) {
    renderModels(MODELS.filter(m => m.name.toLowerCase().includes(q.toLowerCase())));
  }

  function chooseModel(name, base, port) {
    state.baseKm = base;
    document.getElementById('uiCarName').textContent = name;
    document.getElementById('uiCarPort').textContent = port;
    closeCarModal();
    recalc();
  }

  recalc();
</script>

