---
import ZhLayout from '../../layouts/ZhLayout.astro';
import fs from 'node:fs';
import citiesRaw from '../../data/cities_index.json';

let stations = []; let updated = null;
try {
  const raw = JSON.parse(fs.readFileSync('public/charging/stations.json', 'utf-8'));
  stations = raw.stations || [];
  updated = raw.updated;
} catch (e) {}

// Привязка станций к городам: точное имя в адресе → частичное → регион → ближайший город ≤60 км → «Прочие»
const norm = (s) => (s || '').toLowerCase().replace(/ё/g, 'е').trim();
const CITIES = (citiesRaw.cities || []);
const byName = new Map(CITIES.map((c) => [norm(c.n), c]));
const regionIndex = new Map();
CITIES.forEach((c) => {
  const r = norm(c.reg || '');
  if (r.length > 4 && (!regionIndex.has(r) || (c.pop || 0) > (regionIndex.get(r).pop || 0))) regionIndex.set(r, c);
});
const hav = (lat1, lon1, lat2, lon2) => {
  const R = 6371, p = Math.PI / 180;
  const a = Math.sin((lat2 - lat1) * p / 2) ** 2 + Math.cos(lat1 * p) * Math.cos(lat2 * p) * Math.sin((lon2 - lon1) * p / 2) ** 2;
  return 2 * R * Math.asin(Math.min(1, Math.sqrt(a)));
};
const RADIUS = 60;
const byMap = new Map();
for (const s of stations) {
  const a = (s.a || '').trim();
  const frags = a.split(',').map(norm);
  let city = null;
  for (const f of frags) {
    const f2 = f.replace(/\bг\.?\s*/, '').trim();
    if (f2 && byName.has(f2)) { city = byName.get(f2); break; }
  }
  if (!city) outer: for (const f of frags) {
    for (const [name, c] of byName) {
      if (f === name || f.startsWith(name + ' ')) { city = c; break outer; }
    }
  }
  if (!city) outer2: for (const f of frags) {
    for (const [r, c] of regionIndex) {
      if (f.includes(r)) { city = c; break outer2; }
    }
  }
  if (!city) {
    let bd = Infinity;
    for (const c of CITIES) {
      const d = hav(s.lat, s.lon, c.lat, c.lon);
      if (d < bd) { bd = d; city = c; if (bd <= RADIUS) break; }
    }
    if (bd > RADIUS) city = null;
  }
  const key = city ? city.n : 'Прочие регионы';
  if (!byMap.has(key)) byMap.set(key, []);
  byMap.get(key).push(s);
}
const groups = [...byMap.entries()].map(([name, items]) => ({ name, items, count: items.length }));
const other = groups.filter((g) => g.name === 'Прочие регионы');
const real = groups.filter((g) => g.name !== 'Прочие регионы').sort((x, y) => y.count - x.count);
const all = [...real, ...other];
const total = stations.length;
const plz = (n, one, few, many) => { const a = n % 10, b = n % 100; if (a === 1 && b !== 11) return one; if (a >= 2 && a <= 4 && (b < 12 || b > 14)) return few; return many; };
const upd = updated ? new Date(updated).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
const topCities = real.slice(0, 60);
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Полный индекс электрозаправок по городам',
  description: 'Полный список электрозаправок из живой базы Запас хода EV по городам и регионам.'
};
---
<ZhLayout title="Электрозаправки: полный индекс по городам и регионам 2026 — Запас хода EV" description={`Полный индекс электрозаправок: ${total.toLocaleString('ru-RU')} станций по ${all.length} городам и регионам — операторы, адреса, мощности. Живая база Запас хода EV, обновлено ${upd}.`} canonical="/obzor/" jsonld={jsonld}>
<main class="obz">
  <style is:global>
    .obz{background:#050507;color:#E7E7E7;min-height:100vh;padding:28px 16px 60px;max-width:920px;margin:0 auto;font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif}
    .obz h1{font-size:30px;font-weight:800;line-height:1.15;margin:0 0 12px;color:#fff}
    .obz .obz-sub{color:#A7A7A7;font-size:15px;line-height:1.55;margin:0 0 20px}
    .obz .obz-note{background:rgba(232,80,2,.09);border:1px solid rgba(232,80,2,.28);border-radius:14px;padding:14px 16px;color:#E7C9B8;font-size:13.5px;line-height:1.5;margin:0 0 24px}
    .obz .obz-toc{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;margin:0 0 30px;padding:0;list-style:none}
    .obz .obz-toc a{display:flex;justify-content:space-between;gap:6px;color:#FF8F33;text-decoration:none;font-size:13px;padding:8px 10px;background:#121214;border-radius:10px;border:1px solid rgba(148,163,184,.10)}
    .obz .obz-toc a span{color:#646464;font-size:12px}
    .obz h2{font-size:20px;font-weight:700;color:#fff;margin:34px 0 12px;padding-bottom:8px;border-bottom:1px solid rgba(148,163,184,.12)}
    .obz h2 small{color:#FF8F33;font-size:14px;font-weight:600;margin-left:8px}
    .obz ul.obz-list{list-style:none;margin:0 0 8px;padding:0}
    .obz ul.obz-list li{padding:10px 12px;border-radius:10px;background:#0C0C0F;border:1px solid rgba(148,163,184,.07);margin-bottom:6px;font-size:13.5px;line-height:1.45;color:#CFCFCF}
    .obz ul.obz-list li b{color:#fff;font-weight:600}
    .obz ul.obz-list li .pw{color:#FF8F33;font-weight:600;white-space:nowrap}
    .obz ul.obz-list li .cnt{color:#646464;font-size:12px}
    .obz .obz-foot{margin-top:34px;padding-top:18px;border-top:1px solid rgba(148,163,184,.12);color:#646464;font-size:12.5px;line-height:1.6}
    .obz .obz-cta{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,#C10801,#E85002);color:#fff;text-decoration:none;font-weight:700;font-size:14.5px;padding:13px 20px;border-radius:13px;margin:0 0 26px}
  </style>
  <h1>Электрозаправки России: полный индекс по городам</h1>
  <p class="obz-sub">{total.toLocaleString('ru-RU')} зарядных станций в живой базе «Запас хода EV», сгруппированы по {real.length} городам. Данные обновлены: <b>{upd}</b>. В индексе — станции операторов: Пункт Е, РусГидро, Россети, Энергия Москвы, Яндекс.Заправки, Open Charge Map и другие.</p>
  <a class="obz-cta" href="/charging/">Живая карта ЭЗС →</a>
  <div class="obz-note"><b>Про «9 900 станций».</b> По данным 2Chargers, к апрелю 2026 в России было 9 889 публичных ЭЗС — это верхняя оценка всего парка с учётом региональных сетей и частных точек. Наш индекс растёт по мере пополнения базы: сейчас в нём {total.toLocaleString('ru-RU')} станций с адресами и мощностями — это самая крупная открытая сводка по городам.</div>
  <h2 id="toc">Содержание индекса</h2>
  <ul class="obz-toc">
    {topCities.map((g, i) => (
      <li><a href={'#g' + i}>{g.name}<span>{g.count}</span></a></li>
    ))}
    {other.map((g) => (
      <li><a href="#gother">Прочие регионы<span>{g.count}</span></a></li>
    ))}
  </ul>
  {real.map((g, i) => (
    <section>
      <h2 id={'g' + i}>{g.name}<small>{g.count} {plz(g.count, 'станция', 'станции', 'станций')}</small></h2>
      <ul class="obz-list">
        {g.items.map((s) => (
          <li><b>{(s.op || s.n || 'Электрозаправка')}</b> — {s.a || 'адрес уточняется'}{s.pw ? <span class="pw"> · {s.pw} кВт</span> : ''}{s.c ? <span class="cnt"> · {s.c} {plz(s.c, 'порт', 'порта', 'портов')}</span> : ''}</li>
        ))}
      </ul>
    </section>
  ))}
  {other.map((g) => (
    <section>
      <h2 id="gother">Прочие регионы<small>{g.count} {plz(g.count, 'станция', 'станции', 'станций')}</small></h2>
      <ul class="obz-list">
        {g.items.map((s) => (
          <li><b>{(s.op || s.n || 'Электрозаправка')}</b> — {s.a || 'адрес уточняется'}{s.pw ? <span class="pw"> · {s.pw} кВт</span> : ''}{s.c ? <span class="cnt"> · {s.c} {plz(s.c, 'порт', 'порта', 'портов')}</span> : ''}</li>
        ))}
      </ul>
    </section>
  ))}
  <div class="obz-foot">Индекс формируется автоматически из живой базы «Запас хода EV» (zapashoda-ev.ru/charging/) и обновляется вместе с ней. Станция привязывается к городу по точному совпадению в адресе, а если адрес неполный — по ближайшему крупному городу (до 60 км). Типы разъёмов, мощность и наличие порта стоит проверять на месте — данные собираются из открытых источников.</div>
</main>
</ZhLayout>
