<ZhLayout title={d.title + ' — Запас хода'} description={d.desc}>
  <section class="sec"><div class="wrap"><div class="crumbs"><a href="/">Главная</a> / <a href="/cost/">Стоимость зарядки</a> / {d.title}</div><div class="article" set:html={d.body} /></div></section>
