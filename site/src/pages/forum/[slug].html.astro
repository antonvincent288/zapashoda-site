---
export const prerender = true;
// Форум закрыт: каждая тема перенаправляется на живой гайд (решение владельца, 12.11)
const MAP: Record<string, string> = {
  "pain-12v-akb": "/pain/12v-akb/",
    "pain-adapter-gbt": "/pain/adapter-gbt/",
    "pain-chademo": "/pain/chademo/",
    "pain-domashnie-stancii": "/pain/domashnie-stancii/",
    "pain-kabel-ne-otdaet": "/pain/kabel-ne-otdaet/",
    "pain-lyuchok": "/pain/lyuchok/",
    "pain-ne-zaryazhaetsya": "/pain/ne-zaryazhaetsya/",
    "pain-plata-za-prostoy": "/pain/plata-za-prostoy/",
    "pain-podogrev-batarei": "/pain/podogrev-batarei/",
    "pain-poteri-pri-zaryadke": "/pain/poteri-pri-zaryadke/",
    "pain-stanciya-otdaet-pol-moshchnosti": "/pain/stanciya-otdaet-pol-moshchnosti/",
    "pain-stoimost-zaryadki": "/pain/stoimost-zaryadki/",
    "pain-tesla": "/pain/tesla/",
    "pain-type1-ccs1": "/pain/type1-ccs1/",
    "pain-udlinitel": "/pain/udlinitel/",
    "pain-zapas-hoda-zimoy": "/pain/zapas-hoda-zimoy/",
    "pain-zaryadka-na-trasse": "/pain/zaryadka-na-trasse/",
    "pain-zaryadka-ot-rozetki": "/pain/zaryadka-ot-rozetki/",
    "pain-zaryadka-pod-dozhdyom": "/pain/zaryadka-pod-dozhdyom/",
    "gbt-vs-type2": "/blog/gbt-zaryadka-elektromobilya/",
    "welcome": "/quiz/"
};
export function getStaticPaths() {
  const MAP: Record<string, string> = {
  "pain-12v-akb": "/pain/12v-akb/",
    "pain-adapter-gbt": "/pain/adapter-gbt/",
    "pain-chademo": "/pain/chademo/",
    "pain-domashnie-stancii": "/pain/domashnie-stancii/",
    "pain-kabel-ne-otdaet": "/pain/kabel-ne-otdaet/",
    "pain-lyuchok": "/pain/lyuchok/",
    "pain-ne-zaryazhaetsya": "/pain/ne-zaryazhaetsya/",
    "pain-plata-za-prostoy": "/pain/plata-za-prostoy/",
    "pain-podogrev-batarei": "/pain/podogrev-batarei/",
    "pain-poteri-pri-zaryadke": "/pain/poteri-pri-zaryadke/",
    "pain-stanciya-otdaet-pol-moshchnosti": "/pain/stanciya-otdaet-pol-moshchnosti/",
    "pain-stoimost-zaryadki": "/pain/stoimost-zaryadki/",
    "pain-tesla": "/pain/tesla/",
    "pain-type1-ccs1": "/pain/type1-ccs1/",
    "pain-udlinitel": "/pain/udlinitel/",
    "pain-zapas-hoda-zimoy": "/pain/zapas-hoda-zimoy/",
    "pain-zaryadka-na-trasse": "/pain/zaryadka-na-trasse/",
    "pain-zaryadka-ot-rozetki": "/pain/zaryadka-ot-rozetki/",
    "pain-zaryadka-pod-dozhdyom": "/pain/zaryadka-pod-dozhdyom/",
    "gbt-vs-type2": "/blog/gbt-zaryadka-elektromobilya/",
    "welcome": "/quiz/"
  };
  return Object.keys(MAP).map((slug: string) => ({ params: { slug }, props: { target: MAP[slug] } }));
}
const { target } = Astro.props;
const url = 'https://zapashoda-ev.ru' + target;
---
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${url}`} />
    <link rel="canonical" href={url} />
    <meta name="robots" content="noindex, follow" />
    <title>Страница перенесена — «Запас хода»</title>
  </head>
  <body>
    <p>Раздел «Форум» закрыт, тема переехала в базу знаний. Если вас не перекинуло автоматически — <a href={url}>откройте новый адрес</a>.</p>
    <script is:inline define:vars={{url}}>location.replace(url);</script>
  </body>
</html>
