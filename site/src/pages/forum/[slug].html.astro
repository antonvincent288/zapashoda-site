---
import ZhLayout from '../../layouts/ZhLayout.astro';
import src from '../../data/legacy/forum_threads.json';
export async function getStaticPaths() {
  return src.map((x) => ({ params: { slug: x.slug }, props: { d: x } }));
}
const { d } = Astro.props;
const painSlug = d.slug.startsWith('pain-') ? d.slug.replace(/^pain-/, '') : null;
const cano = painSlug ? 'https://zapashoda-ev.ru/pain/' + painSlug + '/' : undefined;
---
<ZhLayout title={d.title} description={d.desc} canonical={cano}>
  <section class="sec"><div class="wrap f-full">
    <div class="crumbs"><a href="/">Главная</a> / <a href="/forum/">Форум</a> / {d.title}</div>
    <div class="article" set:html={d.body_html} />
    {d.body_script && <script is:inline set:html={d.body_script} />}
  </div></section>

<style is:global>
/* форум — широкая legacy-сетка: снимаем узкую 760px-колонку статей */
.f-full{display:block;max-width:1152px;grid-template-columns:none}.f-full .article{max-width:none}
/* полировка v3: чужие подложки, подчёркивания, выравнивание плиток */
.f-full .article .hero{background:transparent;padding:24px 0 6px}
.f-full .article a{text-decoration:none}
.f-full .article p a,.f-full .article li a,.f-full .article td a{text-decoration:underline}
.f-full .fgrid{align-items:stretch}
.f-full .fgrid .fcard2,.f-full .fgrid .fcard{height:100%}
.f-full .fcard2 .fc2-m{margin-top:auto;padding-top:6px}
.f-full .fcard2 .fc2-d,.f-full .fcard .fc-desc{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
/* сетка плиток: 3 колонки на десктопе вместо чужих 4; брейкпоинты как у шаблона */
.f-full .fgrid{grid-template-columns:repeat(3,1fr);gap:22px}
@media (width<=860px){.f-full .fgrid{grid-template-columns:1fr 1fr}}
@media (width<=520px){.f-full .fgrid{grid-template-columns:1fr}}
/* тёмная тема форума: перекрываем светлые inline-стили legacy-разметки */
.faside-box{background:var(--card)!important;border:1px solid var(--line)!important;border-radius:16px}
.faside-box h3{color:var(--txt-muted)!important}
.fcomm{color:var(--txt)!important}
.fcomm:hover{background:var(--bg2)!important}
.fcomm .n{color:var(--txt-muted)!important}
.fcard2{background:var(--card)!important;border:1px solid var(--line)!important;color:var(--txt)!important;box-shadow:none!important}
.fcard2 .fc2-t{color:var(--head)!important}
.fcard2 .fc2-d{color:var(--txt-muted)!important}
.fcard2 .fc2-m{color:var(--txt-muted)!important}
.fcard2 .fc2-a{color:var(--txt-muted)!important}
.fcard2 .fc2-tag{color:#cfe2ff!important;border-color:rgba(77,155,245,.35)!important;background:rgba(1,97,239,.12)!important}
.fcard2:hover{box-shadow:0 12px 34px rgba(0,0,0,.45)!important;transform:translateY(-1px)!important}
.fchip{background:var(--bg2)!important;border:1px solid var(--line)!important;color:var(--txt)!important}
.note{color:var(--txt-muted)!important}
.hero .kicker{color:#5aa9ff!important}
.btn.lime{background:#4d9bf5!important;color:#fff!important}
.btn.ghost{border:1px solid rgba(255,255,255,.16)!important;color:#f5f5f7!important;background:transparent!important}
</style>
</ZhLayout>
