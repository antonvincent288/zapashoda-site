---
import ZhLayout from '../../layouts/ZhLayout.astro';
import LegacyStyles from '../../components/LegacyStyles.astro';
---

<ZhLayout title="Сколько заряжать по времени — калькулятор «Запас хода»" description="Простой калькулятор времени зарядки: выберите машину, откуда заряжаете и насколько разряжена батарея — покажем часы, минуты и когда батарея будет готова. Три нажатия кнопок.">
  <section class="sec"><div class="wrap">
    <LegacyStyles />
    <div class="crumbs"><a href="/">Главная</a> / <a href="/calculators/">Калькуляторы</a> / Время зарядки</div>

    <style is:global>
      .wz{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:22px;margin:26px 0}
      .wz-bar{display:flex;align-items:center;gap:10px;margin-bottom:16px}
      .wz-bar .dot{width:10px;height:10px;border-radius:99px;background:var(--line)}
      .wz-bar .dot.on{background:#0161EF;width:26px}
      .wz-q{font-weight:800;font-size:21px;margin:0 0 6px}
      .wz-hint{color:var(--txt-muted);font-size:14px;margin:0 0 16px}
      .wz-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}
      .wz-btn{border:1.5px solid var(--line);border-radius:16px;background:var(--bg);color:var(--txt);font-size:17px;font-weight:700;cursor:pointer;min-height:68px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;text-align:center;user-select:none;transition:all .15s;font-family:inherit;padding:8px}
      .wz-btn .t{font-size:16px;font-weight:700}
      .wz-btn .h{font-size:12px;font-weight:500;color:var(--txt-muted)}
      .wz-btn.on{border-color:#0161EF;background:rgba(1,97,239,.08);color:#0161EF}
      .wz-btn:hover{border-color:#0161EF}
      .wz-back{display:inline-flex;align-items:center;gap:6px;margin-top:16px;background:none;border:none;color:var(--txt-muted);font-size:14px;font-weight:600;cursor:pointer;font-family:inherit;padding:10px 0;min-height:44px}
      .wz-res{text-align:center;padding-top:6px}
      .wz-big{font-size:clamp(44px,9vw,64px);font-weight:800;font-variant-numeric:tabular-nums;color:#0161EF;line-height:1.05}
      .wz-big small{font-size:16px;font-weight:700;color:var(--txt-muted);display:block;margin-top:4px}
      .wz-ready{margin-top:14px;padding:14px;border-radius:14px;font-weight:700;font-size:16px;background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.5);color:#15803d}
      .wz-mid{font-size:20px;font-weight:800;margin-top:12px}
      .wz-mid small{font-size:13.5px;color:var(--txt-muted);font-weight:600}
      .wz-cta{display:block;margin-top:18px;background:#0161EF;color:#fff;font-weight:800;border-radius:14px;padding:16px;min-height:56px;text-decoration:none;font-size:17px}
      .wz-restart{display:inline-block;margin-top:12px;color:#0161EF;font-weight:700;font-size:14.5px;text-decoration:none;min-height:44px;padding:10px}
      details.wz-note{margin-top:18px;border-top:1px solid var(--line);padding-top:12px;text-align:left}
      details.wz-note summary{color:var(--txt-muted);font-size:13px;cursor:pointer}
      details.wz-note p{color:var(--txt-muted);font-size:13px;line-height:1.55;margin:10px 0 0}
      details.pro{margin-top:26px;border:1.5px dashed var(--line);border-radius:16px;padding:16px 18px;background:var(--card)}
      details.pro summary{font-weight:700;cursor:pointer;font-size:15.5px;color:var(--txt)}
      details.pro summary .hint{color:var(--txt-muted);font-weight:400;font-size:13px;margin-left:8px}
      .t-card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:24px;margin-top:16px}
      .t-row{display:flex;flex-wrap:wrap;gap:16px;align-items:flex-end}
      .t-field{flex:1;min-width:180px}
      .t-field label{display:block;font-size:13px;font-weight:600;color:var(--txt-muted);margin-bottom:6px}
      .t-field input{width:100%;box-sizing:border-box;border:1px solid var(--line);background:var(--bg);border-radius:10px;padding:11px 12px;font-size:15px;font-variant-numeric:tabular-nums;min-height:44px}
      .t-chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
      .t-chip{border:1px solid var(--line);background:var(--bg);border-radius:999px;padding:7px 13px;font-size:13.5px;font-weight:600;cursor:pointer;min-height:36px;display:inline-flex;align-items:center;user-select:none}
      .t-chip.on{background:#0161EF;border-color:#0161EF;color:#fff}
      .t-res{margin-top:26px;padding-top:20px;border-top:1px solid var(--line)}
      .t-res .big{font-size:clamp(30px,5vw,40px);font-weight:800;font-variant-numeric:tabular-nums;color:#0161EF;line-height:1.1}
      .t-res .sub{color:var(--txt-muted);font-size:14.5px;margin-top:8px}
      .t-res .grid{display:flex;gap:24px;flex-wrap:wrap;margin-top:16px;font-size:14px}
      .t-res .grid b{font-variant-numeric:tabular-nums}
      .t-faq{margin-top:36px}
      .t-faq details{border-bottom:1px solid var(--line);padding:12px 0}
      .t-faq summary{font-weight:700;cursor:pointer;font-size:16.5px}
      .t-faq p{margin-top:8px}
      @media(max-width:600px){.t-card{padding:18px}}
    </style>

    <h1>Сколько заряжать по времени</h1>
    <p class="lede">Три вопроса — и вы узнаете, когда батарея будет готова. Цифры набирать не нужно.</p>

    <div class="wz" id="wzt">
      <div class="wz-bar"><span class="dot on"></span><span class="dot"></span><span class="dot"></span></div>
      <div id="wzt-s1">
        <div class="wz-q">Ваша машина?</div>
        <div class="wz-hint">Выберите марку — дальше сами посчитаем</div>
        <div class="wz-grid" id="wzt-m1"></div>
      </div>
      <div id="wzt-s2" hidden>
        <div class="wz-q">Откуда заряжаете?</div>
        <div class="wz-hint">Не знаете — берите «Розетка дома»</div>
        <div class="wz-grid" id="wzt-m2"></div>
        <button class="wz-back" type="button" data-back="1">← Назад</button>
      </div>
      <div id="wzt-s3" hidden>
        <div class="wz-q">Насколько пустая батарея?</div>
        <div class="wz-hint">Не знаете — берите «Почти пустая»</div>
        <div class="wz-grid" id="wzt-m3"></div>
        <button class="wz-back" type="button" data-back="2">← Назад</button>
      </div>
      <div id="wzt-s4" hidden>
        <div class="wz-res">
          <div class="wz-big" id="wzt-r1">~7 ч</div>
          <div class="wz-mid" id="wzt-r2">—</div>
          <div class="wz-ready" id="wzt-r3">—</div>
          <div class="wz-mid" style="font-size:16px"><span id="wzt-r4">—</span> <small>нужно налить в батарею</small></div>
          <a class="wz-cta" href="/quiz/" onclick="window.ym&&ym('113935123','reachGoal','time_wizard_cta')">Подобрать зарядку под себя →</a>
          <a class="wz-restart" href="#" id="wzt-restart">← Начать заново</a>
          <details class="wz-note"><summary>Откуда эти цифры?</summary>
            <p>Время = сколько нужно энергии ÷ мощность зарядки. Ёмкость берём типовую по марке. Обычная розетка даёт 3,3 кВт, настенная зарядка — 7 кВт, трёхфазная — 11 кВт, быстрая станция — 60 кВт. Дальше 80% батарея заряжается медленно — поэтому до 100% добивают на ночёвке. Реальное время может отличаться: зимой батарея холодная и заряжается дольше.</p>
          </details>
        </div>
        <button class="wz-back" type="button" data-back="3">← Назад</button>
      </div>
    </div>

    <details class="pro" id="pro-time">
      <summary>Считать точнее, по своим цифрам <span class="hint">ввести ёмкость, мощность и проценты вручную</span></summary>
      <div class="t-card">
        <div class="t-row">
          <div class="t-field">
            <label for="tc-cap">Ёмкость батареи, кВт·ч</label>
            <input id="tc-cap" type="number" inputmode="decimal" min="8" max="200" step="1" value="60">
            <div class="t-chips" id="tc-cap-chips">
              <span class="t-chip" data-cap="43">43 · гибрид</span>
              <span class="t-chip" data-cap="60">60 · компакт</span>
              <span class="t-chip on" data-cap="75">75</span>
              <span class="t-chip" data-cap="88">88</span>
              <span class="t-chip" data-cap="100">100</span>
              <span class="t-chip" data-cap="116">116</span>
            </div>
          </div>
          <div class="t-field">
            <label for="tc-kw">Мощность зарядки, кВт</label>
            <input id="tc-kw" type="number" inputmode="decimal" min="1.5" max="250" step="0.1" value="11">
            <div class="t-chips" id="tc-kw-chips">
              <span class="t-chip" data-kw="3.3">3.3 · розетка 16А</span>
              <span class="t-chip" data-kw="7">7 · стена</span>
              <span class="t-chip on" data-kw="11">11 · трёхфазка</span>
              <span class="t-chip" data-kw="22">22</span>
              <span class="t-chip" data-kw="60">60 · DC</span>
              <span class="t-chip" data-kw="120">120 · DC</span>
            </div>
          </div>
          <div class="t-field">
            <label for="tc-from">Текущий уровень, %</label>
            <input id="tc-from" type="number" inputmode="numeric" min="0" max="99" step="1" value="20">
          </div>
          <div class="t-field">
            <label for="tc-to">Целевой уровень, %</label>
            <input id="tc-to" type="number" inputmode="numeric" min="1" max="100" step="1" value="80">
          </div>
        </div>
        <div class="t-res">
          <div class="big" id="tc-out">—</div>
          <div class="sub" id="tc-sub">Заполните поля выше — пересчёт мгновенный.</div>
          <div class="grid">
            <span>Энергия до цели: <b id="tc-kwh">—</b> кВт·ч</span>
            <span>С учётом потерь: <b id="tc-kwh2">—</b> кВт·ч</span>
            <span>Эффективность: <b>90%</b> на AC</span>
          </div>
        </div>
      </div>
    </details>

    <div class="t-faq">
      <h2 style="margin-bottom:6px">Частые вопросы о времени зарядки</h2>
      <details open><summary>Почему последние 20% заряжаются так долго?</summary><p>После ~80% бортовой заряд снижает ток, чтобы не перегревать батарею и продлить её ресурс. Это нормально: планируйте быструю сессию «до 80%», а 100% добирайте на ночёвке.</p></details>
      <details><summary>Сколько даёт обычная розетка в квартире?</summary><p>Классическая розетка 16А на 230В — до 3.3 кВт, то есть 25–35 км запаса за час для большинства моделей. Полная зарядка 60 кВт·ч «с нуля» — около 20 часов. Именно поэтому ночной сценарий — базовый.</p></details>
      <details><summary>Почему время зависит и от машины, и от станции?</summary><p>Скорость ограничивает узкое место цепочки: если бортовой заряд машины 11 кВт, станция 22 кВт не поможет. Соответствие вашей модели — в <a href="/models/">каталоге</a>: там же бортовой заряд каждой комплектации.</p></details>
      <details><summary>Насколько точен расчёт на быстрой станции?</summary><p>На DC время зависит от кривой батареи: заявленная пиковая мощность держится не всю сессию. Калькулятор даёт верхнюю оценку при 95% КПД; реальное время до 80% обычно на 10–20% дольше, а после 80% — заметно дольше.</p></details>
    </div>

    <script is:inline>
    (function(){
      function el(id){return document.getElementById(id)}
      function fmtTime(h){
        if(!isFinite(h)||h<=0) return '—';
        var hh=Math.floor(h), mm=Math.round((h-hh)*60);
        if(mm===60){hh++;mm=0}
        return hh>0 ? (hh+' ч'+(mm>0?' '+mm+' мин':'')) : (mm+' мин');
      }
      // ——— ШАГИ 1–3 ———
      var M=[
        {n:'Zeekr',cap:100},
        {n:'Li Auto',cap:43},
        {n:'BYD',cap:70},
        {n:'Voyah',cap:88},
        {n:'Avatr',cap:116},
        {n:'Tesla',cap:60},
        {n:'Другая машина',cap:60}
      ];
      var P=[
        {n:'Розетка дома',h:'обычная, 3,3 кВт',v:3.3},
        {n:'Зарядка во дворе',h:'стена, 7 кВт',v:7},
        {n:'Мощная зарядка',h:'11 кВт',v:11},
        {n:'Быстрая станция',h:'60 кВт',v:60},
        {n:'Супербыстрая',h:'120 кВт',v:120}
      ];
      var L=[
        {n:'Почти пустая',h:'10% → 80%',a:10,b:80},
        {n:'Половина',h:'40% → 80%',a:40,b:80},
        {n:'Немного осталось',h:'60% → 80%',a:60,b:80},
        {n:'Добить до 100%',h:'50% → 100%',a:50,b:100}
      ];
      var st={m:6,p:0,l:0};
      function dots(n){
        var ds=el('wzt').querySelectorAll('.dot');
        Array.prototype.forEach.call(ds,function(d,i){d.classList.toggle('on',i<n)});
      }
      function show(step){
        [1,2,3,4].forEach(function(i){el('wzt-s'+i).hidden=(i!==step)});
        dots(step);
      }
      function make(boxId,list,key,e){
        var box=el(boxId);box.innerHTML='';
        list.forEach(function(o){
          var b=document.createElement('button');b.type='button';b.className='wz-btn';
          b.innerHTML='<span class="t">'+o.n+'</span>'+(o.h?'<span class="h">'+o.h+'</span>':'');
          b.addEventListener('click',function(){
            st[key]=list.indexOf(o);
            if(key==='m'){show(2)}
            else if(key==='p'){show(3)}
            else{res();show(4)}
          });
          box.appendChild(b);
        });
      }
      function res(){
        var m=M[st.m],p=P[st.p].v,lv=L[st.l];
        var eff=p>22?0.95:0.9;
        var e=(lv.b-lv.a)/100*m.cap;
        var h=e/(p*eff);
        el('wzt-r1').textContent='~'+fmtTime(h);
        el('wzt-r2').textContent='зарядки на «'+P[st.p].n+'»';
        var ready=new Date(Date.now()+h*3600*1000);
        var hh=String(ready.getHours()).padStart(2,'0'),mm=String(ready.getMinutes()).padStart(2,'0');
        el('wzt-r3').textContent='Включите сейчас — готово к '+hh+':'+mm;
        el('wzt-r4').textContent=Math.round(e/eff)+' кВт·ч';
        var pc=el('tc-cap');if(pc){pc.value=m.cap;el('tc-kw').value=p;el('tc-from').value=lv.a;el('tc-to').value=lv.b;tcalc();}
      }
      make('wzt-m1',M,'m');
      make('wzt-m2',P,'p');
      make('wzt-m3',L,'l');
      Array.prototype.forEach.call(el('wzt').querySelectorAll('.wz-back'),function(b){
        b.addEventListener('click',function(){show(parseInt(b.getAttribute('data-back'),10))});
      });
      el('wzt-restart').addEventListener('click',function(ev){ev.preventDefault();show(1)});
      show(1);

      // ——— ТОЧНЫЙ БЛОК ———
      function bindChips(id,input,attr){
        var box=el(id); if(!box) return;
        box.addEventListener('click', function(e){
          var t=e.target.closest('.t-chip'); if(!t) return;
          box.querySelectorAll('.t-chip').forEach(function(c){c.classList.remove('on')});
          t.classList.add('on'); input.value=t.getAttribute(attr); tcalc();
        });
      }
      function tcalc(){
        var cap=el('tc-cap'), kw=el('tc-kw'), from=el('tc-from'), to=el('tc-to');
        var out=el('tc-out'), sub=el('tc-sub'), kwh=el('tc-kwh'), kwh2=el('tc-kwh2');
        var c=parseFloat(cap.value), p=parseFloat(kw.value), a=parseFloat(from.value), b=parseFloat(to.value);
        if(!(c>0&&p>0&&b>a)) { out.textContent='—'; sub.textContent='Проверьте значения: целевой уровень должен быть выше текущего.'; kwh.textContent=kwh2.textContent='—'; return; }
        var eff = p>22 ? 0.95 : 0.9;
        var e=(b-a)/100*c;
        var h=e/(p*eff);
        out.textContent='~ '+fmtTime(h);
        sub.textContent='Подъём с '+Math.round(a)+' до '+Math.round(b)+'% на '+p+' кВт'+(p>22?' (DC, КПД 95%)':' (AC, КПД 90%)');
        kwh.textContent=Math.round(e);
        kwh2.textContent=Math.round(e/eff);
      }
      [ 'tc-cap','tc-kw','tc-from','tc-to' ].forEach(function(id){var x=el(id); if(x){x.addEventListener('input',tcalc);x.addEventListener('change',tcalc);}});
      bindChips('tc-cap-chips', el('tc-cap'), 'data-cap');
      bindChips('tc-kw-chips', el('tc-kw'), 'data-kw');
      tcalc();
    })();
    </script>
  </div></section>
</ZhLayout>
