---
import ZhLayout from '../../layouts/ZhLayout.astro';
import LegacyStyles from '../../components/LegacyStyles.astro';
import src from '../../../data/legacy/tools.json';
const d = src.find((x) => x.slug === 'calculator');
---
<ZhLayout title={d.title + ' — Калькуляторы Запас хода'} description={d.desc}>
  <section class="sec"><div class="wrap">
    <LegacyStyles />
    <div class="crumbs"><a href="/">Главная</a> / <a href="/calculators/">Калькуляторы</a> / Стоимость зарядки</div>
    <div class="article" set:html={d.body_html} />
    {d.body_script && <script is:inline set:html={d.body_script} />}
  </div></section>
</ZhLayout>