---
import ZhLayout from '../../layouts/ZhLayout.astro';
import LegacyStyles from '../../components/LegacyStyles.astro';
import PlugIcon from '../../components/PlugIcon.astro';
import BATTERY from '../../data/models_battery.json';
import { priceFix as pf, fmtRub as fmtR } from '../../lib/prices';
export async function getStaticPaths() {
  const modules = import.meta.glob('../../data/models/*.json', { eager: true, import: 'default' });
  const models = Object.values(modules) as any[];
  const seen: Map<string, number> = new Map();
  return models.map((m) => {
    let slug = String(m.slug || m.title || 'model');
    const n = (seen.get(slug) || 0) + 1;
    seen.set(slug, n);
    if (n > 1) slug = `${slug}-${n}`;
    return { params: { slug }, props: { m } };
  });
}
const { m } = Astro.props;
const stripEmo = (x: string) => String(x || '').replace(/[\u{1F000}-\u{1FAFF}\u2600-\u27BF\uFE0F\u2B00-\u2BFF]+/gu, '').replace(/\s{2,}/g, ' ').trim();
const deepStrip = (o: any) => { for (const k in o) { const v = o[k]; if (typeof v === 'string') o[k] = stripEmo(v); else if (v && typeof v === 'object') deepStrip(v); } return o; };
deepStrip(m as any);
const SOLUTIONS: Record<string, string> = {
  'GB/T': 'Адаптер Type 2 → GB/T (SKU 1 premium / SKU 8 базовый) или кабель',
  'EU': 'Разъёмы такие же, как в РФ — переходники не нужны',
  'Type1/CCS1': 'Адаптер Type 1 → Type 2; CCS1-станции редки',
  'JP/CHAdeMO': 'CHAdeMO-станции; адаптер по запросу',
};
const solutionFor = (port: string) => {
  if (port && port.includes('GB/T')) return SOLUTIONS['GB/T'];
  if (port && port.includes('Type1')) return SOLUTIONS['Type1/CCS1'];
  if (port && port.includes('CHAdeMO')) return SOLUTIONS['JP/CHAdeMO'];
  if (port && port.includes('EU')) return SOLUTIONS['EU'];
  return 'Уточните разъём по VIN — подберём комплект';
};
const portSlug = (p: string) => {
  if (p.includes('GB/T')) return 'gbt';
  if (p.includes('CHAdeMO')) return 'chademo';
  if (p.includes('Type1')) return 'type1';
  return 'type2';
};
const portIcon = (p: string) => {
  if (!p) return 'type2';
  if (p.includes('GB/T')) return 'gbt';
  if (p.includes('CHAdeMO')) return 'chademo';
  if (p.includes('Type1')) return 'type1';
  return 'type2';
};
const FAQ_GB = `<div class="card" style="margin-top:26px">
        <h3>Частые вопросы про разъём</h3>
        <details class="mfaq"><summary>Можно ли зарядить GB/T-машину на Type 2 / CCS2 станции?</summary><p>Да, через адаптер: Type 2 → GB/T для медленной зарядки в городе (примерно 4–9 тыс. ₽) или CCS2 → GB/T DC для быстрой (95 000 ₽ в каталоге) — обычно ради дальних поездок. Подробнее — <a href="/razemy/gbt/">в справочнике GB/T</a>.</p></details>
        <details class="mfaq"><summary>GB/T AC и GB/T DC — это один разъём?</summary><p>Нет, это два разных порта: малый для медленной зарядки (до 7 кВт) и большой для быстрой (60–120 кВт на современных моделях). У машины обычно оба.</p></details>
        <details class="mfaq"><summary>Какой адаптер купить в первую очередь?</summary><p>Адаптер Type 2 → GB/T на 32 А: он открывает большинство городских станций. Полный план — в <a href="/matrix/">матрице совместимости</a>.</p></details>
      </div>`;
const FAQ_EU = `<div class="card" style="margin-top:26px">
        <h3>Частые вопросы про разъём</h3>
        <details class="mfaq"><summary>Нужен ли свой кабель для Type 2?</summary><p>Если на станции есть Type 2-кабель — нет. Если только розетка (Type 2 socket) — да, нужен свой кабель Type 2. Какая станция с чем — видно на <a href="/charging/">карте ЗУ</a>.</p></details>
        <details class="mfaq"><summary>Какая мощность у Type 2?</summary><p>Одна фаза — до 7 кВт, три фазы — до 22 кВт. Фактическая скорость зависит от бортового зарядного модуля машины. Подробнее — <a href="/razemy/type2/">в справочнике Type 2</a>.</p></details>
        <details class="mfaq"><summary>Быстрая зарядка — какой разъём?</summary><p>CCS2: тот же порт сверху плюс два силовых контакта снизу. Кабель Type 2 вставляется в CCS2-порт без адаптера. Подробнее — <a href="/razemy/ccs2/">в справочнике CCS2</a>.</p></details>
      </div>`;
const FAQ_T1 = `<div class="card" style="margin-top:26px">
        <h3>Частые вопросы про разъём</h3>
        <details class="mfaq"><summary>Подойдёт ли кабель Type 2 к Type 1?</summary><p>Нет, это разные порты. Нужен адаптер Type 1 → Type 2 для медленной зарядки. Подробнее — <a href="/razemy/type1/">в справочнике Type 1</a>.</p></details>
        <details class="mfaq"><summary>Где заряжаться на Type 1 / CCS1 в России?</summary><p>Публичных станций Type 1/CCS1 почти нет: база — домашняя зарядка через адаптер, быстрая — только там, где сохранился CCS1.</p></details>
        <details class="mfaq"><summary>Какая мощность у Type 1?</summary><p>До 7,4 кВт на одной фазе — это медленная зарядка. Быстрая только через CCS1.</p></details>
      </div>`;
const FAQ_CD = `<div class="card" style="margin-top:26px">
        <h3>Частые вопросы про разъём</h3>
        <details class="mfaq"><summary>Сколько кВт даёт CHAdeMO?</summary><p>В российских сетях обычно до 50 кВт — ограничение в разъёме и машине. Подробнее — <a href="/razemy/chademo/">в справочнике CHAdeMO</a>.</p></details>
        <details class="mfaq"><summary>Можно ли Leaf подключить к GB/T DC станции?</summary><p>Есть переходники CHAdeMO → GB/T DC у ряда производителей. Выбирайте сертифицированные — дешёвые адаптеры на быстрой зарядке небезопасны.</p></details>
        <details class="mfaq"><summary>Какой разъём у Leaf для медленной зарядки?</summary><p>Старые версии — Type 1 (до 7,4 кВт), поздние европейские — Type 2. Смотрите в таблице спецификации выше.</p></details>
      </div>`;
const faqPort = String(m.port||'').includes('GB/T') ? FAQ_GB : (String(m.port||'').includes('Type1') ? FAQ_T1 : (String(m.port||'').includes('CHAdeMO') ? FAQ_CD : FAQ_EU));
// парсинг таблицы спецификации из prod-контента
const body = String(m.body_html || '').replace(/[\u{1F000}-\u{1FAFF}\u2600-\u27BF\uFE0F\u2B00-\u2BFF]+/gu, '').replace(/\s{2,}/g, ' ');
// spec собираем ТОЛЬКО из первой таблицы тела; вторая таблица («Сколько занимает зарядка»)
// не должна попадать в спецификацию — раньше из неё утекали «до 100 кВт / 29 мин»
const tEnd = body.indexOf('</table>');
const specSource = tEnd >= 0 ? body.slice(0, tEnd + '</table>'.length) : body;
const spec: Record<string, string> = {};
const rowRe = /<tr[^>]*>\s*<td[^>]*>([\s\S]*?)<\/td>\s*<td[^>]*>([\s\S]*?)<\/td>\s*<\/tr>/gi;
const strip = (s: string) => String(s || '').replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ').trim();
let rm: RegExpExecArray | null;
while ((rm = rowRe.exec(specSource))) {
  const k = strip(rm[1]);
  const v = strip(rm[2]);
  if (!k || !v) continue;
  // заглушки («нет публичных данных», «н/д», «—») не превращаем в чипы паспорта
  if (/^(нет\s+(публичных\s+)?дан|н\/д|н\.д\.|[—−-]|уточняем|подтвержд[ао]|нет\s+инфо)/i.test(v)) continue;
  if (/AC/i.test(k) && /медлен/i.test(k)) spec.ac = v;
  else if (/DC/i.test(k) && /быстр/i.test(k)) { if (!/dmin|&quot;|"/.test(v)) spec.dc = v; }
  else if (/Борт/i.test(k) || /OBC/i.test(k)) spec.obc = v;
  else if (/Мощность DC/i.test(k)) spec.dcpow = v;
  else if (/Рынок/i.test(k)) spec.market = v;
  else if (/Батаре/i.test(k)) spec.batt = v;
}
const cutBalanced = (html: string, marker: string, tag: string) => {
  const i = html.indexOf(marker);
  if (i < 0) return html;
  const rx = new RegExp('<' + tag + '[\\s>]|</' + tag + '>', 'g');
  rx.lastIndex = i;
  let d = 0, mm;
  while ((mm = rx.exec(html))) {
    if (mm[0][1] === '/') d--; else d++;
    if (d === 0) return html.slice(0, i) + html.slice(rx.lastIndex);
  }
  return html;
};
const cutFrom = (html: string, start: number, tag: string): [string, string] => {
  const rx = new RegExp('<' + tag + '[\\s>]|</' + tag + '>', 'g');
  rx.lastIndex = start;
  let d = 0, mm;
  while ((mm = rx.exec(html))) {
    if (mm[0][1] === '/') d--; else d++;
    if (d === 0) return [html.slice(0, start), html.slice(rx.lastIndex)];
  }
  return [html, html];
};
const cutMid = (html: string, start: number, tag: string): [string, string, string] => {
  const rx = new RegExp('<' + tag + '[\\s>]|</' + tag + '>', 'g');
  rx.lastIndex = start;
  let d = 0, mm;
  while ((mm = rx.exec(html))) {
    if (mm[0][1] === '/') d--; else d++;
    if (d === 0) return [html.slice(0, start), html.slice(start, rx.lastIndex), html.slice(rx.lastIndex)];
  }
  return [html, html, html];
};

const isGBT = String(m.port || '').includes('GB/T');
const CAP_OVERRIDES: Record<string, string> = { 'aito-m5-m7': '40' };
const CAP_NOTE: Record<string, string> = { 'aito-m5-m7': ' (у EV-версии AITO M5 — 80 кВт·ч)' };
const dcpowClean = String(spec.dcpow || '').replace(/\(не подтверждено\)/g, '(уточняем по VIN)');
const dcShort = (dcpowClean.match(/[0-9]+(?:–[0-9]+)?\+?\s?кВт/) || [dcpowClean])[0];
const battInfo = BATTERY[String(m.slug || '')] || null;
const specBattCap = (String(spec.batt || '').match(/([0-9]+(?:[.,][0-9]+)?)\s*кВт[·.]?\s*ч/i) || [])[1];
const capFinal = CAP_OVERRIDES[String(m.slug || '')] || (battInfo && battInfo.cap) || (specBattCap ? specBattCap.replace(',', '.') : null);
const battLabel = String(spec.batt || '').trim() || (battInfo ? battInfo.label : '') || (CAP_OVERRIDES[String(m.slug || '')] ? CAP_OVERRIDES[String(m.slug || '')] + ' кВт·ч' : '');
// для машин с Type 2/CCS2 держатель GB/T не продаём — вместо него честный EU-аксессуар
const ULG_CARD = '<div class="relative rounded-lg break-words border bg-white border-gray-300 card-product" data-cat="Аксессуары" data-ln="both phev" data-price="9900"><div class="flex-auto p-4"><div class="text-center relative flex justify-center"><div class="absolute top-0 left-0"><span class="inline-block p-1 text-center font-semibold text-sm align-baseline leading-none rounded bg-gray-800 text-white">Опционально</span></div><a href="/catalog/udlinitel-type2-type2-5m.html" aria-label="Удлинитель Type 2 — Type 2, 5 м, 32 А"><img src="/assets/sku/cable-t2t2-5m.webp" alt="Удлинитель Type 2 — Type 2, 5 м, 32 А" loading="lazy" decoding="async"></a></div><div class="flex flex-col gap-3"><a href="/catalog/udlinitel-type2-type2-5m.html" class="text-decoration-none text-gray-500"><small>Аксессуары</small></a><div class="flex flex-col gap-2"><h3 class="text-base"><a href="/catalog/udlinitel-type2-type2-5m.html" class="text-gray-800">Удлинитель Type 2 — Type 2, 5 м, 32 А</a></h3></div><small class="text-gray-500" style="display:block">5 м запаса на парковке, если штатного кабеля не хватает</small><div class="flex justify-between items-center"><div><span class="text-gray-900 font-semibold">9 900 ₽</span></div></div></div></div></div>';
const OIL_CARD = '<div class="relative rounded-lg break-words border bg-white border-gray-300 card-product" data-cat="Аксессуары" data-ln="both phev" data-price="690"><div class="flex-auto p-4"><div class="text-center relative flex justify-center"><div class="absolute top-0 left-0"><span class="inline-block p-1 text-center font-semibold text-sm align-baseline leading-none rounded bg-gray-800 text-white">Нужно</span></div><a href="/catalog/smazka-silikonom-zima.html" aria-label="Смазка силиконовая (зимний kit)"><img src="/assets/sku/smazka-silicone.webp" alt="Смазка силиконовая (зимний kit)" loading="lazy" decoding="async"></a></div><div class="flex flex-col gap-3"><a href="/catalog/smazka-silikonom-zima.html" class="text-decoration-none text-gray-500"><small>Аксессуары</small></a><div class="flex flex-col gap-2"><h3 class="text-base"><a href="/catalog/smazka-silikonom-zima.html" class="text-gray-800">Смазка силиконовая (зимний kit)</a></h3></div><small class="text-gray-500" style="display:block">чтобы зимой не примерзал лючок и коннектор</small><div class="flex justify-between items-center"><div><span class="text-gray-900 font-semibold">690 ₽</span></div></div></div></div></div>';
const bodyClean = (() => {
  let h = String(m.body_html || '');
  h = h.replace(/^<main[^>]*>/, '').replace(/<\/main>\s*$/, '');
  h = cutBalanced(h, '<nav ', 'nav');
  h = cutBalanced(h, '<div class="mhero">', 'div');
  h = cutBalanced(h, '<div class="pc-cartbar', 'div');
  h = cutBalanced(h, '<div class="cta">', 'div');
  h = h.replace(/<button[^>]*pc-add[\s\S]*?<\/button>/g, '');
  h = h.replace(/(?:text-white\s+)?bg-green-600(?:\s+text-white)?/g, 'tag');
  // «по данным модели: X» с colspan=3 растягивается под колонки «Время»/«Стоимость» — ставим в колонки —
  h = h.replace(/<td colspan="3">по данным модели:([^<]*)<\/td>/g, (s0, txt) => '<td>' + txt.trim() + '</td><td>—</td><td>—</td>');
  h = h.replace(/<td colspan="3">по данным модели: ('[^<]*'|"[^<]*")<\/td><\/tr>/g, "<td>$1</td><td>—</td><td>—</td></tr>");
  // первая таблица дублирует spec-таблицу сверху — снять таблицу, её заголовок и пустую обёртку
  const tIdx = h.indexOf('<table');
  if (tIdx >= 0) {
    const rx2 = /<table[\s\S]*?<\/table>/;
    h = h.replace(rx2, '');
  }
  h = h.replace(/<h2[^>]*>\s*Разъёмы и мощность зарядки\s*<\/h2>\s*/g, '');
  h = h.replace(/<div class="[^"]*overflow-x-auto[^"]*">\s*<\/div>/g, '');
  if (!isGBT) {
    // честный «что понадобится» для EU/Type 2: без GB/T-адаптеров и несуществующих SKU-ссылок
    h = h.replace('Type 2/CCS2 — штатные разъёмы РФ-инфраструктуры: заряжается напрямую, без адаптеров. На GB/T-станциях: обратный адаптер GB/T→Type 2 (SKU 2). Держатель (SKU 12), смазка (SKU 17). Портативка Type 2 и держатель Type 2 — вне каталога (потенциальные новые SKU).', 'Type 2/CCS2 — штатные разъёмы РФ-инфраструктуры: заряжается напрямую, без адаптеров. Портативка Type 2, кабель Type 2 — Type 2 и удлинитель Type 2 — в каталоге ниже. Держатель Type 2 пока вне каталога — напишите нам в Telegram, добавим в поставку. Смазка контактов (SKU 17) — для лючка и коннектора зимой.');
    // карточка UN-06: не отсылаем владельца «европейца» к GB/T-товарам
    h = h.replace('выручит кабель 10 м (SKU 15) или удлинитель GB/T (SKU 14)', 'выручит кабель Type 2 — Type 2 7 м (SKU 22) или удлинитель Type 2 (SKU 26)');
    // состав премиум-комплекта b-eu: держатель GB/T → удлинитель Type 2, цены пересчитаны
    h = h.replace('В комплекте: Портативная зарядка Type 2, Кабель Type 2 — Type 2, Держатель / органайзер кабеля GB/T, Смазка силиконовая (зимний kit)', 'В комплекте: Портативная зарядка Type 2, Кабель Type 2 — Type 2, Удлинитель Type 2 — Type 2, 5 м, Смазка силиконовая (зимний kit)');
    h = h.replace('Защита от перегрева, кабель повышенной прочности 5 м и органайзер для гаража', 'Защита от перегрева, кабель повышенной прочности 5 м и удлинитель Type 2 на парковке');
    h = h.replace('>26 190 ₽<', '>34 590 ₽<');
    h = h.replace('>28 190 ₽<', '>36 590 ₽<');
    h = h.replace('"price": 26190, "was": 28190, "items": [19, 21, 12, 17]', '"price": 34590, "was": 36590, "items": [19, 21, 26, 17]');
    // карточка держателя GB/T → карточка удлинителя Type 2
    // персональный подбор: без готового комплекта, топ-3 = кабель → портативка → смазка
    const kitIdx = h.indexOf('data-cat="Комплекты"');
    if (kitIdx >= 0) {
      const ks = h.lastIndexOf('<div class="', kitIdx);
      const [preK, postK] = cutFrom(h, ks, 'div');
      h = preK + postK;
    }
    const bi = h.indexOf('"id": "b-eu"');
    if (bi >= 0) {
      const bs = h.lastIndexOf('{', bi);
      const be = h.indexOf('},', bi) + 2;
      h = h.slice(0, bs) + h.slice(be);
    }
    const cabIdx = h.indexOf('/catalog/kabel-type2-type2-5m-22kw.html');
    if (cabIdx >= 0) {
      const cs2 = h.lastIndexOf('<div class="relative', cabIdx);
      const [pre3, seg, post3] = cutMid(h, cs2, 'div');
      h = pre3 + post3;
      const porIdx = h.indexOf('/catalog/portativnaya-zaryadka-type2-7kw.html');
      if (porIdx >= 0) {
        const ps3 = h.lastIndexOf('<div class="relative', porIdx);
        h = h.slice(0, ps3) + seg + h.slice(ps3);
      }
    }
    const stIdx = h.indexOf('/catalog/nastennaya-stanciya-type2-7kw.html');
    if (stIdx >= 0) {
      const ss3 = h.lastIndexOf('<div class="relative', stIdx);
      h = h.slice(0, ss3) + OIL_CARD + h.slice(ss3);
    }
    const ai = h.indexOf('/catalog/derzhatel-organayzer-kabelya.html');
    if (ai >= 0) {
      const cs = h.lastIndexOf('<div class="relative', ai);
      if (cs >= 0) {
        const [pre, post] = cutFrom(h, cs, 'div');
        h = pre + ULG_CARD + post;
      }
    }
  }
  // ГИГИЕНА (08.11): дубли плиток портов, внутренние пометки, дефолт батареи, имя бандла
  h = h.replace(/<div class="pt">\s*<div style="display:flex;gap:10px;align-items:center;margin-bottom:6px">\s*<img[^>]*src="\/assets\/img\/plugs\/zsh-[a-z0-9-]+\.svg"[^>]*>\s*<b>[^<]+<\/b>\s*<\/div>\s*<div class="sol"><\/div>\s*<\/div>/g, '');
  h = h.replace(/<p class="note">\s*<b>Примечание:<\/b>\s*Канал Major[\s\S]{0,120}?<\/p>\s*/g, '');
  const mslug2 = String(m.slug || '');
  if (capFinal) {
    h = h.replace(/value="60"/g, 'value="' + capFinal + '"');
    h = h.replace(/Время посчитано для батареи 60 кВт·ч/g, 'Время посчитано для батареи ' + capFinal + ' кВт·ч' + (CAP_NOTE[mslug2] || ''));
  }
  if (!capFinal) {
    h = h.replace(/Время посчитано для батареи 60 кВт·ч; для своей машины умножьте на её ёмкость\./g, 'Ёмкость батареи этой модели не указана — подставьте свою (у большинства EV из Китая 60–80 кВт·ч); расчёт обновится автоматически.');
    h = h.replace('value="60"', 'value=""');
  }
  if (isGBT) {
    h = h.split('Пакет „Максимальный ход“ для Zeekr / Li Auto / Voyah').join('Пакет «Максимальный ход» для китайских EV (GB/T)');
  }
  // Блок «Проблемы и решения»: серверный фильтр по порту/марке + аккордеон (вместо клиентского JS-двойника)
  {
    const h2ms = [...h.matchAll(/<h2[^>]*>[^<]*Проблемы и решения[^<]*<\/h2>/g)].map(x => x.index);
    const h2i = h2ms.length ? h2ms[h2ms.length - 1] : -1;
    let gi = -1, gEnd = -1;
    if (h2i >= 0) {
      const gx = h.indexOf('<div class="prob-grid">', h2i);
      if (gx >= 0) gi = gx;
    }
    if (gi < 0) {
      const gs = [...h.matchAll(/<div class="prob-grid">/g)].map(x => x.index);
      if (gs.length) gi = gs[gs.length - 1];
    }
    if (gi >= 0) {
      const rx = /<div\b|<\/div>/g;
      rx.lastIndex = gi;
      let d2 = 0, mm2;
      while ((mm2 = rx.exec(h))) { if (mm2[0][1] === '/') d2--; else d2++; if (d2 === 0) { gEnd = rx.lastIndex; break; } }
    }
    if (gi >= 0 && gEnd > 0) {
      const inner = h.slice(gi + '<div class="prob-grid">'.length, gEnd - '</div>'.length);
      const pis = [...inner.matchAll(/<div class="pt">/g)].map(x => x.index);
      const cards = pis.map((p, j) => inner.slice(p, j + 1 < pis.length ? pis[j + 1] : inner.length));
      const mnameAll = (String(m.brand || '') + ' ' + String(m.name || m.title || '')).toLowerCase().replace(/[()/]/g, ' ').split(/\s+/).filter(t => t.length > 2);
      const mtype = String(m.type || '').toUpperCase();
      const portTokens = isGBT ? ['gb/t', 'gbt'] : ['type 2', 'type2', 'ccs2', 'ccs'];
      const bodyKeywords = isGBT ? ['китай'] : ['европ', 'европейск'];
      const FRAMES = ['zeekr', 'tesla', 'voyah', 'avatr', 'lotus', 'hiphi', 'nio', 'im '];
      const KEEP = ['UN-01', 'ZM-01', 'UN-04', 'UN-05', 'UN-06'];
      const keepPainS = (txt, pid) => {
        const t = String(txt || '').toLowerCase().replace(/^кому актуально:\s*/, '');
        if (pid && KEEP.includes(pid)) return true;
        for (const tk of mnameAll) if (tk && t.indexOf(tk) >= 0) return true;
        for (const pt of portTokens) if (t.indexOf(pt) >= 0) return true;
        for (const bk of bodyKeywords) if (t.indexOf(bk) >= 0) return true;
        if (/^(все|китайск|импорт|владелец|люб)/.test(t.trim())) return true;
        if (t.indexOf('eu-групп') >= 0) return true;
        if (t.indexOf('все ev') >= 0 || t.indexOf('многие ev') >= 0 || t.indexOf('все с adas') >= 0) return true;
        if (t.indexOf('безрам') >= 0) {
          for (const tk of mnameAll) { for (const fr of FRAMES) { if (tk.indexOf(fr) === 0) return true; } }
        }
        if (mtype.indexOf('EREV') >= 0 || mtype.indexOf('PHEV') >= 0) {
          if ((pid || '').indexOf('PHEV-') === 0 || t.indexOf('erev') >= 0) return true;
        }
        return false;
      };
      const accParts = [];
      let hiddenCount = 0;
      for (const c of cards) {
        const idm = c.match(/pain-id">([A-Z0-9-]+)/);
        const pid = idm ? idm[1] : '';
        const actm = c.match(/<div class="sol">[\s\S]*?<\/div>/);
        const actTxt = actm ? actm[0].replace(/<[^>]+>/g, '').trim() : '';
        if (!keepPainS(actTxt, pid)) { hiddenCount++; continue; }
        const h3m = c.match(/<h3>[\s\S]*?<\/h3>/);
        let title = h3m ? h3m[0].replace(/<[^>]+>/g, '').trim() : '';
        title = pid && title.indexOf(pid) === 0 ? title.slice(pid.length).replace(/^\s+/, '') : title;
        let rest = h3m ? c.slice(c.indexOf(h3m[0]) + h3m[0].length) : c;
        rest = rest.replace(/<\/div>\s*$/, '');
        accParts.push('<details class="pain-acc"><summary><span class="pain-id">' + pid + '</span> <b>' + title + '</b><span class="pa-arrow">\u25be</span></summary><div class="pa-body">' + rest + '</div></details>');
      }
      if (accParts.length === 0) {
        const h2s2 = h2i >= 0 ? h.lastIndexOf('<h2', h2i) : -1;
        const start = h2s2 >= 0 ? h2s2 : gi;
        h = h.slice(0, start) + '<p class="note">Специфичные разборы для этой модели в подготовке. Общие проблемы и решения — в <a href="/pain/">разделе «Проблемы и решения»</a>.</p>' + h.slice(gEnd);
      } else {
        const more = hiddenCount ? '<details class="pain-acc pain-more"><summary><b>Ещё ' + hiddenCount + ' проблем смежных сценариев</b><span class="pa-arrow">\u25be</span></summary><div class="pa-body">Разобраны в <a href="/pain/">общем разделе «Проблемы и решения»</a> и на страницах соответствующих моделей.</div></details>' : '';
        h = h.slice(0, gi) + '<div class="pain-acc-wrap">' + accParts.join('') + more + '</div>' + h.slice(gEnd);
      }
    }
  }
  // СЦЕНАРИИ (08.11): карточки «Город / Дом / Трасса» перед каталогом; весь каталог — в сворачиваемый блок
  {
    const GBT_SCEN = '<div class="scen">' +
      '<a class="sc" href="/catalog/adapter-type2-gbt-premium.html"><div class="sc-k">Город и Type 2-станции</div><div class="sc-t">Адаптер Type 2 → GB/T</div><div class="sc-p">от 4 500 ₽ · открывает большинство городских станций</div></a>' +
      '<a class="sc" href="/catalog/portativnaya-zaryadka-gbt-3-5kw.html"><div class="sc-k">Дом и дача (220 В)</div><div class="sc-t">Портативная зарядка GB/T</div><div class="sc-p">от 9 500 ₽ · от любой розетки</div></a>' +
      '<a class="sc" href="/catalog/adapter-ccs2-gbt-dc.html"><div class="sc-k">Трасса (быстрая зарядка)</div><div class="sc-t">DC-адаптер CCS2 → GB/T</div><div class="sc-p">95 000 ₽ · для дальних поездок: быстрых GB/T-станций мало</div></a>' +
      '</div>';
    const EU_SCEN = '<div class="scen">' +
      '<a class="sc" href="/catalog/kabel-type2-type2-5m-22kw.html"><div class="sc-k">Город и Type 2-станции</div><div class="sc-t">Кабель Type 2 — Type 2, 5 м</div><div class="sc-p">13 500 ₽ · если на станции нет своего кабеля</div></a>' +
      '<a class="sc" href="/catalog/portativnaya-zaryadka-type2-7kw.html"><div class="sc-k">Дом и дача (220 В)</div><div class="sc-t">Портативная зарядка Type 2</div><div class="sc-p">от 7 500 ₽ · от любой розетки</div></a>' +
      '<a class="sc" href="/razemy/ccs2/"><div class="sc-k">Трасса (быстрая зарядка)</div><div class="sc-t">CCS2-станции — напрямую</div><div class="sc-p">без адаптеров: у машины CCS2 на борту</div></a>' +
      '</div>';
    const scenHtml = pf(isGBT ? GBT_SCEN : EU_SCEN);
    const h2i2 = h.indexOf('Что докупить');
    if (h2i2 >= 0) {
      const h2end = h.indexOf('</h2>', h2i2);
      if (h2end >= 0) h = h.slice(0, h2end + 5) + scenHtml + h.slice(h2end + 5);
    }
    // Устаревшая статичная таблица «Сколько занимает зарядка» (жёсткие цифры под 60 кВт·ч) — снять: калькулятор ниже считает по своей батарее
    const h2chg = /<h2[^>]*>[^<]*Сколько занимает зарядка[^<]*<\/h2>/.exec(h);
    if (h2chg) {
      const stw = h.indexOf('<div class="rounded-lg', h2chg.index);
      if (stw >= 0 && stw - h2chg.index < 500) {
        const rxs = /<div\b|<\/div>/g; rxs.lastIndex = stw;
        let ddS = 0, mmS;
        while ((mmS = rxs.exec(h))) { if (mmS[0][1] === '/') ddS--; else ddS++; if (ddS === 0) { h = h.slice(0, stw) + h.slice(rxs.lastIndex); break; } }
      }
    }
    // SKU-заметка «Что понадобится для зарядки» (h3-блок) — дублирует сценарные карточки
    const h3m = /<h3[^>]*>Что понадобится для зарядки<\/h3>/.exec(h);
    if (h3m) {
      const ds3 = h.lastIndexOf('<div class="rounded-lg', h3m.index);
      if (ds3 >= 0) {
        const rx3 = /<div\b|<\/div>/g; rx3.lastIndex = ds3;
        let dd3 = 0, mm3;
        while ((mm3 = rx3.exec(h))) { if (mm3[0][1] === '/') dd3--; else dd3++; if (dd3 === 0) { h = h.slice(0, ds3) + h.slice(rx3.lastIndex); break; } }
      }
    }
    // весь каталог — в сворачиваемый блок
    const pg = h.indexOf('<div class="pc-grid">');
    if (pg >= 0) {
      const rxc = /<div\b|<\/div>/g; rxc.lastIndex = pg;
      let dd2 = 0, mm4, pEnd = -1;
      while ((mm4 = rxc.exec(h))) { if (mm4[0][1] === '/') dd2--; else dd2++; if (dd2 === 0) { pEnd = rxc.lastIndex; break; } }
      if (pEnd > 0) {
        const cnt = (h.slice(pg, pEnd).match(/card-product/g) || []).length;
        const grid = h.slice(pg, pEnd);
        h = h.slice(0, pg) + '<details class="pain-acc pc-more"><summary><b>Показать весь каталог (' + cnt + ' позиций) — цены и кнопка заказа</b><span class="pa-arrow">\u25be</span></summary><div class="pa-body">' + grid + '</div></details>' + h.slice(pEnd);
      }
    }
  }
  return pf(h.trim());
})();

const yearsShort = String(m.years || '').split(' · ')[0];
const jsonld = { '@context': 'https://schema.org', '@type': 'Article', headline: m.title, description: m.desc };
---
<ZhLayout title={`${m.title} — Запас хода`} description={m.desc} og={m.og} jsonld={jsonld}>
  <LegacyStyles />
  <style is:global>
    .prob-grid{display:flex;gap:12px;flex-wrap:wrap;margin:16px 0}
    .prob-grid .pt{flex:1 1 280px;border:1px solid var(--line);border-radius:12px;padding:14px 16px;background:var(--card)}
    .prob-grid .pt h3{font-size:16px;margin:0 0 8px;line-height:1.4}
    .prob-grid .sol{margin-top:8px;font-size:14px;line-height:1.5;color:var(--txt)}
    .prob-grid .pain-id{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.06em;padding:2px 8px;border-radius:6px;border:1px solid var(--gold);color:var(--gold);margin-right:8px}
    .prob-grid .src{font-size:12px;color:var(--txt-muted);margin:10px 0 0;word-break:break-word}
    .tbl-tabs{display:flex;gap:8px;flex-wrap:wrap;margin:14px 0}
    .tbl-tabs .tt{border:1px solid var(--line);background:var(--card);color:var(--txt);border-radius:10px;padding:8px 14px;font-weight:600;cursor:pointer;font-size:14px;font-family:inherit}
    .tbl-tabs .tt.on{background:var(--gold);border-color:var(--gold);color:#fff}
    .cout .f{display:inline-block;vertical-align:top;margin:0 10px 10px 0;padding:10px 14px;border:1px solid var(--line);border-radius:10px;background:var(--bg2,transparent)}
    .cout .k{font-size:12px;color:var(--txt-muted);margin-bottom:3px}
    .cout .v{font-size:18px;font-weight:700;color:var(--head)}
    .ccp-on{background:var(--gold)!important;border-color:var(--gold)!important;color:#fff!important}
    .pain-acc-wrap{margin:18px 0 8px}
    .pain-acc{border:1px solid var(--line);border-radius:12px;background:var(--card);margin-bottom:10px;overflow:hidden;transition:border-color .15s}
    .pain-acc:hover{border-color:rgba(77,155,245,.4)}
    .pain-acc summary{display:flex;align-items:center;gap:10px;padding:14px 18px;cursor:pointer;list-style:none;font-size:15px;line-height:1.45;color:var(--txt)}
    .pain-acc summary::-webkit-details-marker{display:none}
    .pain-acc .pa-arrow{margin-left:auto;color:var(--txt-muted);flex-shrink:0;transition:transform .15s}
    .pain-acc[open] .pa-arrow{transform:rotate(180deg)}
    .pain-acc .pa-body{padding:2px 18px 16px;font-size:14px;line-height:1.6;color:var(--txt-muted);max-width:65ch}
    .pain-acc .pa-body .sol{margin-top:10px}
    .pain-acc .pa-body .sol b{color:var(--txt)}
    .pain-more summary{font-weight:600}
    .pain-more .pa-body a{word-break:break-word}
    @media (max-width:640px){
      .prob-grid-pains{flex-wrap:nowrap;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;padding-bottom:6px}
      .prob-grid-pains .pt{flex:0 0 84%;scroll-snap-align:start}
    }
  .mfaq{border:1px solid var(--line);border-radius:12px;padding:10px 14px;margin:8px 0 0;background:var(--bg2)}
    [data-mport].wrap{max-width:1180px!important}
    .mgrid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:32px;align-items:start}
    .mside{position:sticky;top:81px;max-height:calc(100vh - 97px);overflow-y:auto;scrollbar-width:none;-ms-overflow-style:none}.mside::-webkit-scrollbar{display:none}.mside::after{content:'';position:sticky;bottom:0;display:block;height:22px;margin-top:-22px;pointer-events:none;background:linear-gradient(180deg,transparent,var(--bg));opacity:0;transition:opacity .25s}.mside.has-more::after{opacity:1}
    .pp-chip{border:1px solid var(--line);background:var(--card);border-radius:12px;padding:10px 12px;margin-bottom:8px}
    .pp-k{font-size:11.5px;letter-spacing:.04em;text-transform:uppercase;color:var(--txt-muted)}
    .pp-v{font-size:15px;font-weight:700;color:var(--head);margin-top:2px}
    .scen{display:grid;gap:10px;margin:14px 0}
    .sc{display:block;border:1px solid var(--line);background:var(--card);border-radius:12px;padding:14px 16px;text-decoration:none;color:inherit;transition:border-color .15s}
    .sc:hover{border-color:rgba(77,155,245,.4)}
    .sc-k{font-size:11.5px;letter-spacing:.04em;text-transform:uppercase;color:var(--txt-muted)}
    .sc-t{font-size:16px;font-weight:700;color:var(--txt);margin-top:4px}
    .sc-p{font-size:13.5px;color:var(--gold);margin-top:6px;font-weight:600}
    .pc-more .pa-body{max-width:none}
    @media (max-width:1024px){.mgrid{grid-template-columns:1fr}.mside{position:static;order:-1;max-height:none;overflow:visible}}
    .mfaq summary{font-weight:700;cursor:pointer;font-size:14.5px}
    .mfaq p{margin:8px 0 0;font-size:14px;line-height:1.5;color:var(--txt-muted)}
  </style>
  <section class="sec">
    <div class="wrap" data-mbrand={m.brand || ''} data-mname={m.name || ''} data-mport={String(m.port || '').includes('GB/T') ? 'GBT' : 'EU'} data-mtype={m.type || ''}>
      <div class="crumbs"><a href="/">Главная</a> / <a href="/models/">Модели</a> / {m.name || m.title}</div>
      <div class="badge">{m.type || 'EV'} · {yearsShort}{spec.market ? ` · ${spec.market}` : ''}</div>
      <h1>{m.name || m.title}: разъёмы, адаптеры и совместимость</h1>
      <div class="meta">
        <a href={`/razemy/${portSlug(String(m.port || ''))}/`} style="display:inline-flex;align-items:center;gap:6px;text-decoration:none;color:inherit" title="Справочник разъёма"><PlugIcon name={portIcon(String(m.port || ''))} size={16} label={String(m.port || '')} /> {m.port || '—'} <span style="font-size:11px;color:var(--txt-muted)">что за разъём →</span></a>
        {spec.obc && <span>{spec.obc}</span>}
        {dcpowClean && <span>DC {dcShort}</span>}
        <span>Обновлено: ноябрь 2026</span>
      </div>
      {m.desc && <p class="article" style="font-size:18px;color:var(--txt-muted)">Коротко: {m.desc}</p>}
      <div class="mgrid">
        <div class="mmain">
      {isGBT && (<p style="margin-top:16px;font-size:13.5px;color:var(--txt-muted);background:var(--bg2);border:1px solid var(--line);border-radius:12px;padding:12px 16px"><b style="color:var(--head)">Телематика:</b> у китайских EV в РФ важно, чтобы работали мастер-аккаунт и SIM/eSIM — без интернета в машине недоступны предпрогрев батареи перед зарядкой и удалённый контроль из приложения. Разбор темы — <a href="/telematika/" style="color:#5aa9ff">в разделе «Телематика»</a>.</p>)}

      {faqPort && <Fragment set:html={faqPort} />}
            {bodyClean && <div class="article" style="margin-top:8px" set:html={bodyClean} />}
        </div>
        <aside class="mside">
          <div style="font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--txt-muted);margin:0 0 10px">Паспорт модели</div>
          <div class="pp-chip"><div class="pp-k">Разъём</div><div class="pp-v">{m.port || '—'}</div></div>
          {spec.obc && <div class="pp-chip"><div class="pp-k">Скорость дома</div><div class="pp-v">{spec.obc}</div></div>}
          {dcpowClean && <div class="pp-chip"><div class="pp-k">Быстрая зарядка</div><div class="pp-v">{dcShort}</div></div>}
          {battLabel && <div class="pp-chip"><div class="pp-k">Батарея</div><div class="pp-v">{battLabel}</div></div>}
          {spec.market && <div class="pp-chip"><div class="pp-k">Откуда машина</div><div class="pp-v">{spec.market}</div></div>}
          <div class="pp-chip"><div class="pp-k">Нужен ли адаптер</div><div class="pp-v" style="font-size:13.5px;font-weight:600">{solutionFor(m.port)}</div></div>
      {battLabel && (() => {
        const kb = (String(battLabel).match(/([0-9]+(?:[.,][0-9]+)?)\s*кВт[·.]?\s*ч/i) || []);
        const kwh = kb.length > 1 ? parseFloat(kb[1].replace(',', '.')) : 0;
        return kwh > 0 && (<div class="card" style="margin-top:12px">
          <h3 style="margin:0 0 6px">Сколько реально зальётся</h3>
          <p style="font-size:13.5px;color:var(--txt-muted);margin:0">Паспортная ёмкость: <b style="color:var(--head)">{kwh} кВт·ч</b>. На ходу реально доступно примерно <b style="color:var(--head)">{Math.round(kwh * 0.9)} кВт·ч</b> (буфер сверху и снизу батареи, разница на 10%±3). При зарядке с учётом потерь преобразователей в батарею уйдёт до <b style="color:var(--head)">{Math.round(kwh * 0.95)} кВт·ч</b> — остальное греется по пути. Оценка усреднённая: точные цифры зависят от прошивки, температуры и износа батареи.{CAP_NOTE[String(m.slug||'')] || ''}{battInfo && battInfo.note ? ' ' + battInfo.note : ''}</p>
        </div>);
      })()}
          <a class="btn btn-gold" href={isGBT ? ('/catalog/?line=gbt&model=' + encodeURIComponent(String(m.name || m.title))) : '/catalog/'} style="text-decoration:none;display:block;text-align:center;margin-top:6px">Подобрать комплект</a>
          <a href="#chg-calc" style="display:block;text-align:center;font-size:13.5px;color:#5aa9ff;margin-top:10px;text-decoration:none">Рассчитать время и цену зарядки ↓</a>
        </aside>
<script is:inline>const ms=document.querySelector('.mside');if(ms){const u=()=>{ms.classList.toggle('has-more',ms.scrollHeight>ms.clientHeight+2)};u();ms.addEventListener('scroll',u);window.addEventListener('resize',u);}</script>
      </div>


  <script is:inline>
  (function(){
    function norm(s){ return (s||'').toLowerCase(); }
    var wrapEl = document.querySelector('[data-mport]');
    var brandTokens = ((wrapEl && wrapEl.getAttribute('data-mbrand')) || '') + ' ' + ((wrapEl && wrapEl.getAttribute('data-mname')) || '');
    var tokens = brandTokens.toLowerCase().replace(/[()/]/g,' ').split(/\s+/).filter(function(t){return t.length>2;});
    var isGBT = wrapEl && wrapEl.getAttribute('data-mport') === 'GBT';
    var portTokens = isGBT ? ['gb/t','gbt'] : ['type 2','type2','ccs2','ccs'];
    var bodyKeywords = isGBT ? ['китай'] : ['европ','европейск'];
    var mtype = ((wrapEl && wrapEl.getAttribute('data-mtype')) || '').toUpperCase();
    function keepPain(txt, pid){
      var t = norm(txt).replace(/^кому актуально:\s*/, '');
      for (var i=0;i<tokens.length;i++){ if (t.indexOf(tokens[i]) >= 0) return true; }
      for (var i=0;i<portTokens.length;i++){ if (t.indexOf(portTokens[i]) >= 0) return true; }
      for (var i=0;i<bodyKeywords.length;i++){ if (t.indexOf(bodyKeywords[i]) >= 0) return true; }
      if (/^(все|китайск|импорт|владельц|люб)/.test(t.trim())) return true;
      if (t.indexOf('eu-групп') >= 0) return true;
      if (t.indexOf('все ev') >= 0 || t.indexOf('многие ev') >= 0 || t.indexOf('все с adas') >= 0) return true;
      if (t.indexOf('безрам') >= 0) {
        var FRAMES = ['zeekr','tesla','voyah','avatr','lotus','hiphi','nio','im '];
        for (var i=0;i<tokens.length;i++){ for (var j=0;j<FRAMES.length;j++){ if (tokens[i].indexOf(FRAMES[j]) === 0) return true; } }
      }
      if (mtype.indexOf('EREV') >= 0 || mtype.indexOf('PHEV') >= 0) {
        if ((pid || '').indexOf('PHEV-') === 0 || t.indexOf('erev') >= 0) return true;
      }
      return false;
    }
    function shortenSrc(box){
      box.querySelectorAll('a').forEach(function(a){
        if (a.textContent.length > 34) a.textContent = 'Источник ↗';
      });
    }
    function gridAfter(h2){
      var el = h2.nextElementSibling;
      while (el) {
        if (el.tagName === 'H2') return null;
        if (el.classList && el.classList.contains('prob-grid')) return el;
        if (el.querySelector) {
          var g = el.querySelector('.prob-grid');
          if (g) return g;
        }
        el = el.nextElementSibling;
      }
      return null;
    }
    var h2s = Array.prototype.slice.call(document.querySelectorAll('h2'));
    h2s.forEach(function(h2){
      var ht = (h2.textContent || '').trim();
      if (ht.indexOf('Проблемы и решения') === 0) {
        // боли рендерятся серверно в bodyClean (аккордеон) — клиентский двойник больше не нужен (08.11)
      }
    if (ht.indexOf('Скачать руководство') === 0) {
      var el = h2.nextElementSibling;
      var box = document.createElement('div');
      box.className = 'pain-acc pdf-acc';
      var sum = document.createElement('summary');
      sum.innerHTML = '<b>Руководства и материалы (PDF)</b><span class="pa-arrow">▾</span>';
      var inner = document.createElement('div');
      inner.className = 'pa-body';
      var nodes = [];
      while (el && el.tagName !== 'H2') {
        nodes.push(el); el = el.nextElementSibling;
      }
      nodes.forEach(function(n){ inner.appendChild(n); });
      box.appendChild(sum); box.appendChild(inner);
      h2.insertAdjacentElement('afterend', box);
    }
      if (ht.indexOf('Что докупить') === 0) {
        h2.textContent = 'Каталог подходящих товаров';
      }
    });
  })();
  </script>


    </div>
  </section>
</ZhLayout>
