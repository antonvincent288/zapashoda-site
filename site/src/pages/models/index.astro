---
import ZhLayout from '../../layouts/ZhLayout.astro';
import PlugIcon from '../../components/PlugIcon.astro';
const modules = import.meta.glob('../../data/models/*.json', { eager: true, import: 'default' });
const models = Object.values(modules) as any[];
models.sort((a, b) => String(a.brand || '').localeCompare(String(b.brand || '')) || String(a.name || '').localeCompare(String(b.name || '')));
const SOLUTIONS: Record<string, string> = {
  'GB/T': 'Адаптер Type 2 → GB/T (SKU 1 premium / SKU 8 базовый) или кабель',
  'EU': 'Штатные станции Type 2/CCS2 РФ — без адаптера',
  'Type1/CCS1': 'Адаптер Type 1 → Type 2; CCS1-станции редки',
  'JP/CHAdeMO': 'CHAdeMO-станции; адаптер по запросу',
};
const plugIconOf = (p: string) => {
  if (p.includes('GB/T')) return 'gbt-dc';
  if (p.includes('CHAdeMO')) return 'chademo';
  if (p.includes('Type1')) return 'type1';
  return 'type2';
};
const plugSlugOf = (p: string) => {
  if (p.includes('GB/T')) return 'gbt';
  if (p.includes('CHAdeMO')) return 'chademo';
  if (p.includes('Type1')) return 'type1';
  return 'type2';
};
const solutionFor = (port: string, type: string) => {
  if (port && port.includes('GB/T')) return SOLUTIONS['GB/T'];
  if (port && port.includes('Type1')) return SOLUTIONS['Type1/CCS1'];
  if (port && port.includes('CHAdeMO')) return SOLUTIONS['JP/CHAdeMO'];
  if (port && port.includes('EU')) return SOLUTIONS['EU'];
  return 'Уточните разъём по VIN — подберём комплект';
};
const brands = ['Все', 'Zeekr', 'Li Auto', 'BYD', 'Voyah', 'Geely', 'Tesla'];
const yearShort = (years: string) => String(years || '').split(' · ')[0];
const typeOf = (t: string) => {
  const s = String(t || '').toUpperCase();
  if (s.includes('EREV')) return 'erev';
  if (s.includes('PHEV') || s.includes('C-DM') || s.includes('DM-I')) return 'phev';
  return 'bev';
};
---
<ZhLayout title="Каталог моделей — Запас хода" description={`Каталог ${models.length} моделей: разъёмы, мощность борта, решения и совместимость с российской инфраструктурой зарядки.`}>
  <section class="sec">
    <div class="wrap">
      <div class="crumbs"><a href="/">Главная</a> / Каталог моделей</div>
      <h1>Каталог моделей</h1>
      <p class="lead">{models.length} моделей: разъёмы, мощность борта, решения и совместимость с российской инфраструктурой.</p>
      <div class="fbar" style="margin-top:28px">
        <input id="q" type="search" placeholder="Поиск модели…" autocomplete="off" />
        {brands.map((b) => (
          <button class:list={["fchip", b === 'Все' && "on"]} data-brand={b === 'Все' ? 'all' : b}>{b}</button>
        ))}
      </div>
      <div class="fbar" style="margin-top:12px">
        <button class="fchip on" data-type="all">Все типы</button>
        <button class="fchip" data-type="bev">Электромобиль (BEV)</button>
        <button class="fchip" data-type="erev">Гибрид-резерв (EREV)</button>
        <button class="fchip" data-type="phev">Подключаемый (PHEV)</button>
      </div>
      <div class="mgrid" id="mgrid">
        {models.map((m) => (
          <div class="mcard" data-brand={m.brand} data-type={typeOf(m.type)}>
            <a class="mclink" href={`/models/${m.slug}/`}><b>{m.brand} {m.name || ''}</b></a>
            {m.type && <span class="tag">{m.type} · {yearShort(m.years)}</span>}
            {m.port && <div class="ports"><PlugIcon name={plugIconOf(String(m.port))} size={18} label={String(m.port)} /> <a class="mc-raz" href={`/razemy/${plugSlugOf(String(m.port))}/`}>Разъём: {m.port}</a></div>}
            <div class="sol"><b>Решение</b>{solutionFor(m.port, m.type)}</div>
          </div>
        ))}
      </div>
      <p class="note" id="mcount" style="margin-top:24px">Показано: {models.length} из {models.length}</p>
    </div>
  </section>
</ZhLayout>
<script>
  const inp = document.getElementById('q');
  document.querySelectorAll('#mgrid .mcard').forEach((c) => c.addEventListener('click', (e) => { if (e.target.closest('a')) return; const l = c.querySelector('a.mclink'); if (l) window.location.href = l.href; }));
  const count = document.getElementById('mcount');
  const total = document.querySelectorAll('#mgrid .mcard').length;
  function apply() {
    const q = (inp && inp.value ? inp.value.toLowerCase() : '');
    const active = document.querySelector('.fchip.on[data-brand]');
    const v = active ? active.getAttribute('data-brand') : 'all';
    const tActive = document.querySelector('.fchip.on[data-type]');
    const tv = tActive ? tActive.getAttribute('data-type') : 'all';
    let shown = 0;
    document.querySelectorAll('#mgrid .mcard').forEach((c) => {
      const okBrand = (v === 'all' || c.getAttribute('data-brand') === v);
      const okType = (tv === 'all' || c.getAttribute('data-type') === tv);
      const okText = c.textContent.toLowerCase().includes(q);
      const show = okBrand && okType && okText;
      (c as HTMLElement).style.display = show ? '' : 'none';
      if (show) shown++;
    });
    if (count) count.textContent = `Показано: ${shown} из ${total}`;
  }
  document.querySelectorAll('.fchip').forEach((b) => b.addEventListener('click', () => {
    const grp = b.hasAttribute('data-type') ? '[data-type]' : '[data-brand]';
    document.querySelectorAll('.fchip' + grp).forEach((x) => x.classList.remove('on'));
    b.classList.add('on');
    apply();
  }));
  if (inp) inp.addEventListener('input', apply);
</script>
