---
import ZhLayout from '../../layouts/ZhLayout.astro';
---
<ZhLayout title="Оплата | Запас хода" description="Статус оплаты и выдача цифрового гайда." noindex>
  <section class="sec">
    <div class="wrap" style="max-width:760px">
      <div class="crumbs"><a href="/">Главная</a> / <a href="/shop/digital/">Товары</a> / Оплата</div>
      <h1 id="succ-title">Проверяем оплату…</h1>
      <div id="succ-box" class="tldr-box"><p>Минуту…</p></div>
      <div style="margin-top:28px"><a class="btn btn-ghost" style="text-decoration:none" href="/shop/digital/">Вернуться к гайду</a></div>
    </div>
  </section>
  <style is:inline>.tldr-box{background:var(--bg2);border:1px solid var(--line);border-radius:14px;padding:18px 20px;font-size:14.5px;color:var(--txt-muted);margin-top:20px}.tldr-box a{color:var(--gold)}</style>
  <script is:inline>
  (function(){
    var gas="https://script.google.com/macros/s/AKfycby_Zx4ahWRuCX2Jq--yf6FqVpAOBqb9bEvj0rbGPJyFIr45WPcuZ4EKci-n-B2d3VzKQw/exec";
    var q=new URLSearchParams(location.search);
    var oid=q.get("oid")||"";var fail=q.get("fail");
    var title=document.getElementById("succ-title"),box=document.getElementById("succ-box");
    function h1(t){title.textContent=t;}
    function bh(h){box.innerHTML=h;}
    if(fail){h1("Оплата не прошла");bh("<p>Платёж не был завершён или отменён. Можно <a href='/shop/digital/'>повторить попытку</a>.</p>");return;}
    if(!oid){h1("Нет данных заказа");bh("<p>Откройте эту страницу по ссылке из письма или сразу после оплаты.</p>");return;}
    var tries=0;
    function poll(){
      tries++;
      fetch(gas+"?shop_status="+encodeURIComponent(oid)).then(function(r){return r.json();}).then(function(j){
        if(j&&j.status==="paid"){
          h1("Оплата прошла — гайд ваш");
          if(j.download_status==="limit-reached"){bh("<p><b>Лимит скачиваний исчерпан (3).</b> PDF отправлен на ваш email при оплате. Нужна повторная выдача — напишите нам.</p>");}
          else if(j.download_status==="expired"){bh("<p><b>Срок действия ссылки истёк (24 ч).</b> PDF отправлен на ваш email при оплате. Нужна повторная выдача — напишите нам.</p>");}
          else if(j.token){bh("<p>Ссылка на скачивание (действует 24 ч, до 3 скачиваний):</p><p><a class='btn btn-gold' style='display:inline-block;margin:8px 0;text-decoration:none' href='/shop/digital/download.html?token="+j.token+"'>Скачать PDF</a></p><p>Дубль отправлен на email, указанный при оплате.</p>");}
          else{bh("<p>Токен не найден — напишите в поддержку, номер заказа: "+oid+".</p>");}}
        else if(j&&j.status&&j.status!=="unknown"){
          if(tries<12){setTimeout(poll,4000);}else{h1("Оплата в обработке");bh("<p>Уведомление от банка обычно приходит за 1–2 минуты. Обновите страницу через пару минут — или проверьте email, ссылка придёт и туда.</p><p>Номер заказа: <b>"+oid+"</b></p>");}}
        else{bh("<p>Заказ не найден. Номер: "+oid+". Напишите в поддержку.</p>");}
      }).catch(function(){if(tries<12){setTimeout(poll,4000);}else{bh("<p>Ошибка сети при проверке статуса. Номер заказа: "+oid+".</p>");}});
    }
    poll();
  })();
  </script>
</ZhLayout>
