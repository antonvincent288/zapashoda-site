---
import ZhLayout from '../../layouts/ZhLayout.astro';
export async function getStaticPaths() {
  const modules = import.meta.glob('../../data/articles/**/*.json', { eager: true, import: 'default' });
  const seen: Map<string, number> = new Map();
  return Object.entries(modules).map(([path, val]) => {
    const a = val as any;
    const seg = path.split('/articles/')[1].split('/');
    const section = seg[0];
    let slug = String(a.slug || seg[seg.length - 1].replace('.json', ''));
    const n = (seen.get(slug) || 0) + 1;
    seen.set(slug, n);
    if (n > 1) slug = `${section}-${slug}`;
    return { params: { slug }, props: { a, section } };
  });
}
const { a, section } = Astro.props;
const labels: Record<string, string> = { blog: 'Блог', pain: 'Проблемы', safety: 'Безопасность' };
const jsonld = { '@context': 'https://schema.org', '@type': 'Article', headline: a.title, description: a.desc, datePublished: a.date, articleSection: labels[section] || section };
---
<ZhLayout title={`${a.title} — Запас хода`} description={a.desc} og={a.og} jsonld={jsonld}>
  <section class="sec">
    <div class="wrap">
      <div class="crumbs"><a href="/">Главная</a> / <a href="/article/">Статьи</a> / {a.title}</div>
      <div class="artgrid">
        <aside class="toc">
          <div>Содержание</div>
          {a.headings && <Fragment set:html={a.headings} />}
        </aside>
        <article class="article">
          <h1 style="font-size:clamp(28px,3.4vw,40px)">{a.title}</h1>
          {a.desc && <p class="lead">{a.desc}</p>}
          <div class="meta">
            <span>{labels[section] || section}</span>
            {a.category && <span>{a.category}</span>}
            {a.date && <span>📅 {a.date}</span>}
            {a.read_min && <span>⏱ {a.read_min} мин</span>}
          </div>
          <div set:html={a.body_html} />
          {a.extra_html && <div set:html={a.extra_html} />}
          <div class="share"><span>Telegram</span><span>WhatsApp</span><span>Скопировать ссылку</span></div>
        </article>
      </div>
    </div>
  </section>
</ZhLayout>
