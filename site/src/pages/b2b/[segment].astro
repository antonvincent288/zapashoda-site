---
import ZhLayout from '../../layouts/ZhLayout.astro';
export async function getStaticPaths() {
  const segs = (await import('../../data/b2b_segments.json')).default as any[];
  return segs.map((s) => ({ params: { segment: s.slug }, props: { s } }));
}
const s = Astro.props.s as any;
const TELEGRAM = 'https://t.me/zapashoda_ev';
const PDF = '/b2b/paket-dileram.pdf';
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: s.faq.map((f: any) => ({ '@type': 'Question', name: f[0], acceptedAnswer: { '@type': 'Answer', text: f[1] } })) };
const STEPS = [
  'Заявка. Напишите в Telegram или на почту — достаточно профиля и города.',
  'Прайс и условия. Пришлём в течение рабочего дня: позиции, дилерские цены, условия по объёму и доставке.',
  'Пилот. Начинаем с небольшой партии, чтобы проверить спрос без заморозки денег.',
  'Поддержка. Карточки моделей и базы болей — с вашим логотипом; замена брака за 1 день.',
];
---
<ZhLayout title={`${s.h1} — Запас хода`} description={s.lead}>
  <div class="hero" style="padding:72px 0 56px"><div class="wrap">
    <div class="badge" style="color:#4D9BF5">{s.kicker}</div>
    <h1>{s.h1}</h1>
    <p style="max-width:760px">{s.lead}</p>
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:22px">
      <a class="btn btn-gold" href="/quiz/" style="text-decoration:none">Запросить расчёт за 30 секунд</a>
      <a class="btn btn-ghost" href={PDF} download style="text-decoration:none">Партнёрский пакет (PDF)</a>
    </div>
  </div></div>

  <section class="sec"><div class="wrap">
    <h2>Типовые боли и как мы их закрываем</h2>
    <div class="cards" style="margin-top:24px">
      {s.pains.map((p: any) => (
        <div class="card">
          <b style="display:block;margin-bottom:6px">{p[0]}</b>
          <p style="font-size:14.5px;color:var(--txt-muted)">{p[1]}</p>
        </div>
      ))}
    </div>
  </div></section>

  <section class="sec-alt"><div class="wrap">
    <h2>Что поставляем под ваш сценарий</h2>
    <div class="cards" style="margin-top:24px">
      {s.solutions.map((r: any) => (
        <div class="card">
          <div style="display:flex;gap:10px;align-items:center;margin-bottom:8px">
            <img src={`/assets/img/plugs/zsh-${r[0]}.svg`} width="26" height="26" alt="" />
            <b>{r[2]}</b>
          </div>
          <p style="font-size:14.5px;color:var(--txt-muted)">{r[3]}</p>
          <p style="margin-top:10px;font-size:13.5px"><a href={`/razemy/${r[1]}/`} style="color:var(--gold);text-decoration:none">Справочник разъёма →</a></p>
        </div>
      ))}
    </div>
    <p style="margin-top:14px;font-size:13.5px;color:var(--txt-muted)">Разъёмы и совместимость — в <a href="/razemy/" style="color:var(--gold);text-decoration:none">справочнике разъёмов</a>, станции — на <a href="/charging/" style="color:var(--gold);text-decoration:none">карте ЗУ</a>.</p>
  </div></section>

  <section class="sec"><div class="wrap">
    <h2>Как работаем</h2>
    <div class="cards" style="margin-top:24px">
      {STEPS.map((st, i) => (
        <div class="card"><span class="ico">{i + 1}</span><p style="font-size:15px;color:var(--txt)">{st}</p></div>
      ))}
    </div>
  </div></section>

  <section class="sec-alt"><div class="wrap">
    <h2>FAQ по сегменту</h2>
    <div class="faqbox" style="margin-top:20px;max-width:820px">
      {s.faq.map((f: any) => (
        <details open={f === s.faq[0]}><summary>{f[0]}</summary><p>{f[1]}</p></details>
      ))}
    </div>
  </div></section>

  <section class="sec"><div class="wrap"><div class="cta">
    <h2>Обсудить ваш сценарий</h2>
    <p>Опишите задачи в форме подбора — ответит наш менеджер. Партнёрский пакет с ценами пришлём вместе с расчётом. Быстрый канал — Telegram.</p>
    <div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-top:18px">
      <a class="btn btn-gold" href="/quiz/" style="text-decoration:none">Отправить заявку</a>
      <a class="btn btn-ghost" href={TELEGRAM} rel="noopener" style="text-decoration:none">Telegram</a>
      <a class="btn btn-ghost" href="/b2b/" style="text-decoration:none">Все B2B-сегменты</a>
    </div>
  </div></div></section>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</ZhLayout>
