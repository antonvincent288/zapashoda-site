---
import ZhLayout from '../layouts/ZhLayout.astro';
import c from '../data/b2b_content.json';
const rrc = c.rrc || [];
const faq = c.faq || [];
const faqLd = faq.length ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) } : null;
---
<ZhLayout title="Оптовые поставки зарядного оборудования для автосалонов — Запас хода" description="B2B-поставки зарядного оборудования: дилерские цены, пилотная партия, РРЦ, доставка в автосалон." jsonld={faqLd}>
  <section class="sec">
    <div class="wrap" style="max-width:820px">
      <div class="crumbs"><a href="/">Главная</a> / B2B</div>
      <h1>Оптовые поставки зарядного оборудования для автосалонов</h1>
      <p class="lead">Дилерские цены без заморозки денег в стоке: пилотная партия под ваш зал, витрина компетенции и комплектация машины в момент покупки.</p>
      {c.benefits && c.benefits.length > 0 && (
        <ul style="margin:24px 0 0 20px">
          {c.benefits.map((b) => <li style="margin-bottom:10px">{b}</li>)}
        </ul>
      )}
      <h2 style="margin-top:44px">Как работаем</h2>
      <ol style="margin:18px 0 0 20px">
        {c.steps.map((s) => <li style="margin-bottom:10px">{s}</li>)}
      </ol>
      <h2 style="margin-top:44px">Рекомендуемые розничные цены (РРЦ)</h2>
      <div class="card" style="margin-top:18px;padding:0;overflow:hidden">
        <table style="width:100%;border-collapse:collapse;font-size:15px">
          <thead><tr style="border-bottom:1px solid var(--line)"><th style="text-align:left;padding:12px 16px">Позиция</th><th style="text-align:right;padding:12px 16px">РРЦ</th></tr></thead>
          <tbody>
            {rrc.map(([name, price]) => (
              <tr style="border-bottom:1px solid var(--line)"><td style="padding:10px 16px">{name}</td><td style="padding:10px 16px;text-align:right;font-weight:700">{price}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      {c.infra && c.infra.length > 0 && (
        <>
          <h2 style="margin-top:44px">Зарядная инфраструктура для бизнеса: ТЦ, паркинги, HoReCa</h2>
          <ul style="margin:18px 0 0 20px">
            {c.infra.map((s) => <li style="margin-bottom:10px">{s}</li>)}
          </ul>
        </>
      )}
      {faq.length > 0 && (
        <>
          <h2 style="margin-top:44px">Частые вопросы</h2>
          <div class="faqbox" style="margin-top:18px">
            {faq.map((f) => (
              <details><summary>{f.q}</summary><p>{f.a}</p></details>
            ))}
          </div>
        </>
      )}
      <h2 style="margin-top:44px">Запросить расчёт проекта</h2>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:18px">
        <a class="btn btn-gold" style="text-decoration:none" href="https://zapashoda-ev.ru/b2b/" rel="nofollow">Запросить расчёт проекта</a>
        <a class="btn btn-ghost" style="text-decoration:none" href="/b2b/paket-dileram.pdf" download>Скачать партнёрский пакет (PDF)</a>
      </div>
      <p class="lead" style="margin-top:16px;font-size:14px">Заявка идёт через рабочую форму прода — после переключения формы на статическую сборку маршрут не меняется.</p>
    </div>
  </section>
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
</ZhLayout>
