---
import ZhLayout from '../../layouts/ZhLayout.astro';
import c from '../../data/b2b_content.json';
const rrc = c.rrc || [];
const faqProd = c.faq || [];
const faqMock = [
  { q: 'Как оформить первый пилот?', a: 'Начинаем с небольшой партии, чтобы проверить спрос без заморозки денег. Условия и объёмы фиксируем в прайсе — с ценами, не «на пальцах».' },
  { q: 'Что входит в маркетинговую поддержку?', a: 'База 88 болей, 138 карточек моделей, руководства на русском и карта станций — с вашим логотипом, чтобы продавали допы без лишних вопросов.' },
];
const faq = [...faqMock, ...faqProd.filter((f: any) => !faqMock.some((m) => m.q === f.q))];
const faqLd = faq.length ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) } : null;
const plans = [
  { name: 'Старт', note: 'Проверка спроса без заморозки денег', pop: false, cta: 'Оставить заявку', items: ['Базовый адаптер Type 2 → GB/T (SKU 8)', 'Обратный адаптер GB/T → Type 2 (SKU 2)', 'Мини-партия для пилота', 'Консультация по подбору'] },
  { name: 'Комплект', note: 'Оптимальный выбор для салона', pop: true, cta: 'Получить прайс', items: ['Премиум-адаптер Type 2 → GB/T (SKU 1)', 'Держатель кабеля (SKU 12)', 'Смазка контактов (SKU 17)', 'Карточки моделей и базы болей — с вашим логотипом', 'Руководства на русском'] },
  { name: 'Зимний комплект', note: 'Сезонный лид-оффер', pop: false, cta: 'Запросить условия', items: ['Комплект «Комплект» + зимний набор', 'Кейс: простая стоянка, ночёвка, замена', 'Витринная упаковка под полку'] },
];
const cmp = [
  ['Адаптер Type 2 → GB/T', 'SKU 8', 'SKU 1 premium', 'SKU 1'],
  ['Обратный адаптер', 'SKU 2', 'SKU 2', 'SKU 2'],
  ['Держатель / смазка', '—', 'SKU 12 + 17', 'SKU 12'],
  ['Маркетинг-база (боли, карточки)', '—', '✓ с логотипом', '✓'],
  ['Поддержка подбора', 'консультация', '✓ приоритет', '✓'],
];
const icos = ['📦', '🤝', '🧰'];
---
<ZhLayout title="Комплекты адаптеров и поддержка продаж — B2B — Запас хода" description="Дилерам и автосалонам: оптовые комплекты адаптеров Type 2 → GB/T, поддержка продаж, РРЦ и партнёрский пакет PDF." jsonld={faqLd}>
  <div class="hero" style="padding:72px 0 64px">
    <div class="wrap">
      <div class="badge" style="color:#D4AF37">Дилерам и автосалонам</div>
      <h1>Комплекты адаптеров <span>и поддержка продаж</span></h1>
      <p>Оптовые цены и условия фиксируем в прайсе — публично показываем только розницу и состав комплектов.</p>
      <a class="btn btn-gold" href="/b2b/paket-dileram.pdf" download>Скачать партнёрский пакет (PDF)</a>
    </div>
  </div>
  <section class="sec">
    <div class="wrap">
      <h2>Три партнёрских уровня</h2>
      <div class="plans" style="margin-top:32px">
        {plans.map((p) => (
          <div class:list={["plan", p.pop && "pop"]}>
            {p.pop && <div class="popb">Популярный</div>}
            <h3>{p.name}</h3>
            <p style="font-size:13.5px;color:var(--txt-muted)">{p.note}</p>
            <div class="price">по запросу <small>/ опт</small></div>
            <ul>{p.items.map((it) => <li>{it}</li>)}</ul>
            <a class="btn btn-ghost" style="width:100%;text-align:center;text-decoration:none" href="https://zapashoda-ev.ru/b2b/" rel="nofollow">{p.cta}</a>
          </div>
        ))}
      </div>
      <h2 style="margin-top:56px">Сравнение уровней</h2>
      <table class="cmp">
        <tr><th>Фича</th><th>Старт</th><th>Комплект</th><th>Зимний</th></tr>
        {cmp.map((row) => (
          <tr><td>{row[0]}</td><td>{row[1]}</td><td>{row[2]}</td><td>{row[3]}</td></tr>
        ))}
      </table>
      {c.benefits && c.benefits.length > 0 && (
        <>
          <h2 style="margin-top:56px">Что получает партнёр</h2>
          <div class="cards" style="margin-top:24px">
            {c.benefits.map((b: string, i: number) => (
              <div class="card"><span class="ico">{icos[i] || '✓'}</span><p style="font-size:15px;color:var(--txt)">{b}</p></div>
            ))}
          </div>
        </>
      )}
      <h2 style="margin-top:56px">Как работаем</h2>
      <div class="cards" style="margin-top:24px">
        {c.steps.map((s: string, i: number) => (
          <div class="card"><span class="ico">{i + 1}</span><p style="font-size:15px;color:var(--txt)">{s}</p></div>
        ))}
      </div>
      {rrc.length > 0 && (
        <>
          <h2 style="margin-top:56px">Рекомендуемые розничные цены (РРЦ)</h2>
          <div class="card" style="margin-top:18px;padding:0;overflow:hidden">
            <table style="width:100%;border-collapse:collapse;font-size:15px">
              <thead><tr style="border-bottom:1px solid var(--line)"><th style="text-align:left;padding:12px 16px">Позиция</th><th style="text-align:right;padding:12px 16px">РРЦ</th></tr></thead>
              <tbody>
                {rrc.map(([name, price]: [string, string]) => (
                  <tr style="border-bottom:1px solid var(--line)"><td style="padding:10px 16px">{name}</td><td style="padding:10px 16px;text-align:right;font-weight:700">{price}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )}
      {c.infra && c.infra.length > 0 && (
        <>
          <h2 style="margin-top:56px">Зарядная инфраструктура для бизнеса: ТЦ, паркинги, HoReCa</h2>
          <div class="cards" style="margin-top:24px">
            {c.infra.map((s: string, i: number) => (
              <div class="card"><span class="ico">{['🏢', '🅿️', '☕'][i] || '✓'}</span><p style="font-size:15px;color:var(--txt)">{s}</p></div>
            ))}
          </div>
        </>
      )}
      <h2 style="margin-top:56px">FAQ по сотрудничеству</h2>
      <div class="faqbox" style="margin-top:20px;max-width:820px">
        {faq.map((f: any) => (
          <details open={f.q === faq[0].q}><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>
  <section class="sec">
    <div class="wrap">
      <div class="cta">
        <h2>Запросить расчёт проекта</h2>
        <p>Опишите вашу машину и задачи в форме подбора — на продвижении прайса и условий для дилеров ответит наш менеджер. Партнёрский пакет с ценами пришлём вместе с расчётом.</p>
        <a class="btn btn-gold" href="/quiz/" style="text-decoration:none">Отправить заявку за 30 секунд</a>
      </div>
    </div>
  </section>
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
</ZhLayout>
