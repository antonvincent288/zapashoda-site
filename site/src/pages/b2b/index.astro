---
import ZhLayout from '../../layouts/ZhLayout.astro';
import c from '../../data/b2b_content.json';
import { PRICES_ON, priceFix } from '../../lib/prices';
const rrc = c.rrc || [];
const faqProd = c.faq || [];
const faqMock = [
  { q: 'Как оформить первый пилот?', a: 'Начинаем с небольшой партии, чтобы проверить спрос без заморозки денег. Условия и объёмы фиксируем в прайсе — с ценами, не «на пальцах».' },
  { q: 'Что входит в маркетинговую поддержку?', a: 'База из 164 типовых разборов и 154 карточек моделей, руководства на русском и карта станций — с вашим логотипом, чтобы продавали допы без лишних вопросов.' },
];
const faq = [...faqMock, ...faqProd.filter((f: any) =>!faqMock.some((m) =>m.q === f.q))];
const faqLd = faq.length ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) =>({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) } : null;
const plans = [
  { name: 'Старт', note: 'Проверка спроса без заморозки денег', anchor: 'Пилот от 5 наборов', pop: false, cta: 'Оставить заявку', items: ['Базовый адаптер Type 2 → GB/T', 'Обратный адаптер GB/T → Type 2', 'Мини-партия для пилота', 'Консультация по подбору'] },
  { name: 'Стандарт', note: 'Оптимальный выбор для салона', anchor: 'Маржа салона до 35%', pop: true, cta: 'Получить прайс', items: ['Премиум-адаптер Type 2 → GB/T', 'Обратный адаптер GB/T → Type 2', 'Держатель кабеля', 'Смазка контактов', 'Карточки моделей и ответы на вопросы клиентов — с вашим логотипом', 'Руководства на русском'] },
  { name: 'Зимний', note: 'Сезонный лид-оффер', anchor: 'Сезонный хит · витрина', pop: false, cta: 'Запросить условия', items: ['Набор уровня «Стандарт» + зимний комплект', 'Кейс: простая стоянка, ночёвка, замена', 'Витринная упаковка под полку'] },
];
const cmp = [
  ['Адаптер Type 2 → GB/T', 'Базовый', 'Премиум', 'Премиум'],
  ['Обратный адаптер', '✓ Входит', '✓ Входит', '✓ Входит'],
  ['Держатель / смазка', '—', '✓ В комплекте', '✓ В комплекте'],
  ['База для отдела продаж (164 разбора и карточки)', '—', 'с логотипом', 'с логотипом'],
  ['Поддержка подбора', 'консультация', 'приоритет', 'приоритет'],
];
const icos = [
  '<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 7H9a3 3 0 0 0-3 3v9"/><path d="M20 7V3H8"/><rect x="3" y="14" width="8" height="7" rx="1.5"/></svg>',
  '<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 21h8M12 8l2 4h-4l2-4z"/></svg>',
  '<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 17h14l-1-5-3-1V8l-2-2H8l-2 3v3l-2 1z"/><circle cx="7.5" cy="17.5" r="1.5"/><circle cx="16.5" cy="17.5" r="1.5"/><path d="M12 3v4M10 5h4"/></svg>'
];
---
<ZhLayout title="Комплекты адаптеров и поддержка продаж — B2B — Запас хода" description="Дилерам и автосалонам: оптовые комплекты адаптеров Type 2 → GB/T, поддержка продаж, РРЦ и партнёрский пакет PDF." jsonld={faqLd}><div class="hero" style="padding:72px 0 64px"><div class="wrap hero-grid"><div><div class="badge" style="color:#4D9BF5;border:1px solid rgba(77,155,245,.45);border-radius:999px;padding:6px 16px;display:inline-block;font-size:13px;letter-spacing:.02em">Дилерам и автосалонам</div><h1 style="line-height:1.15;margin:18px 0 12px">Комплекты адаптеров <span>и поддержка продаж</span></h1><p style="font-size:16px;color:var(--txt-muted,#94A3B8);max-width:560px;margin:0 0 22px">Готовые наборы зарядных адаптеров и база знаний на 154 модели под брендом вашего салона. Увеличивайте маржу на выдаче каждого электромобиля и закрывайте вопросы клиентов по зарядке с первого дня — оптовый прайс и условия фиксируем индивидуально.</p><div class="hero-btns"><a class="btn btn-gold zs-cta-btn" data-mode="b2b" style="cursor:pointer;text-decoration:none">Запросить оптовый прайс</a><a class="btn btn-ghost" href="/b2b/paket-dileram.pdf" download style="text-decoration:none">Скачать партнёрский пакет (PDF)</a></div><div class="hero-facts"><span>Склад в Москве · отгрузка 1 день</span><span>Подмена брака за 24 часа</span><span>Материалы с вашим лого</span></div></div><div class="kit-card"><div class="kit-badge">Дилерский комплект выдачи EV</div><div class="kit-row"><span class="kit-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg></span><div><b>Type 2 → GB/T 32A</b><p>Клиент заряжается на станциях GB/T</p></div></div><div class="kit-row"><span class="kit-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="M11 18l-6-6 6-6"/></svg></span><div><b>Обратный GB/T → Type 2</b><p>И на европейских станциях тоже</p></div></div><div class="kit-row"><span class="kit-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2s6 7 6 11a6 6 0 0 1-12 0c0-4 6-11 6-11z"/></svg></span><div><b>Диэлектрическая смазка</b><p>Контакты не окисляются — зарядка стабильна</p></div></div><div class="kit-row"><span class="kit-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h5"/></svg></span><div><b>Памятка владельца с лого салона</b><p>Клиент вспоминает салон при каждой зарядке</p></div></div></div></div></div><section class="sec"><div class="wrap"><h2>Форматы закупки: от теста до партии с вашим лого</h2><div class="plans" style="margin-top:32px">{plans.map((p) =>(
          <div class:list={["plan", p.pop && "pop"]} style={p.pop ? "border:1.5px solid rgba(212,175,55,.85);box-shadow:0 12px 40px rgba(212,175,55,.13);background:rgba(255,255,255,.035)" : ""}>{p.pop && <div class="popb">Популярный</div>}
            <h3>{p.name}</h3><p style="font-size:15px;color:#CBD5E1">{p.note}</p><div class="price" style={`font-size:18px;font-weight:700;${p.pop ? 'color:#D4AF37' : 'color:#F8FAFC'}`}>{p.anchor}</div><ul>{p.items.map((it) =><li>{it}</li>)}</ul><a class={(p.pop ? "btn btn-gold" : "btn btn-ghost") + " zs-cta-btn"} data-mode="b2b" style="width:100%;text-align:center;text-decoration:none;cursor:pointer">{p.cta}</a></div>))}
      </div><h2>Сравнение уровней</h2><div style="overflow-x:auto;-webkit-overflow-scrolling:touch"><table class="cmp"><tr><th>Фича</th><th>Старт</th><th style="background:rgba(255,255,255,.035)">Стандарт</th><th>Зимний</th></tr>{cmp.map((row) =>(
          <tr><td>{row[0]}</td>{row.slice(1).map((v: string, j: number) =>(<td style={j === 1 ? "background:rgba(255,255,255,.035)" : ""}>{v.startsWith("✓") && <span style="color:#34d399;margin-right:6px">✓</span>}{v.startsWith("✓") ? v.slice(2) : v}</td>))}</tr>))}
      </table></div></div></section><section class="sec sec-tint"><div class="wrap">{c.benefits && c.benefits.length >0 && (
        <><h2>Почему автосалоны и парки выбирают нас</h2><div class="cards b3grid" style="margin-top:24px">{c.benefits.map((b: string, i: number) =>(
              <div class="card"><span class="ico" set:html={icos[i] || ''}></span><h3 style="font-size:19px;font-weight:700;margin:0 0 8px;color:#F8FAFC">{priceFix(b.split('.  ')[0])}</h3><p style="font-size:16px;line-height:1.6;color:#CBD5E1;margin:0">{priceFix(b.split('.  ').slice(1).join('.  '))}</p></div>))}
          </div></>)}
      </div></section><section class="sec"><div class="wrap"><h2>От заявки до отгрузки со склада в Москве — 4 шага</h2><div class="steps" style="margin-top:28px">{c.steps.map((s: string, i: number) =>(
          <div class="step"><div class="step-n">{String(i + 1).padStart(2, '0')}</div><h3 style="font-size:19px;font-weight:700;margin:0 0 6px;color:#F8FAFC">{s.split('.  ')[0]}</h3><p style="font-size:16px;line-height:1.6;color:#CBD5E1;margin:0">{s.split('.  ').slice(1).join('.  ')}</p></div>))}
      </div>{PRICES_ON && rrc.length >0 && (
        <><h2>Рекомендуемые розничные цены (РРЦ)</h2><p style="font-size:13.5px;color:var(--txt-muted);margin-top:6px">РРЦ соответствуют ценам каталога zapashoda-ev.ru/catalog/ 1:1. Оптовые цены и состав партии фиксируются в прайсе по запросу — скидка зависит от объёма и позиций.</p><div class="card" style="margin-top:18px;padding:0;overflow:hidden"><table style="width:100%;border-collapse:collapse;font-size:15px"><thead><tr style="border-bottom:1px solid var(--line)"><th style="text-align:left;padding:12px 16px">Позиция</th><th style="text-align:right;padding:12px 16px">РРЦ</th></tr></thead><tbody>{rrc.map(([name, price]: [string, string]) =>(
                  <tr style="border-bottom:1px solid var(--line)"><td style="padding:10px 16px">{name}</td><td style="padding:10px 16px;text-align:right;font-weight:700">{price}</td></tr>))}
              </tbody></table></div></>)}

      </div></section><section class="sec sec-tint"><div class="wrap"><div class="faq-grid"><div class="faq-left"><h2>Частые вопросы по сотрудничеству</h2><p class="faq-sub">Отвечаем на главные вопросы по пилотной партии, документам с НДС, логистике и бонусам для отдела продаж</p><a class="btn btn-gold zs-cta-btn" data-mode="b2b" style="cursor:pointer;text-decoration:none">Задать свой вопрос</a></div><div class="faq-right"><div class="faqbox">{faq.map((f: any) =>(
          <details open={faq.indexOf(f) < 2} style="text-align:left"><summary class="faq-q"><span>{f.q}</span><span class="faq-chev">▾</span></summary><div class="faq-answer">{f.a}</div></details>))}
      </div></div></div></div></section><section class="sec"><div class="wrap"><><h2>Зарядная инфраструктура для бизнеса: ТЦ, паркинги, HoReCa</h2><div class="infra3" style="margin-top:24px"><div class="card"><span class="chip">2-в-1 · 22 кВт</span><h3>ТЦ и бизнес-центры</h3><p>Станции 2-в-1 (Type 2 + GB/T, 22 кВт) покрывают оба потока: клиенты и сотрудники.</p><a href="#b2b-cta" class="infra-link">Подобрать станцию 2-в-1 →</a></div><div class="card"><span class="chip">Type 2 · 7–22 кВт</span><h3>Паркинги</h3><p>Подземные и наземные: настенные Type 2 — 7 или 22 кВт под расчёт мощности и схему учёта.</p><a href="#b2b-cta" class="infra-link">Рассчитать мощность и учёт →</a></div><div class="card"><span class="chip">GB/T · 3,5–7 кВт</span><h3>HoReCa</h3><p>Гостевая зарядка GB/T 3,5–7 кВт или портативные комплекты для гостей.</p><a href="#b2b-cta" class="infra-link">Подобрать гостевую зарядку →</a></div></div></>
</div></section><section class="sec-alt"><div class="wrap">
      <h2>Кому подходим</h2>
      <div class="cards" style="margin-top:24px">
        {[['taksi','Таксопарки и каршеринг','Комплекты адаптеров, обучение водителей, замена за 1 день'],['avtopark','Корпоративные автопарки','Разные разъёмы в одном гараже: адаптеры и настенные станции'],['azs','АЗС и платные парковки','Зарядка как допродажа к остановке; точка на карте — бесплатно'],['jk','ЖК и застройщики','Паркинги и дворы: расчёт мощности и схема учёта'],['salony','Автосалоны и дилеры','Партнёрские уровни Старт / Стандарт / Зимний без заморозки денег'],['predlozh-mesto','Предложить место для зарядки','Бесплатный расчёт сценария для собственников площадок']].map((sg) => (
          <a class="card" href={`/b2b/${sg[0]}/`} style="text-decoration:none;display:block">
            <b style="display:block;margin-bottom:6px">{sg[1]}</b>
            <p style="font-size:16px;line-height:1.6;color:#CBD5E1">{sg[2]}</p>
            <p style="margin-top:8px;font-size:13px;color:var(--gold)">Подробнее →</p>
          </a>
        ))}
      </div>
    </div></section><section class="sec" id="b2b-cta"><div class="wrap"><div class="cta" style="background:linear-gradient(135deg,rgba(59,130,246,.12) 0%,rgba(15,23,42,.9) 100%);border:1px solid rgba(59,130,246,.3);border-radius:20px;padding:48px 40px"><h2>Запросить прайс и условия для бизнеса</h2><p>Укажите профиль компании, город и ориентировочный парк или объём продаж — пришлём дилерский прайс и расчёт пилотной партии в течение рабочего дня.</p><div style="display:flex;gap:14px;flex-wrap:wrap;justify-content:center;margin-top:18px"><a class="btn btn-gold zs-cta-btn" data-mode="b2b" style="cursor:pointer;text-decoration:none">Запросить оптовый прайс</a><a class="btn btn-ghost" href="/b2b/paket-dileram.pdf" download style="text-decoration:none">Скачать партнёрский пакет (PDF)</a></div></div></div></section><script is:inline>(function(){document.addEventListener("click",function(e){var btn=e.target.closest(".zs-cta-btn");if(!btn)return;var mode=btn.getAttribute("data-mode")||"retail";if(window.ZS_OPEN_LEAD){window.ZS_OPEN_LEAD("","","","",mode==="b2b"?"b2b":"retail");}else{location.href="/quiz/";}},true);})();</script>{faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
<style is:inline>{`
.b3grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;align-items:stretch}
.b3grid .card{height:100%;box-sizing:border-box}
.b3grid .ico{display:inline-flex;align-items:center;justify-content:center;width:52px;height:52px;border-radius:14px;background:rgba(212,175,55,.12);margin-bottom:12px}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;position:relative}

.step{position:relative;z-index:1;border-top:1px solid rgba(255,255,255,.12);padding-top:20px}
.step-n{font-size:28px;font-weight:800;color:var(--accent-primary,#D4AF37);font-variant-numeric:tabular-nums;margin-bottom:12px;line-height:1}
.step p{margin:0}
.faqbox summary{list-style:none;cursor:pointer}
.faqbox summary::-webkit-details-marker{display:none}


.sec-alt .card{transition:border-color .2s ease,box-shadow .2s ease}
.sec-alt .card:hover{border-color:rgba(212,175,55,.7)}
.sec-alt .card p:last-child{transition:transform .2s ease}
.sec-alt .card:hover p:last-child{transform:translateX(4px)}
@media(max-width:900px){.steps{grid-template-columns:1fr;gap:18px}.b3grid{grid-template-columns:1fr}}
@media(max-width:768px){.cmp td:first-child,.cmp th:first-child{position:sticky;left:0;background:var(--bg,#0B0D10);z-index:1}.cmp{min-width:520px}}
.hero-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:32px;align-items:center}
.hero h1{font-size:36px}
.hero-btns{display:flex;gap:12px;flex-wrap:wrap}
.hero-facts{display:flex;gap:12px;flex-wrap:wrap;margin-top:18px;font-size:13.5px;color:var(--txt-muted,#94A3B8)}
.hero-facts span{padding-left:12px;border-left:1px solid rgba(212,175,55,.35)}
.hero-facts span:first-child{padding-left:0;border-left:none}
.kit-card{background:rgba(255,255,255,.03);border:1px solid rgba(212,175,55,.3);border-radius:20px;padding:22px}
.kit-badge{font-size:12.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#D4AF37;margin-bottom:6px}
.kit-row{display:flex;gap:12px;align-items:flex-start;padding:10px 0}
.kit-row + .kit-row{border-top:1px solid rgba(255,255,255,.06)}
.kit-ico{flex:0 0 36px;width:36px;height:36px;border-radius:12px;background:rgba(212,175,55,.12);display:flex;align-items:center;justify-content:center}
.kit-row b{display:block;font-size:14.5px;color:var(--txt,#fff)}
.kit-row p{margin:2px 0 0;font-size:13px;color:var(--txt-muted,#94A3B8)}
.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;align-items:stretch}
.plan{display:flex;flex-direction:column;height:100%;box-sizing:border-box}
.plan ul{flex-grow:1}
.plan .btn{margin-top:auto}
.infra3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.infra3 .card{display:flex;flex-direction:column;height:100%;box-sizing:border-box}
.infra3 h3{font-size:19px;font-weight:700;margin:10px 0 6px;color:#F8FAFC}
.infra3 .chip{display:inline-block;font-size:12.5px;font-weight:600;color:#D4AF37;border:1px solid rgba(212,175,55,.45);border-radius:999px;padding:4px 10px;align-self:flex-start}
.infra3 p{font-size:16px;line-height:1.6;color:#CBD5E1;margin:0 0 14px;flex-grow:1}
.infra3 .infra-link{margin-top:auto;color:#D4AF37;text-decoration:none;font-size:14px}
@media(max-width:900px){.hero-grid{grid-template-columns:1fr}.plans{grid-template-columns:1fr}.infra3{grid-template-columns:1fr}}
@media(max-width:640px){.hero h1{font-size:26px}}
.sec{padding-block:72px}
.sec-tint{background:rgba(255,255,255,.025);border-block:1px solid rgba(255,255,255,.06)}
@media(max-width:640px){.sec{padding-block:48px}}
.sec h2{font-size:32px;font-weight:700;color:#F8FAFC;margin:0 0 28px}
@media(max-width:640px){.sec h2{font-size:24px}}
.card h3,.infra3 h3{font-size:19px;font-weight:700;color:#F8FAFC}
.wrap .card,.wrap .plan{padding:28px}
@media(max-width:640px){.wrap .card,.wrap .plan{padding:20px}}
.wrap .plan ul li{font-size:16px;line-height:1.6;color:#CBD5E1}
.faq-grid{display:grid;grid-template-columns:.85fr 1.65fr;gap:48px;align-items:start}
.faq-left{position:sticky;top:96px}
.faq-sub{font-size:16px;color:#CBD5E1;margin:0 0 22px}
.faq-right details{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);border-radius:12px;margin-bottom:12px;text-align:left}
.faq-right .faq-q{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;padding:20px 24px;font-size:17px;font-weight:600;color:#F8FAFC;cursor:pointer;list-style:none;text-align:left}
.faq-right .faq-answer{padding:0 24px 22px;font-size:16px;line-height:1.65;color:#CBD5E1;text-align:left}
@media(max-width:900px){.faq-grid{grid-template-columns:1fr}.faq-left{position:static}}
.faq-chev{flex-shrink:0;margin-top:3px;font-size:20px;color:#D4AF37}
.wrap .cmp th,.wrap .cmp td{padding:16px 20px}
.wrap .cmp th{font-size:16px;font-weight:700}
.wrap .cmp td{font-size:15px;line-height:1.5}
`}</style>
</ZhLayout>