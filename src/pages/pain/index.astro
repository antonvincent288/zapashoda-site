---
import ArticleCard from '@/components/ArticleCard'
import TitlePage from '@/components/TitlePage'
import { bySection } from '../../utils/articles'
const posts = bySection('pain')
---
<TitlePage title='Проблемы электромобилей: разбор и решения' description='Реальные проблемы владельцев EV в России: зарядка, адаптеры, батарея, VIN — и что с ними делать' />
<main class='mx-auto max-w-6xl px-4 py-8'>
  <div class='grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3'>
    {posts.map((a) => <ArticleCard article={a} />)}
  </div>
</main>
