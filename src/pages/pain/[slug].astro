---
import Article from '../layouts/Article'
export async function getStaticPaths() {
  const { bySection } = await import('../../utils/articles')
  const all = bySection('pain')
  return all.map((a) => ({ params: { slug: a.slug }, props: { article: a } }))
}
type Props = { article: any }
const { article } = Astro.props as { article: any }
------
<Article article={article} crumbs={[{ label: 'Проблемы', href: '/pain/' }, { label: article.title }]} />
