---
import ArticleCard from '@/components/ArticleCard'
import TitlePage from '@/components/TitlePage'
import { bySection } from '../../../../utils/articles'
const posts = bySection('blog')
---
<TitlePage title='Блог «Запас хода»' description='Практика владения электромобилем в России: зарядка, зима, гарантии, реальные истории' />
<main class='mx-auto max-w-6xl px-4 py-8'>
  <div class='grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3'>
    {posts.map((a) => <ArticleCard article={a} />)}
  </div>
</main>
