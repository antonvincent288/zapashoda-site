---
import Article from '@/layouts/Article'
import { bySection, getArticle } from '../../utils/articles'
const all = bySection('blog')
export function getStaticPaths() {
  return all.map((a) => ({ params: { slug: a.slug }, props: { article: a } }))
}
type Props = { article: ReturnType<typeof getArticle> }
const { article } = Astro.props as { article: any }
---
<Article article={article} crumbs={[{ label: 'Блог', href: '/blog/' }, { label: article.title }]} />
