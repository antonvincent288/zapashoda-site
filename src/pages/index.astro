import ListPosts from '@/components/ListPosts'
import TitlePage from '@/components/TitlePage'
import BaseLayout from '@/layouts/BaseLayout'
---

<BaseLayout title='Запас хода — зарядка электромобилей в России'>
	<TitlePage title='Запас хода' />
	<ListCategories />

	<div>
		<h2 class='text-lg font-medium tracking-wide text-end'>Свежие статьи</h2>
		<ListPosts FirstBig={true} max={6} />
	</div>

	<div class='mt-10 text-center'>
		<a href='/blog/' class='font-semibold text-indigo-600 dark:text-indigo-400 hover:underline'
			>Все 59 статей →</a
		>
	</div>
</BaseLayout>
