---
import PostCard from '@/components/PostCard'
import { ARTICLES } from '../utils/articles'

const LABEL: Record<string, string> = { blog: 'Зарядка', pain: 'Проблемы', safety: 'Безопасность' }

type Props = { posts?: unknown[]; FirstBig?: boolean; max?: number }
const { posts, FirstBig = false, max = 6 } = Astro.props

const raw = (posts ?? ARTICLES).slice(0)
const sorted = raw.sort((x: any, y: any) => String(y.date || '').localeCompare(String(x.date || '')))
const source = sorted.slice(0, max)
const cards = source.map((a: any) => ({
	slug: a.slug,
	href: '/' + (a.section || 'blog') + '/' + a.slug + '/',
	title: a.title,
	description: a.desc,
	heroImage: a.og || '/assets/og/default.png',
	category: LABEL[a.section] || 'Зарядка',
	pubDate: a.date || '',
	readTime: a.read_min ? a.read_min + ' мин чтения' : '4 мин чтения'
}))
---

<section
	class:list={['grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 mt-3', FirstBig && 'md:[&>*:first-child]:col-span-2']}
>
	{cards.map((c: any) => <PostCard article={c} />)}
</section>
