import PostCard from '@/components/PostCard'
import { cn } from '@/utils'
import { ARTICLES } from '@/utils/articles'

const SECTION_LABEL = { blog: 'Зарядка', pain: 'Проблемы', safety: 'Безопасность' }
export function toCard(a) {
	return {
		slug: a.slug,
		title: a.title,
		description: a.desc,
		heroImage: a.og,
		category: SECTION_LABEL[a.section] || a.category,
		pubDate: a.date,
		readTime: a.read_min ? `${a.read_min} мин чтения` : '4 мин чтения'
	}
}

type Props = { posts?: unknown[]; FirstBig?: boolean; max?: number; exclude?: string[] }
const { FirstBig = false, max = 6, exclude = [] } = Astro.props
const source = (posts ?? ARTICLES.filter((a) => !exclude.includes(a.slug)))
	.sort((x, y) => (x.date < y.date ? 1 : -1))
	.slice(0, max)
---

<section
	class={cn(
		`grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 mt-3`,
		FirstBig && `md:[&>*:first-child]:col-span-2`
	)}
>
	{source.map((a) => <PostCard article={toCard(a)} />)}
</section>
