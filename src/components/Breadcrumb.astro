---
type Crumb = { label: string; href?: string }
const { items } = Astro.props as { items: Crumb[] }
---
<nav aria-label='Хлебные крошки' class='mb-4'>
  <ol class='flex flex-wrap items-center gap-1 text-sm text-slate-500 dark:text-slate-400'>
    <li><a class='hover:text-blue-600 dark:hover:text-blue-400' href='/'>Главная</a></li>
    {items.map((c) => (
      <li class='flex items-center gap-1'>
        <span class='opacity-50'>/</span>
        {c.href ? (
          <a class='hover:text-blue-600 dark:hover:text-blue-400' href={c.href}>{c.label}</a>
        ) : (
          <span class='font-medium text-slate-700 dark:text-slate-200' aria-current='page'>{c.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
